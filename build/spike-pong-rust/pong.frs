@@[target("rust")]

@@system Pong {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }
        get_winning_score(): i32 { @@:(@@:self.winning_score) }

    interface:
        start()
        restart()
        launch()
        pause()
        resume()
        tick()
        ball_out_left()
        ball_out_right()
        get_score_left(): i32
        get_score_right(): i32
        get_serve_direction(): i32
        get_winner(): String
        is_playing(): bool

    machine:
        $AttractMode {
            $>() {
                @@:self.score_left = 0;
                @@:self.score_right = 0;
                @@:self.winner = "".to_string();
            }

            start() { -> $Serving }

            get_score_left(): i32        { @@:(@@:self.score_left) }
            get_score_right(): i32       { @@:(@@:self.score_right) }
            get_serve_direction(): i32   { @@:(@@:self.serving_to) }
            get_winner(): String         { @@:(@@:self.winner.clone()) }
            is_playing(): bool           { @@:(false) }
        }

        $Serving {
            launch() { -> $InPlay }
            pause() { push$ -> $Paused }

            get_score_left(): i32        { @@:(@@:self.score_left) }
            get_score_right(): i32       { @@:(@@:self.score_right) }
            get_serve_direction(): i32   { @@:(@@:self.serving_to) }
            get_winner(): String         { @@:(@@:self.winner.clone()) }
            is_playing(): bool           { @@:(false) }
        }

        $InPlay {
            ball_out_left() {
                @@:self.score_right = @@:self.score_right + 1;
                @@:self.last_scorer = "right".to_string();
                -> $PointScored
            }

            ball_out_right() {
                @@:self.score_left = @@:self.score_left + 1;
                @@:self.last_scorer = "left".to_string();
                -> $PointScored
            }

            pause() { push$ -> $Paused }

            get_score_left(): i32        { @@:(@@:self.score_left) }
            get_score_right(): i32       { @@:(@@:self.score_right) }
            get_serve_direction(): i32   { @@:(@@:self.serving_to) }
            get_winner(): String         { @@:(@@:self.winner.clone()) }
            is_playing(): bool           { @@:(true) }
        }

        $PointScored {
            $>() {
                if @@:self.last_scorer == "left" {
                    @@:self.serving_to = 1;
                } else {
                    @@:self.serving_to = -1;
                }

                if @@:self.score_left >= @@:self.winning_score {
                    @@:self.winner = "left".to_string();
                    -> "left wins" $GameOver
                } else if @@:self.score_right >= @@:self.winning_score {
                    @@:self.winner = "right".to_string();
                    -> "right wins" $GameOver
                } else {
                    -> "next point" $Serving
                }
            }

            get_score_left(): i32        { @@:(@@:self.score_left) }
            get_score_right(): i32       { @@:(@@:self.score_right) }
            get_serve_direction(): i32   { @@:(@@:self.serving_to) }
            get_winner(): String         { @@:(@@:self.winner.clone()) }
            is_playing(): bool           { @@:(false) }
        }

        $Paused {
            resume() { -> pop$ }

            get_score_left(): i32        { @@:(@@:self.score_left) }
            get_score_right(): i32       { @@:(@@:self.score_right) }
            get_serve_direction(): i32   { @@:(@@:self.serving_to) }
            get_winner(): String         { @@:(@@:self.winner.clone()) }
            is_playing(): bool           { @@:(false) }
        }

        $GameOver {
            restart() { -> $AttractMode }

            get_score_left(): i32        { @@:(@@:self.score_left) }
            get_score_right(): i32       { @@:(@@:self.score_right) }
            get_serve_direction(): i32   { @@:(@@:self.serving_to) }
            get_winner(): String         { @@:(@@:self.winner.clone()) }
            is_playing(): bool           { @@:(false) }
        }

    domain:
        score_left: i32 = 0
        score_right: i32 = 0
        winning_score: i32 = 11
        serving_to: i32 = 1
        last_scorer: String = ""
        winner: String = ""
}
