@@[target("lua")]

-- Stealth — guard agent AI, Lua port of the canonical controller
-- (games/stealth/src/stealth.fjs). Native Lua bodies (brace blocks with
-- paren-stripped conditions, @@:self access, math.sqrt, 1-based patrol
-- indexing); the @@[persist]/@@[save]/@@[load] contract is kept.

@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Guard {

    interface:
        init(patrol, speed)
        tick(dt, current_pos)
        spot_player(at)
        hear_sound(at)
        touched_player()
        get_state(): string
        get_target()
        get_last_known()
        is_aware(): boolean
        is_alerted(): boolean
        should_move(): boolean

    machine:
        $Idle {
            init(patrol, speed) {
                @@:self.patrol = patrol
                @@:self.speed = speed
                @@:self.next_wp = 0
                if #patrol > 0 {
                    @@:self.target = patrol[1]
                }
                -> $Patrolling
            }

            tick(dt, current_pos) {
            }

            get_state(): string         { @@:("idle") }
            get_target()                { @@:(@@:self.target) }
            get_last_known()            { @@:(@@:self.last_known) }
            is_aware(): boolean         { @@:(false) }
            is_alerted(): boolean       { @@:(false) }
            should_move(): boolean      { @@:(false) }
        }

        $Aware {
            spot_player(at) {
                @@:self.last_known = at
                -> $Alerted
            }

            touched_player() {
                -> $Engaged
            }

            get_state(): string         { @@:("aware") }
            get_target()                { @@:(@@:self.target) }
            get_last_known()            { @@:(@@:self.last_known) }
            is_aware(): boolean         { @@:(true) }
            is_alerted(): boolean       { @@:(false) }
            should_move(): boolean      { @@:(true) }
        }

        $Patrolling => $Aware {
            tick(dt, current_pos) {
                if #@@:self.patrol == 0 {
                    return
                }
                local dx = current_pos.x - @@:self.target.x
                local dy = current_pos.y - @@:self.target.y
                local d = math.sqrt(dx * dx + dy * dy)
                if d < @@:self.ARRIVAL_RADIUS {
                    @@:self.next_wp = @@:self.next_wp + 1
                    if @@:self.next_wp >= #@@:self.patrol {
                        @@:self.next_wp = 0
                    }
                    @@:self.target = @@:self.patrol[@@:self.next_wp + 1]
                }
            }

            hear_sound(at) {
                push$
                @@:self.last_known = at
                -> $Investigating
            }

            get_state(): string         { @@:("patrolling") }
            is_aware(): boolean         { @@:(false) }
            should_move(): boolean      { @@:(true) }
            => $^
        }

        $Investigating => $Aware {
            $.timer: number = 0.0

            tick(dt, current_pos) {
                $.timer = $.timer + dt
                if $.timer >= @@:self.INVESTIGATE_DURATION {
                    -> pop$
                }
            }

            get_state(): string { @@:("investigating") }
            should_move(): boolean { @@:(false) }
            => $^
        }

        $Alerted => $Aware {
            $.chase_timer: number = 0.0

            spot_player(at) {
                @@:self.last_known = at
                $.chase_timer = 0.0
            }

            tick(dt, current_pos) {
                @@:self.target = @@:self.last_known
                $.chase_timer = $.chase_timer + dt
                local dx = current_pos.x - @@:self.last_known.x
                local dy = current_pos.y - @@:self.last_known.y
                local d = math.sqrt(dx * dx + dy * dy)
                if d < @@:self.ARRIVAL_RADIUS {
                    -> $Searching
                } elseif $.chase_timer >= @@:self.CHASE_TIMEOUT {
                    -> $Searching
                }
            }

            get_state(): string { @@:("alerted") }
            is_alerted(): boolean { @@:(true) }
            should_move(): boolean { @@:(true) }
            => $^
        }

        $Searching => $Aware {
            $.timer: number = 0.0

            tick(dt, current_pos) {
                $.timer = $.timer + dt
                if $.timer >= @@:self.SEARCH_DURATION {
                    @@:self._resume_patrol(current_pos)
                    -> $Patrolling
                }
            }

            get_state(): string { @@:("searching") }
            should_move(): boolean { @@:(false) }
            => $^
        }

        $Engaged {
            tick(dt, current_pos) {
            }

            get_state(): string         { @@:("engaged") }
            get_target()                { @@:(@@:self.target) }
            get_last_known()            { @@:(@@:self.last_known) }
            is_aware(): boolean         { @@:(true) }
            is_alerted(): boolean       { @@:(true) }
            should_move(): boolean      { @@:(false) }
        }

    actions:
        _resume_patrol(current_pos) {
            if #@@:self.patrol == 0 {
                return
            }
            local best_i = 0
            local b0dx = current_pos.x - @@:self.patrol[1].x
            local b0dy = current_pos.y - @@:self.patrol[1].y
            local best_d = math.sqrt(b0dx * b0dx + b0dy * b0dy)
            local i = 1
            while i < #@@:self.patrol {
                local dx = current_pos.x - @@:self.patrol[i + 1].x
                local dy = current_pos.y - @@:self.patrol[i + 1].y
                local d = math.sqrt(dx * dx + dy * dy)
                if d < best_d {
                    best_d = d
                    best_i = i
                }
                i = i + 1
            }
            @@:self.next_wp = best_i
            @@:self.target = @@:self.patrol[best_i + 1]
        }

    domain:
        patrol: [] = {}
        next_wp: number = 0
        target = { x = 0.0, y = 0.0 }
        last_known = { x = 0.0, y = 0.0 }
        speed: number = 60.0
        ARRIVAL_RADIUS: number = 12.0
        INVESTIGATE_DURATION: number = 1.5
        SEARCH_DURATION: number = 3.0
        CHASE_TIMEOUT: number = 4.0
}

@@[main]
@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Stealth {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }

    interface:
        start(p1, p2, p3)
        restart()
        pause()
        resume()
        tick(dt, pos1, pos2, pos3)
        guard_caught_player(i)
        player_at_exit()
        get_state(): string
        get_elapsed(): number
        get_caught_by(): number

    machine:
        $Attract {
            $>() {
                @@:self.elapsed = 0.0
                @@:self.caught_by = -1
            }

            start(p1, p2, p3) {
                @@:self.guard1.init(p1, @@:self.PATROL_SPEED)
                @@:self.guard2.init(p2, @@:self.PATROL_SPEED)
                @@:self.guard3.init(p3, @@:self.PATROL_SPEED)
                -> $Playing
            }

            get_state(): string     { @@:("attract") }
            get_elapsed(): number   { @@:(0.0) }
            get_caught_by(): number { @@:(-1) }
        }

        $Playing {
            tick(dt, pos1, pos2, pos3) {
                @@:self.elapsed = @@:self.elapsed + dt
                @@:self.guard1.tick(dt, pos1)
                @@:self.guard2.tick(dt, pos2)
                @@:self.guard3.tick(dt, pos3)
            }

            guard_caught_player(i) {
                @@:self.caught_by = i
                if i == 0 {
                    @@:self.guard1.touched_player()
                } elseif i == 1 {
                    @@:self.guard2.touched_player()
                } elseif i == 2 {
                    @@:self.guard3.touched_player()
                }
                -> $Caught
            }

            player_at_exit() {
                -> $Escaped
            }

            pause() {
                push$ -> $Paused
            }

            get_state(): string     { @@:("playing") }
            get_elapsed(): number   { @@:(@@:self.elapsed) }
            get_caught_by(): number { @@:(@@:self.caught_by) }
        }

        $Paused {
            resume() {
                -> pop$
            }

            get_state(): string     { @@:("paused") }
            get_elapsed(): number   { @@:(@@:self.elapsed) }
            get_caught_by(): number { @@:(@@:self.caught_by) }
        }

        $Caught {
            restart() {
                -> $Attract
            }

            get_state(): string     { @@:("caught") }
            get_elapsed(): number   { @@:(@@:self.elapsed) }
            get_caught_by(): number { @@:(@@:self.caught_by) }
        }

        $Escaped {
            restart() {
                -> $Attract
            }

            get_state(): string     { @@:("escaped") }
            get_elapsed(): number   { @@:(@@:self.elapsed) }
            get_caught_by(): number { @@:(-1) }
        }

    domain:
        guard1: Guard = @@Guard()
        guard2: Guard = @@Guard()
        guard3: Guard = @@Guard()
        elapsed: number = 0.0
        caught_by: number = -1
        PATROL_SPEED: number = 95.0
}
