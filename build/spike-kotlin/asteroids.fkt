@@[target("kotlin")]

// Asteroids — Kotlin port of the Frame controller. Same three systems as every
// other port. Kotlin is a typed backend with native-passthrough control flow
// (like the C#/Dart ports): write native Kotlin `if (cond) {` / `while (cond) {`,
// with the Frame splices `@@:self.X` (domain/self), `$.x` (state var),
// `@@:(e)` / `@@:return(e)` (return slot), `@@:system.state.name`, transitions.
// Types are required (Int/Double/Boolean/String/MutableList). `@@Sys(args)`
// lowers to `Sys.__create(args)`. Kotlin has operator overloading, so Vec2 uses
// +/*; the host implements IShipHost.
import kotlin.math.cos
import kotlin.math.sin
import kotlin.math.sqrt
import kotlin.math.PI
import kotlin.random.Random

class Vec2(var x: Double = 0.0, var y: Double = 0.0) {
    operator fun plus(o: Vec2): Vec2 = Vec2(x + o.x, y + o.y)
    operator fun times(s: Double): Vec2 = Vec2(x * s, y * s)
    fun length(): Double = sqrt(x * x + y * y)
    fun distanceTo(o: Vec2): Double = sqrt((x - o.x) * (x - o.x) + (y - o.y) * (y - o.y))
}

class Asteroid(var pos: Vec2, var vel: Vec2, var size: Int, var alive: Boolean)

interface IShipHost {
    fun warp_out()
    fun warp_in()
    fun spawn_explosion()
    fun reset_ship()
}

fun rf(): Double = Random.nextDouble()
fun fromAngle(a: Double, speed: Double): Vec2 = Vec2(cos(a) * speed, sin(a) * speed)

// ------------------------------------------------------------ Ship
@@system Ship(host: IShipHost) {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }
        get_hyperspaces_remaining(): Int { @@:(@@:self.hyperspaces_remaining) }

    interface:
        tick(dt: Double)
        hit()
        hyperspace()
        respawn()
        fire()
        can_fire(): Boolean
        can_be_hit(): Boolean
        can_hyperspace(): Boolean
        is_visible(): Boolean
        is_alive(): Boolean
        get_lives(): Int

    machine:

        $Alive {
            $.cooldown: Double = 0.0
            tick(dt: Double) {
                if ($.cooldown > 0.0) {
                    $.cooldown = $.cooldown - dt
                }
            }
            fire() { $.cooldown = 0.22 }
            hit() { -> $Exploding }
            hyperspace() {
                if (@@:self.hyperspaces_remaining > 0) {
                    @@:self.hyperspaces_remaining = @@:self.hyperspaces_remaining - 1
                    -> $InHyperspace
                }
            }
            can_fire(): Boolean       { @@:($.cooldown <= 0.0) }
            can_be_hit(): Boolean     { @@:(true) }
            can_hyperspace(): Boolean { @@:(@@:self.hyperspaces_remaining > 0) }
            is_visible(): Boolean     { @@:(true) }
            is_alive(): Boolean       { @@:(true) }
            get_lives(): Int          { @@:(@@:self.lives_remaining) }
        }

        $InHyperspace {
            $.timer: Double = 0.0
            $.duration: Double = 0.4
            $>() { @@:self.host.warp_out() }
            <$() { @@:self.host.warp_in() }
            tick(dt: Double) {
                $.timer = $.timer + dt
                if ($.timer >= $.duration) {
                    -> "warp complete" $Alive
                }
            }
            can_fire(): Boolean       { @@:(false) }
            can_be_hit(): Boolean     { @@:(false) }
            can_hyperspace(): Boolean { @@:(false) }
            is_visible(): Boolean     { @@:(false) }
            is_alive(): Boolean       { @@:(true) }
            get_lives(): Int          { @@:(@@:self.lives_remaining) }
        }

        $Exploding {
            $.timer: Double = 0.0
            $.duration: Double = 1.0
            $>() { @@:self.host.spawn_explosion() }
            tick(dt: Double) {
                $.timer = $.timer + dt
                if ($.timer >= $.duration) {
                    @@:self.lives_remaining = @@:self.lives_remaining - 1
                    if (@@:self.lives_remaining <= 0) {
                        -> "no lives left" $Dead
                    } else {
                        -> "lives remain" $Respawning
                    }
                }
            }
            can_fire(): Boolean       { @@:(false) }
            can_be_hit(): Boolean     { @@:(false) }
            can_hyperspace(): Boolean { @@:(false) }
            is_visible(): Boolean     { @@:(true) }
            is_alive(): Boolean       { @@:(false) }
            get_lives(): Int          { @@:(@@:self.lives_remaining) }
        }

        $Respawning {
            $.timer: Double = 0.0
            $.duration: Double = 2.0
            $>() { @@:self.host.reset_ship() }
            tick(dt: Double) {
                $.timer = $.timer + dt
                if ($.timer >= $.duration) {
                    -> "invuln expired" $Alive
                }
            }
            can_fire(): Boolean       { @@:(true) }
            can_be_hit(): Boolean     { @@:(false) }
            can_hyperspace(): Boolean { @@:(false) }
            is_visible(): Boolean     { @@:(true) }
            is_alive(): Boolean       { @@:(true) }
            get_lives(): Int          { @@:(@@:self.lives_remaining) }
        }

        $Dead {
            respawn() {
                @@:self.lives_remaining = @@:self.starting_lives
                @@:self.hyperspaces_remaining = @@:self.starting_hyperspaces
                -> $Respawning
            }
            can_fire(): Boolean       { @@:(false) }
            can_be_hit(): Boolean     { @@:(false) }
            can_hyperspace(): Boolean { @@:(false) }
            is_visible(): Boolean     { @@:(false) }
            is_alive(): Boolean       { @@:(false) }
            get_lives(): Int          { @@:(0) }
        }

    domain:
        host: IShipHost = host
        lives_remaining: Int = 3
        starting_lives: Int = 3
        hyperspaces_remaining: Int = 3
        starting_hyperspaces: Int = 3
}

// ------------------------------------------------------------ AsteroidField
@@system AsteroidField {

    interface:
        spawn_wave(count: Int, court_size: Vec2)
        split(index: Int): Boolean
        remove(index: Int)
        clear()
        advance(dt: Double, court_size: Vec2)
        count(): Int
        alive_count(): Int
        is_alive(index: Int): Boolean
        position(index: Int): Vec2
        velocity(index: Int): Vec2
        size_of(index: Int): Int
        radius_of(index: Int): Double

    machine:

        $Active {
            spawn_wave(count: Int, court_size: Vec2) {
                @@:self.asteroids = mutableListOf()
                var i: Int = 0
                while (i < count) {
                    @@:self.spawn_large(court_size)
                    i = i + 1
                }
            }

            split(index: Int): Boolean {
                if (index < 0 || index >= @@:self.asteroids.size) {
                    @@:return(false)
                }
                if (!@@:self.asteroids[index].alive) {
                    @@:return(false)
                }
                @@:self.asteroids[index].alive = false
                val sz: Int = @@:self.asteroids[index].size
                val p: Vec2 = @@:self.asteroids[index].pos
                if (sz > 1) {
                    @@:self.spawn_child(p, sz - 1)
                    @@:self.spawn_child(p, sz - 1)
                }
                @@:(true)
            }

            remove(index: Int) {
                if (index < 0 || index >= @@:self.asteroids.size) {
                    return
                }
                @@:self.asteroids[index].alive = false
            }

            clear() { @@:self.asteroids = mutableListOf() }

            advance(dt: Double, court_size: Vec2) {
                var i: Int = 0
                while (i < @@:self.asteroids.size) {
                    if (@@:self.asteroids[i].alive) {
                        @@:self.asteroids[i].pos = @@:self.asteroids[i].pos + @@:self.asteroids[i].vel * dt
                        if (@@:self.asteroids[i].pos.x < 0.0) { @@:self.asteroids[i].pos.x = @@:self.asteroids[i].pos.x + court_size.x }
                        if (@@:self.asteroids[i].pos.x > court_size.x) { @@:self.asteroids[i].pos.x = @@:self.asteroids[i].pos.x - court_size.x }
                        if (@@:self.asteroids[i].pos.y < 0.0) { @@:self.asteroids[i].pos.y = @@:self.asteroids[i].pos.y + court_size.y }
                        if (@@:self.asteroids[i].pos.y > court_size.y) { @@:self.asteroids[i].pos.y = @@:self.asteroids[i].pos.y - court_size.y }
                    }
                    i = i + 1
                }
            }

            count(): Int { @@:(@@:self.asteroids.size) }

            alive_count(): Int {
                var c: Int = 0
                var i: Int = 0
                while (i < @@:self.asteroids.size) {
                    if (@@:self.asteroids[i].alive) { c = c + 1 }
                    i = i + 1
                }
                @@:(c)
            }

            is_alive(index: Int): Boolean {
                if (index < 0 || index >= @@:self.asteroids.size) {
                    @@:return(false)
                }
                @@:(@@:self.asteroids[index].alive)
            }

            position(index: Int): Vec2 {
                if (index < 0 || index >= @@:self.asteroids.size) {
                    @@:return(Vec2(0.0, 0.0))
                }
                @@:(@@:self.asteroids[index].pos)
            }

            velocity(index: Int): Vec2 {
                if (index < 0 || index >= @@:self.asteroids.size) {
                    @@:return(Vec2(0.0, 0.0))
                }
                @@:(@@:self.asteroids[index].vel)
            }

            size_of(index: Int): Int {
                if (index < 0 || index >= @@:self.asteroids.size) {
                    @@:return(0)
                }
                @@:(@@:self.asteroids[index].size)
            }

            radius_of(index: Int): Double {
                if (index < 0 || index >= @@:self.asteroids.size) {
                    @@:return(0.0)
                }
                val sz: Int = @@:self.asteroids[index].size
                if (sz == 3) { @@:return(32.0) }
                if (sz == 2) { @@:return(18.0) }
                @@:(10.0)
            }
        }

    actions:

        spawn_large(court_size: Vec2) {
            val edge: Int = (rf() * 4).toInt()
            var pos: Vec2 = Vec2(0.0, 0.0)
            if (edge == 0) {
                pos = Vec2(0.0, rf() * court_size.y)
            } else if (edge == 1) {
                pos = Vec2(court_size.x, rf() * court_size.y)
            } else if (edge == 2) {
                pos = Vec2(rf() * court_size.x, 0.0)
            } else {
                pos = Vec2(rf() * court_size.x, court_size.y)
            }
            val angle: Double = rf() * 2.0 * PI
            val speed: Double = 40.0 + rf() * 30.0
            val vel: Vec2 = fromAngle(angle, speed)
            @@:self.asteroids.add(Asteroid(pos, vel, 3, true))
        }

        spawn_child(pos: Vec2, size: Int) {
            val angle: Double = rf() * 2.0 * PI
            val speed: Double = 60.0 + rf() * 40.0 + (3 - size) * 20.0
            val vel: Vec2 = fromAngle(angle, speed)
            @@:self.asteroids.add(Asteroid(pos, vel, size, true))
        }

    domain:
        asteroids: MutableList<Asteroid> = mutableListOf()
}

// ------------------------------------------------------------ AsteroidsGame
@@[main]
@@system AsteroidsGame(ship_host: IShipHost, difficulty: Int) {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }
        get_bullets_in_flight(): Int { @@:(@@:self.bullets_in_flight) }
        get_max_bullets(): Int       { @@:(@@:self.max_bullets) }

    interface:
        start()
        restart()
        pause()
        resume()
        tick(dt: Double, court_size: Vec2)
        ship_hit_asteroid(index: Int)
        bullet_hit_asteroid(index: Int)
        ship_hyperspace()
        bullet_fired()
        bullet_expired()
        get_score(): Int
        get_lives(): Int
        get_wave(): Int
        get_difficulty(): Int
        is_paused(): Boolean

    machine:

        $Attract {
            $>() {
                @@:self.score = 0
                @@:self.wave = 1
                @@:self.bullets_in_flight = 0
            }
            start() {
                @@:self.ship.respawn()
                val n: Int = @@:self.asteroids_for_wave(1)
                @@:self.field.spawn_wave(n, @@:self.last_court_size)
                -> $Playing
            }
            get_score(): Int      { @@:(@@:self.score) }
            get_lives(): Int      { @@:(@@:self.ship.get_lives()) }
            get_wave(): Int       { @@:(@@:self.wave) }
            get_difficulty(): Int { @@:(@@:self.difficulty) }
            is_paused(): Boolean  { @@:(false) }
        }

        $InGame {
            pause() {
                push$ -> $Paused
            }
            bullet_fired() {
                @@:self.bullets_in_flight = @@:self.bullets_in_flight + 1
            }
            bullet_expired() {
                if (@@:self.bullets_in_flight > 0) {
                    @@:self.bullets_in_flight = @@:self.bullets_in_flight - 1
                }
            }
            get_score(): Int      { @@:(@@:self.score) }
            get_lives(): Int      { @@:(@@:self.ship.get_lives()) }
            get_wave(): Int       { @@:(@@:self.wave) }
            get_difficulty(): Int { @@:(@@:self.difficulty) }
            is_paused(): Boolean  { @@:(false) }
        }

        $Playing => $InGame {
            tick(dt: Double, court_size: Vec2) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.field.advance(dt, court_size)
            }
            ship_hit_asteroid(index: Int) {
                if (!@@:self.ship.can_be_hit()) {
                    return
                }
                @@:self.ship.hit()
                -> $ShipDying
            }
            bullet_hit_asteroid(index: Int) {
                if (@@:self.field.split(index)) {
                    val sz: Int = @@:self.size_points(index)
                    @@:self.score = @@:self.score + sz * @@:self.difficulty
                    if (@@:self.field.alive_count() <= 0) {
                        -> "all asteroids cleared" $WaveClear
                    }
                }
            }
            ship_hyperspace() {
                @@:self.ship.hyperspace()
            }
            => $^
        }

        $ShipDying => $InGame {
            tick(dt: Double, court_size: Vec2) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.field.advance(dt, court_size)
                if (@@:self.ship.get_current_state_name() == "Respawning") {
                    -> "ship respawning" $Playing
                } else if (@@:self.ship.get_current_state_name() == "Dead") {
                    -> "no lives left" $GameOver
                }
            }
            => $^
        }

        $WaveClear => $InGame {
            $>() { @@:self.wave_timer = 0.0 }
            tick(dt: Double, court_size: Vec2) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.wave_timer = @@:self.wave_timer + dt
                if (@@:self.wave_timer >= @@:self.wave_pause) {
                    @@:self.wave = @@:self.wave + 1
                    val n: Int = @@:self.asteroids_for_wave(@@:self.wave)
                    @@:self.field.spawn_wave(n, court_size)
                    -> "next wave" $Playing
                }
            }
            => $^
        }

        $Paused {
            resume() {
                -> pop$
            }
            get_score(): Int      { @@:(@@:self.score) }
            get_lives(): Int      { @@:(@@:self.ship.get_lives()) }
            get_wave(): Int       { @@:(@@:self.wave) }
            get_difficulty(): Int { @@:(@@:self.difficulty) }
            is_paused(): Boolean  { @@:(true) }
        }

        $GameOver {
            restart() {
                -> $Attract
            }
            get_score(): Int      { @@:(@@:self.score) }
            get_lives(): Int      { @@:(@@:self.ship.get_lives()) }
            get_wave(): Int       { @@:(@@:self.wave) }
            get_difficulty(): Int { @@:(@@:self.difficulty) }
            is_paused(): Boolean  { @@:(false) }
        }

    actions:

        asteroids_for_wave(wave: Int): Int {
            val base_count: Int = 2 + @@:self.difficulty
            return base_count + wave - 1
        }

        size_points(index: Int): Int {
            val sz: Int = @@:self.field.size_of(index)
            if (sz == 3) { return 20 }
            if (sz == 2) { return 50 }
            return 100
        }

    domain:
        difficulty: Int = difficulty
        score: Int = 0
        wave: Int = 1
        wave_timer: Double = 0.0
        wave_pause: Double = 2.0
        bullets_in_flight: Int = 0
        max_bullets: Int = 4
        last_court_size: Vec2 = Vec2(640.0, 480.0)
        ship: Ship = @@Ship(ship_host)
        field: AsteroidField = @@AsteroidField()
}
