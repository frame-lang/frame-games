@@[target("python_3")]


@@system Locomotion {

    interface:
        tick(dt: float)

        press_left()
        press_right()
        release_horizontal()
        press_sprint()
        release_sprint()
        press_jump()
        release_jump()

        ground_contact()
        left_ground()

        get_state(): string
        wants_velocity_x(): float
        wants_jump_impulse(): bool
        consume_jump_impulse()
        facing(): int
        is_grounded(): bool
        is_in_air(): bool

    machine:
        $Idle {
            press_left() {
                @@:self.input_x = -1
                -> $Walking
            }
            press_right() {
                @@:self.input_x = 1
                -> $Walking
            }
            press_jump() {
                @@:self.pending_jump = True
                -> $Jumping
            }
            left_ground() {
                -> $Falling
            }

            get_state(): string         { @@:("idle") }
            wants_velocity_x(): float    { @@:(0.0) }
            wants_jump_impulse(): bool   { @@:(@@:self.pending_jump) }
            consume_jump_impulse()       { @@:self.pending_jump = False }
            facing(): int                { @@:(@@:self.face) }
            is_grounded(): bool          { @@:(True) }
            is_in_air(): bool            { @@:(False) }
        }

        $Walking {
            press_left() {
                @@:self.input_x = -1
                @@:self.face = -1
            }
            press_right() {
                @@:self.input_x = 1
                @@:self.face = 1
            }
            release_horizontal() {
                @@:self.input_x = 0
                -> $Idle
            }
            press_sprint() {
                -> $Running
            }
            press_jump() {
                @@:self.pending_jump = True
                -> $Jumping
            }
            left_ground() {
                -> $Falling
            }

            get_state(): string         { @@:("walking") }
            wants_velocity_x(): float    { @@:(@@:self.input_x * @@:self.walk_speed) }
            wants_jump_impulse(): bool   { @@:(@@:self.pending_jump) }
            consume_jump_impulse()       { @@:self.pending_jump = False }
            facing(): int                { @@:(@@:self.face) }
            is_grounded(): bool          { @@:(True) }
            is_in_air(): bool            { @@:(False) }
        }

        $Running {
            press_left() {
                @@:self.input_x = -1
                @@:self.face = -1
            }
            press_right() {
                @@:self.input_x = 1
                @@:self.face = 1
            }
            release_horizontal() {
                @@:self.input_x = 0
                -> $Walking
            }
            release_sprint() {
                -> $Walking
            }
            press_jump() {
                @@:self.pending_jump = True
                -> $Jumping
            }
            left_ground() {
                -> $Falling
            }

            get_state(): string         { @@:("running") }
            wants_velocity_x(): float    { @@:(@@:self.input_x * @@:self.run_speed) }
            wants_jump_impulse(): bool   { @@:(@@:self.pending_jump) }
            consume_jump_impulse()       { @@:self.pending_jump = False }
            facing(): int                { @@:(@@:self.face) }
            is_grounded(): bool          { @@:(True) }
            is_in_air(): bool            { @@:(False) }
        }

        $Jumping {
            $.jump_held_time: float = 0.0
            $.jump_released: bool = False

            tick(dt: float) {
                if not $.jump_released:
                    $.jump_held_time = $.jump_held_time + dt
                if $.jump_held_time >= 0.35:
                    -> $Falling
            }

            press_left() {
                @@:self.input_x = -1
                @@:self.face = -1
            }
            press_right() {
                @@:self.input_x = 1
                @@:self.face = 1
            }
            release_horizontal() {
                @@:self.input_x = 0
            }
            release_jump() {
                $.jump_released = True
            }
            ground_contact() {
                -> $Landing
            }

            get_state(): string         { @@:("jumping") }
            wants_velocity_x(): float    { @@:(@@:self.input_x * @@:self.air_speed) }
            wants_jump_impulse(): bool   { @@:(@@:self.pending_jump) }
            consume_jump_impulse()       { @@:self.pending_jump = False }
            facing(): int                { @@:(@@:self.face) }
            is_grounded(): bool          { @@:(False) }
            is_in_air(): bool            { @@:(True) }
        }

        $Falling {
            press_left() {
                @@:self.input_x = -1
                @@:self.face = -1
            }
            press_right() {
                @@:self.input_x = 1
                @@:self.face = 1
            }
            release_horizontal() {
                @@:self.input_x = 0
            }
            ground_contact() {
                -> $Landing
            }

            get_state(): string         { @@:("falling") }
            wants_velocity_x(): float    { @@:(@@:self.input_x * @@:self.air_speed) }
            wants_jump_impulse(): bool   { @@:(False) }
            consume_jump_impulse()       { @@:self.pending_jump = False }
            facing(): int                { @@:(@@:self.face) }
            is_grounded(): bool          { @@:(False) }
            is_in_air(): bool            { @@:(True) }
        }

        $Landing {
            $.timer: float = 0.0
            $.duration: float = 0.08

            $>() {
                @@:self.pending_jump = False
            }

            tick(dt: float) {
                $.timer = $.timer + dt
                if $.timer >= $.duration:
                    if @@:self.input_x != 0:
                        -> $Walking
                    else:
                        -> $Idle
            }

            press_left() {
                @@:self.input_x = -1
                @@:self.face = -1
            }
            press_right() {
                @@:self.input_x = 1
                @@:self.face = 1
            }
            release_horizontal() {
                @@:self.input_x = 0
            }
            press_jump() {
                @@:self.pending_jump = True
                -> $Jumping
            }
            left_ground() {
                -> $Falling
            }

            get_state(): string         { @@:("landing") }
            wants_velocity_x(): float    { @@:(@@:self.input_x * @@:self.walk_speed * 0.6) }
            wants_jump_impulse(): bool   { @@:(@@:self.pending_jump) }
            consume_jump_impulse()       { @@:self.pending_jump = False }
            facing(): int                { @@:(@@:self.face) }
            is_grounded(): bool          { @@:(True) }
            is_in_air(): bool            { @@:(False) }
        }

    domain:
        input_x: int = 0
        face: int = 1
        pending_jump: bool = False
        walk_speed: float = 140.0
        run_speed: float = 260.0
        air_speed: float = 180.0
}

@@system PowerUp {

    interface:
        pickup_mushroom()
        pickup_flower()
        take_damage(): bool
        reset()
        get_form(): string
        hit_box_height(): int
        can_shoot(): bool

    machine:
        $Small {
            pickup_mushroom() {
                -> $Big
            }
            pickup_flower() {
                -> $Fiery
            }
            take_damage(): bool {
                @@:(False)
            }
            reset() {
            }

            get_form(): string      { @@:("small") }
            hit_box_height(): int   { @@:(24) }
            can_shoot(): bool       { @@:(False) }
        }

        $Big {
            pickup_mushroom() {
            }
            pickup_flower() {
                -> $Fiery
            }
            take_damage(): bool {
                @@:(True)
                -> $Small
            }
            reset() {
                -> $Small
            }

            get_form(): string      { @@:("big") }
            hit_box_height(): int   { @@:(48) }
            can_shoot(): bool       { @@:(False) }
        }

        $Fiery {
            pickup_mushroom() {
            }
            pickup_flower() {
            }
            take_damage(): bool {
                @@:(True)
                -> $Big
            }
            reset() {
                -> $Small
            }

            get_form(): string      { @@:("fiery") }
            hit_box_height(): int   { @@:(48) }
            can_shoot(): bool       { @@:(True) }
        }
}

@@[main]
@@system Platformer {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }

    interface:
        tick(dt: float)

        press_left()
        press_right()
        release_horizontal()
        press_sprint()
        release_sprint()
        press_jump()
        release_jump()

        ground_contact()
        left_ground()

        pickup_mushroom()
        pickup_flower()
        take_damage(): bool

        pause()
        resume()
        is_paused(): bool

        locomotion_state(): string
        form(): string
        wants_velocity_x(): float
        wants_jump_impulse(): bool
        consume_jump_impulse()
        facing(): int
        is_grounded(): bool
        is_in_air(): bool
        hit_box_height(): int
        can_shoot(): bool

    machine:
        $Playing {
            tick(dt: float) {
                @@:self.loco.tick(dt)
            }

            press_left()            { @@:self.loco.press_left() }
            press_right()           { @@:self.loco.press_right() }
            release_horizontal()    { @@:self.loco.release_horizontal() }
            press_sprint()          { @@:self.loco.press_sprint() }
            release_sprint()        { @@:self.loco.release_sprint() }
            press_jump()            { @@:self.loco.press_jump() }
            release_jump()          { @@:self.loco.release_jump() }
            ground_contact()        { @@:self.loco.ground_contact() }
            left_ground()           { @@:self.loco.left_ground() }

            pickup_mushroom()       { @@:self.power.pickup_mushroom() }
            pickup_flower()         { @@:self.power.pickup_flower() }

            take_damage(): bool {
                @@:(@@:self.power.take_damage())
            }

            pause() {
                push$ -> $Paused
            }

            locomotion_state(): string  { @@:(@@:self.loco.get_state()) }
            form(): string              { @@:(@@:self.power.get_form()) }
            wants_velocity_x(): float   { @@:(@@:self.loco.wants_velocity_x()) }
            wants_jump_impulse(): bool  { @@:(@@:self.loco.wants_jump_impulse()) }
            consume_jump_impulse()      { @@:self.loco.consume_jump_impulse() }
            facing(): int               { @@:(@@:self.loco.facing()) }
            is_grounded(): bool         { @@:(@@:self.loco.is_grounded()) }
            is_in_air(): bool           { @@:(@@:self.loco.is_in_air()) }
            hit_box_height(): int       { @@:(@@:self.power.hit_box_height()) }
            can_shoot(): bool           { @@:(@@:self.power.can_shoot()) }
            is_paused(): bool           { @@:(False) }
        }

        $Paused {
            resume() {
                -> pop$
            }

            locomotion_state(): string  { @@:(@@:self.loco.get_state()) }
            form(): string              { @@:(@@:self.power.get_form()) }
            wants_velocity_x(): float   { @@:(@@:self.loco.wants_velocity_x()) }
            wants_jump_impulse(): bool  { @@:(@@:self.loco.wants_jump_impulse()) }
            facing(): int               { @@:(@@:self.loco.facing()) }
            is_grounded(): bool         { @@:(@@:self.loco.is_grounded()) }
            is_in_air(): bool           { @@:(@@:self.loco.is_in_air()) }
            hit_box_height(): int       { @@:(@@:self.power.hit_box_height()) }
            can_shoot(): bool           { @@:(@@:self.power.can_shoot()) }
            is_paused(): bool           { @@:(True) }
        }

    domain:
        loco = @@Locomotion()
        power = @@PowerUp()
}
