@@[target("php")]

@@system Locomotion {

    interface:
        tick(dt)
        press_left()
        press_right()
        release_horizontal()
        press_sprint()
        release_sprint()
        press_jump()
        release_jump()
        ground_contact()
        left_ground()
        get_state()
        wants_velocity_x()
        wants_jump_impulse()
        consume_jump_impulse()
        facing()
        is_grounded()
        is_in_air()

    machine:
        $Idle {
            press_left() {
                $this->input_x = -1;
                -> $Walking
            }
            press_right() {
                $this->input_x = 1;
                -> $Walking
            }
            press_jump() {
                $this->pending_jump = true;
                -> $Jumping
            }
            left_ground() {
                -> $Falling
            }

            get_state()             { @@:("idle") }
            wants_velocity_x()       { @@:(0.0) }
            wants_jump_impulse()     { @@:($this->pending_jump) }
            consume_jump_impulse()   { $this->pending_jump = false; }
            facing()                 { @@:($this->face) }
            is_grounded()            { @@:(true) }
            is_in_air()              { @@:(false) }
        }

        $Walking {
            press_left() {
                $this->input_x = -1;
                $this->face = -1;
            }
            press_right() {
                $this->input_x = 1;
                $this->face = 1;
            }
            release_horizontal() {
                $this->input_x = 0;
                -> $Idle
            }
            press_sprint() {
                -> $Running
            }
            press_jump() {
                $this->pending_jump = true;
                -> $Jumping
            }
            left_ground() {
                -> $Falling
            }

            get_state()             { @@:("walking") }
            wants_velocity_x()       { @@:($this->input_x * $this->walk_speed) }
            wants_jump_impulse()     { @@:($this->pending_jump) }
            consume_jump_impulse()   { $this->pending_jump = false; }
            facing()                 { @@:($this->face) }
            is_grounded()            { @@:(true) }
            is_in_air()              { @@:(false) }
        }

        $Running {
            press_left() {
                $this->input_x = -1;
                $this->face = -1;
            }
            press_right() {
                $this->input_x = 1;
                $this->face = 1;
            }
            release_horizontal() {
                $this->input_x = 0;
                -> $Walking
            }
            release_sprint() {
                -> $Walking
            }
            press_jump() {
                $this->pending_jump = true;
                -> $Jumping
            }
            left_ground() {
                -> $Falling
            }

            get_state()             { @@:("running") }
            wants_velocity_x()       { @@:($this->input_x * $this->run_speed) }
            wants_jump_impulse()     { @@:($this->pending_jump) }
            consume_jump_impulse()   { $this->pending_jump = false; }
            facing()                 { @@:($this->face) }
            is_grounded()            { @@:(true) }
            is_in_air()              { @@:(false) }
        }

        $Jumping {
            $.jump_held_time = 0.0
            $.jump_released = false

            tick(dt) {
                if (!$.jump_released) {
                    $.jump_held_time = $.jump_held_time + $dt;
                }
                if ($.jump_held_time >= 0.35) {
                    -> $Falling
                }
            }

            press_left() {
                $this->input_x = -1;
                $this->face = -1;
            }
            press_right() {
                $this->input_x = 1;
                $this->face = 1;
            }
            release_horizontal() {
                $this->input_x = 0;
            }
            release_jump() {
                $.jump_released = true;
            }
            ground_contact() {
                -> $Landing
            }

            get_state()             { @@:("jumping") }
            wants_velocity_x()       { @@:($this->input_x * $this->air_speed) }
            wants_jump_impulse()     { @@:($this->pending_jump) }
            consume_jump_impulse()   { $this->pending_jump = false; }
            facing()                 { @@:($this->face) }
            is_grounded()            { @@:(false) }
            is_in_air()              { @@:(true) }
        }

        $Falling {
            press_left() {
                $this->input_x = -1;
                $this->face = -1;
            }
            press_right() {
                $this->input_x = 1;
                $this->face = 1;
            }
            release_horizontal() {
                $this->input_x = 0;
            }
            ground_contact() {
                -> $Landing
            }

            get_state()             { @@:("falling") }
            wants_velocity_x()       { @@:($this->input_x * $this->air_speed) }
            wants_jump_impulse()     { @@:(false) }
            consume_jump_impulse()   { $this->pending_jump = false; }
            facing()                 { @@:($this->face) }
            is_grounded()            { @@:(false) }
            is_in_air()              { @@:(true) }
        }

        $Landing {
            $.timer = 0.0
            $.duration = 0.08

            $>() {
                $this->pending_jump = false;
            }

            tick(dt) {
                $.timer = $.timer + $dt;
                if ($.timer >= $.duration) {
                    if ($this->input_x != 0) {
                        -> $Walking
                    } else {
                        -> $Idle
                    }
                }
            }

            press_left() {
                $this->input_x = -1;
                $this->face = -1;
            }
            press_right() {
                $this->input_x = 1;
                $this->face = 1;
            }
            release_horizontal() {
                $this->input_x = 0;
            }
            press_jump() {
                $this->pending_jump = true;
                -> $Jumping
            }
            left_ground() {
                -> $Falling
            }

            get_state()             { @@:("landing") }
            wants_velocity_x()       { @@:($this->input_x * $this->walk_speed * 0.6) }
            wants_jump_impulse()     { @@:($this->pending_jump) }
            consume_jump_impulse()   { $this->pending_jump = false; }
            facing()                 { @@:($this->face) }
            is_grounded()            { @@:(true) }
            is_in_air()              { @@:(false) }
        }

    domain:
        input_x = 0
        face = 1
        pending_jump = false
        walk_speed = 140.0
        run_speed = 260.0
        air_speed = 180.0
}

@@system PowerUp {

    interface:
        pickup_mushroom()
        pickup_flower()
        take_damage()
        reset()
        get_form()
        hit_box_height()
        can_shoot()

    machine:
        $Small {
            pickup_mushroom() {
                -> $Big
            }
            pickup_flower() {
                -> $Fiery
            }
            take_damage() {
                @@:(false)
            }
            reset() {
            }

            get_form()          { @@:("small") }
            hit_box_height()    { @@:(24) }
            can_shoot()         { @@:(false) }
        }

        $Big {
            pickup_mushroom() {
            }
            pickup_flower() {
                -> $Fiery
            }
            take_damage() {
                @@:(true)
                -> $Small
            }
            reset() {
                -> $Small
            }

            get_form()          { @@:("big") }
            hit_box_height()    { @@:(48) }
            can_shoot()         { @@:(false) }
        }

        $Fiery {
            pickup_mushroom() {
            }
            pickup_flower() {
            }
            take_damage() {
                @@:(true)
                -> $Big
            }
            reset() {
                -> $Small
            }

            get_form()          { @@:("fiery") }
            hit_box_height()    { @@:(48) }
            can_shoot()         { @@:(true) }
        }
}

@@[main]
@@system Platformer {

    operations:
        get_current_state_name() { @@:(@@:system.state.name) }

    interface:
        tick(dt)
        press_left()
        press_right()
        release_horizontal()
        press_sprint()
        release_sprint()
        press_jump()
        release_jump()
        ground_contact()
        left_ground()
        pickup_mushroom()
        pickup_flower()
        take_damage()
        pause()
        resume()
        is_paused()
        locomotion_state()
        form()
        wants_velocity_x()
        wants_jump_impulse()
        consume_jump_impulse()
        facing()
        is_grounded()
        is_in_air()
        hit_box_height()
        can_shoot()

    machine:
        $Playing {
            tick(dt) {
                $this->loco->tick($dt);
            }

            press_left()            { $this->loco->press_left(); }
            press_right()           { $this->loco->press_right(); }
            release_horizontal()    { $this->loco->release_horizontal(); }
            press_sprint()          { $this->loco->press_sprint(); }
            release_sprint()        { $this->loco->release_sprint(); }
            press_jump()            { $this->loco->press_jump(); }
            release_jump()          { $this->loco->release_jump(); }
            ground_contact()        { $this->loco->ground_contact(); }
            left_ground()           { $this->loco->left_ground(); }

            pickup_mushroom()       { $this->power->pickup_mushroom(); }
            pickup_flower()         { $this->power->pickup_flower(); }

            take_damage() {
                @@:($this->power->take_damage())
            }

            pause() {
                push$ -> $Paused
            }

            locomotion_state()      { @@:($this->loco->get_state()) }
            form()                  { @@:($this->power->get_form()) }
            wants_velocity_x()      { @@:($this->loco->wants_velocity_x()) }
            wants_jump_impulse()    { @@:($this->loco->wants_jump_impulse()) }
            consume_jump_impulse()  { $this->loco->consume_jump_impulse(); }
            facing()                { @@:($this->loco->facing()) }
            is_grounded()           { @@:($this->loco->is_grounded()) }
            is_in_air()             { @@:($this->loco->is_in_air()) }
            hit_box_height()        { @@:($this->power->hit_box_height()) }
            can_shoot()             { @@:($this->power->can_shoot()) }
            is_paused()             { @@:(false) }
        }

        $Paused {
            resume() {
                -> pop$
            }

            locomotion_state()      { @@:($this->loco->get_state()) }
            form()                  { @@:($this->power->get_form()) }
            wants_velocity_x()      { @@:($this->loco->wants_velocity_x()) }
            wants_jump_impulse()    { @@:($this->loco->wants_jump_impulse()) }
            facing()                { @@:($this->loco->facing()) }
            is_grounded()           { @@:($this->loco->is_grounded()) }
            is_in_air()             { @@:($this->loco->is_in_air()) }
            hit_box_height()        { @@:($this->power->hit_box_height()) }
            can_shoot()             { @@:($this->power->can_shoot()) }
            is_paused()             { @@:(true) }
        }

    domain:
        loco = @@Locomotion()
        power = @@PowerUp()
}
