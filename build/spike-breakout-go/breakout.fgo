@@[target("go")]
package main

// Breakout — C# port of the canonical controller
// (games/breakout/src/breakout.fjs). Ball / BrickField / Breakout. The star is
// the enter-argument transition: Ball.launch does `-> (vx, vy) $InFlight`,
// threading the velocity into $InFlight's `$>(vx, vy)` handler. Bodies native
// C#; doubles throughout so dt=1/64 math matches the JS baseline bit-for-bit.

@@system Ball {

    interface:
        launch(vx: float64, vy: float64)
        lose()
        attach()
        bounce_x()
        bounce_y()
        set_velocity(vx: float64, vy: float64)
        tick(dt: float64)
        get_state(): string
        get_vx(): float64
        get_vy(): float64
        is_flying(): bool
        respawn_progress(): float64

    machine:
        $AttachedToPaddle {
            launch(vx: float64, vy: float64) { -> (vx, vy) $InFlight }

            get_state(): string         { @@:("attached") }
            get_vx(): float64            { @@:(0.0) }
            get_vy(): float64            { @@:(0.0) }
            is_flying(): bool           { @@:(false) }
            respawn_progress(): float64  { @@:(1.0) }
        }

        $InFlight {
            $.vx: float64 = 0.0
            $.vy: float64 = 0.0

            $>(vx: float64, vy: float64) {
                $.vx = vx
                $.vy = vy
            }

            bounce_x() { $.vx = -$.vx; }
            bounce_y() { $.vy = -$.vy; }

            set_velocity(vx: float64, vy: float64) {
                $.vx = vx
                $.vy = vy
            }

            lose() { -> $Lost }

            get_state(): string         { @@:("in_flight") }
            get_vx(): float64            { @@:($.vx) }
            get_vy(): float64            { @@:($.vy) }
            is_flying(): bool           { @@:(true) }
            respawn_progress(): float64  { @@:(1.0) }
        }

        $Lost {
            $.elapsed: float64 = 0.0

            tick(dt: float64) {
                $.elapsed = $.elapsed + dt
                if $.elapsed >= 2.0 {
                    -> $AttachedToPaddle
                }
            }

            attach() { -> $AttachedToPaddle }

            get_state(): string         { @@:("lost") }
            get_vx(): float64            { @@:(0.0) }
            get_vy(): float64            { @@:(0.0) }
            is_flying(): bool           { @@:(false) }
            respawn_progress(): float64  { @@:($.elapsed / 2.0) }
        }
}

@@system BrickField {

    interface:
        reset(count: int)
        break_brick(index: int): bool
        is_broken(index: int): bool
        remaining(): int
        is_cleared(): bool

    machine:
        $Active {
            reset(count: int) {
                @@:self.bricks = []bool{}
                _i := 0
                for _i < count {
                    @@:self.bricks = append(@@:self.bricks, true)
                    _i = _i + 1
                }
                @@:self.remaining_count = count
            }

            break_brick(index: int): bool {
                if index < 0 || index >= len(@@:self.bricks) {
                    @@:return(false)
                }
                if !@@:self.bricks[index] {
                    @@:return(false)
                }
                @@:self.bricks[index] = false
                @@:self.remaining_count = @@:self.remaining_count - 1
                @@:(true)
            }

            is_broken(index: int): bool {
                if index < 0 || index >= len(@@:self.bricks) {
                    @@:return(true)
                }
                @@:(!@@:self.bricks[index])
            }

            remaining(): int  { @@:(@@:self.remaining_count) }
            is_cleared(): bool { @@:(@@:self.remaining_count <= 0) }
        }

    domain:
        bricks: []bool = []bool{}
        remaining_count: int = 0
}

@@[main]
@@system Breakout {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }

    interface:
        start()
        launch_ball(vx: float64, vy: float64)
        brick_hit(index: int)
        paddle_hit(vx: float64, vy: float64)
        wall_bounce_x()
        wall_bounce_y()
        ball_fell_off()
        tick(dt: float64)
        pause()
        resume()
        restart()
        get_state(): string
        get_score(): int
        get_lives(): int
        get_level(): int
        bricks_remaining(): int
        is_brick_broken(index: int): bool
        ball_state(): string
        ball_vx(): float64
        ball_vy(): float64
        ball_respawn_progress(): float64

    machine:
        $Attract {
            $>() {
                @@:self.score = 0
                @@:self.lives = 3
                @@:self.level = 1
                @@:self.bricks.reset(@@:self.brick_count)
            }

            start() {
                @@:self.bricks.reset(@@:self.brick_count)
                @@:self.ball.attach()
                -> $Playing
            }

            get_state(): string          { @@:("attract") }
            get_score(): int             { @@:(@@:self.score) }
            get_lives(): int             { @@:(@@:self.lives) }
            get_level(): int             { @@:(@@:self.level) }
            bricks_remaining(): int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: int): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): string         { @@:(@@:self.ball.get_state()) }
            ball_vx(): float64            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): float64            { @@:(@@:self.ball.get_vy()) }
        }

        $Playing {
            launch_ball(vx: float64, vy: float64) {
                @@:self.ball.launch(vx, vy)
            }

            brick_hit(index: int) {
                if @@:self.bricks.break_brick(index) {
                    @@:self.score = @@:self.score + @@:self.points_per_brick
                    @@:self.ball.bounce_y()
                    if @@:self.bricks.is_cleared() {
                        -> $LevelClear
                    }
                }
            }

            paddle_hit(vx: float64, vy: float64) {
                @@:self.ball.set_velocity(vx, vy)
            }

            wall_bounce_x() { @@:self.ball.bounce_x(); }
            wall_bounce_y() { @@:self.ball.bounce_y(); }

            ball_fell_off() {
                @@:self.lives = @@:self.lives - 1
                if @@:self.lives <= 0 {
                    -> $GameOver
                } else {
                    @@:self.ball.lose()
                }
            }

            tick(dt: float64) { @@:self.ball.tick(dt); }

            pause() { push$ -> $Paused }

            get_state(): string          { @@:("playing") }
            get_score(): int             { @@:(@@:self.score) }
            get_lives(): int             { @@:(@@:self.lives) }
            get_level(): int             { @@:(@@:self.level) }
            bricks_remaining(): int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: int): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): string         { @@:(@@:self.ball.get_state()) }
            ball_vx(): float64            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): float64            { @@:(@@:self.ball.get_vy()) }
            ball_respawn_progress(): float64 { @@:(@@:self.ball.respawn_progress()) }
        }

        $LevelClear {
            $>() {
                @@:self.level = @@:self.level + 1
            }

            start() {
                @@:self.bricks.reset(@@:self.brick_count)
                @@:self.ball.attach()
                -> $Playing
            }

            get_state(): string          { @@:("level_clear") }
            get_score(): int             { @@:(@@:self.score) }
            get_lives(): int             { @@:(@@:self.lives) }
            get_level(): int             { @@:(@@:self.level) }
            bricks_remaining(): int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: int): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): string         { @@:(@@:self.ball.get_state()) }
            ball_vx(): float64            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): float64            { @@:(@@:self.ball.get_vy()) }
        }

        $Paused {
            resume() { -> pop$ }

            get_state(): string          { @@:("paused") }
            get_score(): int             { @@:(@@:self.score) }
            get_lives(): int             { @@:(@@:self.lives) }
            get_level(): int             { @@:(@@:self.level) }
            bricks_remaining(): int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: int): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): string         { @@:(@@:self.ball.get_state()) }
            ball_vx(): float64            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): float64            { @@:(@@:self.ball.get_vy()) }
        }

        $GameOver {
            restart() { -> $Attract }

            get_state(): string          { @@:("game_over") }
            get_score(): int             { @@:(@@:self.score) }
            get_lives(): int             { @@:(@@:self.lives) }
            get_level(): int             { @@:(@@:self.level) }
            bricks_remaining(): int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: int): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): string         { @@:(@@:self.ball.get_state()) }
            ball_vx(): float64            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): float64            { @@:(@@:self.ball.get_vy()) }
        }

    domain:
        score: int = 0
        lives: int = 3
        level: int = 1
        brick_count: int = 40
        points_per_brick: int = 10
        ball: Ball = @@Ball()
        bricks: BrickField = @@BrickField()
}
