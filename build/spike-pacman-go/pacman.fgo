@@[target("go")]

// Pac-Man ghost AI — Go port of the canonical controller
// (games/pacman/src/pacman.fjs). Same three systems (Ghost / GhostPen /
// GhostGame), states, the $OutOfPen HSM parent, the push$/pop$ frightened
// subroutine, the parameterized Ghost(name, home_corner, target_kind), the
// $Frightened enter/exit broadcast, and the driver-populated ghosts list.
// Bodies are native Go: `for` (no while), `:=` locals, append() on the
// []*Ghost slice; the four instances are plain pointers into one generated
// machine type.

package main

type Vector2 struct{ X, Y float64 }

// ------------------------------------------------------------ Ghost
@@system Ghost(name: string, home_corner: Vector2, target_kind: int) {

    interface:
        tick(dt: float64)
        power_pellet_eaten()
        frighten_expired()
        eaten()
        arrived_at_pen()
        released()
        phase_changed_to_chase()
        phase_changed_to_scatter()
        reset_to_pen()
        get_state(): string
        get_name(): string
        get_home_corner(): Vector2
        get_target_kind(): int
        is_frightened(): bool
        is_dangerous(): bool
        is_edible(): bool

    machine:
        $InPen {
            released() { -> $Scatter }
            reset_to_pen() { }

            get_state(): string         { @@:("in_pen") }
            get_name(): string          { @@:(@@:self.gname) }
            get_home_corner(): Vector2  { @@:(@@:self.home) }
            get_target_kind(): int      { @@:(@@:self.tkind) }
            is_frightened(): bool       { @@:(false) }
            is_dangerous(): bool        { @@:(false) }
            is_edible(): bool           { @@:(false) }
        }

        $OutOfPen {
            power_pellet_eaten() {
                push$
                -> $Frightened
            }

            reset_to_pen() { -> $InPen }

            get_state(): string         { @@:("out_of_pen") }
            get_name(): string          { @@:(@@:self.gname) }
            get_home_corner(): Vector2  { @@:(@@:self.home) }
            get_target_kind(): int      { @@:(@@:self.tkind) }
            is_frightened(): bool       { @@:(false) }
            is_dangerous(): bool        { @@:(true) }
            is_edible(): bool           { @@:(false) }
        }

        $Chase => $OutOfPen {
            phase_changed_to_scatter() { -> $Scatter }
            get_state(): string { @@:("chase") }
            => $^
        }

        $Scatter => $OutOfPen {
            phase_changed_to_chase() { -> $Chase }
            get_state(): string { @@:("scatter") }
            => $^
        }

        $Frightened {
            frighten_expired() { -> pop$ }
            eaten() { -> $Eaten }
            reset_to_pen() { -> $InPen }

            get_state(): string         { @@:("frightened") }
            get_name(): string          { @@:(@@:self.gname) }
            get_home_corner(): Vector2  { @@:(@@:self.home) }
            get_target_kind(): int      { @@:(@@:self.tkind) }
            is_frightened(): bool       { @@:(true) }
            is_dangerous(): bool        { @@:(false) }
            is_edible(): bool           { @@:(true) }
        }

        $Eaten {
            arrived_at_pen() { -> $InPen }

            get_state(): string         { @@:("eaten") }
            get_name(): string          { @@:(@@:self.gname) }
            get_home_corner(): Vector2  { @@:(@@:self.home) }
            get_target_kind(): int      { @@:(@@:self.tkind) }
            is_frightened(): bool       { @@:(false) }
            is_dangerous(): bool        { @@:(false) }
            is_edible(): bool           { @@:(false) }
        }

    domain:
        gname: string = name
        home: Vector2 = home_corner
        tkind: int = target_kind
}

// ------------------------------------------------------------ GhostPen
@@system GhostPen {

    interface:
        tick(dt: float64)
        reset()
        next_release_index(): int
        should_release(): bool
        consume_release()

    machine:
        $Active {
            tick(dt: float64) {
                @@:self.release_timer = @@:self.release_timer + dt
            }

            reset() {
                @@:self.release_timer = 0.0
                @@:self.next_index = 0
            }

            next_release_index(): int { @@:(@@:self.next_index) }

            should_release(): bool {
                @@:(@@:self.release_timer >= @@:self.release_interval && @@:self.next_index < @@:self.max_ghosts)
            }

            consume_release() {
                @@:self.next_index = @@:self.next_index + 1
                @@:self.release_timer = 0.0
            }
        }

    domain:
        release_timer: float64 = 0.0
        release_interval: float64 = 2.0
        next_index: int = 0
        max_ghosts: int = 4
}

// ------------------------------------------------------------ GhostGame
@@[main]
@@system GhostGame {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }

    interface:
        tick(dt: float64)
        start()
        add_ghost(g: *Ghost)
        power_pellet_picked_up()
        ghost_caught(index: int)
        ghost_arrived_at_pen(index: int)
        get_phase(): string
        is_frightened(): bool
        ghost_count(): int
        ghost_state(index: int): string
        ghost_is_dangerous(index: int): bool
        ghost_is_edible(index: int): bool
        ghost_home_corner(index: int): Vector2
        ghost_target_kind(index: int): int
        get_score(): int
        frighten_seconds_left(): float64

    machine:
        $Idle {
            add_ghost(g: *Ghost) {
                @@:self.ghosts = append(@@:self.ghosts, g)
            }

            start() {
                @@:self.phase_timer = 0.0
                @@:self.phase_index = 0
                @@:self.score = 0
                @@:self.pen.reset()
                -> $Scatter
            }

            get_phase(): string                    { @@:("idle") }
            is_frightened(): bool                  { @@:(false) }
            ghost_count(): int                     { @@:(len(@@:self.ghosts)) }
            ghost_state(index: int): string        { @@:(@@:self.q_state(index)) }
            ghost_is_dangerous(index: int): bool   { @@:(@@:self.q_dangerous(index)) }
            ghost_is_edible(index: int): bool      { @@:(@@:self.q_edible(index)) }
            ghost_home_corner(index: int): Vector2 { @@:(@@:self.q_home(index)) }
            ghost_target_kind(index: int): int     { @@:(@@:self.q_tkind(index)) }
            get_score(): int                       { @@:(@@:self.score) }
            frighten_seconds_left(): float64       { @@:(0.0) }
        }

        $Scatter {
            $>() {
                @@:self.phase_timer = 0.0
                @@:self.broadcast_scatter()
                @@:self.try_release()
            }

            tick(dt: float64) {
                @@:self.phase_timer = @@:self.phase_timer + dt
                @@:self.tick_all(dt)
                @@:self.try_release()
                if @@:self.phase_timer >= @@:self.scatter_duration() {
                    -> $Chase
                }
            }

            power_pellet_picked_up() {
                push$
                -> $Frightened
            }

            ghost_caught(index: int) { }

            ghost_arrived_at_pen(index: int) {
                @@:self.deliver_arrived(index)
            }

            add_ghost(g: *Ghost) {
                @@:self.ghosts = append(@@:self.ghosts, g)
            }

            get_phase(): string                    { @@:("scatter") }
            is_frightened(): bool                  { @@:(false) }
            ghost_count(): int                     { @@:(len(@@:self.ghosts)) }
            ghost_state(index: int): string        { @@:(@@:self.q_state(index)) }
            ghost_is_dangerous(index: int): bool   { @@:(@@:self.q_dangerous(index)) }
            ghost_is_edible(index: int): bool      { @@:(@@:self.q_edible(index)) }
            ghost_home_corner(index: int): Vector2 { @@:(@@:self.q_home(index)) }
            ghost_target_kind(index: int): int     { @@:(@@:self.q_tkind(index)) }
            get_score(): int                       { @@:(@@:self.score) }
            frighten_seconds_left(): float64       { @@:(0.0) }
        }

        $Chase {
            $>() {
                @@:self.phase_timer = 0.0
                @@:self.broadcast_chase()
                @@:self.try_release()
            }

            tick(dt: float64) {
                @@:self.phase_timer = @@:self.phase_timer + dt
                @@:self.tick_all(dt)
                @@:self.try_release()
                if @@:self.phase_timer >= @@:self.chase_duration() {
                    @@:self.phase_index = @@:self.phase_index + 1
                    -> $Scatter
                }
            }

            power_pellet_picked_up() {
                push$
                -> $Frightened
            }

            ghost_caught(index: int) { }

            ghost_arrived_at_pen(index: int) {
                @@:self.deliver_arrived(index)
            }

            add_ghost(g: *Ghost) {
                @@:self.ghosts = append(@@:self.ghosts, g)
            }

            get_phase(): string                    { @@:("chase") }
            is_frightened(): bool                  { @@:(false) }
            ghost_count(): int                     { @@:(len(@@:self.ghosts)) }
            ghost_state(index: int): string        { @@:(@@:self.q_state(index)) }
            ghost_is_dangerous(index: int): bool   { @@:(@@:self.q_dangerous(index)) }
            ghost_is_edible(index: int): bool      { @@:(@@:self.q_edible(index)) }
            ghost_home_corner(index: int): Vector2 { @@:(@@:self.q_home(index)) }
            ghost_target_kind(index: int): int     { @@:(@@:self.q_tkind(index)) }
            get_score(): int                       { @@:(@@:self.score) }
            frighten_seconds_left(): float64       { @@:(0.0) }
        }

        $Frightened {
            $>() {
                @@:self.frighten_timer = 0.0
                @@:self.broadcast_frighten()
            }

            <$() {
                @@:self.broadcast_frighten_expired()
            }

            tick(dt: float64) {
                @@:self.frighten_timer = @@:self.frighten_timer + dt
                @@:self.tick_all(dt)
                @@:self.try_release()
                if @@:self.frighten_timer >= @@:self.frighten_duration {
                    -> pop$
                }
            }

            power_pellet_picked_up() {
                -> $Frightened
            }

            ghost_caught(index: int) {
                if index < 0 || index >= len(@@:self.ghosts) {
                    return
                }
                if @@:self.ghosts[index].is_edible() {
                    @@:self.ghosts[index].eaten()
                    @@:self.score = @@:self.score + @@:self.points_per_ghost
                }
            }

            ghost_arrived_at_pen(index: int) {
                @@:self.deliver_arrived(index)
            }

            add_ghost(g: *Ghost) {
                @@:self.ghosts = append(@@:self.ghosts, g)
            }

            get_phase(): string                    { @@:("frightened") }
            is_frightened(): bool                  { @@:(true) }
            ghost_count(): int                     { @@:(len(@@:self.ghosts)) }
            ghost_state(index: int): string        { @@:(@@:self.q_state(index)) }
            ghost_is_dangerous(index: int): bool   { @@:(@@:self.q_dangerous(index)) }
            ghost_is_edible(index: int): bool      { @@:(@@:self.q_edible(index)) }
            ghost_home_corner(index: int): Vector2 { @@:(@@:self.q_home(index)) }
            ghost_target_kind(index: int): int     { @@:(@@:self.q_tkind(index)) }
            get_score(): int                       { @@:(@@:self.score) }
            frighten_seconds_left(): float64 {
                rem := @@:self.frighten_duration - @@:self.frighten_timer
                if rem < 0.0 {
                    @@:return(0.0)
                }
                @@:(rem)
            }
        }

    actions:
        scatter_duration(): float64 {
            if @@:self.phase_index == 0 {
                return 7.0
            }
            if @@:self.phase_index == 1 {
                return 5.0
            }
            return 5.0
        }

        chase_duration(): float64 {
            if @@:self.phase_index >= 3 {
                return 9999.0
            }
            return 20.0
        }

        broadcast_scatter() {
            i := 0
            for i < len(@@:self.ghosts) {
                @@:self.ghosts[i].phase_changed_to_scatter()
                i = i + 1
            }
        }

        broadcast_chase() {
            i := 0
            for i < len(@@:self.ghosts) {
                @@:self.ghosts[i].phase_changed_to_chase()
                i = i + 1
            }
        }

        broadcast_frighten() {
            i := 0
            for i < len(@@:self.ghosts) {
                @@:self.ghosts[i].power_pellet_eaten()
                i = i + 1
            }
        }

        broadcast_frighten_expired() {
            i := 0
            for i < len(@@:self.ghosts) {
                @@:self.ghosts[i].frighten_expired()
                i = i + 1
            }
        }

        tick_all(dt: float64) {
            i := 0
            for i < len(@@:self.ghosts) {
                @@:self.ghosts[i].tick(dt)
                i = i + 1
            }
            @@:self.pen.tick(dt)
        }

        try_release() {
            if @@:self.pen.should_release() {
                idx := @@:self.pen.next_release_index()
                if idx >= 0 && idx < len(@@:self.ghosts) {
                    @@:self.ghosts[idx].released()
                    @@:self.pen.consume_release()
                }
            }
        }

        deliver_arrived(index: int) {
            if index < 0 || index >= len(@@:self.ghosts) {
                return
            }
            @@:self.ghosts[index].arrived_at_pen()
        }

        q_state(index: int): string {
            if index < 0 || index >= len(@@:self.ghosts) {
                return ""
            }
            return @@:self.ghosts[index].get_state()
        }
        q_dangerous(index: int): bool {
            if index < 0 || index >= len(@@:self.ghosts) {
                return false
            }
            return @@:self.ghosts[index].is_dangerous()
        }
        q_edible(index: int): bool {
            if index < 0 || index >= len(@@:self.ghosts) {
                return false
            }
            return @@:self.ghosts[index].is_edible()
        }
        q_home(index: int): Vector2 {
            if index < 0 || index >= len(@@:self.ghosts) {
                return Vector2{0.0, 0.0}
            }
            return @@:self.ghosts[index].get_home_corner()
        }
        q_tkind(index: int): int {
            if index < 0 || index >= len(@@:self.ghosts) {
                return 0
            }
            return @@:self.ghosts[index].get_target_kind()
        }

    domain:
        score: int = 0
        phase_timer: float64 = 0.0
        phase_index: int = 0
        frighten_timer: float64 = 0.0
        frighten_duration: float64 = 6.0
        points_per_ghost: int = 200
        ghosts: []*Ghost = nil
        pen: GhostPen = @@GhostPen()
}
