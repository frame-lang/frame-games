@@[target("cpp")]

// Stealth — guard agent AI, C++ port of the canonical controller
// (games/stealth/src/stealth.fjs). Same two systems (Guard / Stealth),
// states, the $Aware HSM parent that shares the spot_player response, the
// push$/pop$ investigate-then-resume subroutine, the three owned Guard
// instances, and the game flow $Attract -> $Playing -> $Caught/$Escaped
// plus the push$/pop$ pause. Bodies are native C++ (braces, `;`,
// std::vector<T>); doubles throughout so timer math matches the JS baseline
// bit-for-bit. The @@[persist]/@@[save]/@@[load] contract is kept verbatim.
// The blob type is std::string; persist uses nlohmann::json. Vector2 gets
// its JSON glue (NLOHMANN_DEFINE_TYPE_INTRUSIVE) in this native preamble —
// providing the native type's serialization is native-body territory, same
// as providing the struct and the distance helper.

#include <vector>
#include <string>
#include <cmath>
#include <nlohmann/json.hpp>

struct Vector2 {
    double x = 0.0;
    double y = 0.0;
    Vector2() {}
    Vector2(double x_, double y_) : x(x_), y(y_) {}
    NLOHMANN_DEFINE_TYPE_INTRUSIVE(Vector2, x, y)
};

struct Geo {
    static double Dist(Vector2 a, Vector2 b) {
        double dx = a.x - b.x;
        double dy = a.y - b.y;
        return std::sqrt(dx * dx + dy * dy);
    }
};

@@[persist(std::string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Guard {

    interface:
        init(patrol: std::vector<Vector2>, speed: double)
        tick(dt: double, current_pos: Vector2)
        spot_player(at: Vector2)
        hear_sound(at: Vector2)
        touched_player()
        get_state(): std::string
        get_target(): Vector2
        get_last_known(): Vector2
        is_aware(): bool
        is_alerted(): bool
        should_move(): bool

    machine:
        $Idle {
            init(patrol: std::vector<Vector2>, speed: double) {
                @@:self.patrol = patrol;
                @@:self.speed = speed;
                @@:self.next_wp = 0;
                if (patrol.size() > 0) {
                    @@:self.target = patrol[0];
                }
                -> $Patrolling
            }

            tick(dt: double, current_pos: Vector2) {
            }

            get_state(): std::string    { @@:("idle") }
            get_target(): Vector2       { @@:(@@:self.target) }
            get_last_known(): Vector2   { @@:(@@:self.last_known) }
            is_aware(): bool            { @@:(false) }
            is_alerted(): bool          { @@:(false) }
            should_move(): bool         { @@:(false) }
        }

        $Aware {
            spot_player(at: Vector2) {
                @@:self.last_known = at;
                -> $Alerted
            }

            touched_player() {
                -> $Engaged
            }

            get_state(): std::string    { @@:("aware") }
            get_target(): Vector2       { @@:(@@:self.target) }
            get_last_known(): Vector2   { @@:(@@:self.last_known) }
            is_aware(): bool            { @@:(true) }
            is_alerted(): bool          { @@:(false) }
            should_move(): bool         { @@:(true) }
        }

        $Patrolling => $Aware {
            tick(dt: double, current_pos: Vector2) {
                if (@@:self.patrol.size() == 0) {
                    return;
                }
                double d = Geo::Dist(current_pos, @@:self.target);
                if (d < @@:self.ARRIVAL_RADIUS) {
                    @@:self.next_wp = @@:self.next_wp + 1;
                    if (@@:self.next_wp >= (int)@@:self.patrol.size()) {
                        @@:self.next_wp = 0;
                    }
                    @@:self.target = @@:self.patrol[@@:self.next_wp];
                }
            }

            hear_sound(at: Vector2) {
                push$
                @@:self.last_known = at;
                -> $Investigating
            }

            get_state(): std::string    { @@:("patrolling") }
            is_aware(): bool            { @@:(false) }
            should_move(): bool         { @@:(true) }
            => $^
        }

        $Investigating => $Aware {
            $.timer: double = 0.0

            tick(dt: double, current_pos: Vector2) {
                $.timer = $.timer + dt;
                if ($.timer >= @@:self.INVESTIGATE_DURATION) {
                    -> pop$
                }
            }

            get_state(): std::string { @@:("investigating") }
            should_move(): bool { @@:(false) }
            => $^
        }

        $Alerted => $Aware {
            $.chase_timer: double = 0.0

            spot_player(at: Vector2) {
                @@:self.last_known = at;
                $.chase_timer = 0.0;
            }

            tick(dt: double, current_pos: Vector2) {
                @@:self.target = @@:self.last_known;
                $.chase_timer = $.chase_timer + dt;
                double d = Geo::Dist(current_pos, @@:self.last_known);
                if (d < @@:self.ARRIVAL_RADIUS) {
                    -> $Searching
                } else if ($.chase_timer >= @@:self.CHASE_TIMEOUT) {
                    -> $Searching
                }
            }

            get_state(): std::string { @@:("alerted") }
            is_alerted(): bool  { @@:(true) }
            should_move(): bool { @@:(true) }
            => $^
        }

        $Searching => $Aware {
            $.timer: double = 0.0

            tick(dt: double, current_pos: Vector2) {
                $.timer = $.timer + dt;
                if ($.timer >= @@:self.SEARCH_DURATION) {
                    @@:self._resume_patrol(current_pos);
                    -> $Patrolling
                }
            }

            get_state(): std::string { @@:("searching") }
            should_move(): bool { @@:(false) }
            => $^
        }

        $Engaged {
            tick(dt: double, current_pos: Vector2) {
            }

            get_state(): std::string    { @@:("engaged") }
            get_target(): Vector2       { @@:(@@:self.target) }
            get_last_known(): Vector2   { @@:(@@:self.last_known) }
            is_aware(): bool            { @@:(true) }
            is_alerted(): bool          { @@:(true) }
            should_move(): bool         { @@:(false) }
        }

    actions:
        _resume_patrol(current_pos: Vector2) {
            if (@@:self.patrol.size() == 0) {
                return;
            }
            int best_i = 0;
            double best_d = Geo::Dist(current_pos, @@:self.patrol[0]);
            int i = 1;
            while (i < (int)@@:self.patrol.size()) {
                double d = Geo::Dist(current_pos, @@:self.patrol[i]);
                if (d < best_d) {
                    best_d = d;
                    best_i = i;
                }
                i = i + 1;
            }
            @@:self.next_wp = best_i;
            @@:self.target = @@:self.patrol[best_i];
        }

    domain:
        patrol: std::vector<Vector2> = {}
        next_wp: int = 0
        target: Vector2 = Vector2(0.0, 0.0)
        last_known: Vector2 = Vector2(0.0, 0.0)
        speed: double = 60.0
        ARRIVAL_RADIUS: double = 12.0
        INVESTIGATE_DURATION: double = 1.5
        SEARCH_DURATION: double = 3.0
        CHASE_TIMEOUT: double = 4.0
}

@@[main]
@@[persist(std::string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Stealth {

    operations:
        get_current_state_name(): std::string { @@:(@@:system.state.name) }

    interface:
        start(p1: std::vector<Vector2>, p2: std::vector<Vector2>, p3: std::vector<Vector2>)
        restart()
        pause()
        resume()
        tick(dt: double, pos1: Vector2, pos2: Vector2, pos3: Vector2)
        guard_caught_player(i: int)
        player_at_exit()
        get_state(): std::string
        get_elapsed(): double
        get_caught_by(): int

    machine:
        $Attract {
            $>() {
                @@:self.elapsed = 0.0;
                @@:self.caught_by = -1;
            }

            start(p1: std::vector<Vector2>, p2: std::vector<Vector2>, p3: std::vector<Vector2>) {
                @@:self.guard1.init(p1, @@:self.PATROL_SPEED);
                @@:self.guard2.init(p2, @@:self.PATROL_SPEED);
                @@:self.guard3.init(p3, @@:self.PATROL_SPEED);
                -> $Playing
            }

            get_state(): std::string    { @@:("attract") }
            get_elapsed(): double   { @@:(0.0) }
            get_caught_by(): int    { @@:(-1) }
        }

        $Playing {
            tick(dt: double, pos1: Vector2, pos2: Vector2, pos3: Vector2) {
                @@:self.elapsed = @@:self.elapsed + dt;
                @@:self.guard1.tick(dt, pos1);
                @@:self.guard2.tick(dt, pos2);
                @@:self.guard3.tick(dt, pos3);
            }

            guard_caught_player(i: int) {
                @@:self.caught_by = i;
                if (i == 0) {
                    @@:self.guard1.touched_player();
                } else if (i == 1) {
                    @@:self.guard2.touched_player();
                } else if (i == 2) {
                    @@:self.guard3.touched_player();
                }
                -> $Caught
            }

            player_at_exit() {
                -> $Escaped
            }

            pause() {
                push$ -> $Paused
            }

            get_state(): std::string    { @@:("playing") }
            get_elapsed(): double   { @@:(@@:self.elapsed) }
            get_caught_by(): int    { @@:(@@:self.caught_by) }
        }

        $Paused {
            resume() {
                -> pop$
            }

            get_state(): std::string    { @@:("paused") }
            get_elapsed(): double   { @@:(@@:self.elapsed) }
            get_caught_by(): int    { @@:(@@:self.caught_by) }
        }

        $Caught {
            restart() {
                -> $Attract
            }

            get_state(): std::string    { @@:("caught") }
            get_elapsed(): double   { @@:(@@:self.elapsed) }
            get_caught_by(): int    { @@:(@@:self.caught_by) }
        }

        $Escaped {
            restart() {
                -> $Attract
            }

            get_state(): std::string    { @@:("escaped") }
            get_elapsed(): double   { @@:(@@:self.elapsed) }
            get_caught_by(): int    { @@:(-1) }
        }

    domain:
        guard1: Guard = @@Guard()
        guard2: Guard = @@Guard()
        guard3: Guard = @@Guard()
        elapsed: double = 0.0
        caught_by: int = -1
        PATROL_SPEED: double = 95.0
}
