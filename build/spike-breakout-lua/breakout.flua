@@[target("lua")]

-- Breakout — Lua port (native bodies, @@:self, 1-based bricks table).
-- Interface index is 0-based (oracle) -> bricks[index + 1]. Enter-arg
-- transition: Ball.launch does -> (vx, vy) $InFlight into $>(vx, vy).

@@system Ball {

    interface:
        launch(vx: number, vy: number)
        lose()
        attach()
        bounce_x()
        bounce_y()
        set_velocity(vx: number, vy: number)
        tick(dt: number)
        get_state(): string
        get_vx(): number
        get_vy(): number
        is_flying(): boolean
        respawn_progress(): number

    machine:
        $AttachedToPaddle {
            launch(vx: number, vy: number) { -> (vx, vy) $InFlight }

            get_state(): string        { @@:("attached") }
            get_vx(): number           { @@:(0.0) }
            get_vy(): number           { @@:(0.0) }
            is_flying(): boolean       { @@:(false) }
            respawn_progress(): number { @@:(1.0) }
        }

        $InFlight {
            $.vx: number = 0.0
            $.vy: number = 0.0

            $>(vx: number, vy: number) {
                $.vx = vx
                $.vy = vy
            }

            bounce_x() { $.vx = -$.vx }
            bounce_y() { $.vy = -$.vy }

            set_velocity(vx: number, vy: number) {
                $.vx = vx
                $.vy = vy
            }

            lose() { -> $Lost }

            get_state(): string        { @@:("in_flight") }
            get_vx(): number           { @@:($.vx) }
            get_vy(): number           { @@:($.vy) }
            is_flying(): boolean       { @@:(true) }
            respawn_progress(): number { @@:(1.0) }
        }

        $Lost {
            $.elapsed: number = 0.0

            tick(dt: number) {
                $.elapsed = $.elapsed + dt
                if $.elapsed >= 2.0 {
                    -> $AttachedToPaddle
                }
            }

            attach() { -> $AttachedToPaddle }

            get_state(): string        { @@:("lost") }
            get_vx(): number           { @@:(0.0) }
            get_vy(): number           { @@:(0.0) }
            is_flying(): boolean       { @@:(false) }
            respawn_progress(): number { @@:($.elapsed / 2.0) }
        }
}

@@system BrickField {

    interface:
        reset(count: number)
        break_brick(index: number): boolean
        is_broken(index: number): boolean
        remaining(): number
        is_cleared(): boolean

    machine:
        $Active {
            reset(count: number) {
                @@:self.bricks = {}
                local _i = 0
                while _i < count {
                    table.insert(@@:self.bricks, true)
                    _i = _i + 1
                }
                @@:self.remaining_count = count
            }

            break_brick(index: number): boolean {
                if index < 0 or index >= #@@:self.bricks {
                    @@:return(false)
                }
                if not @@:self.bricks[index + 1] {
                    @@:return(false)
                }
                @@:self.bricks[index + 1] = false
                @@:self.remaining_count = @@:self.remaining_count - 1
                @@:(true)
            }

            is_broken(index: number): boolean {
                if index < 0 or index >= #@@:self.bricks {
                    @@:return(true)
                }
                @@:(not @@:self.bricks[index + 1])
            }

            remaining(): number  { @@:(@@:self.remaining_count) }
            is_cleared(): boolean { @@:(@@:self.remaining_count <= 0) }
        }

    domain:
        bricks: [] = {}
        remaining_count: number = 0
}

@@[main]
@@system Breakout {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }

    interface:
        start()
        launch_ball(vx: number, vy: number)
        brick_hit(index: number)
        paddle_hit(vx: number, vy: number)
        wall_bounce_x()
        wall_bounce_y()
        ball_fell_off()
        tick(dt: number)
        pause()
        resume()
        restart()
        get_state(): string
        get_score(): number
        get_lives(): number
        get_level(): number
        bricks_remaining(): number
        is_brick_broken(index: number): boolean
        ball_state(): string
        ball_vx(): number
        ball_vy(): number
        ball_respawn_progress(): number

    machine:
        $Attract {
            $>() {
                @@:self.score = 0
                @@:self.lives = 3
                @@:self.level = 1
                @@:self.bricks.reset(@@:self.brick_count)
            }

            start() {
                @@:self.bricks.reset(@@:self.brick_count)
                @@:self.ball.attach()
                -> $Playing
            }

            get_state(): string          { @@:("attract") }
            get_score(): number          { @@:(@@:self.score) }
            get_lives(): number          { @@:(@@:self.lives) }
            get_level(): number          { @@:(@@:self.level) }
            bricks_remaining(): number   { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: number): boolean { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): string         { @@:(@@:self.ball.get_state()) }
            ball_vx(): number            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): number            { @@:(@@:self.ball.get_vy()) }
        }

        $Playing {
            launch_ball(vx: number, vy: number) {
                @@:self.ball.launch(vx, vy)
            }

            brick_hit(index: number) {
                if @@:self.bricks.break_brick(index) {
                    @@:self.score = @@:self.score + @@:self.points_per_brick
                    @@:self.ball.bounce_y()
                    if @@:self.bricks.is_cleared() {
                        -> $LevelClear
                    }
                }
            }

            paddle_hit(vx: number, vy: number) {
                @@:self.ball.set_velocity(vx, vy)
            }

            wall_bounce_x() { @@:self.ball.bounce_x() }
            wall_bounce_y() { @@:self.ball.bounce_y() }

            ball_fell_off() {
                @@:self.lives = @@:self.lives - 1
                if @@:self.lives <= 0 {
                    -> $GameOver
                } else {
                    @@:self.ball.lose()
                }
            }

            tick(dt: number) { @@:self.ball.tick(dt) }

            pause() { push$ -> $Paused }

            get_state(): string          { @@:("playing") }
            get_score(): number          { @@:(@@:self.score) }
            get_lives(): number          { @@:(@@:self.lives) }
            get_level(): number          { @@:(@@:self.level) }
            bricks_remaining(): number   { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: number): boolean { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): string         { @@:(@@:self.ball.get_state()) }
            ball_vx(): number            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): number            { @@:(@@:self.ball.get_vy()) }
            ball_respawn_progress(): number { @@:(@@:self.ball.respawn_progress()) }
        }

        $LevelClear {
            $>() {
                @@:self.level = @@:self.level + 1
            }

            start() {
                @@:self.bricks.reset(@@:self.brick_count)
                @@:self.ball.attach()
                -> $Playing
            }

            get_state(): string          { @@:("level_clear") }
            get_score(): number          { @@:(@@:self.score) }
            get_lives(): number          { @@:(@@:self.lives) }
            get_level(): number          { @@:(@@:self.level) }
            bricks_remaining(): number   { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: number): boolean { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): string         { @@:(@@:self.ball.get_state()) }
            ball_vx(): number            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): number            { @@:(@@:self.ball.get_vy()) }
        }

        $Paused {
            resume() { -> pop$ }

            get_state(): string          { @@:("paused") }
            get_score(): number          { @@:(@@:self.score) }
            get_lives(): number          { @@:(@@:self.lives) }
            get_level(): number          { @@:(@@:self.level) }
            bricks_remaining(): number   { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: number): boolean { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): string         { @@:(@@:self.ball.get_state()) }
            ball_vx(): number            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): number            { @@:(@@:self.ball.get_vy()) }
        }

        $GameOver {
            restart() { -> $Attract }

            get_state(): string          { @@:("game_over") }
            get_score(): number          { @@:(@@:self.score) }
            get_lives(): number          { @@:(@@:self.lives) }
            get_level(): number          { @@:(@@:self.level) }
            bricks_remaining(): number   { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: number): boolean { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): string         { @@:(@@:self.ball.get_state()) }
            ball_vx(): number            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): number            { @@:(@@:self.ball.get_vy()) }
        }

    domain:
        score: number = 0
        lives: number = 3
        level: number = 1
        brick_count: number = 40
        points_per_brick: number = 10
        ball: Ball = @@Ball()
        bricks: BrickField = @@BrickField()
}
