@@[target("rust")]

// Pac-Man ghost AI — Rust port of the canonical controller
// (games/pacman/src/pacman.fjs). Same three systems (Ghost / GhostPen /
// GhostGame), states, the $OutOfPen HSM parent, the push$/pop$ frightened
// subroutine, the parameterized Ghost(name, home_corner, target_kind), the
// $Frightened enter/exit broadcast, and the driver-populated ghosts list.
// Bodies are native Rust (no-paren `if cond {`, `let mut`, `as usize`);
// doubles throughout so timer math matches the JS baseline bit-for-bit.
// Per framec E616, live system instances cross the interface as
// Rc<RefCell<Ghost>> (the event is Rc-shared; a live machine must not be
// cloned); bodies dispatch via .borrow_mut()/.borrow().

use std::rc::Rc;
use std::cell::RefCell;

#[derive(Clone, Copy, Debug, Default)]
pub struct Vector2 { pub x: f64, pub y: f64 }

// ------------------------------------------------------------ Ghost
@@system Ghost(name: String, home_corner: Vector2, target_kind: i32) {

    interface:
        tick(dt: f64)
        power_pellet_eaten()
        frighten_expired()
        eaten()
        arrived_at_pen()
        released()
        phase_changed_to_chase()
        phase_changed_to_scatter()
        reset_to_pen()
        get_state(): String
        get_name(): String
        get_home_corner(): Vector2
        get_target_kind(): i32
        is_frightened(): bool
        is_dangerous(): bool
        is_edible(): bool

    machine:
        $InPen {
            released() { -> $Scatter }
            reset_to_pen() { }

            get_state(): String         { @@:("in_pen".to_string()) }
            get_name(): String          { @@:(@@:self.gname) }
            get_home_corner(): Vector2  { @@:(@@:self.home) }
            get_target_kind(): i32      { @@:(@@:self.tkind) }
            is_frightened(): bool       { @@:(false) }
            is_dangerous(): bool        { @@:(false) }
            is_edible(): bool           { @@:(false) }
        }

        $OutOfPen {
            power_pellet_eaten() {
                push$
                -> $Frightened
            }

            reset_to_pen() { -> $InPen }

            get_state(): String         { @@:("out_of_pen".to_string()) }
            get_name(): String          { @@:(@@:self.gname) }
            get_home_corner(): Vector2  { @@:(@@:self.home) }
            get_target_kind(): i32      { @@:(@@:self.tkind) }
            is_frightened(): bool       { @@:(false) }
            is_dangerous(): bool        { @@:(true) }
            is_edible(): bool           { @@:(false) }
        }

        $Chase => $OutOfPen {
            phase_changed_to_scatter() { -> $Scatter }
            get_state(): String { @@:("chase".to_string()) }
            => $^
        }

        $Scatter => $OutOfPen {
            phase_changed_to_chase() { -> $Chase }
            get_state(): String { @@:("scatter".to_string()) }
            => $^
        }

        $Frightened {
            frighten_expired() { -> pop$ }
            eaten() { -> $Eaten }
            reset_to_pen() { -> $InPen }

            get_state(): String         { @@:("frightened".to_string()) }
            get_name(): String          { @@:(@@:self.gname) }
            get_home_corner(): Vector2  { @@:(@@:self.home) }
            get_target_kind(): i32      { @@:(@@:self.tkind) }
            is_frightened(): bool       { @@:(true) }
            is_dangerous(): bool        { @@:(false) }
            is_edible(): bool           { @@:(true) }
        }

        $Eaten {
            arrived_at_pen() { -> $InPen }

            get_state(): String         { @@:("eaten".to_string()) }
            get_name(): String          { @@:(@@:self.gname) }
            get_home_corner(): Vector2  { @@:(@@:self.home) }
            get_target_kind(): i32      { @@:(@@:self.tkind) }
            is_frightened(): bool       { @@:(false) }
            is_dangerous(): bool        { @@:(false) }
            is_edible(): bool           { @@:(false) }
        }

    domain:
        gname: String = name
        home: Vector2 = home_corner
        tkind: i32 = target_kind
}

// ------------------------------------------------------------ GhostPen
@@system GhostPen {

    interface:
        tick(dt: f64)
        reset()
        next_release_index(): i32
        should_release(): bool
        consume_release()

    machine:
        $Active {
            tick(dt: f64) {
                @@:self.release_timer = @@:self.release_timer + dt;
            }

            reset() {
                @@:self.release_timer = 0.0;
                @@:self.next_index = 0;
            }

            next_release_index(): i32 { @@:(@@:self.next_index) }

            should_release(): bool {
                @@:(@@:self.release_timer >= @@:self.release_interval && @@:self.next_index < @@:self.max_ghosts)
            }

            consume_release() {
                @@:self.next_index = @@:self.next_index + 1;
                @@:self.release_timer = 0.0;
            }
        }

    domain:
        release_timer: f64 = 0.0
        release_interval: f64 = 2.0
        next_index: i32 = 0
        max_ghosts: i32 = 4
}

// ------------------------------------------------------------ GhostGame
@@[main]
@@system GhostGame {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }

    interface:
        tick(dt: f64)
        start()
        add_ghost(g: Rc<RefCell<Ghost>>)
        power_pellet_picked_up()
        ghost_caught(index: i32)
        ghost_arrived_at_pen(index: i32)
        get_phase(): String
        is_frightened(): bool
        ghost_count(): i32
        ghost_state(index: i32): String
        ghost_is_dangerous(index: i32): bool
        ghost_is_edible(index: i32): bool
        ghost_home_corner(index: i32): Vector2
        ghost_target_kind(index: i32): i32
        get_score(): i32
        frighten_seconds_left(): f64

    machine:
        $Idle {
            add_ghost(g: Rc<RefCell<Ghost>>) {
                @@:self.ghosts.push(g);
            }

            start() {
                @@:self.phase_timer = 0.0;
                @@:self.phase_index = 0;
                @@:self.score = 0;
                @@:self.pen.reset();
                -> $Scatter
            }

            get_phase(): String                     { @@:("idle".to_string()) }
            is_frightened(): bool                   { @@:(false) }
            ghost_count(): i32                      { @@:(@@:self.ghosts.len() as i32) }
            ghost_state(index: i32): String         { @@:(@@:self._q_state(index)) }
            ghost_is_dangerous(index: i32): bool    { @@:(@@:self._q_dangerous(index)) }
            ghost_is_edible(index: i32): bool       { @@:(@@:self._q_edible(index)) }
            ghost_home_corner(index: i32): Vector2  { @@:(@@:self._q_home(index)) }
            ghost_target_kind(index: i32): i32      { @@:(@@:self._q_tkind(index)) }
            get_score(): i32                        { @@:(@@:self.score) }
            frighten_seconds_left(): f64         { @@:(0.0) }
        }

        $Scatter {
            $>() {
                @@:self.phase_timer = 0.0;
                @@:self._broadcast_scatter();
                @@:self._try_release();
            }

            tick(dt: f64) {
                @@:self.phase_timer = @@:self.phase_timer + dt;
                @@:self._tick_all(dt);
                @@:self._try_release();
                if @@:self.phase_timer >= @@:self._scatter_duration() {
                    -> $Chase
                }
            }

            power_pellet_picked_up() {
                push$
                -> $Frightened
            }

            ghost_caught(index: i32) { }

            ghost_arrived_at_pen(index: i32) {
                @@:self._deliver_arrived(index);
            }

            add_ghost(g: Rc<RefCell<Ghost>>) {
                @@:self.ghosts.push(g);
            }

            get_phase(): String                     { @@:("scatter".to_string()) }
            is_frightened(): bool                   { @@:(false) }
            ghost_count(): i32                      { @@:(@@:self.ghosts.len() as i32) }
            ghost_state(index: i32): String         { @@:(@@:self._q_state(index)) }
            ghost_is_dangerous(index: i32): bool    { @@:(@@:self._q_dangerous(index)) }
            ghost_is_edible(index: i32): bool       { @@:(@@:self._q_edible(index)) }
            ghost_home_corner(index: i32): Vector2  { @@:(@@:self._q_home(index)) }
            ghost_target_kind(index: i32): i32      { @@:(@@:self._q_tkind(index)) }
            get_score(): i32                        { @@:(@@:self.score) }
            frighten_seconds_left(): f64         { @@:(0.0) }
        }

        $Chase {
            $>() {
                @@:self.phase_timer = 0.0;
                @@:self._broadcast_chase();
                @@:self._try_release();
            }

            tick(dt: f64) {
                @@:self.phase_timer = @@:self.phase_timer + dt;
                @@:self._tick_all(dt);
                @@:self._try_release();
                if @@:self.phase_timer >= @@:self._chase_duration() {
                    @@:self.phase_index = @@:self.phase_index + 1;
                    -> $Scatter
                }
            }

            power_pellet_picked_up() {
                push$
                -> $Frightened
            }

            ghost_caught(index: i32) { }

            ghost_arrived_at_pen(index: i32) {
                @@:self._deliver_arrived(index);
            }

            add_ghost(g: Rc<RefCell<Ghost>>) {
                @@:self.ghosts.push(g);
            }

            get_phase(): String                     { @@:("chase".to_string()) }
            is_frightened(): bool                   { @@:(false) }
            ghost_count(): i32                      { @@:(@@:self.ghosts.len() as i32) }
            ghost_state(index: i32): String         { @@:(@@:self._q_state(index)) }
            ghost_is_dangerous(index: i32): bool    { @@:(@@:self._q_dangerous(index)) }
            ghost_is_edible(index: i32): bool       { @@:(@@:self._q_edible(index)) }
            ghost_home_corner(index: i32): Vector2  { @@:(@@:self._q_home(index)) }
            ghost_target_kind(index: i32): i32      { @@:(@@:self._q_tkind(index)) }
            get_score(): i32                        { @@:(@@:self.score) }
            frighten_seconds_left(): f64         { @@:(0.0) }
        }

        $Frightened {
            $>() {
                @@:self.frighten_timer = 0.0;
                @@:self._broadcast_frighten();
            }

            <$() {
                @@:self._broadcast_frighten_expired();
            }

            tick(dt: f64) {
                @@:self.frighten_timer = @@:self.frighten_timer + dt;
                @@:self._tick_all(dt);
                @@:self._try_release();
                if @@:self.frighten_timer >= @@:self.frighten_duration {
                    -> pop$
                }
            }

            power_pellet_picked_up() {
                -> $Frightened
            }

            ghost_caught(index: i32) {
                if index < 0 || index >= @@:self.ghosts.len() as i32 {
                    return;
                }
                if @@:self.ghosts[index as usize].borrow_mut().is_edible() {
                    @@:self.ghosts[index as usize].borrow_mut().eaten();
                    @@:self.score = @@:self.score + @@:self.points_per_ghost;
                }
            }

            ghost_arrived_at_pen(index: i32) {
                @@:self._deliver_arrived(index);
            }

            add_ghost(g: Rc<RefCell<Ghost>>) {
                @@:self.ghosts.push(g);
            }

            get_phase(): String                     { @@:("frightened".to_string()) }
            is_frightened(): bool                   { @@:(true) }
            ghost_count(): i32                      { @@:(@@:self.ghosts.len() as i32) }
            ghost_state(index: i32): String         { @@:(@@:self._q_state(index)) }
            ghost_is_dangerous(index: i32): bool    { @@:(@@:self._q_dangerous(index)) }
            ghost_is_edible(index: i32): bool       { @@:(@@:self._q_edible(index)) }
            ghost_home_corner(index: i32): Vector2  { @@:(@@:self._q_home(index)) }
            ghost_target_kind(index: i32): i32      { @@:(@@:self._q_tkind(index)) }
            get_score(): i32                        { @@:(@@:self.score) }
            frighten_seconds_left(): f64 {
                let rem: f64 = @@:self.frighten_duration - @@:self.frighten_timer;
                if rem < 0.0 {
                    @@:return(0.0)
                }
                @@:(rem)
            }
        }

    actions:
        _scatter_duration(): f64 {
            if @@:self.phase_index == 0 { return 7.0; }
            if @@:self.phase_index == 1 { return 5.0; }
            return 5.0;
        }

        _chase_duration(): f64 {
            if @@:self.phase_index >= 3 { return 9999.0; }
            return 20.0;
        }

        _broadcast_scatter() {
            let mut i: i32 = 0;
            while i < @@:self.ghosts.len() as i32 {
                @@:self.ghosts[i as usize].borrow_mut().phase_changed_to_scatter();
                i = i + 1;
            }
        }

        _broadcast_chase() {
            let mut i: i32 = 0;
            while i < @@:self.ghosts.len() as i32 {
                @@:self.ghosts[i as usize].borrow_mut().phase_changed_to_chase();
                i = i + 1;
            }
        }

        _broadcast_frighten() {
            let mut i: i32 = 0;
            while i < @@:self.ghosts.len() as i32 {
                @@:self.ghosts[i as usize].borrow_mut().power_pellet_eaten();
                i = i + 1;
            }
        }

        _broadcast_frighten_expired() {
            let mut i: i32 = 0;
            while i < @@:self.ghosts.len() as i32 {
                @@:self.ghosts[i as usize].borrow_mut().frighten_expired();
                i = i + 1;
            }
        }

        _tick_all(dt: f64) {
            let mut i: i32 = 0;
            while i < @@:self.ghosts.len() as i32 {
                @@:self.ghosts[i as usize].borrow_mut().tick(dt);
                i = i + 1;
            }
            @@:self.pen.tick(dt);
        }

        _try_release() {
            if @@:self.pen.should_release() {
                let idx: i32 = @@:self.pen.next_release_index();
                if idx >= 0 && idx < @@:self.ghosts.len() as i32 {
                    @@:self.ghosts[idx as usize].borrow_mut().released();
                    @@:self.pen.consume_release();
                }
            }
        }

        _deliver_arrived(index: i32) {
            if index < 0 || index >= @@:self.ghosts.len() as i32 {
                return;
            }
            @@:self.ghosts[index as usize].borrow_mut().arrived_at_pen();
        }

        _q_state(index: i32): String {
            if index < 0 || index >= @@:self.ghosts.len() as i32 {
                return "".to_string();
            }
            return @@:self.ghosts[index as usize].borrow_mut().get_state();
        }
        _q_dangerous(index: i32): bool {
            if index < 0 || index >= @@:self.ghosts.len() as i32 {
                return false;
            }
            return @@:self.ghosts[index as usize].borrow_mut().is_dangerous();
        }
        _q_edible(index: i32): bool {
            if index < 0 || index >= @@:self.ghosts.len() as i32 {
                return false;
            }
            return @@:self.ghosts[index as usize].borrow_mut().is_edible();
        }
        _q_home(index: i32): Vector2 {
            if index < 0 || index >= @@:self.ghosts.len() as i32 {
                return Vector2 { x: 0.0, y: 0.0 };
            }
            return @@:self.ghosts[index as usize].borrow_mut().get_home_corner();
        }
        _q_tkind(index: i32): i32 {
            if index < 0 || index >= @@:self.ghosts.len() as i32 {
                return 0;
            }
            return @@:self.ghosts[index as usize].borrow_mut().get_target_kind();
        }

    domain:
        score: i32 = 0
        phase_timer: f64 = 0.0
        phase_index: i32 = 0
        frighten_timer: f64 = 0.0
        frighten_duration: f64 = 6.0
        points_per_ghost: i32 = 200
        ghosts: Vec<Rc<RefCell<Ghost>>> = Vec::new()
        pen: GhostPen = @@GhostPen()
}
