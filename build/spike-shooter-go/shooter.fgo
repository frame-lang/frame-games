@@[target("go")]

// Side-scrolling shooter — Go port of the canonical capstone controller
// (games/shooter/src/shooter.fjs, which mirrors the Godot ch07 reference).
// Same four systems (Player / Enemy / Boss / Shooter), states, transitions,
// the parameterized Enemy(kind, hp, fire_rate, points), the three-phase Boss
// HSM (phase parents own hit()/thresholds; idle/fire leaves), the owned
// player/boss + driver-populated enemies list, and the push$/pop$ pause.
// Bodies are native Go (for/:=/append, slice-splice removal); float64
// timers so the oracle's dt=1/64 arithmetic matches the JS baseline
// bit-for-bit.

package main

// ------------------------------------------------------------ Player
@@system Player {

    interface:
        tick(dt: float64)
        hit()
        respawn()
        can_fire(): bool
        can_be_hit(): bool
        is_visible(): bool
        get_state(): string
        get_lives(): int

    machine:
        $Alive {
            hit() { -> $Exploding }

            can_fire(): bool    { @@:(true) }
            can_be_hit(): bool  { @@:(true) }
            is_visible(): bool  { @@:(true) }
            get_state(): string { @@:("alive") }
            get_lives(): int    { @@:(@@:self.lives) }
        }

        $Exploding {
            $.timer: float64 = 0.0
            $.duration: float64 = 1.0

            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    @@:self.lives = @@:self.lives - 1
                    if @@:self.lives <= 0 {
                        -> $Dead
                    } else {
                        -> $Invulnerable
                    }
                }
            }

            can_fire(): bool    { @@:(false) }
            can_be_hit(): bool  { @@:(false) }
            is_visible(): bool  { @@:(true) }
            get_state(): string { @@:("exploding") }
            get_lives(): int    { @@:(@@:self.lives) }
        }

        $Invulnerable {
            $.timer: float64 = 0.0
            $.duration: float64 = 2.0

            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> $Alive
                }
            }

            can_fire(): bool    { @@:(true) }
            can_be_hit(): bool  { @@:(false) }
            is_visible(): bool  { @@:(true) }
            get_state(): string { @@:("invulnerable") }
            get_lives(): int    { @@:(@@:self.lives) }
        }

        $Dead {
            respawn() {
                @@:self.lives = @@:self.starting_lives
                -> $Alive
            }

            can_fire(): bool    { @@:(false) }
            can_be_hit(): bool  { @@:(false) }
            is_visible(): bool  { @@:(false) }
            get_state(): string { @@:("dead") }
            get_lives(): int    { @@:(0) }
        }

    domain:
        lives: int = 3
        starting_lives: int = 3
}

// ------------------------------------------------------------ Enemy
@@system Enemy(kind: int, hp: int, fire_rate: float64, points: int) {

    interface:
        tick(dt: float64)
        hit(damage: int)
        get_state(): string
        get_kind(): int
        get_hp(): int
        get_points(): int
        wants_to_fire(): bool
        consume_fire()
        is_alive(): bool
        is_cleanup(): bool

    machine:
        $Spawning {
            $.timer: float64 = 0.0
            $.duration: float64 = 0.5

            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> $Active
                }
            }

            hit(damage: int) {
            }

            get_state(): string { @@:("spawning") }
            get_kind(): int     { @@:(@@:self.ekind) }
            get_hp(): int       { @@:(@@:self.hp_remaining) }
            get_points(): int   { @@:(@@:self.pts) }
            wants_to_fire(): bool { @@:(false) }
            consume_fire()      { }
            is_alive(): bool    { @@:(true) }
            is_cleanup(): bool  { @@:(false) }
        }

        $Active {
            $.fire_timer: float64 = 0.0

            tick(dt: float64) {
                if @@:self.rate > 0.0 {
                    $.fire_timer = $.fire_timer + dt
                }
            }

            hit(damage: int) {
                @@:self.hp_remaining = @@:self.hp_remaining - damage
                if @@:self.hp_remaining <= 0 {
                    -> $Dying
                }
            }

            get_state(): string { @@:("active") }
            get_kind(): int     { @@:(@@:self.ekind) }
            get_hp(): int       { @@:(@@:self.hp_remaining) }
            get_points(): int   { @@:(@@:self.pts) }
            wants_to_fire(): bool {
                if @@:self.rate <= 0.0 {
                    @@:return(false)
                }
                @@:($.fire_timer >= @@:self.rate)
            }
            consume_fire()      { $.fire_timer = 0.0; }
            is_alive(): bool    { @@:(true) }
            is_cleanup(): bool  { @@:(false) }
        }

        $Dying {
            $.timer: float64 = 0.0
            $.duration: float64 = 0.4

            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> $Gone
                }
            }

            hit(damage: int) {
            }

            get_state(): string { @@:("dying") }
            get_kind(): int     { @@:(@@:self.ekind) }
            get_hp(): int       { @@:(0) }
            get_points(): int   { @@:(@@:self.pts) }
            wants_to_fire(): bool { @@:(false) }
            consume_fire()      { }
            is_alive(): bool    { @@:(false) }
            is_cleanup(): bool  { @@:(false) }
        }

        $Gone {
            get_state(): string { @@:("gone") }
            get_kind(): int     { @@:(@@:self.ekind) }
            get_hp(): int       { @@:(0) }
            get_points(): int   { @@:(@@:self.pts) }
            wants_to_fire(): bool { @@:(false) }
            consume_fire()      { }
            is_alive(): bool    { @@:(false) }
            is_cleanup(): bool  { @@:(true) }
        }

    domain:
        ekind: int = kind
        hp_remaining: int = hp
        rate: float64 = fire_rate
        pts: int = points
}

// ------------------------------------------------------------ Boss
@@system Boss {

    interface:
        tick(dt: float64)
        hit(damage: int)
        get_phase(): int
        get_hp(): int
        get_hp_fraction(): float64
        get_state(): string
        is_alive(): bool
        is_dying(): bool
        is_gone(): bool
        wants_to_fire_single(): bool
        wants_to_fire_spread(): bool
        wants_to_fire_spray(): bool
        consume_fire()

    machine:
        $P1Idle => $PhaseOne {
            $.timer: float64 = 0.0
            $.idle_duration: float64 = 1.8

            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.idle_duration {
                    -> $P1Firing
                }
            }

            get_state(): string { @@:("p1_idle") }
            => $^
        }

        $PhaseOne {
            hit(damage: int) {
                @@:self.hp = @@:self.hp - damage
                if float64(@@:self.hp) <= float64(@@:self.hp_start) * 0.66 {
                    -> $P2Idle
                } else if @@:self.hp <= 0 {
                    -> $Dying
                }
            }

            get_phase(): int        { @@:(1) }
            get_hp(): int           { @@:(@@:self.hp) }
            get_hp_fraction(): float64 { @@:(float64(@@:self.hp) / float64(@@:self.hp_start)) }
            get_state(): string     { @@:("phase_one") }
            is_alive(): bool        { @@:(true) }
            is_dying(): bool        { @@:(false) }
            is_gone(): bool         { @@:(false) }
            wants_to_fire_single(): bool  { @@:(false) }
            wants_to_fire_spread(): bool  { @@:(false) }
            wants_to_fire_spray(): bool   { @@:(false) }
            consume_fire()          { }
        }

        $P1Firing => $PhaseOne {
            $.timer: float64 = 0.0
            $.duration: float64 = 0.4
            $.fired: bool = false

            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> $P1Idle
                }
            }

            wants_to_fire_single(): bool {
                if $.fired {
                    @@:return(false)
                }
                @@:(true)
            }
            consume_fire() { $.fired = true; }

            get_state(): string { @@:("p1_firing") }
            => $^
        }

        $PhaseTwo {
            hit(damage: int) {
                @@:self.hp = @@:self.hp - damage
                if float64(@@:self.hp) <= float64(@@:self.hp_start) * 0.33 {
                    -> $P3Idle
                } else if @@:self.hp <= 0 {
                    -> $Dying
                }
            }

            get_phase(): int        { @@:(2) }
            get_hp(): int           { @@:(@@:self.hp) }
            get_hp_fraction(): float64 { @@:(float64(@@:self.hp) / float64(@@:self.hp_start)) }
            get_state(): string     { @@:("phase_two") }
            is_alive(): bool        { @@:(true) }
            is_dying(): bool        { @@:(false) }
            is_gone(): bool         { @@:(false) }
            wants_to_fire_single(): bool  { @@:(false) }
            wants_to_fire_spread(): bool  { @@:(false) }
            wants_to_fire_spray(): bool   { @@:(false) }
            consume_fire()          { }
        }

        $P2Idle => $PhaseTwo {
            $.timer: float64 = 0.0
            $.idle_duration: float64 = 1.3

            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.idle_duration {
                    -> $P2Spread
                }
            }

            get_state(): string { @@:("p2_idle") }
            => $^
        }

        $P2Spread => $PhaseTwo {
            $.timer: float64 = 0.0
            $.duration: float64 = 0.5
            $.fired: bool = false

            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> $P2Idle
                }
            }

            wants_to_fire_spread(): bool {
                if $.fired {
                    @@:return(false)
                }
                @@:(true)
            }
            consume_fire() { $.fired = true; }

            get_state(): string { @@:("p2_spread") }
            => $^
        }

        $PhaseThree {
            hit(damage: int) {
                @@:self.hp = @@:self.hp - damage
                if @@:self.hp <= 0 {
                    -> $Dying
                }
            }

            get_phase(): int        { @@:(3) }
            get_hp(): int           { @@:(@@:self.hp) }
            get_hp_fraction(): float64 { @@:(float64(@@:self.hp) / float64(@@:self.hp_start)) }
            get_state(): string     { @@:("phase_three") }
            is_alive(): bool        { @@:(true) }
            is_dying(): bool        { @@:(false) }
            is_gone(): bool         { @@:(false) }
            wants_to_fire_single(): bool  { @@:(false) }
            wants_to_fire_spread(): bool  { @@:(false) }
            wants_to_fire_spray(): bool   { @@:(false) }
            consume_fire()          { }
        }

        $P3Idle => $PhaseThree {
            $.timer: float64 = 0.0
            $.idle_duration: float64 = 0.6

            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.idle_duration {
                    -> $P3Spray
                }
            }

            get_state(): string { @@:("p3_idle") }
            => $^
        }

        $P3Spray => $PhaseThree {
            $.timer: float64 = 0.0
            $.duration: float64 = 0.8
            $.fire_accumulator: float64 = 0.0
            $.fire_ready: bool = false

            tick(dt: float64) {
                $.timer = $.timer + dt
                $.fire_accumulator = $.fire_accumulator + dt
                if $.fire_accumulator >= 0.12 {
                    $.fire_accumulator = 0.0
                    $.fire_ready = true
                }
                if $.timer >= $.duration {
                    -> $P3Idle
                }
            }

            wants_to_fire_spray(): bool {
                @@:($.fire_ready)
            }
            consume_fire() { $.fire_ready = false; }

            get_state(): string { @@:("p3_spray") }
            => $^
        }

        $Dying {
            $.timer: float64 = 0.0
            $.duration: float64 = 2.5

            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> $Gone
                }
            }

            hit(damage: int) {
            }

            get_phase(): int        { @@:(0) }
            get_hp(): int           { @@:(0) }
            get_hp_fraction(): float64 { @@:(0.0) }
            get_state(): string     { @@:("dying") }
            is_alive(): bool        { @@:(false) }
            is_dying(): bool        { @@:(true) }
            is_gone(): bool         { @@:(false) }
            wants_to_fire_single(): bool  { @@:(false) }
            wants_to_fire_spread(): bool  { @@:(false) }
            wants_to_fire_spray(): bool   { @@:(false) }
            consume_fire()          { }
        }

        $Gone {
            get_phase(): int        { @@:(0) }
            get_hp(): int           { @@:(0) }
            get_hp_fraction(): float64 { @@:(0.0) }
            get_state(): string     { @@:("gone") }
            is_alive(): bool        { @@:(false) }
            is_dying(): bool        { @@:(false) }
            is_gone(): bool         { @@:(true) }
            wants_to_fire_single(): bool  { @@:(false) }
            wants_to_fire_spread(): bool  { @@:(false) }
            wants_to_fire_spray(): bool   { @@:(false) }
            consume_fire()          { }
        }

    domain:
        hp: int = 90
        hp_start: int = 90
}

// ------------------------------------------------------------ Shooter
@@[main]
@@system Shooter {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }

    interface:
        start()
        restart()
        tick(dt: float64)

        add_enemy(e: *Enemy)
        clear_dead_enemies()

        player_hit()
        enemy_hit(index: int, damage: int): bool
        boss_hit(damage: int): bool

        get_state(): string
        get_score(): int
        get_lives(): int
        enemy_count(): int
        should_spawn_wave(): bool
        consume_wave()
        should_spawn_boss(): bool
        consume_boss_spawn()

        pause()
        resume()

    machine:
        $Attract {
            $>() {
                @@:self.score = 0
                @@:self.waves_spawned = 0
                @@:self.wave_timer = 0.0
                @@:self.boss_spawn_pending = false
            }

            start() {
                @@:self.player.respawn()
                -> $Playing
            }

            get_state(): string         { @@:("attract") }
            get_score(): int            { @@:(@@:self.score) }
            get_lives(): int            { @@:(@@:self.player.get_lives()) }
            enemy_count(): int          { @@:(len(@@:self.enemies)) }
            should_spawn_wave(): bool   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): bool   { @@:(false) }
            consume_boss_spawn()        { }
        }

        $Playing {
            tick(dt: float64) {
                @@:self.player.tick(dt)
                @@:self._tick_enemies(dt)
                @@:self.wave_timer = @@:self.wave_timer + dt
                if @@:self.player.get_state() == "dead" {
                    -> $GameOver
                }

                if @@:self.waves_spawned >= @@:self.waves_before_boss {
                    -> $BossFight
                }
            }

            add_enemy(e: *Enemy) {
                @@:self.enemies = append(@@:self.enemies, e)
            }

            clear_dead_enemies() {
                @@:self._cleanup_enemies()
            }

            player_hit() {
                if @@:self.player.can_be_hit() {
                    @@:self.player.hit()
                }
            }

            enemy_hit(index: int, damage: int): bool {
                if index < 0 || index >= len(@@:self.enemies) {
                    @@:return(false)
                }
                @@:self.enemies[index].hit(damage)
                if !@@:self.enemies[index].is_alive() {
                    @@:self.score = @@:self.score + @@:self.enemies[index].get_points()
                    @@:return(true)
                }
                @@:(false)
            }

            boss_hit(damage: int): bool {
                @@:(false)
            }

            should_spawn_wave(): bool {
                @@:(@@:self.wave_timer >= @@:self.wave_interval)
            }

            consume_wave() {
                @@:self.wave_timer = 0.0
                @@:self.waves_spawned = @@:self.waves_spawned + 1
            }

            should_spawn_boss(): bool { @@:(false) }
            consume_boss_spawn()      { }

            pause() {
                push$ -> $Paused
            }

            get_state(): string { @@:("playing") }
            get_score(): int    { @@:(@@:self.score) }
            get_lives(): int    { @@:(@@:self.player.get_lives()) }
            enemy_count(): int  { @@:(len(@@:self.enemies)) }
        }

        $BossFight {
            $>() {
                @@:self.boss_spawn_pending = true
            }

            tick(dt: float64) {
                @@:self.player.tick(dt)
                @@:self._tick_enemies(dt)
                @@:self.boss.tick(dt)
                if @@:self.player.get_state() == "dead" {
                    -> $GameOver
                }

                if @@:self.boss.is_gone() {
                    -> $Victory
                }
            }

            add_enemy(e: *Enemy) {
                @@:self.enemies = append(@@:self.enemies, e)
            }

            clear_dead_enemies() {
                @@:self._cleanup_enemies()
            }

            player_hit() {
                if @@:self.player.can_be_hit() {
                    @@:self.player.hit()
                }
            }

            enemy_hit(index: int, damage: int): bool {
                if index < 0 || index >= len(@@:self.enemies) {
                    @@:return(false)
                }
                @@:self.enemies[index].hit(damage)
                if !@@:self.enemies[index].is_alive() {
                    @@:self.score = @@:self.score + @@:self.enemies[index].get_points()
                    @@:return(true)
                }
                @@:(false)
            }

            boss_hit(damage: int): bool {
                @@:self.boss.hit(damage)
                if @@:self.boss.is_dying() || @@:self.boss.is_gone() {
                    @@:(true)
                } else {
                    @@:(false)
                }
            }

            should_spawn_wave(): bool   { @@:(false) }
            consume_wave()              { }

            should_spawn_boss(): bool   { @@:(@@:self.boss_spawn_pending) }
            consume_boss_spawn()        { @@:self.boss_spawn_pending = false; }

            pause() {
                push$ -> $Paused
            }

            get_state(): string { @@:("boss_fight") }
            get_score(): int    { @@:(@@:self.score) }
            get_lives(): int    { @@:(@@:self.player.get_lives()) }
            enemy_count(): int  { @@:(len(@@:self.enemies)) }
        }

        $Paused {
            resume() {
                -> pop$
            }

            get_state(): string         { @@:("paused") }
            get_score(): int            { @@:(@@:self.score) }
            get_lives(): int            { @@:(@@:self.player.get_lives()) }
            enemy_count(): int          { @@:(len(@@:self.enemies)) }
            should_spawn_wave(): bool   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): bool   { @@:(false) }
            consume_boss_spawn()        { }
        }

        $Victory {
            restart() {
                -> $Attract
            }

            get_state(): string         { @@:("victory") }
            get_score(): int            { @@:(@@:self.score) }
            get_lives(): int            { @@:(@@:self.player.get_lives()) }
            enemy_count(): int          { @@:(len(@@:self.enemies)) }
            should_spawn_wave(): bool   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): bool   { @@:(false) }
            consume_boss_spawn()        { }
        }

        $GameOver {
            restart() {
                -> $Attract
            }

            get_state(): string         { @@:("game_over") }
            get_score(): int            { @@:(@@:self.score) }
            get_lives(): int            { @@:(@@:self.player.get_lives()) }
            enemy_count(): int          { @@:(len(@@:self.enemies)) }
            should_spawn_wave(): bool   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): bool   { @@:(false) }
            consume_boss_spawn()        { }
        }

    actions:
        _tick_enemies(dt: float64) {
            i := 0
            for i < len(@@:self.enemies) {
                @@:self.enemies[i].tick(dt)
                i = i + 1
            }
        }

        _cleanup_enemies() {
            i := len(@@:self.enemies) - 1
            for i >= 0 {
                if @@:self.enemies[i].is_cleanup() {
                    @@:self.enemies = append(@@:self.enemies[:i], @@:self.enemies[i+1:]...)
                }
                i = i - 1
            }
        }

    domain:
        score: int = 0
        wave_timer: float64 = 0.0
        wave_interval: float64 = 2.0
        waves_spawned: int = 0
        waves_before_boss: int = 10
        boss_spawn_pending: bool = false
        player: Player = @@Player()
        boss: Boss = @@Boss()
        enemies: []*Enemy = nil
}
