@@[target("ruby")]

# Asteroids — Ruby port of the Frame controller. Same three systems as every
# other port. The ruby backend is native passthrough (like js/python/ts):
# handler bodies are written in native Ruby — `if cond ... elsif ... else ... end`,
# `while ... end`, 0-based arrays, true/false/nil — NOT the brace style the
# C-family/Lua/Dart backends translate. Ruby has operator overloading, so Vec2
# uses +/*; the host is duck-typed (responds to warp_out/warp_in/...).

class Vec2
  attr_accessor :x, :y
  def initialize(x = 0.0, y = 0.0)
    @x = x
    @y = y
  end
  def +(o)
    Vec2.new(@x + o.x, @y + o.y)
  end
  def *(s)
    Vec2.new(@x * s, @y * s)
  end
  def length
    Math.sqrt(@x * @x + @y * @y)
  end
  def distance_to(o)
    Math.sqrt((@x - o.x) ** 2 + (@y - o.y) ** 2)
  end
end

class Asteroid
  attr_accessor :pos, :vel, :size, :alive
  def initialize(pos, vel, size, alive)
    @pos = pos
    @vel = vel
    @size = size
    @alive = alive
  end
end

def _rf
  rand
end

def _from_angle(a, speed)
  Vec2.new(Math.cos(a) * speed, Math.sin(a) * speed)
end

# ------------------------------------------------------------ Ship
@@system Ship(host) {

    operations:
        get_current_state_name() { @@:(@@:system.state.name) }
        get_hyperspaces_remaining() { @@:(@@:self.hyperspaces_remaining) }

    interface:
        tick(dt)
        hit()
        hyperspace()
        respawn()
        fire()
        can_fire()
        can_be_hit()
        can_hyperspace()
        is_visible()
        is_alive()
        get_lives()

    machine:

        $Alive {
            $.cooldown = 0.0
            tick(dt) {
                if @@:($.cooldown) > 0.0
                    $.cooldown = @@:($.cooldown) - dt
                end
            }
            fire() { $.cooldown = 0.22 }
            hit() { -> $Exploding }
            hyperspace() {
                if @@:self.hyperspaces_remaining > 0
                    @@:self.hyperspaces_remaining = @@:self.hyperspaces_remaining - 1
                    -> $InHyperspace
                end
            }
            can_fire()       { @@:(@@:($.cooldown) <= 0.0) }
            can_be_hit()     { @@:(true) }
            can_hyperspace() { @@:(@@:self.hyperspaces_remaining > 0) }
            is_visible()     { @@:(true) }
            is_alive()       { @@:(true) }
            get_lives()      { @@:(@@:self.lives_remaining) }
        }

        $InHyperspace {
            $.timer = 0.0
            $.duration = 0.4
            $>() { @@:self.host.warp_out() }
            <$() { @@:self.host.warp_in() }
            tick(dt) {
                $.timer = @@:($.timer) + dt
                if @@:($.timer) >= @@:($.duration)
                    -> "warp complete" $Alive
                end
            }
            can_fire()       { @@:(false) }
            can_be_hit()     { @@:(false) }
            can_hyperspace() { @@:(false) }
            is_visible()     { @@:(false) }
            is_alive()       { @@:(true) }
            get_lives()      { @@:(@@:self.lives_remaining) }
        }

        $Exploding {
            $.timer = 0.0
            $.duration = 1.0
            $>() { @@:self.host.spawn_explosion() }
            tick(dt) {
                $.timer = @@:($.timer) + dt
                if @@:($.timer) >= @@:($.duration)
                    @@:self.lives_remaining = @@:self.lives_remaining - 1
                    if @@:self.lives_remaining <= 0
                        -> "no lives left" $Dead
                    else
                        -> "lives remain" $Respawning
                    end
                end
            }
            can_fire()       { @@:(false) }
            can_be_hit()     { @@:(false) }
            can_hyperspace() { @@:(false) }
            is_visible()     { @@:(true) }
            is_alive()       { @@:(false) }
            get_lives()      { @@:(@@:self.lives_remaining) }
        }

        $Respawning {
            $.timer = 0.0
            $.duration = 2.0
            $>() { @@:self.host.reset_ship() }
            tick(dt) {
                $.timer = @@:($.timer) + dt
                if @@:($.timer) >= @@:($.duration)
                    -> "invuln expired" $Alive
                end
            }
            can_fire()       { @@:(true) }
            can_be_hit()     { @@:(false) }
            can_hyperspace() { @@:(false) }
            is_visible()     { @@:(true) }
            is_alive()       { @@:(true) }
            get_lives()      { @@:(@@:self.lives_remaining) }
        }

        $Dead {
            respawn() {
                @@:self.lives_remaining = @@:self.starting_lives
                @@:self.hyperspaces_remaining = @@:self.starting_hyperspaces
                -> $Respawning
            }
            can_fire()       { @@:(false) }
            can_be_hit()     { @@:(false) }
            can_hyperspace() { @@:(false) }
            is_visible()     { @@:(false) }
            is_alive()       { @@:(false) }
            get_lives()      { @@:(0) }
        }

    domain:
        host = host
        lives_remaining = 3
        starting_lives = 3
        hyperspaces_remaining = 3
        starting_hyperspaces = 3
}

# ------------------------------------------------------------ AsteroidField
@@system AsteroidField {

    interface:
        spawn_wave(count, court_size)
        split(index)
        remove(index)
        clear()
        advance(dt, court_size)
        count()
        alive_count()
        is_alive(index)
        position(index)
        velocity(index)
        size_of(index)
        radius_of(index)

    machine:

        $Active {
            spawn_wave(count, court_size) {
                @@:self.asteroids = []
                i = 0
                while i < count
                    @@:self.spawn_large(court_size)
                    i = i + 1
                end
            }

            split(index) {
                if index < 0 || index >= @@:self.asteroids.length
                    @@:return(false)
                end
                if !@@:self.asteroids[index].alive
                    @@:return(false)
                end
                @@:self.asteroids[index].alive = false
                sz = @@:self.asteroids[index].size
                p = @@:self.asteroids[index].pos
                if sz > 1
                    @@:self.spawn_child(p, sz - 1)
                    @@:self.spawn_child(p, sz - 1)
                end
                @@:(true)
            }

            remove(index) {
                if index < 0 || index >= @@:self.asteroids.length
                    return
                end
                @@:self.asteroids[index].alive = false
            }

            clear() { @@:self.asteroids = [] }

            advance(dt, court_size) {
                i = 0
                while i < @@:self.asteroids.length
                    if @@:self.asteroids[i].alive
                        @@:self.asteroids[i].pos = @@:self.asteroids[i].pos + @@:self.asteroids[i].vel * dt
                        if @@:self.asteroids[i].pos.x < 0.0
                            @@:self.asteroids[i].pos.x = @@:self.asteroids[i].pos.x + court_size.x
                        end
                        if @@:self.asteroids[i].pos.x > court_size.x
                            @@:self.asteroids[i].pos.x = @@:self.asteroids[i].pos.x - court_size.x
                        end
                        if @@:self.asteroids[i].pos.y < 0.0
                            @@:self.asteroids[i].pos.y = @@:self.asteroids[i].pos.y + court_size.y
                        end
                        if @@:self.asteroids[i].pos.y > court_size.y
                            @@:self.asteroids[i].pos.y = @@:self.asteroids[i].pos.y - court_size.y
                        end
                    end
                    i = i + 1
                end
            }

            count() { @@:(@@:self.asteroids.length) }

            alive_count() {
                c = 0
                i = 0
                while i < @@:self.asteroids.length
                    if @@:self.asteroids[i].alive
                        c = c + 1
                    end
                    i = i + 1
                end
                @@:(c)
            }

            is_alive(index) {
                if index < 0 || index >= @@:self.asteroids.length
                    @@:return(false)
                end
                @@:(@@:self.asteroids[index].alive)
            }

            position(index) {
                if index < 0 || index >= @@:self.asteroids.length
                    @@:return(Vec2.new(0, 0))
                end
                @@:(@@:self.asteroids[index].pos)
            }

            velocity(index) {
                if index < 0 || index >= @@:self.asteroids.length
                    @@:return(Vec2.new(0, 0))
                end
                @@:(@@:self.asteroids[index].vel)
            }

            size_of(index) {
                if index < 0 || index >= @@:self.asteroids.length
                    @@:return(0)
                end
                @@:(@@:self.asteroids[index].size)
            }

            radius_of(index) {
                if index < 0 || index >= @@:self.asteroids.length
                    @@:return(0.0)
                end
                sz = @@:self.asteroids[index].size
                if sz == 3
                    @@:return(32.0)
                end
                if sz == 2
                    @@:return(18.0)
                end
                @@:(10.0)
            }
        }

    actions:

        spawn_large(court_size) {
            edge = (_rf() * 4).floor
            pos = Vec2.new(0.0, 0.0)
            if edge == 0
                pos = Vec2.new(0.0, _rf() * court_size.y)
            elsif edge == 1
                pos = Vec2.new(court_size.x, _rf() * court_size.y)
            elsif edge == 2
                pos = Vec2.new(_rf() * court_size.x, 0.0)
            else
                pos = Vec2.new(_rf() * court_size.x, court_size.y)
            end
            angle = _rf() * 2.0 * Math::PI
            speed = 40.0 + _rf() * 30.0
            vel = _from_angle(angle, speed)
            @@:self.asteroids.push(Asteroid.new(pos, vel, 3, true))
        }

        spawn_child(pos, size) {
            angle = _rf() * 2.0 * Math::PI
            speed = 60.0 + _rf() * 40.0 + (3 - size) * 20.0
            vel = _from_angle(angle, speed)
            @@:self.asteroids.push(Asteroid.new(pos, vel, size, true))
        }

    domain:
        asteroids = []
}

# ------------------------------------------------------------ AsteroidsGame
@@[main]
@@system AsteroidsGame(ship_host, difficulty) {

    operations:
        get_current_state_name() { @@:(@@:system.state.name) }
        get_bullets_in_flight() { @@:(@@:self.bullets_in_flight) }
        get_max_bullets()       { @@:(@@:self.max_bullets) }

    interface:
        start()
        restart()
        pause()
        resume()
        tick(dt, court_size)
        ship_hit_asteroid(index)
        bullet_hit_asteroid(index)
        ship_hyperspace()
        bullet_fired()
        bullet_expired()
        get_score()
        get_lives()
        get_wave()
        get_difficulty()
        is_paused()

    machine:

        $Attract {
            $>() {
                @@:self.score = 0
                @@:self.wave = 1
                @@:self.bullets_in_flight = 0
            }
            start() {
                @@:self.ship.respawn()
                n = @@:self.asteroids_for_wave(1)
                @@:self.field.spawn_wave(n, @@:self.last_court_size)
                -> $Playing
            }
            get_score()      { @@:(@@:self.score) }
            get_lives()      { @@:(@@:self.ship.get_lives()) }
            get_wave()       { @@:(@@:self.wave) }
            get_difficulty() { @@:(@@:self.difficulty) }
            is_paused()      { @@:(false) }
        }

        $InGame {
            pause() {
                push$ -> $Paused
            }
            bullet_fired() {
                @@:self.bullets_in_flight = @@:self.bullets_in_flight + 1
            }
            bullet_expired() {
                if @@:self.bullets_in_flight > 0
                    @@:self.bullets_in_flight = @@:self.bullets_in_flight - 1
                end
            }
            get_score()      { @@:(@@:self.score) }
            get_lives()      { @@:(@@:self.ship.get_lives()) }
            get_wave()       { @@:(@@:self.wave) }
            get_difficulty() { @@:(@@:self.difficulty) }
            is_paused()      { @@:(false) }
        }

        $Playing => $InGame {
            tick(dt, court_size) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.field.advance(dt, court_size)
            }
            ship_hit_asteroid(index) {
                if !@@:self.ship.can_be_hit()
                    return
                end
                @@:self.ship.hit()
                -> $ShipDying
            }
            bullet_hit_asteroid(index) {
                if @@:self.field.split(index)
                    sz = @@:self.size_points(index)
                    @@:self.score = @@:self.score + sz * @@:self.difficulty
                    if @@:self.field.alive_count() <= 0
                        -> "all asteroids cleared" $WaveClear
                    end
                end
            }
            ship_hyperspace() {
                @@:self.ship.hyperspace()
            }
            => $^
        }

        $ShipDying => $InGame {
            tick(dt, court_size) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.field.advance(dt, court_size)
                if @@:self.ship.get_current_state_name() == "Respawning"
                    -> "ship respawning" $Playing
                elsif @@:self.ship.get_current_state_name() == "Dead"
                    -> "no lives left" $GameOver
                end
            }
            => $^
        }

        $WaveClear => $InGame {
            $>() { @@:self.wave_timer = 0.0 }
            tick(dt, court_size) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.wave_timer = @@:self.wave_timer + dt
                if @@:self.wave_timer >= @@:self.wave_pause
                    @@:self.wave = @@:self.wave + 1
                    n = @@:self.asteroids_for_wave(@@:self.wave)
                    @@:self.field.spawn_wave(n, court_size)
                    -> "next wave" $Playing
                end
            }
            => $^
        }

        $Paused {
            resume() {
                -> pop$
            }
            get_score()      { @@:(@@:self.score) }
            get_lives()      { @@:(@@:self.ship.get_lives()) }
            get_wave()       { @@:(@@:self.wave) }
            get_difficulty() { @@:(@@:self.difficulty) }
            is_paused()      { @@:(true) }
        }

        $GameOver {
            restart() {
                -> $Attract
            }
            get_score()      { @@:(@@:self.score) }
            get_lives()      { @@:(@@:self.ship.get_lives()) }
            get_wave()       { @@:(@@:self.wave) }
            get_difficulty() { @@:(@@:self.difficulty) }
            is_paused()      { @@:(false) }
        }

    actions:

        asteroids_for_wave(wave) {
            base_count = 2 + @@:self.difficulty
            return base_count + wave - 1
        }

        size_points(index) {
            sz = @@:self.field.size_of(index)
            if sz == 3
                return 20
            end
            if sz == 2
                return 50
            end
            return 100
        }

    domain:
        difficulty = difficulty
        score = 0
        wave = 1
        wave_timer = 0.0
        wave_pause = 2.0
        bullets_in_flight = 0
        max_bullets = 4
        last_court_size = Vec2.new(640, 480)
        ship: Ship = @@Ship(ship_host)
        field: AsteroidField = @@AsteroidField()
}
