@@[target("python_3")]

# Asteroids — Python/Pygame port of the Frame controller. Same three systems as
# the other ports. The python_3 backend is "native passthrough" for handler
# bodies (the Oceans model): bodies are written in native Python — `if:`/`elif:`/
# `else:`/`while:` with indentation, True/False, len(), 0-based lists — NOT the
# brace style the C-family/Lua/Dart backends translate. Vec2 is a small class
# (Python has operator overloading); the host is duck-typed.
import math
import random


class Vec2:
    __slots__ = ("x", "y")

    def __init__(self, x=0.0, y=0.0):
        self.x = x
        self.y = y

    def __add__(self, o):
        return Vec2(self.x + o.x, self.y + o.y)

    def __mul__(self, s):
        return Vec2(self.x * s, self.y * s)

    def length(self):
        return math.hypot(self.x, self.y)

    def distance_to(self, o):
        return math.hypot(self.x - o.x, self.y - o.y)


class Asteroid:
    __slots__ = ("pos", "vel", "size", "alive")

    def __init__(self, pos, vel, size, alive):
        self.pos = pos
        self.vel = vel
        self.size = size
        self.alive = alive


def _rf():
    return random.random()


def _from_angle(a, speed):
    return Vec2(math.cos(a) * speed, math.sin(a) * speed)


# ------------------------------------------------------------ Ship
@@system Ship(host: any) {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }
        get_hyperspaces_remaining(): int { @@:(@@:self.hyperspaces_remaining) }

    interface:
        tick(dt: float)
        hit()
        hyperspace()
        respawn()
        fire()
        can_fire(): bool
        can_be_hit(): bool
        can_hyperspace(): bool
        is_visible(): bool
        is_alive(): bool
        get_lives(): int

    machine:

        $Alive {
            $.cooldown: float = 0.0
            tick(dt: float) {
                if $.cooldown > 0.0:
                    $.cooldown = $.cooldown - dt
            }
            fire() { $.cooldown = 0.22 }
            hit() { -> $Exploding }
            hyperspace() {
                if @@:self.hyperspaces_remaining > 0:
                    @@:self.hyperspaces_remaining = @@:self.hyperspaces_remaining - 1
                    -> $InHyperspace
            }
            can_fire(): bool       { @@:($.cooldown <= 0.0) }
            can_be_hit(): bool     { @@:(True) }
            can_hyperspace(): bool { @@:(@@:self.hyperspaces_remaining > 0) }
            is_visible(): bool     { @@:(True) }
            is_alive(): bool       { @@:(True) }
            get_lives(): int       { @@:(@@:self.lives_remaining) }
        }

        $InHyperspace {
            $.timer: float = 0.0
            $.duration: float = 0.4
            $>() { @@:self.host.warp_out() }
            <$() { @@:self.host.warp_in() }
            tick(dt: float) {
                $.timer = $.timer + dt
                if $.timer >= $.duration:
                    -> "warp complete" $Alive
            }
            can_fire(): bool       { @@:(False) }
            can_be_hit(): bool     { @@:(False) }
            can_hyperspace(): bool { @@:(False) }
            is_visible(): bool     { @@:(False) }
            is_alive(): bool       { @@:(True) }
            get_lives(): int       { @@:(@@:self.lives_remaining) }
        }

        $Exploding {
            $.timer: float = 0.0
            $.duration: float = 1.0
            $>() { @@:self.host.spawn_explosion() }
            tick(dt: float) {
                $.timer = $.timer + dt
                if $.timer >= $.duration:
                    @@:self.lives_remaining = @@:self.lives_remaining - 1
                    if @@:self.lives_remaining <= 0:
                        -> "no lives left" $Dead
                    else:
                        -> "lives remain" $Respawning
            }
            can_fire(): bool       { @@:(False) }
            can_be_hit(): bool     { @@:(False) }
            can_hyperspace(): bool { @@:(False) }
            is_visible(): bool     { @@:(True) }
            is_alive(): bool       { @@:(False) }
            get_lives(): int       { @@:(@@:self.lives_remaining) }
        }

        $Respawning {
            $.timer: float = 0.0
            $.duration: float = 2.0
            $>() { @@:self.host.reset_ship() }
            tick(dt: float) {
                $.timer = $.timer + dt
                if $.timer >= $.duration:
                    -> "invuln expired" $Alive
            }
            can_fire(): bool       { @@:(True) }
            can_be_hit(): bool     { @@:(False) }
            can_hyperspace(): bool { @@:(False) }
            is_visible(): bool     { @@:(True) }
            is_alive(): bool       { @@:(True) }
            get_lives(): int       { @@:(@@:self.lives_remaining) }
        }

        $Dead {
            respawn() {
                @@:self.lives_remaining = @@:self.starting_lives
                @@:self.hyperspaces_remaining = @@:self.starting_hyperspaces
                -> $Respawning
            }
            can_fire(): bool       { @@:(False) }
            can_be_hit(): bool     { @@:(False) }
            can_hyperspace(): bool { @@:(False) }
            is_visible(): bool     { @@:(False) }
            is_alive(): bool       { @@:(False) }
            get_lives(): int       { @@:(0) }
        }

    domain:
        host: any = host
        lives_remaining: int = 3
        starting_lives: int = 3
        hyperspaces_remaining: int = 3
        starting_hyperspaces: int = 3
}

# ------------------------------------------------------------ AsteroidField
@@system AsteroidField {

    interface:
        spawn_wave(count: int, court_size: any)
        split(index: int): bool
        remove(index: int)
        clear()
        advance(dt: float, court_size: any)
        count(): int
        alive_count(): int
        is_alive(index: int): bool
        position(index: int): any
        velocity(index: int): any
        size_of(index: int): int
        radius_of(index: int): float

    machine:

        $Active {
            spawn_wave(count: int, court_size: any) {
                @@:self.asteroids = []
                i = 0
                while i < count:
                    @@:self.spawn_large(court_size)
                    i = i + 1
            }

            split(index: int): bool {
                if index < 0 or index >= len(@@:self.asteroids):
                    @@:return(False)
                if not @@:self.asteroids[index].alive:
                    @@:return(False)
                @@:self.asteroids[index].alive = False
                sz = @@:self.asteroids[index].size
                p = @@:self.asteroids[index].pos
                if sz > 1:
                    @@:self.spawn_child(p, sz - 1)
                    @@:self.spawn_child(p, sz - 1)
                @@:(True)
            }

            remove(index: int) {
                if index < 0 or index >= len(@@:self.asteroids):
                    return
                @@:self.asteroids[index].alive = False
            }

            clear() { @@:self.asteroids = [] }

            advance(dt: float, court_size: any) {
                i = 0
                while i < len(@@:self.asteroids):
                    if @@:self.asteroids[i].alive:
                        @@:self.asteroids[i].pos = @@:self.asteroids[i].pos + @@:self.asteroids[i].vel * dt
                        if @@:self.asteroids[i].pos.x < 0.0:
                            @@:self.asteroids[i].pos.x = @@:self.asteroids[i].pos.x + court_size.x
                        if @@:self.asteroids[i].pos.x > court_size.x:
                            @@:self.asteroids[i].pos.x = @@:self.asteroids[i].pos.x - court_size.x
                        if @@:self.asteroids[i].pos.y < 0.0:
                            @@:self.asteroids[i].pos.y = @@:self.asteroids[i].pos.y + court_size.y
                        if @@:self.asteroids[i].pos.y > court_size.y:
                            @@:self.asteroids[i].pos.y = @@:self.asteroids[i].pos.y - court_size.y
                    i = i + 1
            }

            count(): int { @@:(len(@@:self.asteroids)) }

            alive_count(): int {
                c = 0
                for r in @@:self.asteroids:
                    if r.alive:
                        c = c + 1
                @@:(c)
            }

            is_alive(index: int): bool {
                if index < 0 or index >= len(@@:self.asteroids):
                    @@:return(False)
                @@:(@@:self.asteroids[index].alive)
            }

            position(index: int): any {
                if index < 0 or index >= len(@@:self.asteroids):
                    @@:return(Vec2(0, 0))
                @@:(@@:self.asteroids[index].pos)
            }

            velocity(index: int): any {
                if index < 0 or index >= len(@@:self.asteroids):
                    @@:return(Vec2(0, 0))
                @@:(@@:self.asteroids[index].vel)
            }

            size_of(index: int): int {
                if index < 0 or index >= len(@@:self.asteroids):
                    @@:return(0)
                @@:(@@:self.asteroids[index].size)
            }

            radius_of(index: int): float {
                if index < 0 or index >= len(@@:self.asteroids):
                    @@:return(0.0)
                sz = @@:self.asteroids[index].size
                if sz == 3:
                    @@:return(32.0)
                if sz == 2:
                    @@:return(18.0)
                @@:(10.0)
            }
        }

    actions:

        spawn_large(court_size: any) {
            edge = random.randrange(4)
            pos = Vec2(0.0, 0.0)
            if edge == 0:
                pos = Vec2(0.0, _rf() * court_size.y)
            elif edge == 1:
                pos = Vec2(court_size.x, _rf() * court_size.y)
            elif edge == 2:
                pos = Vec2(_rf() * court_size.x, 0.0)
            else:
                pos = Vec2(_rf() * court_size.x, court_size.y)
            angle = _rf() * 2.0 * math.pi
            speed = 40.0 + _rf() * 30.0
            vel = _from_angle(angle, speed)
            @@:self.asteroids.append(Asteroid(pos, vel, 3, True))
        }

        spawn_child(pos: any, size: int) {
            angle = _rf() * 2.0 * math.pi
            speed = 60.0 + _rf() * 40.0 + float(3 - size) * 20.0
            vel = _from_angle(angle, speed)
            @@:self.asteroids.append(Asteroid(pos, vel, size, True))
        }

    domain:
        asteroids: any = []
}

# ------------------------------------------------------------ AsteroidsGame
@@[main]
@@system AsteroidsGame(ship_host: any, difficulty: int) {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }
        get_bullets_in_flight(): int { @@:(@@:self.bullets_in_flight) }
        get_max_bullets(): int       { @@:(@@:self.max_bullets) }

    interface:
        start()
        restart()
        pause()
        resume()
        tick(dt: float, court_size: any)
        ship_hit_asteroid(index: int)
        bullet_hit_asteroid(index: int)
        ship_hyperspace()
        bullet_fired()
        bullet_expired()
        get_score(): int
        get_lives(): int
        get_wave(): int
        get_difficulty(): int
        is_paused(): bool

    machine:

        $Attract {
            $>() {
                @@:self.score = 0
                @@:self.wave = 1
                @@:self.bullets_in_flight = 0
            }
            start() {
                @@:self.ship.respawn()
                n = @@:self.asteroids_for_wave(1)
                @@:self.field.spawn_wave(n, @@:self.last_court_size)
                -> $Playing
            }
            get_score(): int        { @@:(@@:self.score) }
            get_lives(): int        { @@:(@@:self.ship.get_lives()) }
            get_wave(): int         { @@:(@@:self.wave) }
            get_difficulty(): int   { @@:(@@:self.difficulty) }
            is_paused(): bool       { @@:(False) }
        }

        $InGame {
            pause() {
                push$ -> $Paused
            }
            bullet_fired() {
                @@:self.bullets_in_flight = @@:self.bullets_in_flight + 1
            }
            bullet_expired() {
                if @@:self.bullets_in_flight > 0:
                    @@:self.bullets_in_flight = @@:self.bullets_in_flight - 1
            }
            get_score(): int        { @@:(@@:self.score) }
            get_lives(): int        { @@:(@@:self.ship.get_lives()) }
            get_wave(): int         { @@:(@@:self.wave) }
            get_difficulty(): int   { @@:(@@:self.difficulty) }
            is_paused(): bool       { @@:(False) }
        }

        $Playing => $InGame {
            tick(dt: float, court_size: any) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.field.advance(dt, court_size)
            }
            ship_hit_asteroid(index: int) {
                if not @@:self.ship.can_be_hit():
                    return
                @@:self.ship.hit()
                -> $ShipDying
            }
            bullet_hit_asteroid(index: int) {
                if @@:self.field.split(index):
                    sz = @@:self.size_points(index)
                    @@:self.score = @@:self.score + sz * @@:self.difficulty
                    if @@:self.field.alive_count() <= 0:
                        -> "all asteroids cleared" $WaveClear
            }
            ship_hyperspace() {
                @@:self.ship.hyperspace()
            }
            => $^
        }

        $ShipDying => $InGame {
            tick(dt: float, court_size: any) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.field.advance(dt, court_size)
                if @@:self.ship.get_current_state_name() == "Respawning":
                    -> "ship respawning" $Playing
                elif @@:self.ship.get_current_state_name() == "Dead":
                    -> "no lives left" $GameOver
            }
            => $^
        }

        $WaveClear => $InGame {
            $>() { @@:self.wave_timer = 0.0 }
            tick(dt: float, court_size: any) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.wave_timer = @@:self.wave_timer + dt
                if @@:self.wave_timer >= @@:self.wave_pause:
                    @@:self.wave = @@:self.wave + 1
                    n = @@:self.asteroids_for_wave(@@:self.wave)
                    @@:self.field.spawn_wave(n, court_size)
                    -> "next wave" $Playing
            }
            => $^
        }

        $Paused {
            resume() {
                -> pop$
            }
            get_score(): int        { @@:(@@:self.score) }
            get_lives(): int        { @@:(@@:self.ship.get_lives()) }
            get_wave(): int         { @@:(@@:self.wave) }
            get_difficulty(): int   { @@:(@@:self.difficulty) }
            is_paused(): bool       { @@:(True) }
        }

        $GameOver {
            restart() {
                -> $Attract
            }
            get_score(): int        { @@:(@@:self.score) }
            get_lives(): int        { @@:(@@:self.ship.get_lives()) }
            get_wave(): int         { @@:(@@:self.wave) }
            get_difficulty(): int   { @@:(@@:self.difficulty) }
            is_paused(): bool       { @@:(False) }
        }

    actions:

        asteroids_for_wave(wave: int): int {
            base_count = 2 + @@:self.difficulty
            return base_count + wave - 1
        }

        size_points(index: int): int {
            sz = @@:self.field.size_of(index)
            if sz == 3:
                return 20
            if sz == 2:
                return 50
            return 100
        }

    domain:
        difficulty: int = difficulty
        score: int = 0
        wave: int = 1
        wave_timer: float = 0.0
        wave_pause: float = 2.0
        bullets_in_flight: int = 0
        max_bullets: int = 4
        last_court_size: any = Vec2(640, 480)
        ship: Ship = @@Ship(ship_host)
        field: AsteroidField = @@AsteroidField()
}
