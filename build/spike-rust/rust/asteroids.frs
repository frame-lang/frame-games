@@[target("rust")]

// ============================================================
// Asteroids — Rust/gdext port of the Frame controller.
// Three systems: Ship, AsteroidField, AsteroidsGame. FSM logic is
// identical to asteroids.fgd; only the native bodies differ (// comments,
// braces + parens, explicit Rust types, gdext APIs). The FSMs are plain
// Rust structs — gdext wrapping lives in the gameplay layer.
// ============================================================

use godot::prelude::*;

// An asteroid is plain data — the field owns a typed Vec of them (the
// Rust analog of the GDScript Array<Dictionary>).
#[derive(Clone, Copy)]
pub struct Asteroid {
    pub pos: Vector2,
    pub vel: Vector2,
    pub size: i32,
    pub alive: bool,
}

fn rf() -> f32 { godot::global::randf() as f32 }

// ------------------------------------------------------------ Ship
@@system Ship(host: Gd<Node>) {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }
        get_hyperspaces_remaining(): i32 { @@:(@@:self.hyperspaces_remaining) }

    interface:
        tick(dt: f32)
        hit()
        hyperspace()
        respawn()
        fire()
        can_fire(): bool
        can_be_hit(): bool
        can_hyperspace(): bool
        is_visible(): bool
        is_alive(): bool
        get_lives(): i32

    machine:

        $Alive {
            $.cooldown: f32 = 0.0
            tick(dt: f32) {
                if $.cooldown > 0.0 {
                    $.cooldown = $.cooldown - dt;
                }
            }
            fire() { $.cooldown = 0.22; }
            hit() { -> $Exploding }
            hyperspace() {
                if @@:self.hyperspaces_remaining > 0 {
                    @@:self.hyperspaces_remaining = @@:self.hyperspaces_remaining - 1;
                    -> $InHyperspace
                }
            }
            can_fire(): bool       { @@:($.cooldown <= 0.0) }
            can_be_hit(): bool     { @@:(true) }
            can_hyperspace(): bool { @@:(@@:self.hyperspaces_remaining > 0) }
            is_visible(): bool     { @@:(true) }
            is_alive(): bool       { @@:(true) }
            get_lives(): i32       { @@:(@@:self.lives_remaining) }
        }

        $InHyperspace {
            $.timer: f32 = 0.0
            $.duration: f32 = 0.4
            $>() { @@:self.host.call_deferred("warp_out", &[]); }
            <$() { @@:self.host.call_deferred("warp_in", &[]); }
            tick(dt: f32) {
                $.timer = $.timer + dt;
                if $.timer >= $.duration {
                    -> "warp complete" $Alive
                }
            }
            can_fire(): bool       { @@:(false) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(false) }
            is_alive(): bool       { @@:(true) }
            get_lives(): i32       { @@:(@@:self.lives_remaining) }
        }

        $Exploding {
            $.timer: f32 = 0.0
            $.duration: f32 = 1.0
            $>() { @@:self.host.call_deferred("spawn_explosion", &[]); }
            tick(dt: f32) {
                $.timer = $.timer + dt;
                if $.timer >= $.duration {
                    @@:self.lives_remaining = @@:self.lives_remaining - 1;
                    if @@:self.lives_remaining <= 0 {
                        -> "no lives left" $Dead
                    } else {
                        -> "lives remain" $Respawning
                    }
                }
            }
            can_fire(): bool       { @@:(false) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(true) }
            is_alive(): bool       { @@:(false) }
            get_lives(): i32       { @@:(@@:self.lives_remaining) }
        }

        $Respawning {
            $.timer: f32 = 0.0
            $.duration: f32 = 2.0
            $>() { @@:self.host.call_deferred("reset_ship", &[]); }
            tick(dt: f32) {
                $.timer = $.timer + dt;
                if $.timer >= $.duration {
                    -> "invuln expired" $Alive
                }
            }
            can_fire(): bool       { @@:(true) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(true) }
            is_alive(): bool       { @@:(true) }
            get_lives(): i32       { @@:(@@:self.lives_remaining) }
        }

        $Dead {
            respawn() {
                @@:self.lives_remaining = @@:self.starting_lives;
                @@:self.hyperspaces_remaining = @@:self.starting_hyperspaces;
                -> $Respawning
            }
            can_fire(): bool       { @@:(false) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(false) }
            is_alive(): bool       { @@:(false) }
            get_lives(): i32       { @@:(0) }
        }

    domain:
        host: Gd<Node> = host
        lives_remaining: i32 = 3
        starting_lives: i32 = 3
        hyperspaces_remaining: i32 = 3
        starting_hyperspaces: i32 = 3
}

// ------------------------------------------------------------ AsteroidField
@@system AsteroidField {

    interface:
        spawn_wave(count: i32, court_size: Vector2)
        split(index: i32): bool
        remove(index: i32)
        clear()
        advance(dt: f32, court_size: Vector2)
        count(): i32
        alive_count(): i32
        is_alive(index: i32): bool
        position(index: i32): Vector2
        velocity(index: i32): Vector2
        size_of(index: i32): i32
        radius_of(index: i32): f32

    machine:

        $Active {
            spawn_wave(count: i32, court_size: Vector2) {
                @@:self.asteroids.clear();
                let mut i: i32 = 0;
                while i < count {
                    @@:self.spawn_large(court_size)
                    i = i + 1;
                }
            }

            split(index: i32): bool {
                if index < 0 || index as usize >= @@:self.asteroids.len() {
                    @@:return(false)
                }
                if !@@:self.asteroids[index as usize].alive {
                    @@:return(false)
                }
                @@:self.asteroids[index as usize].alive = false;
                let sz: i32 = @@:self.asteroids[index as usize].size;
                let p: Vector2 = @@:self.asteroids[index as usize].pos;
                if sz > 1 {
                    @@:self.spawn_child(p, sz - 1)
                    @@:self.spawn_child(p, sz - 1)
                }
                @@:(true)
            }

            remove(index: i32) {
                if index < 0 || index as usize >= @@:self.asteroids.len() {
                    return;
                }
                @@:self.asteroids[index as usize].alive = false;
            }

            clear() { @@:self.asteroids.clear(); }

            advance(dt: f32, court_size: Vector2) {
                let mut i: usize = 0;
                while i < @@:self.asteroids.len() {
                    if @@:self.asteroids[i].alive {
                        let mut a = @@:self.asteroids[i];
                        a.pos = a.pos + a.vel * dt;
                        if a.pos.x < 0.0 { a.pos.x = a.pos.x + court_size.x; }
                        if a.pos.x > court_size.x { a.pos.x = a.pos.x - court_size.x; }
                        if a.pos.y < 0.0 { a.pos.y = a.pos.y + court_size.y; }
                        if a.pos.y > court_size.y { a.pos.y = a.pos.y - court_size.y; }
                        @@:self.asteroids[i] = a;
                    }
                    i = i + 1;
                }
            }

            count(): i32 { @@:(@@:self.asteroids.len() as i32) }

            alive_count(): i32 {
                let mut c: i32 = 0;
                let mut i: usize = 0;
                while i < @@:self.asteroids.len() {
                    if @@:self.asteroids[i].alive { c = c + 1; }
                    i = i + 1;
                }
                @@:(c)
            }

            is_alive(index: i32): bool {
                if index < 0 || index as usize >= @@:self.asteroids.len() {
                    @@:return(false)
                }
                @@:(@@:self.asteroids[index as usize].alive)
            }

            position(index: i32): Vector2 {
                if index < 0 || index as usize >= @@:self.asteroids.len() {
                    @@:return(Vector2::ZERO)
                }
                @@:(@@:self.asteroids[index as usize].pos)
            }

            velocity(index: i32): Vector2 {
                if index < 0 || index as usize >= @@:self.asteroids.len() {
                    @@:return(Vector2::ZERO)
                }
                @@:(@@:self.asteroids[index as usize].vel)
            }

            size_of(index: i32): i32 {
                if index < 0 || index as usize >= @@:self.asteroids.len() {
                    @@:return(0)
                }
                @@:(@@:self.asteroids[index as usize].size)
            }

            radius_of(index: i32): f32 {
                if index < 0 || index as usize >= @@:self.asteroids.len() {
                    @@:return(0.0)
                }
                let sz: i32 = @@:self.asteroids[index as usize].size;
                if sz == 3 { @@:return(32.0) }
                if sz == 2 { @@:return(18.0) }
                @@:(10.0)
            }
        }

    actions:

        spawn_large(court_size: Vector2) {
            let edge: i32 = (godot::global::randi() % 4) as i32;
            let mut pos: Vector2 = Vector2::ZERO;
            if edge == 0 {
                pos = Vector2::new(0.0, rf() * court_size.y);
            } else if edge == 1 {
                pos = Vector2::new(court_size.x, rf() * court_size.y);
            } else if edge == 2 {
                pos = Vector2::new(rf() * court_size.x, 0.0);
            } else {
                pos = Vector2::new(rf() * court_size.x, court_size.y);
            }
            let angle: f32 = rf() * std::f32::consts::TAU;
            let speed: f32 = 40.0 + rf() * 30.0;
            let vel: Vector2 = Vector2::from_angle(angle) * speed;
            @@:self.asteroids.push(Asteroid { pos: pos, vel: vel, size: 3, alive: true });
        }

        spawn_child(pos: Vector2, size: i32) {
            let angle: f32 = rf() * std::f32::consts::TAU;
            let speed: f32 = 60.0 + rf() * 40.0 + ((3 - size) as f32) * 20.0;
            let vel: Vector2 = Vector2::from_angle(angle) * speed;
            @@:self.asteroids.push(Asteroid { pos: pos, vel: vel, size: size, alive: true });
        }

    domain:
        asteroids: Vec<Asteroid> = Vec::new()
}

// ------------------------------------------------------------ AsteroidsGame
@@[main]
// Note: difficulty first, ship_host last — Rust has no trailing-default
// constraint, so the param order is free (the C++ port had to flip them).
@@system AsteroidsGame(difficulty: i32, ship_host: Gd<Node>) {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }
        get_bullets_in_flight(): i32 { @@:(@@:self.bullets_in_flight) }
        get_max_bullets(): i32       { @@:(@@:self.max_bullets) }

    interface:
        start()
        restart()
        pause()
        resume()
        tick(dt: f32, court_size: Vector2)
        ship_hit_asteroid(index: i32)
        bullet_hit_asteroid(index: i32)
        ship_hyperspace()
        bullet_fired()
        bullet_expired()
        get_score(): i32
        get_lives(): i32
        get_wave(): i32
        get_difficulty(): i32
        is_paused(): bool

    machine:

        $Attract {
            $>() {
                @@:self.score = 0;
                @@:self.wave = 1;
                @@:self.bullets_in_flight = 0;
            }
            start() {
                @@:self.ship.respawn();
                let n: i32 = @@:self.asteroids_for_wave(1);
                @@:self.field.spawn_wave(n, @@:self.last_court_size);
                -> $Playing
            }
            get_score(): i32        { @@:(@@:self.score) }
            get_lives(): i32        { @@:(@@:self.ship.get_lives()) }
            get_wave(): i32         { @@:(@@:self.wave) }
            get_difficulty(): i32   { @@:(@@:self.difficulty) }
            is_paused(): bool       { @@:(false) }
        }

        $InGame {
            pause() {
                push$ -> $Paused
            }
            bullet_fired() {
                @@:self.bullets_in_flight = @@:self.bullets_in_flight + 1;
            }
            bullet_expired() {
                if @@:self.bullets_in_flight > 0 {
                    @@:self.bullets_in_flight = @@:self.bullets_in_flight - 1;
                }
            }
            get_score(): i32        { @@:(@@:self.score) }
            get_lives(): i32        { @@:(@@:self.ship.get_lives()) }
            get_wave(): i32         { @@:(@@:self.wave) }
            get_difficulty(): i32   { @@:(@@:self.difficulty) }
            is_paused(): bool       { @@:(false) }
        }

        $Playing => $InGame {
            tick(dt: f32, court_size: Vector2) {
                @@:self.last_court_size = court_size;
                @@:self.ship.tick(dt);
                @@:self.field.advance(dt, court_size);
            }
            ship_hit_asteroid(index: i32) {
                if !@@:self.ship.can_be_hit() {
                    return;
                }
                @@:self.ship.hit();
                -> $ShipDying
            }
            bullet_hit_asteroid(index: i32) {
                if @@:self.field.split(index) {
                    let sz: i32 = @@:self.size_points(index);
                    @@:self.score = @@:self.score + sz * @@:self.difficulty;
                    if @@:self.field.alive_count() <= 0 {
                        -> "all asteroids cleared" $WaveClear
                    }
                }
            }
            ship_hyperspace() {
                @@:self.ship.hyperspace();
            }
            => $^
        }

        $ShipDying => $InGame {
            tick(dt: f32, court_size: Vector2) {
                @@:self.last_court_size = court_size;
                @@:self.ship.tick(dt);
                @@:self.field.advance(dt, court_size);
                if @@:self.ship.get_current_state_name() == "Respawning" {
                    -> "ship respawning" $Playing
                } else if @@:self.ship.get_current_state_name() == "Dead" {
                    -> "no lives left" $GameOver
                }
            }
            => $^
        }

        $WaveClear => $InGame {
            $>() { @@:self.wave_timer = 0.0; }
            tick(dt: f32, court_size: Vector2) {
                @@:self.last_court_size = court_size;
                @@:self.ship.tick(dt);
                @@:self.wave_timer = @@:self.wave_timer + dt;
                if @@:self.wave_timer >= @@:self.wave_pause {
                    @@:self.wave = @@:self.wave + 1;
                    let n: i32 = @@:self.asteroids_for_wave(@@:self.wave);
                    @@:self.field.spawn_wave(n, court_size);
                    -> "next wave" $Playing
                }
            }
            => $^
        }

        $Paused {
            resume() {
                -> pop$
            }
            get_score(): i32        { @@:(@@:self.score) }
            get_lives(): i32        { @@:(@@:self.ship.get_lives()) }
            get_wave(): i32         { @@:(@@:self.wave) }
            get_difficulty(): i32   { @@:(@@:self.difficulty) }
            is_paused(): bool       { @@:(true) }
        }

        $GameOver {
            restart() {
                -> $Attract
            }
            get_score(): i32        { @@:(@@:self.score) }
            get_lives(): i32        { @@:(@@:self.ship.get_lives()) }
            get_wave(): i32         { @@:(@@:self.wave) }
            get_difficulty(): i32   { @@:(@@:self.difficulty) }
            is_paused(): bool       { @@:(false) }
        }

    actions:

        asteroids_for_wave(wave: i32): i32 {
            let base: i32 = 2 + @@:self.difficulty;
            return base + wave - 1;
        }

        size_points(index: i32): i32 {
            let sz: i32 = @@:self.field.size_of(index);
            if sz == 3 { return 20; }
            if sz == 2 { return 50; }
            return 100;
        }

    domain:
        difficulty: i32 = difficulty
        score: i32 = 0
        wave: i32 = 1
        wave_timer: f32 = 0.0
        wave_pause: f32 = 2.0
        bullets_in_flight: i32 = 0
        max_bullets: i32 = 4
        last_court_size: Vector2 = Vector2::new(640.0, 480.0)
        ship: Ship = @@Ship(ship_host)
        field: AsteroidField = @@AsteroidField()
}
