@@[target("kotlin")]

// Space Invaders — Kotlin port of the canonical controller
// (games/invaders/src/invaders.fjs). Same three systems (Player / Fleet /
// Invaders), the $InGame HSM parent, push$/pop$ pause, owned children.
// Bodies are native C#; doubles for all timers so dt=1/64 math matches the
// JS baseline bit-for-bit. NOTE the pace recompute casts to Double —
// `live / total_invaders` is Int/Int and would floor to 0 otherwise.

@@system Player {

    interface:
        tick(dt: Double)
        hit()
        respawn()
        can_fire(): Boolean
        can_be_hit(): Boolean
        is_alive(): Boolean
        get_state(): String
        get_lives(): Int

    machine:
        $Alive {
            hit() { -> $Exploding }
            can_fire(): Boolean    { @@:(true) }
            can_be_hit(): Boolean  { @@:(true) }
            is_alive(): Boolean    { @@:(true) }
            get_state(): String { @@:("alive") }
            get_lives(): Int    { @@:(@@:self.lives_remaining) }
        }

        $Exploding {
            $.timer: Double = 0.0
            $.duration: Double = 1.2

            tick(dt: Double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.duration) {
                    @@:self.lives_remaining = @@:self.lives_remaining - 1;
                    if (@@:self.lives_remaining <= 0) {
                        -> $Dead
                    } else {
                        -> $Invulnerable
                    }
                }
            }

            can_fire(): Boolean    { @@:(false) }
            can_be_hit(): Boolean  { @@:(false) }
            is_alive(): Boolean    { @@:(false) }
            get_state(): String { @@:("exploding") }
            get_lives(): Int    { @@:(@@:self.lives_remaining) }
        }

        $Invulnerable {
            $.timer: Double = 0.0
            $.duration: Double = 1.5

            tick(dt: Double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.duration) {
                    -> $Alive
                }
            }

            can_fire(): Boolean    { @@:(true) }
            can_be_hit(): Boolean  { @@:(false) }
            is_alive(): Boolean    { @@:(true) }
            get_state(): String { @@:("invulnerable") }
            get_lives(): Int    { @@:(@@:self.lives_remaining) }
        }

        $Dead {
            respawn() {
                @@:self.lives_remaining = @@:self.starting_lives;
                -> $Alive
            }

            can_fire(): Boolean    { @@:(false) }
            can_be_hit(): Boolean  { @@:(false) }
            is_alive(): Boolean    { @@:(false) }
            get_state(): String { @@:("dead") }
            get_lives(): Int    { @@:(@@:self.lives_remaining) }
        }

    domain:
        lives_remaining: Int = 3
        starting_lives: Int = 3
}

@@system Fleet {

    interface:
        tick(dt: Double)
        kill_invader(index: Int): Boolean
        reset(rows: Int, cols: Int)
        edge_reached()
        consume_step(): Boolean
        wants_to_step(): Boolean
        get_state(): String
        get_direction(): Int
        get_step_interval(): Double
        is_alive(index: Int): Boolean
        alive_count(): Int
        lowest_row(): Int
        cols(): Int
        rows(): Int
        total(): Int

    machine:
        $Marching {
            $.timer: Double = 0.0

            tick(dt: Double) {
                $.timer = $.timer + dt;
            }

            reset(rows: Int, cols: Int) {
                @@:self._do_reset(rows, cols);
                $.timer = 0.0;
            }

            kill_invader(index: Int): Boolean {
                if (@@:self._do_kill(index)) {
                    if (@@:self._count_alive() == 0) {
                        -> $Defeated
                        @@:return(true)
                    }
                    @@:return(true)
                }
                @@:(false)
            }

            edge_reached() {
                @@:self.pending_step = true;
                -> $Stepping
            }

            consume_step(): Boolean {
                if ($.timer >= @@:self.step_interval) {
                    $.timer = 0.0;
                    @@:return(true)
                }
                @@:(false)
            }

            wants_to_step(): Boolean       { @@:($.timer >= @@:self.step_interval) }
            get_state(): String         { @@:("marching") }
            get_direction(): Int        { @@:(@@:self.direction) }
            get_step_interval(): Double { @@:(@@:self.step_interval) }
            is_alive(index: Int): Boolean  { @@:(@@:self._is_alive(index)) }
            alive_count(): Int          { @@:(@@:self._count_alive()) }
            lowest_row(): Int           { @@:(@@:self._lowest_row()) }
            cols(): Int                 { @@:(@@:self.grid_cols) }
            rows(): Int                 { @@:(@@:self.grid_rows) }
            total(): Int                { @@:(@@:self.grid_rows * @@:self.grid_cols) }
        }

        $Stepping {
            $>() {
                @@:self.direction = -@@:self.direction;
                @@:self.pending_step = false;
            }

            tick(dt: Double) {
                -> $Marching
            }

            kill_invader(index: Int): Boolean {
                if (@@:self._do_kill(index)) {
                    if (@@:self._count_alive() == 0) {
                        -> $Defeated
                        @@:return(true)
                    }
                    @@:return(true)
                }
                @@:(false)
            }

            consume_step(): Boolean        { @@:(false) }
            wants_to_step(): Boolean       { @@:(false) }
            get_state(): String         { @@:("stepping") }
            get_direction(): Int        { @@:(@@:self.direction) }
            get_step_interval(): Double { @@:(@@:self.step_interval) }
            is_alive(index: Int): Boolean  { @@:(@@:self._is_alive(index)) }
            alive_count(): Int          { @@:(@@:self._count_alive()) }
            lowest_row(): Int           { @@:(@@:self._lowest_row()) }
            cols(): Int                 { @@:(@@:self.grid_cols) }
            rows(): Int                 { @@:(@@:self.grid_rows) }
            total(): Int                { @@:(@@:self.grid_rows * @@:self.grid_cols) }
        }

        $Defeated {
            reset(rows: Int, cols: Int) {
                @@:self._do_reset(rows, cols);
                -> $Marching
            }

            consume_step(): Boolean        { @@:(false) }
            wants_to_step(): Boolean       { @@:(false) }
            get_state(): String         { @@:("defeated") }
            get_direction(): Int        { @@:(@@:self.direction) }
            get_step_interval(): Double { @@:(@@:self.step_interval) }
            is_alive(index: Int): Boolean  { @@:(false) }
            alive_count(): Int          { @@:(0) }
            lowest_row(): Int           { @@:(-1) }
            cols(): Int                 { @@:(@@:self.grid_cols) }
            rows(): Int                 { @@:(@@:self.grid_rows) }
            total(): Int                { @@:(@@:self.grid_rows * @@:self.grid_cols) }
        }

    actions:
        _do_reset(rows: Int, cols: Int) {
            @@:self.grid_rows = rows;
            @@:self.grid_cols = cols;
            @@:self.alive = mutableListOf<Boolean>();
            val total = rows * cols
            var i = 0
            while (i < total) {
                @@:self.alive.add(true);
                i = i + 1;
            }
            @@:self.direction = 1;
            @@:self.step_interval = @@:self.initial_step_interval;
            @@:self.total_invaders = total;
        }

        _do_kill(index: Int): Boolean {
            if (index < 0 || index >= @@:self.alive.size) {
                return false;
            }
            if (!@@:self.alive[index]) {
                return false;
            }
            @@:self.alive[index] = false;
            @@:self._update_pace();
            return true;
        }

        _is_alive(index: Int): Boolean {
            if (index < 0 || index >= @@:self.alive.size) {
                return false;
            }
            return @@:self.alive[index];
        }

        _count_alive(): Int {
            var c = 0
            var i = 0
            while (i < @@:self.alive.size) {
                if (@@:self.alive[i]) {
                    c = c + 1;
                }
                i = i + 1;
            }
            return c;
        }

        _lowest_row(): Int {
            var i = @@:self.alive.size - 1
            while (i >= 0) {
                if (@@:self.alive[i]) {
                    return i / @@:self.grid_cols;
                }
                i = i - 1;
            }
            return -1;
        }

        _update_pace() {
            if (@@:self.total_invaders <= 0) {
                return;
            }
            val live = @@:self._count_alive()
            val frac = live.toDouble() / @@:self.total_invaders;
            @@:self.step_interval = @@:self.min_step_interval + (@@:self.initial_step_interval - @@:self.min_step_interval) * frac;
        }

    domain:
        alive: MutableList<Boolean> = mutableListOf<Boolean>()
        grid_rows: Int = 5
        grid_cols: Int = 11
        total_invaders: Int = 55
        direction: Int = 1
        step_interval: Double = 0.6
        initial_step_interval: Double = 0.6
        min_step_interval: Double = 0.06
        pending_step: Boolean = false
}

@@[main]
@@system Invaders {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }

    interface:
        start()
        restart()
        pause()
        resume()
        tick(dt: Double)
        player_killed_invader(index: Int)
        player_hit()
        fleet_reached_edge()
        fleet_reached_bottom()
        get_state(): String
        get_score(): Int
        get_lives(): Int
        get_wave(): Int
        is_paused(): Boolean

    machine:
        $Attract {
            $>() {
                @@:self.score = 0;
                @@:self.wave = 1;
            }

            start() {
                @@:self.player.respawn();
                @@:self.fleet.reset(@@:self.fleet_rows, @@:self.fleet_cols);
                -> $Playing
            }

            get_state(): String { @@:("attract") }
            get_score(): Int    { @@:(@@:self.score) }
            get_lives(): Int    { @@:(@@:self.player.get_lives()) }
            get_wave(): Int     { @@:(@@:self.wave) }
            is_paused(): Boolean   { @@:(false) }
        }

        $InGame {
            pause() {
                push$ -> $Paused
            }

            get_state(): String { @@:("in_game") }
            get_score(): Int    { @@:(@@:self.score) }
            get_lives(): Int    { @@:(@@:self.player.get_lives()) }
            get_wave(): Int     { @@:(@@:self.wave) }
            is_paused(): Boolean   { @@:(false) }
        }

        $Playing => $InGame {
            tick(dt: Double) {
                @@:self.player.tick(dt);
                @@:self.fleet.tick(dt);
            }

            player_killed_invader(index: Int) {
                if (@@:self.fleet.kill_invader(index)) {
                    @@:self.score = @@:self.score + @@:self.points_per_invader;
                    if (@@:self.fleet.alive_count() <= 0) {
                        -> $WaveComplete
                    }
                }
            }

            player_hit() {
                if (@@:self.player.can_be_hit()) {
                    @@:self.player.hit();
                    -> $PlayerDying
                }
            }

            fleet_reached_edge() {
                @@:self.fleet.edge_reached();
            }

            fleet_reached_bottom() {
                -> $GameOver
            }

            get_state(): String { @@:("playing") }
            => $^
        }

        $PlayerDying => $InGame {
            tick(dt: Double) {
                @@:self.player.tick(dt);
                @@:self.fleet.tick(dt);
                if (@@:self.player.get_state() == "invulnerable") {
                    -> $Playing
                } else if (@@:self.player.get_state() == "dead") {
                    -> $GameOver
                }
            }

            fleet_reached_edge() {
                @@:self.fleet.edge_reached();
            }

            fleet_reached_bottom() {
                -> $GameOver
            }

            get_state(): String { @@:("player_dying") }
            => $^
        }

        $WaveComplete => $InGame {
            $>() {
                @@:self.wave_timer = 0.0;
            }

            tick(dt: Double) {
                @@:self.wave_timer = @@:self.wave_timer + dt;
                if (@@:self.wave_timer >= @@:self.wave_pause) {
                    @@:self.wave = @@:self.wave + 1;
                    @@:self.fleet.reset(@@:self.fleet_rows, @@:self.fleet_cols);
                    -> $Playing
                }
            }

            get_state(): String { @@:("wave_complete") }
            => $^
        }

        $Paused {
            resume() {
                -> pop$
            }

            get_state(): String { @@:("paused") }
            get_score(): Int    { @@:(@@:self.score) }
            get_lives(): Int    { @@:(@@:self.player.get_lives()) }
            get_wave(): Int     { @@:(@@:self.wave) }
            is_paused(): Boolean   { @@:(true) }
        }

        $GameOver {
            restart() {
                -> $Attract
            }

            get_state(): String { @@:("game_over") }
            get_score(): Int    { @@:(@@:self.score) }
            get_lives(): Int    { @@:(@@:self.player.get_lives()) }
            get_wave(): Int     { @@:(@@:self.wave) }
            is_paused(): Boolean   { @@:(false) }
        }

    domain:
        score: Int = 0
        wave: Int = 1
        wave_timer: Double = 0.0
        wave_pause: Double = 2.0
        fleet_rows: Int = 5
        fleet_cols: Int = 11
        points_per_invader: Int = 10
        player: Player = @@Player()
        fleet: Fleet = @@Fleet()
}
