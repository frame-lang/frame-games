@@[target("rust")]

// Side-scrolling shooter — Rust port of the canonical capstone controller
// (games/shooter/src/shooter.fjs, which mirrors the Godot ch07 reference).
// Same four systems (Player / Enemy / Boss / Shooter), states, transitions,
// the parameterized Enemy(kind, hp, fire_rate, points), the three-phase Boss
// HSM (phase parents own hit()/thresholds; idle/fire leaves), the owned
// player/boss + driver-populated enemies list, and the push$/pop$ pause.
// Bodies are native Rust; f64 timers so the oracle's dt=1/64 arithmetic
// matches the JS baseline bit-for-bit. Per framec E616, enemy instances
// cross the interface as Rc<RefCell<Enemy>>; Vec::remove in
// _cleanup_enemies drops the LAST strong reference — the RefCell'd live
// machine is dropped mid-run, Rust's counterpart of C's Enemy_destroy
// (which ASan proved clean).

use std::rc::Rc;
use std::cell::RefCell;

// ------------------------------------------------------------ Player
@@system Player {

    interface:
        tick(dt: f64)
        hit()
        respawn()
        can_fire(): bool
        can_be_hit(): bool
        is_visible(): bool
        get_state(): String
        get_lives(): i32

    machine:
        $Alive {
            hit() { -> $Exploding }

            can_fire(): bool    { @@:(true) }
            can_be_hit(): bool  { @@:(true) }
            is_visible(): bool  { @@:(true) }
            get_state(): String { @@:("alive".to_string()) }
            get_lives(): i32    { @@:(@@:self.lives) }
        }

        $Exploding {
            $.timer: f64 = 0.0
            $.duration: f64 = 1.0

            tick(dt: f64) {
                $.timer = $.timer + dt;
                if $.timer >= $.duration {
                    @@:self.lives = @@:self.lives - 1;
                    if @@:self.lives <= 0 {
                        -> $Dead
                    } else {
                        -> $Invulnerable
                    }
                }
            }

            can_fire(): bool    { @@:(false) }
            can_be_hit(): bool  { @@:(false) }
            is_visible(): bool  { @@:(true) }
            get_state(): String { @@:("exploding".to_string()) }
            get_lives(): i32    { @@:(@@:self.lives) }
        }

        $Invulnerable {
            $.timer: f64 = 0.0
            $.duration: f64 = 2.0

            tick(dt: f64) {
                $.timer = $.timer + dt;
                if $.timer >= $.duration {
                    -> $Alive
                }
            }

            can_fire(): bool    { @@:(true) }
            can_be_hit(): bool  { @@:(false) }
            is_visible(): bool  { @@:(true) }
            get_state(): String { @@:("invulnerable".to_string()) }
            get_lives(): i32    { @@:(@@:self.lives) }
        }

        $Dead {
            respawn() {
                @@:self.lives = @@:self.starting_lives;
                -> $Alive
            }

            can_fire(): bool    { @@:(false) }
            can_be_hit(): bool  { @@:(false) }
            is_visible(): bool  { @@:(false) }
            get_state(): String { @@:("dead".to_string()) }
            get_lives(): i32    { @@:(0) }
        }

    domain:
        lives: i32 = 3
        starting_lives: i32 = 3
}

// ------------------------------------------------------------ Enemy
@@system Enemy(kind: i32, hp: i32, fire_rate: f64, points: i32) {

    interface:
        tick(dt: f64)
        hit(damage: i32)
        get_state(): String
        get_kind(): i32
        get_hp(): i32
        get_points(): i32
        wants_to_fire(): bool
        consume_fire()
        is_alive(): bool
        is_cleanup(): bool

    machine:
        $Spawning {
            $.timer: f64 = 0.0
            $.duration: f64 = 0.5

            tick(dt: f64) {
                $.timer = $.timer + dt;
                if $.timer >= $.duration {
                    -> $Active
                }
            }

            hit(damage: i32) {
            }

            get_state(): String { @@:("spawning".to_string()) }
            get_kind(): i32     { @@:(@@:self.ekind) }
            get_hp(): i32       { @@:(@@:self.hp_remaining) }
            get_points(): i32   { @@:(@@:self.pts) }
            wants_to_fire(): bool { @@:(false) }
            consume_fire()      { }
            is_alive(): bool    { @@:(true) }
            is_cleanup(): bool  { @@:(false) }
        }

        $Active {
            $.fire_timer: f64 = 0.0

            tick(dt: f64) {
                if @@:self.rate > 0.0 {
                    $.fire_timer = $.fire_timer + dt;
                }
            }

            hit(damage: i32) {
                @@:self.hp_remaining = @@:self.hp_remaining - damage;
                if @@:self.hp_remaining <= 0 {
                    -> $Dying
                }
            }

            get_state(): String { @@:("active".to_string()) }
            get_kind(): i32     { @@:(@@:self.ekind) }
            get_hp(): i32       { @@:(@@:self.hp_remaining) }
            get_points(): i32   { @@:(@@:self.pts) }
            wants_to_fire(): bool {
                if @@:self.rate <= 0.0 {
                    @@:return(false)
                }
                @@:($.fire_timer >= @@:self.rate)
            }
            consume_fire()      { $.fire_timer = 0.0; }
            is_alive(): bool    { @@:(true) }
            is_cleanup(): bool  { @@:(false) }
        }

        $Dying {
            $.timer: f64 = 0.0
            $.duration: f64 = 0.4

            tick(dt: f64) {
                $.timer = $.timer + dt;
                if $.timer >= $.duration {
                    -> $Gone
                }
            }

            hit(damage: i32) {
            }

            get_state(): String { @@:("dying".to_string()) }
            get_kind(): i32     { @@:(@@:self.ekind) }
            get_hp(): i32       { @@:(0) }
            get_points(): i32   { @@:(@@:self.pts) }
            wants_to_fire(): bool { @@:(false) }
            consume_fire()      { }
            is_alive(): bool    { @@:(false) }
            is_cleanup(): bool  { @@:(false) }
        }

        $Gone {
            get_state(): String { @@:("gone".to_string()) }
            get_kind(): i32     { @@:(@@:self.ekind) }
            get_hp(): i32       { @@:(0) }
            get_points(): i32   { @@:(@@:self.pts) }
            wants_to_fire(): bool { @@:(false) }
            consume_fire()      { }
            is_alive(): bool    { @@:(false) }
            is_cleanup(): bool  { @@:(true) }
        }

    domain:
        ekind: i32 = kind
        hp_remaining: i32 = hp
        rate: f64 = fire_rate
        pts: i32 = points
}

// ------------------------------------------------------------ Boss
@@system Boss {

    interface:
        tick(dt: f64)
        hit(damage: i32)
        get_phase(): i32
        get_hp(): i32
        get_hp_fraction(): f64
        get_state(): String
        is_alive(): bool
        is_dying(): bool
        is_gone(): bool
        wants_to_fire_single(): bool
        wants_to_fire_spread(): bool
        wants_to_fire_spray(): bool
        consume_fire()

    machine:
        $P1Idle => $PhaseOne {
            $.timer: f64 = 0.0
            $.idle_duration: f64 = 1.8

            tick(dt: f64) {
                $.timer = $.timer + dt;
                if $.timer >= $.idle_duration {
                    -> $P1Firing
                }
            }

            get_state(): String { @@:("p1_idle".to_string()) }
            => $^
        }

        $PhaseOne {
            hit(damage: i32) {
                @@:self.hp = @@:self.hp - damage;
                if (@@:self.hp as f64) <= (@@:self.hp_start as f64) * 0.66 {
                    -> $P2Idle
                } else if @@:self.hp <= 0 {
                    -> $Dying
                }
            }

            get_phase(): i32        { @@:(1) }
            get_hp(): i32           { @@:(@@:self.hp) }
            get_hp_fraction(): f64 { @@:(@@:self.hp as f64 / @@:self.hp_start as f64) }
            get_state(): String     { @@:("phase_one".to_string()) }
            is_alive(): bool        { @@:(true) }
            is_dying(): bool        { @@:(false) }
            is_gone(): bool         { @@:(false) }
            wants_to_fire_single(): bool  { @@:(false) }
            wants_to_fire_spread(): bool  { @@:(false) }
            wants_to_fire_spray(): bool   { @@:(false) }
            consume_fire()          { }
        }

        $P1Firing => $PhaseOne {
            $.timer: f64 = 0.0
            $.duration: f64 = 0.4
            $.fired: bool = false

            tick(dt: f64) {
                $.timer = $.timer + dt;
                if $.timer >= $.duration {
                    -> $P1Idle
                }
            }

            wants_to_fire_single(): bool {
                if $.fired {
                    @@:return(false)
                }
                @@:(true)
            }
            consume_fire() { $.fired = true; }

            get_state(): String { @@:("p1_firing".to_string()) }
            => $^
        }

        $PhaseTwo {
            hit(damage: i32) {
                @@:self.hp = @@:self.hp - damage;
                if (@@:self.hp as f64) <= (@@:self.hp_start as f64) * 0.33 {
                    -> $P3Idle
                } else if @@:self.hp <= 0 {
                    -> $Dying
                }
            }

            get_phase(): i32        { @@:(2) }
            get_hp(): i32           { @@:(@@:self.hp) }
            get_hp_fraction(): f64 { @@:(@@:self.hp as f64 / @@:self.hp_start as f64) }
            get_state(): String     { @@:("phase_two".to_string()) }
            is_alive(): bool        { @@:(true) }
            is_dying(): bool        { @@:(false) }
            is_gone(): bool         { @@:(false) }
            wants_to_fire_single(): bool  { @@:(false) }
            wants_to_fire_spread(): bool  { @@:(false) }
            wants_to_fire_spray(): bool   { @@:(false) }
            consume_fire()          { }
        }

        $P2Idle => $PhaseTwo {
            $.timer: f64 = 0.0
            $.idle_duration: f64 = 1.3

            tick(dt: f64) {
                $.timer = $.timer + dt;
                if $.timer >= $.idle_duration {
                    -> $P2Spread
                }
            }

            get_state(): String { @@:("p2_idle".to_string()) }
            => $^
        }

        $P2Spread => $PhaseTwo {
            $.timer: f64 = 0.0
            $.duration: f64 = 0.5
            $.fired: bool = false

            tick(dt: f64) {
                $.timer = $.timer + dt;
                if $.timer >= $.duration {
                    -> $P2Idle
                }
            }

            wants_to_fire_spread(): bool {
                if $.fired {
                    @@:return(false)
                }
                @@:(true)
            }
            consume_fire() { $.fired = true; }

            get_state(): String { @@:("p2_spread".to_string()) }
            => $^
        }

        $PhaseThree {
            hit(damage: i32) {
                @@:self.hp = @@:self.hp - damage;
                if @@:self.hp <= 0 {
                    -> $Dying
                }
            }

            get_phase(): i32        { @@:(3) }
            get_hp(): i32           { @@:(@@:self.hp) }
            get_hp_fraction(): f64 { @@:(@@:self.hp as f64 / @@:self.hp_start as f64) }
            get_state(): String     { @@:("phase_three".to_string()) }
            is_alive(): bool        { @@:(true) }
            is_dying(): bool        { @@:(false) }
            is_gone(): bool         { @@:(false) }
            wants_to_fire_single(): bool  { @@:(false) }
            wants_to_fire_spread(): bool  { @@:(false) }
            wants_to_fire_spray(): bool   { @@:(false) }
            consume_fire()          { }
        }

        $P3Idle => $PhaseThree {
            $.timer: f64 = 0.0
            $.idle_duration: f64 = 0.6

            tick(dt: f64) {
                $.timer = $.timer + dt;
                if $.timer >= $.idle_duration {
                    -> $P3Spray
                }
            }

            get_state(): String { @@:("p3_idle".to_string()) }
            => $^
        }

        $P3Spray => $PhaseThree {
            $.timer: f64 = 0.0
            $.duration: f64 = 0.8
            $.fire_accumulator: f64 = 0.0
            $.fire_ready: bool = false

            tick(dt: f64) {
                $.timer = $.timer + dt;
                $.fire_accumulator = $.fire_accumulator + dt;
                if $.fire_accumulator >= 0.12 {
                    $.fire_accumulator = 0.0;
                    $.fire_ready = true;
                }
                if $.timer >= $.duration {
                    -> $P3Idle
                }
            }

            wants_to_fire_spray(): bool {
                @@:($.fire_ready)
            }
            consume_fire() { $.fire_ready = false; }

            get_state(): String { @@:("p3_spray".to_string()) }
            => $^
        }

        $Dying {
            $.timer: f64 = 0.0
            $.duration: f64 = 2.5

            tick(dt: f64) {
                $.timer = $.timer + dt;
                if $.timer >= $.duration {
                    -> $Gone
                }
            }

            hit(damage: i32) {
            }

            get_phase(): i32        { @@:(0) }
            get_hp(): i32           { @@:(0) }
            get_hp_fraction(): f64 { @@:(0.0) }
            get_state(): String     { @@:("dying".to_string()) }
            is_alive(): bool        { @@:(false) }
            is_dying(): bool        { @@:(true) }
            is_gone(): bool         { @@:(false) }
            wants_to_fire_single(): bool  { @@:(false) }
            wants_to_fire_spread(): bool  { @@:(false) }
            wants_to_fire_spray(): bool   { @@:(false) }
            consume_fire()          { }
        }

        $Gone {
            get_phase(): i32        { @@:(0) }
            get_hp(): i32           { @@:(0) }
            get_hp_fraction(): f64 { @@:(0.0) }
            get_state(): String     { @@:("gone".to_string()) }
            is_alive(): bool        { @@:(false) }
            is_dying(): bool        { @@:(false) }
            is_gone(): bool         { @@:(true) }
            wants_to_fire_single(): bool  { @@:(false) }
            wants_to_fire_spread(): bool  { @@:(false) }
            wants_to_fire_spray(): bool   { @@:(false) }
            consume_fire()          { }
        }

    domain:
        hp: i32 = 90
        hp_start: i32 = 90
}

// ------------------------------------------------------------ Shooter
@@[main]
@@system Shooter {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }

    interface:
        start()
        restart()
        tick(dt: f64)

        add_enemy(e: Rc<RefCell<Enemy>>)
        clear_dead_enemies()

        player_hit()
        enemy_hit(index: i32, damage: i32): bool
        boss_hit(damage: i32): bool

        get_state(): String
        get_score(): i32
        get_lives(): i32
        enemy_count(): i32
        should_spawn_wave(): bool
        consume_wave()
        should_spawn_boss(): bool
        consume_boss_spawn()

        pause()
        resume()

    machine:
        $Attract {
            $>() {
                @@:self.score = 0;
                @@:self.waves_spawned = 0;
                @@:self.wave_timer = 0.0;
                @@:self.boss_spawn_pending = false;
            }

            start() {
                @@:self.player.respawn();
                -> $Playing
            }

            get_state(): String         { @@:("attract".to_string()) }
            get_score(): i32            { @@:(@@:self.score) }
            get_lives(): i32            { @@:(@@:self.player.get_lives()) }
            enemy_count(): i32          { @@:(@@:self.enemies.len() as i32) }
            should_spawn_wave(): bool   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): bool   { @@:(false) }
            consume_boss_spawn()        { }
        }

        $Playing {
            tick(dt: f64) {
                @@:self.player.tick(dt);
                @@:self._tick_enemies(dt);
                @@:self.wave_timer = @@:self.wave_timer + dt;

                if @@:self.player.get_state() == "dead" {
                    -> $GameOver
                }

                if @@:self.waves_spawned >= @@:self.waves_before_boss {
                    -> $BossFight
                }
            }

            add_enemy(e: Rc<RefCell<Enemy>>) {
                @@:self.enemies.push(e);
            }

            clear_dead_enemies() {
                @@:self._cleanup_enemies();
            }

            player_hit() {
                if @@:self.player.can_be_hit() {
                    @@:self.player.hit();
                }
            }

            enemy_hit(index: i32, damage: i32): bool {
                if index < 0 || index >= @@:self.enemies.len() as i32 {
                    @@:return(false)
                }
                @@:self.enemies[index as usize].borrow_mut().hit(damage);
                if !@@:self.enemies[index as usize].borrow_mut().is_alive() {
                    @@:self.score = @@:self.score + @@:self.enemies[index as usize].borrow_mut().get_points();
                    @@:return(true)
                }
                @@:(false)
            }

            boss_hit(damage: i32): bool {
                @@:(false)
            }

            should_spawn_wave(): bool {
                @@:(@@:self.wave_timer >= @@:self.wave_interval)
            }

            consume_wave() {
                @@:self.wave_timer = 0.0;
                @@:self.waves_spawned = @@:self.waves_spawned + 1;
            }

            should_spawn_boss(): bool { @@:(false) }
            consume_boss_spawn()      { }

            pause() {
                push$ -> $Paused
            }

            get_state(): String { @@:("playing".to_string()) }
            get_score(): i32    { @@:(@@:self.score) }
            get_lives(): i32    { @@:(@@:self.player.get_lives()) }
            enemy_count(): i32  { @@:(@@:self.enemies.len() as i32) }
        }

        $BossFight {
            $>() {
                @@:self.boss_spawn_pending = true;
            }

            tick(dt: f64) {
                @@:self.player.tick(dt);
                @@:self._tick_enemies(dt);
                @@:self.boss.tick(dt);

                if @@:self.player.get_state() == "dead" {
                    -> $GameOver
                }

                if @@:self.boss.is_gone() {
                    -> $Victory
                }
            }

            add_enemy(e: Rc<RefCell<Enemy>>) {
                @@:self.enemies.push(e);
            }

            clear_dead_enemies() {
                @@:self._cleanup_enemies();
            }

            player_hit() {
                if @@:self.player.can_be_hit() {
                    @@:self.player.hit();
                }
            }

            enemy_hit(index: i32, damage: i32): bool {
                if index < 0 || index >= @@:self.enemies.len() as i32 {
                    @@:return(false)
                }
                @@:self.enemies[index as usize].borrow_mut().hit(damage);
                if !@@:self.enemies[index as usize].borrow_mut().is_alive() {
                    @@:self.score = @@:self.score + @@:self.enemies[index as usize].borrow_mut().get_points();
                    @@:return(true)
                }
                @@:(false)
            }

            boss_hit(damage: i32): bool {
                @@:self.boss.hit(damage);
                if @@:self.boss.is_dying() || @@:self.boss.is_gone() {
                    @@:(true)
                } else {
                    @@:(false)
                }
            }

            should_spawn_wave(): bool   { @@:(false) }
            consume_wave()              { }

            should_spawn_boss(): bool   { @@:(@@:self.boss_spawn_pending) }
            consume_boss_spawn()        { @@:self.boss_spawn_pending = false; }

            pause() {
                push$ -> $Paused
            }

            get_state(): String { @@:("boss_fight".to_string()) }
            get_score(): i32    { @@:(@@:self.score) }
            get_lives(): i32    { @@:(@@:self.player.get_lives()) }
            enemy_count(): i32  { @@:(@@:self.enemies.len() as i32) }
        }

        $Paused {
            resume() {
                -> pop$
            }

            get_state(): String         { @@:("paused".to_string()) }
            get_score(): i32            { @@:(@@:self.score) }
            get_lives(): i32            { @@:(@@:self.player.get_lives()) }
            enemy_count(): i32          { @@:(@@:self.enemies.len() as i32) }
            should_spawn_wave(): bool   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): bool   { @@:(false) }
            consume_boss_spawn()        { }
        }

        $Victory {
            restart() {
                -> $Attract
            }

            get_state(): String         { @@:("victory".to_string()) }
            get_score(): i32            { @@:(@@:self.score) }
            get_lives(): i32            { @@:(@@:self.player.get_lives()) }
            enemy_count(): i32          { @@:(@@:self.enemies.len() as i32) }
            should_spawn_wave(): bool   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): bool   { @@:(false) }
            consume_boss_spawn()        { }
        }

        $GameOver {
            restart() {
                -> $Attract
            }

            get_state(): String         { @@:("game_over".to_string()) }
            get_score(): i32            { @@:(@@:self.score) }
            get_lives(): i32            { @@:(@@:self.player.get_lives()) }
            enemy_count(): i32          { @@:(@@:self.enemies.len() as i32) }
            should_spawn_wave(): bool   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): bool   { @@:(false) }
            consume_boss_spawn()        { }
        }

    actions:
        _tick_enemies(dt: f64) {
            let mut i: usize = 0;
            while i < @@:self.enemies.len() {
                @@:self.enemies[i].borrow_mut().tick(dt);
                i = i + 1;
            }
        }

        _cleanup_enemies() {
            let mut i: i32 = @@:self.enemies.len() as i32 - 1;
            while i >= 0 {
                if @@:self.enemies[i as usize].borrow_mut().is_cleanup() {
                    @@:self.enemies.remove(i as usize);
                }
                i = i - 1;
            }
        }

    domain:
        score: i32 = 0
        wave_timer: f64 = 0.0
        wave_interval: f64 = 2.0
        waves_spawned: i32 = 0
        waves_before_boss: i32 = 10
        boss_spawn_pending: bool = false
        player: Player = @@Player()
        boss: Boss = @@Boss()
        enemies: Vec<Rc<RefCell<Enemy>>> = Vec::new()
}
