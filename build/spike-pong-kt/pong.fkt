@@[target("kotlin")]

@@system Pong {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }
        get_winning_score(): Int { @@:(@@:self.winning_score) }

    interface:
        start()
        restart()
        launch()
        pause()
        resume()
        tick()
        ball_out_left()
        ball_out_right()
        get_score_left(): Int
        get_score_right(): Int
        get_serve_direction(): Int
        get_winner(): String
        is_playing(): Boolean

    machine:
        $AttractMode {
            $>() {
                @@:self.score_left = 0;
                @@:self.score_right = 0;
                @@:self.winner = "";
            }

            start() { -> $Serving }

            get_score_left(): Int        { @@:(@@:self.score_left) }
            get_score_right(): Int       { @@:(@@:self.score_right) }
            get_serve_direction(): Int   { @@:(@@:self.serving_to) }
            get_winner(): String         { @@:(@@:self.winner) }
            is_playing(): Boolean           { @@:(false) }
        }

        $Serving {
            launch() { -> $InPlay }
            pause() { push$ -> $Paused }

            get_score_left(): Int        { @@:(@@:self.score_left) }
            get_score_right(): Int       { @@:(@@:self.score_right) }
            get_serve_direction(): Int   { @@:(@@:self.serving_to) }
            get_winner(): String         { @@:(@@:self.winner) }
            is_playing(): Boolean           { @@:(false) }
        }

        $InPlay {
            ball_out_left() {
                @@:self.score_right = @@:self.score_right + 1;
                @@:self.last_scorer = "right";
                -> $PointScored
            }

            ball_out_right() {
                @@:self.score_left = @@:self.score_left + 1;
                @@:self.last_scorer = "left";
                -> $PointScored
            }

            pause() { push$ -> $Paused }

            get_score_left(): Int        { @@:(@@:self.score_left) }
            get_score_right(): Int       { @@:(@@:self.score_right) }
            get_serve_direction(): Int   { @@:(@@:self.serving_to) }
            get_winner(): String         { @@:(@@:self.winner) }
            is_playing(): Boolean           { @@:(true) }
        }

        $PointScored {
            $>() {
                if (@@:self.last_scorer == "left") {
                    @@:self.serving_to = 1;
                } else {
                    @@:self.serving_to = -1;
                }

                if (@@:self.score_left >= @@:self.winning_score) {
                    @@:self.winner = "left";
                    -> "left wins" $GameOver
                } else if (@@:self.score_right >= @@:self.winning_score) {
                    @@:self.winner = "right";
                    -> "right wins" $GameOver
                } else {
                    -> "next point" $Serving
                }
            }

            get_score_left(): Int        { @@:(@@:self.score_left) }
            get_score_right(): Int       { @@:(@@:self.score_right) }
            get_serve_direction(): Int   { @@:(@@:self.serving_to) }
            get_winner(): String         { @@:(@@:self.winner) }
            is_playing(): Boolean           { @@:(false) }
        }

        $Paused {
            resume() { -> pop$ }

            get_score_left(): Int        { @@:(@@:self.score_left) }
            get_score_right(): Int       { @@:(@@:self.score_right) }
            get_serve_direction(): Int   { @@:(@@:self.serving_to) }
            get_winner(): String         { @@:(@@:self.winner) }
            is_playing(): Boolean           { @@:(false) }
        }

        $GameOver {
            restart() { -> $AttractMode }

            get_score_left(): Int        { @@:(@@:self.score_left) }
            get_score_right(): Int       { @@:(@@:self.score_right) }
            get_serve_direction(): Int   { @@:(@@:self.serving_to) }
            get_winner(): String         { @@:(@@:self.winner) }
            is_playing(): Boolean           { @@:(false) }
        }

    domain:
        score_left: Int = 0
        score_right: Int = 0
        winning_score: Int = 11
        serving_to: Int = 1
        last_scorer: String = ""
        winner: String = ""
}
