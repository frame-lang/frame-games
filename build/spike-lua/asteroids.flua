@@[target("lua")]

-- Asteroids — Lua/LÖVE port of the Frame controller. Same three systems as the
-- other ports. Lua has no structs, so Vec2 is a plain {x=,y=} table with the
-- helpers below; field indices are 1-based (idiomatic Lua). Host effects are
-- plain functions on a host table (the LÖVE game supplies it).
local function v2(x, y) return {x = x, y = y} end
local function vadd(a, b) return {x = a.x + b.x, y = a.y + b.y} end
local function vscale(a, s) return {x = a.x * s, y = a.y * s} end
local function vfromangle(a, speed) return {x = math.cos(a) * speed, y = math.sin(a) * speed} end
local function rf() return math.random() end

-- ------------------------------------------------------------ Ship
@@system Ship(host: any) {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }
        get_hyperspaces_remaining(): number { @@:(@@:self.hyperspaces_remaining) }

    interface:
        tick(dt: number)
        hit()
        hyperspace()
        respawn()
        fire()
        can_fire(): bool
        can_be_hit(): bool
        can_hyperspace(): bool
        is_visible(): bool
        is_alive(): bool
        get_lives(): number

    machine:

        $Alive {
            $.cooldown: number = 0.0
            tick(dt: number) {
                if $.cooldown > 0.0 {
                    $.cooldown = $.cooldown - dt
                }
            }
            fire() { $.cooldown = 0.22 }
            hit() { -> $Exploding }
            hyperspace() {
                if @@:self.hyperspaces_remaining > 0 {
                    @@:self.hyperspaces_remaining = @@:self.hyperspaces_remaining - 1
                    -> $InHyperspace
                }
            }
            can_fire(): bool       { @@:($.cooldown <= 0.0) }
            can_be_hit(): bool     { @@:(true) }
            can_hyperspace(): bool { @@:(@@:self.hyperspaces_remaining > 0) }
            is_visible(): bool     { @@:(true) }
            is_alive(): bool       { @@:(true) }
            get_lives(): number    { @@:(@@:self.lives_remaining) }
        }

        $InHyperspace {
            $.timer: number = 0.0
            $.duration: number = 0.4
            $>() { @@:self.host.warp_out() }
            <$() { @@:self.host.warp_in() }
            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> "warp complete" $Alive
                }
            }
            can_fire(): bool       { @@:(false) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(false) }
            is_alive(): bool       { @@:(true) }
            get_lives(): number    { @@:(@@:self.lives_remaining) }
        }

        $Exploding {
            $.timer: number = 0.0
            $.duration: number = 1.0
            $>() { @@:self.host.spawn_explosion() }
            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    @@:self.lives_remaining = @@:self.lives_remaining - 1
                    if @@:self.lives_remaining <= 0 {
                        -> "no lives left" $Dead
                    } else {
                        -> "lives remain" $Respawning
                    }
                }
            }
            can_fire(): bool       { @@:(false) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(true) }
            is_alive(): bool       { @@:(false) }
            get_lives(): number    { @@:(@@:self.lives_remaining) }
        }

        $Respawning {
            $.timer: number = 0.0
            $.duration: number = 2.0
            $>() { @@:self.host.reset_ship() }
            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> "invuln expired" $Alive
                }
            }
            can_fire(): bool       { @@:(true) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(true) }
            is_alive(): bool       { @@:(true) }
            get_lives(): number    { @@:(@@:self.lives_remaining) }
        }

        $Dead {
            respawn() {
                @@:self.lives_remaining = @@:self.starting_lives
                @@:self.hyperspaces_remaining = @@:self.starting_hyperspaces
                -> $Respawning
            }
            can_fire(): bool       { @@:(false) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(false) }
            is_alive(): bool       { @@:(false) }
            get_lives(): number    { @@:(0) }
        }

    domain:
        host: any = host
        lives_remaining: number = 3
        starting_lives: number = 3
        hyperspaces_remaining: number = 3
        starting_hyperspaces: number = 3
}

-- ------------------------------------------------------------ AsteroidField
@@system AsteroidField {

    interface:
        spawn_wave(count: number, court_size: any)
        split(index: number): bool
        remove(index: number)
        clear()
        advance(dt: number, court_size: any)
        count(): number
        alive_count(): number
        is_alive(index: number): bool
        position(index: number): any
        velocity(index: number): any
        size_of(index: number): number
        radius_of(index: number): number

    machine:

        $Active {
            spawn_wave(count: number, court_size: any) {
                @@:self.asteroids = {}
                local i = 0
                while i < count {
                    @@:self.spawn_large(court_size)
                    i = i + 1
                }
            }

            split(index: number): bool {
                if index < 1 or index > #@@:self.asteroids {
                    @@:return(false)
                }
                if not @@:self.asteroids[index].alive {
                    @@:return(false)
                }
                @@:self.asteroids[index].alive = false
                local sz = @@:self.asteroids[index].size
                local p = @@:self.asteroids[index].pos
                if sz > 1 {
                    @@:self.spawn_child(p, sz - 1)
                    @@:self.spawn_child(p, sz - 1)
                }
                @@:(true)
            }

            remove(index: number) {
                if index < 1 or index > #@@:self.asteroids {
                    return
                }
                @@:self.asteroids[index].alive = false
            }

            clear() { @@:self.asteroids = {} }

            advance(dt: number, court_size: any) {
                local i = 1
                while i <= #@@:self.asteroids {
                    if @@:self.asteroids[i].alive {
                        @@:self.asteroids[i].pos = vadd(@@:self.asteroids[i].pos, vscale(@@:self.asteroids[i].vel, dt))
                        if @@:self.asteroids[i].pos.x < 0.0 { @@:self.asteroids[i].pos.x = @@:self.asteroids[i].pos.x + court_size.x }
                        if @@:self.asteroids[i].pos.x > court_size.x { @@:self.asteroids[i].pos.x = @@:self.asteroids[i].pos.x - court_size.x }
                        if @@:self.asteroids[i].pos.y < 0.0 { @@:self.asteroids[i].pos.y = @@:self.asteroids[i].pos.y + court_size.y }
                        if @@:self.asteroids[i].pos.y > court_size.y { @@:self.asteroids[i].pos.y = @@:self.asteroids[i].pos.y - court_size.y }
                    }
                    i = i + 1
                }
            }

            count(): number { @@:(#@@:self.asteroids) }

            alive_count(): number {
                local c = 0
                local i = 1
                while i <= #@@:self.asteroids {
                    if @@:self.asteroids[i].alive { c = c + 1 }
                    i = i + 1
                }
                @@:(c)
            }

            is_alive(index: number): bool {
                if index < 1 or index > #@@:self.asteroids {
                    @@:return(false)
                }
                @@:(@@:self.asteroids[index].alive)
            }

            position(index: number): any {
                if index < 1 or index > #@@:self.asteroids {
                    @@:return(v2(0, 0))
                }
                @@:(@@:self.asteroids[index].pos)
            }

            velocity(index: number): any {
                if index < 1 or index > #@@:self.asteroids {
                    @@:return(v2(0, 0))
                }
                @@:(@@:self.asteroids[index].vel)
            }

            size_of(index: number): number {
                if index < 1 or index > #@@:self.asteroids {
                    @@:return(0)
                }
                @@:(@@:self.asteroids[index].size)
            }

            radius_of(index: number): number {
                if index < 1 or index > #@@:self.asteroids {
                    @@:return(0.0)
                }
                local sz = @@:self.asteroids[index].size
                if sz == 3 { @@:return(32.0) }
                if sz == 2 { @@:return(18.0) }
                @@:(10.0)
            }
        }

    actions:

        spawn_large(court_size: any) {
            local edge = math.random(0, 3)
            local pos = v2(0, 0)
            if edge == 0 {
                pos = v2(0.0, rf() * court_size.y)
            } else if edge == 1 {
                pos = v2(court_size.x, rf() * court_size.y)
            } else if edge == 2 {
                pos = v2(rf() * court_size.x, 0.0)
            } else {
                pos = v2(rf() * court_size.x, court_size.y)
            }
            local angle = rf() * 2.0 * math.pi
            local speed = 40.0 + rf() * 30.0
            local vel = vfromangle(angle, speed)
            table.insert(@@:self.asteroids, {pos = pos, vel = vel, size = 3, alive = true})
        }

        spawn_child(pos: any, size: number) {
            local angle = rf() * 2.0 * math.pi
            local speed = 60.0 + rf() * 40.0 + (3 - size) * 20.0
            local vel = vfromangle(angle, speed)
            table.insert(@@:self.asteroids, {pos = pos, vel = vel, size = size, alive = true})
        }

    domain:
        asteroids: any = {}
}

-- ------------------------------------------------------------ AsteroidsGame
@@[main]
@@system AsteroidsGame(ship_host: any, difficulty: number) {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }
        get_bullets_in_flight(): number { @@:(@@:self.bullets_in_flight) }
        get_max_bullets(): number       { @@:(@@:self.max_bullets) }

    interface:
        start()
        restart()
        pause()
        resume()
        tick(dt: number, court_size: any)
        ship_hit_asteroid(index: number)
        bullet_hit_asteroid(index: number)
        ship_hyperspace()
        bullet_fired()
        bullet_expired()
        get_score(): number
        get_lives(): number
        get_wave(): number
        get_difficulty(): number
        is_paused(): bool

    machine:

        $Attract {
            $>() {
                @@:self.score = 0
                @@:self.wave = 1
                @@:self.bullets_in_flight = 0
            }
            start() {
                @@:self.ship.respawn()
                local n = @@:self.asteroids_for_wave(1)
                @@:self.field.spawn_wave(n, @@:self.last_court_size)
                -> $Playing
            }
            get_score(): number      { @@:(@@:self.score) }
            get_lives(): number      { @@:(@@:self.ship.get_lives()) }
            get_wave(): number       { @@:(@@:self.wave) }
            get_difficulty(): number { @@:(@@:self.difficulty) }
            is_paused(): bool        { @@:(false) }
        }

        $InGame {
            pause() {
                push$ -> $Paused
            }
            bullet_fired() {
                @@:self.bullets_in_flight = @@:self.bullets_in_flight + 1
            }
            bullet_expired() {
                if @@:self.bullets_in_flight > 0 {
                    @@:self.bullets_in_flight = @@:self.bullets_in_flight - 1
                }
            }
            get_score(): number      { @@:(@@:self.score) }
            get_lives(): number      { @@:(@@:self.ship.get_lives()) }
            get_wave(): number       { @@:(@@:self.wave) }
            get_difficulty(): number { @@:(@@:self.difficulty) }
            is_paused(): bool        { @@:(false) }
        }

        $Playing => $InGame {
            tick(dt: number, court_size: any) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.field.advance(dt, court_size)
            }
            ship_hit_asteroid(index: number) {
                if not @@:self.ship.can_be_hit() {
                    return
                }
                @@:self.ship.hit()
                -> $ShipDying
            }
            bullet_hit_asteroid(index: number) {
                if @@:self.field.split(index) {
                    local sz = @@:self.size_points(index)
                    @@:self.score = @@:self.score + sz * @@:self.difficulty
                    if @@:self.field.alive_count() <= 0 {
                        -> "all asteroids cleared" $WaveClear
                    }
                }
            }
            ship_hyperspace() {
                @@:self.ship.hyperspace()
            }
            => $^
        }

        $ShipDying => $InGame {
            tick(dt: number, court_size: any) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.field.advance(dt, court_size)
                if @@:self.ship.get_current_state_name() == "Respawning" {
                    -> "ship respawning" $Playing
                } else if @@:self.ship.get_current_state_name() == "Dead" {
                    -> "no lives left" $GameOver
                }
            }
            => $^
        }

        $WaveClear => $InGame {
            $>() { @@:self.wave_timer = 0.0 }
            tick(dt: number, court_size: any) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.wave_timer = @@:self.wave_timer + dt
                if @@:self.wave_timer >= @@:self.wave_pause {
                    @@:self.wave = @@:self.wave + 1
                    local n = @@:self.asteroids_for_wave(@@:self.wave)
                    @@:self.field.spawn_wave(n, court_size)
                    -> "next wave" $Playing
                }
            }
            => $^
        }

        $Paused {
            resume() {
                -> pop$
            }
            get_score(): number      { @@:(@@:self.score) }
            get_lives(): number      { @@:(@@:self.ship.get_lives()) }
            get_wave(): number       { @@:(@@:self.wave) }
            get_difficulty(): number { @@:(@@:self.difficulty) }
            is_paused(): bool        { @@:(true) }
        }

        $GameOver {
            restart() {
                -> $Attract
            }
            get_score(): number      { @@:(@@:self.score) }
            get_lives(): number      { @@:(@@:self.ship.get_lives()) }
            get_wave(): number       { @@:(@@:self.wave) }
            get_difficulty(): number { @@:(@@:self.difficulty) }
            is_paused(): bool        { @@:(false) }
        }

    actions:

        asteroids_for_wave(wave: number): number {
            local base_count = 2 + @@:self.difficulty
            return base_count + wave - 1
        }

        size_points(index: number): number {
            local sz = @@:self.field.size_of(index)
            if sz == 3 { return 20 }
            if sz == 2 { return 50 }
            return 100
        }

    domain:
        difficulty: number = difficulty
        score: number = 0
        wave: number = 1
        wave_timer: number = 0.0
        wave_pause: number = 2.0
        bullets_in_flight: number = 0
        max_bullets: number = 4
        last_court_size: any = v2(640, 480)
        ship: Ship = @@Ship(ship_host)
        field: AsteroidField = @@AsteroidField()
}
