@@[target("rust")]

// Breakout — C# port of the canonical controller
// (games/breakout/src/breakout.fjs). Ball / BrickField / Breakout. The star is
// the enter-argument transition: Ball.launch does `-> (vx, vy) $InFlight`,
// threading the velocity into $InFlight's `$>(vx, vy)` handler. Bodies native
// C#; doubles throughout so dt=1/64 math matches the JS baseline bit-for-bit.

@@system Ball {

    interface:
        launch(vx: f64, vy: f64)
        lose()
        attach()
        bounce_x()
        bounce_y()
        set_velocity(vx: f64, vy: f64)
        tick(dt: f64)
        get_state(): String
        get_vx(): f64
        get_vy(): f64
        is_flying(): bool
        respawn_progress(): f64

    machine:
        $AttachedToPaddle {
            launch(vx: f64, vy: f64) { -> (vx, vy) $InFlight }

            get_state(): String         { @@:("attached".to_string()) }
            get_vx(): f64            { @@:(0.0) }
            get_vy(): f64            { @@:(0.0) }
            is_flying(): bool           { @@:(false) }
            respawn_progress(): f64  { @@:(1.0) }
        }

        $InFlight {
            $.vx: f64 = 0.0
            $.vy: f64 = 0.0

            $>(vx: f64, vy: f64) {
                $.vx = vx;
                $.vy = vy;
            }

            bounce_x() { $.vx = -$.vx; }
            bounce_y() { $.vy = -$.vy; }

            set_velocity(vx: f64, vy: f64) {
                $.vx = vx;
                $.vy = vy;
            }

            lose() { -> $Lost }

            get_state(): String         { @@:("in_flight".to_string()) }
            get_vx(): f64            { @@:($.vx) }
            get_vy(): f64            { @@:($.vy) }
            is_flying(): bool           { @@:(true) }
            respawn_progress(): f64  { @@:(1.0) }
        }

        $Lost {
            $.elapsed: f64 = 0.0

            tick(dt: f64) {
                $.elapsed = $.elapsed + dt;
                if $.elapsed >= 2.0 {
                    -> $AttachedToPaddle
                }
            }

            attach() { -> $AttachedToPaddle }

            get_state(): String         { @@:("lost".to_string()) }
            get_vx(): f64            { @@:(0.0) }
            get_vy(): f64            { @@:(0.0) }
            is_flying(): bool           { @@:(false) }
            respawn_progress(): f64  { @@:($.elapsed / 2.0) }
        }
}

@@system BrickField {

    interface:
        reset(count: i32)
        break_brick(index: i32): bool
        is_broken(index: i32): bool
        remaining(): i32
        is_cleared(): bool

    machine:
        $Active {
            reset(count: i32) {
                @@:self.bricks = Vec::new();
                let mut _i = 0;
                while _i < count {
                    @@:self.bricks.push(true);
                    _i = _i + 1;
                }
                @@:self.remaining_count = count;
            }

            break_brick(index: i32): bool {
                if index < 0 || index >= @@:self.bricks.len() as i32 {
                    @@:return(false)
                }
                if !@@:self.bricks[(index) as usize] {
                    @@:return(false)
                }
                @@:self.bricks[(index) as usize] = false;
                @@:self.remaining_count = @@:self.remaining_count - 1;
                @@:(true)
            }

            is_broken(index: i32): bool {
                if index < 0 || index >= @@:self.bricks.len() as i32 {
                    @@:return(true)
                }
                @@:(!@@:self.bricks[(index) as usize])
            }

            remaining(): i32  { @@:(@@:self.remaining_count) }
            is_cleared(): bool { @@:(@@:self.remaining_count <= 0) }
        }

    domain:
        bricks: Vec<bool> = Vec::new()
        remaining_count: i32 = 0
}

@@[main]
@@system Breakout {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }

    interface:
        start()
        launch_ball(vx: f64, vy: f64)
        brick_hit(index: i32)
        paddle_hit(vx: f64, vy: f64)
        wall_bounce_x()
        wall_bounce_y()
        ball_fell_off()
        tick(dt: f64)
        pause()
        resume()
        restart()
        get_state(): String
        get_score(): i32
        get_lives(): i32
        get_level(): i32
        bricks_remaining(): i32
        is_brick_broken(index: i32): bool
        ball_state(): String
        ball_vx(): f64
        ball_vy(): f64
        ball_respawn_progress(): f64

    machine:
        $Attract {
            $>() {
                @@:self.score = 0;
                @@:self.lives = 3;
                @@:self.level = 1;
                @@:self.bricks.reset(@@:self.brick_count);
            }

            start() {
                @@:self.bricks.reset(@@:self.brick_count);
                @@:self.ball.attach();
                -> $Playing
            }

            get_state(): String          { @@:("attract".to_string()) }
            get_score(): i32             { @@:(@@:self.score) }
            get_lives(): i32             { @@:(@@:self.lives) }
            get_level(): i32             { @@:(@@:self.level) }
            bricks_remaining(): i32      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: i32): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): f64            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): f64            { @@:(@@:self.ball.get_vy()) }
        }

        $Playing {
            launch_ball(vx: f64, vy: f64) {
                @@:self.ball.launch(vx, vy);
            }

            brick_hit(index: i32) {
                if @@:self.bricks.break_brick(index) {
                    @@:self.score = @@:self.score + @@:self.points_per_brick;
                    @@:self.ball.bounce_y();
                    if @@:self.bricks.is_cleared() {
                        -> $LevelClear
                    }
                }
            }

            paddle_hit(vx: f64, vy: f64) {
                @@:self.ball.set_velocity(vx, vy);
            }

            wall_bounce_x() { @@:self.ball.bounce_x(); }
            wall_bounce_y() { @@:self.ball.bounce_y(); }

            ball_fell_off() {
                @@:self.lives = @@:self.lives - 1;
                if @@:self.lives <= 0 {
                    -> $GameOver
                } else {
                    @@:self.ball.lose();
                }
            }

            tick(dt: f64) { @@:self.ball.tick(dt); }

            pause() { push$ -> $Paused }

            get_state(): String          { @@:("playing".to_string()) }
            get_score(): i32             { @@:(@@:self.score) }
            get_lives(): i32             { @@:(@@:self.lives) }
            get_level(): i32             { @@:(@@:self.level) }
            bricks_remaining(): i32      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: i32): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): f64            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): f64            { @@:(@@:self.ball.get_vy()) }
            ball_respawn_progress(): f64 { @@:(@@:self.ball.respawn_progress()) }
        }

        $LevelClear {
            $>() {
                @@:self.level = @@:self.level + 1;
            }

            start() {
                @@:self.bricks.reset(@@:self.brick_count);
                @@:self.ball.attach();
                -> $Playing
            }

            get_state(): String          { @@:("level_clear".to_string()) }
            get_score(): i32             { @@:(@@:self.score) }
            get_lives(): i32             { @@:(@@:self.lives) }
            get_level(): i32             { @@:(@@:self.level) }
            bricks_remaining(): i32      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: i32): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): f64            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): f64            { @@:(@@:self.ball.get_vy()) }
        }

        $Paused {
            resume() { -> pop$ }

            get_state(): String          { @@:("paused".to_string()) }
            get_score(): i32             { @@:(@@:self.score) }
            get_lives(): i32             { @@:(@@:self.lives) }
            get_level(): i32             { @@:(@@:self.level) }
            bricks_remaining(): i32      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: i32): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): f64            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): f64            { @@:(@@:self.ball.get_vy()) }
        }

        $GameOver {
            restart() { -> $Attract }

            get_state(): String          { @@:("game_over".to_string()) }
            get_score(): i32             { @@:(@@:self.score) }
            get_lives(): i32             { @@:(@@:self.lives) }
            get_level(): i32             { @@:(@@:self.level) }
            bricks_remaining(): i32      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: i32): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): f64            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): f64            { @@:(@@:self.ball.get_vy()) }
        }

    domain:
        score: i32 = 0
        lives: i32 = 3
        level: i32 = 1
        brick_count: i32 = 40
        points_per_brick: i32 = 10
        ball: Ball = @@Ball()
        bricks: BrickField = @@BrickField()
}
