@@[target("typescript")]

interface Vector2 { x: number; y: number }

// Pac-Man ghost AI — three composed state machines.
//
// CANONICAL: mirrors the Godot reference
// (frame-arcade/ch05-pacman/frame/pacman.fgd) exactly — same
// three systems (Ghost / GhostPen / GhostGame), states, the
// $OutOfPen HSM parent, the push$/pop$ frightened subroutine,
// the parameterized Ghost(name, home_corner, target_kind), the
// $Frightened enter/exit broadcast, and the driver-populated
// ghosts list. Only action bodies differ (JS): Vector2 -> {x,y}.
//
// NOTE (same as Godot): this models the GHOST AI, not game flow.
// Pac-Man movement, the maze, pellets, win/lose, and pause live
// in the scene/driver — exactly as in the Godot main.gd.

@@system Ghost(name: string, home_corner: Vector2, target_kind: number) {

    interface:
        tick(dt: number)
        power_pellet_eaten()
        frighten_expired()
        eaten()
        arrived_at_pen()
        released()
        phase_changed_to_chase()
        phase_changed_to_scatter()
        reset_to_pen()
        get_state(): string
        get_name(): string
        get_home_corner(): Vector2
        get_target_kind(): number
        is_frightened(): boolean
        is_dangerous(): boolean
        is_edible(): boolean

    machine:
        $InPen {
            released() { -> $Scatter }
            reset_to_pen() { }

            get_state(): string         { @@:("in_pen") }
            get_name(): string          { @@:(this.gname) }
            get_home_corner(): Vector2  { @@:(this.home) }
            get_target_kind(): number      { @@:(this.tkind) }
            is_frightened(): boolean       { @@:(false) }
            is_dangerous(): boolean        { @@:(false) }
            is_edible(): boolean           { @@:(false) }
        }

        $OutOfPen {
            power_pellet_eaten() {
                push$
                -> $Frightened
            }

            reset_to_pen() { -> $InPen }

            get_state(): string         { @@:("out_of_pen") }
            get_name(): string          { @@:(this.gname) }
            get_home_corner(): Vector2  { @@:(this.home) }
            get_target_kind(): number      { @@:(this.tkind) }
            is_frightened(): boolean       { @@:(false) }
            is_dangerous(): boolean        { @@:(true) }
            is_edible(): boolean           { @@:(false) }
        }

        $Chase => $OutOfPen {
            phase_changed_to_scatter() { -> $Scatter }
            get_state(): string { @@:("chase") }
            => $^
        }

        $Scatter => $OutOfPen {
            phase_changed_to_chase() { -> $Chase }
            get_state(): string { @@:("scatter") }
            => $^
        }

        $Frightened {
            frighten_expired() { -> pop$ }
            eaten() { -> $Eaten }
            reset_to_pen() { -> $InPen }

            get_state(): string         { @@:("frightened") }
            get_name(): string          { @@:(this.gname) }
            get_home_corner(): Vector2  { @@:(this.home) }
            get_target_kind(): number      { @@:(this.tkind) }
            is_frightened(): boolean       { @@:(true) }
            is_dangerous(): boolean        { @@:(false) }
            is_edible(): boolean           { @@:(true) }
        }

        $Eaten {
            arrived_at_pen() { -> $InPen }

            get_state(): string         { @@:("eaten") }
            get_name(): string          { @@:(this.gname) }
            get_home_corner(): Vector2  { @@:(this.home) }
            get_target_kind(): number      { @@:(this.tkind) }
            is_frightened(): boolean       { @@:(false) }
            is_dangerous(): boolean        { @@:(false) }
            is_edible(): boolean           { @@:(false) }
        }

    domain:
        gname: string = name
        home: Vector2 = home_corner
        tkind: number = target_kind
}

@@system GhostPen {

    interface:
        tick(dt: number)
        reset()
        next_release_index(): number
        should_release(): boolean
        consume_release()

    machine:
        $Active {
            tick(dt: number) {
                this.release_timer = this.release_timer + dt
            }

            reset() {
                this.release_timer = 0.0
                this.next_index = 0
            }

            next_release_index(): number { @@:(this.next_index) }

            should_release(): boolean {
                @@:(this.release_timer >= this.release_interval && this.next_index < this.max_ghosts)
            }

            consume_release() {
                this.next_index = this.next_index + 1
                this.release_timer = 0.0
            }
        }

    domain:
        release_timer: number = 0.0
        release_interval: number = 2.0
        next_index: number = 0
        max_ghosts: number = 4
}

@@[main]
@@system GhostGame {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }

    interface:
        tick(dt: number)
        start()
        add_ghost(g: any)
        power_pellet_picked_up()
        ghost_caught(index: number)
        ghost_arrived_at_pen(index: number)
        get_phase(): string
        is_frightened(): boolean
        ghost_count(): number
        ghost_state(index: number): string
        ghost_is_dangerous(index: number): boolean
        ghost_is_edible(index: number): boolean
        ghost_home_corner(index: number): Vector2
        ghost_target_kind(index: number): number
        get_score(): number
        frighten_seconds_left(): number

    machine:
        $Idle {
            add_ghost(g: any) {
                this.ghosts.push(g)
            }

            start() {
                this.phase_timer = 0.0
                this.phase_index = 0
                this.score = 0
                this.pen.reset()
                -> $Scatter
            }

            get_phase(): string                    { @@:("idle") }
            is_frightened(): boolean                  { @@:(false) }
            ghost_count(): number                     { @@:(this.ghosts.length) }
            ghost_state(index: number): string        { @@:(this._q_state(index)) }
            ghost_is_dangerous(index: number): boolean   { @@:(this._q_dangerous(index)) }
            ghost_is_edible(index: number): boolean      { @@:(this._q_edible(index)) }
            ghost_home_corner(index: number): Vector2 { @@:(this._q_home(index)) }
            ghost_target_kind(index: number): number     { @@:(this._q_tkind(index)) }
            get_score(): number                       { @@:(this.score) }
            frighten_seconds_left(): number         { @@:(0.0) }
        }

        $Scatter {
            $>() {
                this.phase_timer = 0.0
                this._broadcast_scatter()
                this._try_release()
            }

            tick(dt: number) {
                this.phase_timer = this.phase_timer + dt
                this._tick_all(dt)
                this._try_release()
                if (this.phase_timer >= this._scatter_duration()) {
                    -> $Chase
                }
            }

            power_pellet_picked_up() {
                push$
                -> $Frightened
            }

            ghost_caught(index: number) { }

            ghost_arrived_at_pen(index: number) {
                this._deliver_arrived(index)
            }

            add_ghost(g: any) {
                this.ghosts.push(g)
            }

            get_phase(): string                    { @@:("scatter") }
            is_frightened(): boolean                  { @@:(false) }
            ghost_count(): number                     { @@:(this.ghosts.length) }
            ghost_state(index: number): string        { @@:(this._q_state(index)) }
            ghost_is_dangerous(index: number): boolean   { @@:(this._q_dangerous(index)) }
            ghost_is_edible(index: number): boolean      { @@:(this._q_edible(index)) }
            ghost_home_corner(index: number): Vector2 { @@:(this._q_home(index)) }
            ghost_target_kind(index: number): number     { @@:(this._q_tkind(index)) }
            get_score(): number                       { @@:(this.score) }
            frighten_seconds_left(): number         { @@:(0.0) }
        }

        $Chase {
            $>() {
                this.phase_timer = 0.0
                this._broadcast_chase()
                this._try_release()
            }

            tick(dt: number) {
                this.phase_timer = this.phase_timer + dt
                this._tick_all(dt)
                this._try_release()
                if (this.phase_timer >= this._chase_duration()) {
                    this.phase_index = this.phase_index + 1
                    -> $Scatter
                }
            }

            power_pellet_picked_up() {
                push$
                -> $Frightened
            }

            ghost_caught(index: number) { }

            ghost_arrived_at_pen(index: number) {
                this._deliver_arrived(index)
            }

            add_ghost(g: any) {
                this.ghosts.push(g)
            }

            get_phase(): string                    { @@:("chase") }
            is_frightened(): boolean                  { @@:(false) }
            ghost_count(): number                     { @@:(this.ghosts.length) }
            ghost_state(index: number): string        { @@:(this._q_state(index)) }
            ghost_is_dangerous(index: number): boolean   { @@:(this._q_dangerous(index)) }
            ghost_is_edible(index: number): boolean      { @@:(this._q_edible(index)) }
            ghost_home_corner(index: number): Vector2 { @@:(this._q_home(index)) }
            ghost_target_kind(index: number): number     { @@:(this._q_tkind(index)) }
            get_score(): number                       { @@:(this.score) }
            frighten_seconds_left(): number         { @@:(0.0) }
        }

        $Frightened {
            $>() {
                this.frighten_timer = 0.0
                this._broadcast_frighten()
            }

            <$() {
                this._broadcast_frighten_expired()
            }

            tick(dt: number) {
                this.frighten_timer = this.frighten_timer + dt
                this._tick_all(dt)
                this._try_release()
                if (this.frighten_timer >= this.frighten_duration) {
                    -> pop$
                }
            }

            power_pellet_picked_up() {
                -> $Frightened
            }

            ghost_caught(index: number) {
                if (index < 0 || index >= this.ghosts.length) {
                    return
                }
                let g = this.ghosts[index]
                if (g.is_edible()) {
                    g.eaten()
                    this.score = this.score + this.points_per_ghost
                }
            }

            ghost_arrived_at_pen(index: number) {
                this._deliver_arrived(index)
            }

            add_ghost(g: any) {
                this.ghosts.push(g)
            }

            get_phase(): string                    { @@:("frightened") }
            is_frightened(): boolean                  { @@:(true) }
            ghost_count(): number                     { @@:(this.ghosts.length) }
            ghost_state(index: number): string        { @@:(this._q_state(index)) }
            ghost_is_dangerous(index: number): boolean   { @@:(this._q_dangerous(index)) }
            ghost_is_edible(index: number): boolean      { @@:(this._q_edible(index)) }
            ghost_home_corner(index: number): Vector2 { @@:(this._q_home(index)) }
            ghost_target_kind(index: number): number     { @@:(this._q_tkind(index)) }
            get_score(): number                       { @@:(this.score) }
            frighten_seconds_left(): number {
                let rem = this.frighten_duration - this.frighten_timer
                if (rem < 0.0) {
                    @@:return(0.0)
                }
                @@:(rem)
            }
        }

    actions:
        _scatter_duration() {
            if (this.phase_index == 0) { return 7.0 }
            if (this.phase_index == 1) { return 5.0 }
            return 5.0
        }

        _chase_duration() {
            if (this.phase_index >= 3) { return 9999.0 }
            return 20.0
        }

        _broadcast_scatter() {
            let i = 0
            while (i < this.ghosts.length) {
                this.ghosts[i].phase_changed_to_scatter()
                i = i + 1
            }
        }

        _broadcast_chase() {
            let i = 0
            while (i < this.ghosts.length) {
                this.ghosts[i].phase_changed_to_chase()
                i = i + 1
            }
        }

        _broadcast_frighten() {
            let i = 0
            while (i < this.ghosts.length) {
                this.ghosts[i].power_pellet_eaten()
                i = i + 1
            }
        }

        _broadcast_frighten_expired() {
            let i = 0
            while (i < this.ghosts.length) {
                this.ghosts[i].frighten_expired()
                i = i + 1
            }
        }

        _tick_all(dt: number) {
            let i = 0
            while (i < this.ghosts.length) {
                this.ghosts[i].tick(dt)
                i = i + 1
            }
            this.pen.tick(dt)
        }

        _try_release() {
            if (this.pen.should_release()) {
                let idx = this.pen.next_release_index()
                if (idx >= 0 && idx < this.ghosts.length) {
                    this.ghosts[idx].released()
                    this.pen.consume_release()
                }
            }
        }

        _deliver_arrived(index: number) {
            if (index < 0 || index >= this.ghosts.length) {
                return
            }
            this.ghosts[index].arrived_at_pen()
        }

        _q_state(index: number) {
            if (index < 0 || index >= this.ghosts.length) {
                return ""
            }
            return this.ghosts[index].get_state()
        }
        _q_dangerous(index: number) {
            if (index < 0 || index >= this.ghosts.length) {
                return false
            }
            return this.ghosts[index].is_dangerous()
        }
        _q_edible(index: number) {
            if (index < 0 || index >= this.ghosts.length) {
                return false
            }
            return this.ghosts[index].is_edible()
        }
        _q_home(index: number) {
            if (index < 0 || index >= this.ghosts.length) {
                return { x: 0.0, y: 0.0 }
            }
            return this.ghosts[index].get_home_corner()
        }
        _q_tkind(index: number) {
            if (index < 0 || index >= this.ghosts.length) {
                return 0
            }
            return this.ghosts[index].get_target_kind()
        }

    domain:
        score: number = 0
        phase_timer: number = 0.0
        phase_index: number = 0
        frighten_timer: number = 0.0
        frighten_duration: number = 6.0
        points_per_ghost: number = 200
        ghosts: any[] = []
        pen: GhostPen = @@GhostPen()
}
