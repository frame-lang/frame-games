@@[target("go")]

// Asteroids — Go/Ebiten port of the Frame controller. Same three systems as
// the other ports; native bodies in Go (no operator overloading, so Vec2 has
// methods; `for` not `while`; len()/append() on slices). Host effects are
// method calls on a ShipHost interface (the Ebiten game implements it).
package main

import (
	"math"
	"math/rand"
)

// Vec2 — Go has no operator overloading, so the FSM uses methods.
type Vec2 struct{ X, Y float64 }

func (a Vec2) Add(b Vec2) Vec2        { return Vec2{a.X + b.X, a.Y + b.Y} }
func (a Vec2) Sub(b Vec2) Vec2        { return Vec2{a.X - b.X, a.Y - b.Y} }
func (a Vec2) Scale(s float64) Vec2   { return Vec2{a.X * s, a.Y * s} }
func (a Vec2) Length() float64        { return math.Hypot(a.X, a.Y) }
func (a Vec2) DistanceTo(b Vec2) float64 { return math.Hypot(a.X-b.X, a.Y-b.Y) }
func vec2FromAngle(ang, speed float64) Vec2 {
	return Vec2{math.Cos(ang) * speed, math.Sin(ang) * speed}
}

// The Ship FSM fires these back at its host (the Ebiten game) on state changes.
type ShipHost interface {
	WarpOut()
	WarpIn()
	SpawnExplosion()
	ResetShip()
}

// An asteroid is plain data — the field owns a typed slice of them.
type Asteroid struct {
	Pos, Vel Vec2
	Size     int
	Alive    bool
}

func rf() float64 { return rand.Float64() }

// ------------------------------------------------------------ Ship
@@system Ship(host: ShipHost) {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }
        get_hyperspaces_remaining(): int { @@:(@@:self.hyperspaces_remaining) }

    interface:
        tick(dt: float64)
        hit()
        hyperspace()
        respawn()
        fire()
        can_fire(): bool
        can_be_hit(): bool
        can_hyperspace(): bool
        is_visible(): bool
        is_alive(): bool
        get_lives(): int

    machine:

        $Alive {
            $.cooldown: float64 = 0.0
            tick(dt: float64) {
                if $.cooldown > 0.0 {
                    $.cooldown = $.cooldown - dt
                }
            }
            fire() { $.cooldown = 0.22 }
            hit() { -> $Exploding }
            hyperspace() {
                if @@:self.hyperspaces_remaining > 0 {
                    @@:self.hyperspaces_remaining = @@:self.hyperspaces_remaining - 1
                    -> $InHyperspace
                }
            }
            can_fire(): bool       { @@:($.cooldown <= 0.0) }
            can_be_hit(): bool     { @@:(true) }
            can_hyperspace(): bool { @@:(@@:self.hyperspaces_remaining > 0) }
            is_visible(): bool     { @@:(true) }
            is_alive(): bool       { @@:(true) }
            get_lives(): int       { @@:(@@:self.lives_remaining) }
        }

        $InHyperspace {
            $.timer: float64 = 0.0
            $.duration: float64 = 0.4
            $>() { @@:self.host.WarpOut() }
            <$() { @@:self.host.WarpIn() }
            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> "warp complete" $Alive
                }
            }
            can_fire(): bool       { @@:(false) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(false) }
            is_alive(): bool       { @@:(true) }
            get_lives(): int       { @@:(@@:self.lives_remaining) }
        }

        $Exploding {
            $.timer: float64 = 0.0
            $.duration: float64 = 1.0
            $>() { @@:self.host.SpawnExplosion() }
            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    @@:self.lives_remaining = @@:self.lives_remaining - 1
                    if @@:self.lives_remaining <= 0 {
                        -> "no lives left" $Dead
                    } else {
                        -> "lives remain" $Respawning
                    }
                }
            }
            can_fire(): bool       { @@:(false) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(true) }
            is_alive(): bool       { @@:(false) }
            get_lives(): int       { @@:(@@:self.lives_remaining) }
        }

        $Respawning {
            $.timer: float64 = 0.0
            $.duration: float64 = 2.0
            $>() { @@:self.host.ResetShip() }
            tick(dt: float64) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> "invuln expired" $Alive
                }
            }
            can_fire(): bool       { @@:(true) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(true) }
            is_alive(): bool       { @@:(true) }
            get_lives(): int       { @@:(@@:self.lives_remaining) }
        }

        $Dead {
            respawn() {
                @@:self.lives_remaining = @@:self.starting_lives
                @@:self.hyperspaces_remaining = @@:self.starting_hyperspaces
                -> $Respawning
            }
            can_fire(): bool       { @@:(false) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(false) }
            is_alive(): bool       { @@:(false) }
            get_lives(): int       { @@:(0) }
        }

    domain:
        host: ShipHost = host
        lives_remaining: int = 3
        starting_lives: int = 3
        hyperspaces_remaining: int = 3
        starting_hyperspaces: int = 3
}

// ------------------------------------------------------------ AsteroidField
@@system AsteroidField {

    interface:
        spawn_wave(count: int, court_size: Vec2)
        split(index: int): bool
        remove(index: int)
        clear()
        advance(dt: float64, court_size: Vec2)
        count(): int
        alive_count(): int
        is_alive(index: int): bool
        position(index: int): Vec2
        velocity(index: int): Vec2
        size_of(index: int): int
        radius_of(index: int): float64

    machine:

        $Active {
            spawn_wave(count: int, court_size: Vec2) {
                @@:self.asteroids = nil
                i := 0
                for i < count {
                    @@:self.spawn_large(court_size)
                    i = i + 1
                }
            }

            split(index: int): bool {
                if index < 0 || index >= len(@@:self.asteroids) {
                    @@:return(false)
                }
                if !@@:self.asteroids[index].Alive {
                    @@:return(false)
                }
                @@:self.asteroids[index].Alive = false
                sz := @@:self.asteroids[index].Size
                p := @@:self.asteroids[index].Pos
                if sz > 1 {
                    @@:self.spawn_child(p, sz - 1)
                    @@:self.spawn_child(p, sz - 1)
                }
                @@:(true)
            }

            remove(index: int) {
                if index < 0 || index >= len(@@:self.asteroids) {
                    return
                }
                @@:self.asteroids[index].Alive = false
            }

            clear() { @@:self.asteroids = nil }

            advance(dt: float64, court_size: Vec2) {
                i := 0
                for i < len(@@:self.asteroids) {
                    if @@:self.asteroids[i].Alive {
                        @@:self.asteroids[i].Pos = @@:self.asteroids[i].Pos.Add(@@:self.asteroids[i].Vel.Scale(dt))
                        if @@:self.asteroids[i].Pos.X < 0.0 { @@:self.asteroids[i].Pos.X += court_size.X }
                        if @@:self.asteroids[i].Pos.X > court_size.X { @@:self.asteroids[i].Pos.X -= court_size.X }
                        if @@:self.asteroids[i].Pos.Y < 0.0 { @@:self.asteroids[i].Pos.Y += court_size.Y }
                        if @@:self.asteroids[i].Pos.Y > court_size.Y { @@:self.asteroids[i].Pos.Y -= court_size.Y }
                    }
                    i = i + 1
                }
            }

            count(): int { @@:(len(@@:self.asteroids)) }

            alive_count(): int {
                c := 0
                i := 0
                for i < len(@@:self.asteroids) {
                    if @@:self.asteroids[i].Alive { c = c + 1 }
                    i = i + 1
                }
                @@:(c)
            }

            is_alive(index: int): bool {
                if index < 0 || index >= len(@@:self.asteroids) {
                    @@:return(false)
                }
                @@:(@@:self.asteroids[index].Alive)
            }

            position(index: int): Vec2 {
                if index < 0 || index >= len(@@:self.asteroids) {
                    @@:return(Vec2{})
                }
                @@:(@@:self.asteroids[index].Pos)
            }

            velocity(index: int): Vec2 {
                if index < 0 || index >= len(@@:self.asteroids) {
                    @@:return(Vec2{})
                }
                @@:(@@:self.asteroids[index].Vel)
            }

            size_of(index: int): int {
                if index < 0 || index >= len(@@:self.asteroids) {
                    @@:return(0)
                }
                @@:(@@:self.asteroids[index].Size)
            }

            radius_of(index: int): float64 {
                if index < 0 || index >= len(@@:self.asteroids) {
                    @@:return(0.0)
                }
                sz := @@:self.asteroids[index].Size
                if sz == 3 { @@:return(32.0) }
                if sz == 2 { @@:return(18.0) }
                @@:(10.0)
            }
        }

    actions:

        spawn_large(court_size: Vec2) {
            edge := rand.Intn(4)
            pos := Vec2{}
            if edge == 0 {
                pos = Vec2{X: 0.0, Y: rf() * court_size.Y}
            } else if edge == 1 {
                pos = Vec2{X: court_size.X, Y: rf() * court_size.Y}
            } else if edge == 2 {
                pos = Vec2{X: rf() * court_size.X, Y: 0.0}
            } else {
                pos = Vec2{X: rf() * court_size.X, Y: court_size.Y}
            }
            angle := rf() * 2.0 * math.Pi
            speed := 40.0 + rf()*30.0
            vel := vec2FromAngle(angle, speed)
            @@:self.asteroids = append(@@:self.asteroids, Asteroid{Pos: pos, Vel: vel, Size: 3, Alive: true})
        }

        spawn_child(pos: Vec2, size: int) {
            angle := rf() * 2.0 * math.Pi
            speed := 60.0 + rf()*40.0 + float64(3-size)*20.0
            vel := vec2FromAngle(angle, speed)
            @@:self.asteroids = append(@@:self.asteroids, Asteroid{Pos: pos, Vel: vel, Size: size, Alive: true})
        }

    domain:
        asteroids: []Asteroid = nil
}

// ------------------------------------------------------------ AsteroidsGame
@@[main]
@@system AsteroidsGame(ship_host: ShipHost, difficulty: int) {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }
        get_bullets_in_flight(): int { @@:(@@:self.bullets_in_flight) }
        get_max_bullets(): int       { @@:(@@:self.max_bullets) }

    interface:
        start()
        restart()
        pause()
        resume()
        tick(dt: float64, court_size: Vec2)
        ship_hit_asteroid(index: int)
        bullet_hit_asteroid(index: int)
        ship_hyperspace()
        bullet_fired()
        bullet_expired()
        get_score(): int
        get_lives(): int
        get_wave(): int
        get_difficulty(): int
        is_paused(): bool

    machine:

        $Attract {
            $>() {
                @@:self.score = 0
                @@:self.wave = 1
                @@:self.bullets_in_flight = 0
            }
            start() {
                @@:self.ship.respawn()
                n := @@:self.asteroids_for_wave(1)
                @@:self.field.spawn_wave(n, @@:self.last_court_size)
                -> $Playing
            }
            get_score(): int        { @@:(@@:self.score) }
            get_lives(): int        { @@:(@@:self.ship.get_lives()) }
            get_wave(): int         { @@:(@@:self.wave) }
            get_difficulty(): int   { @@:(@@:self.difficulty) }
            is_paused(): bool       { @@:(false) }
        }

        $InGame {
            pause() {
                push$ -> $Paused
            }
            bullet_fired() {
                @@:self.bullets_in_flight = @@:self.bullets_in_flight + 1
            }
            bullet_expired() {
                if @@:self.bullets_in_flight > 0 {
                    @@:self.bullets_in_flight = @@:self.bullets_in_flight - 1
                }
            }
            get_score(): int        { @@:(@@:self.score) }
            get_lives(): int        { @@:(@@:self.ship.get_lives()) }
            get_wave(): int         { @@:(@@:self.wave) }
            get_difficulty(): int   { @@:(@@:self.difficulty) }
            is_paused(): bool       { @@:(false) }
        }

        $Playing => $InGame {
            tick(dt: float64, court_size: Vec2) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.field.advance(dt, court_size)
            }
            ship_hit_asteroid(index: int) {
                if !@@:self.ship.can_be_hit() {
                    return
                }
                @@:self.ship.hit()
                -> $ShipDying
            }
            bullet_hit_asteroid(index: int) {
                if @@:self.field.split(index) {
                    sz := @@:self.size_points(index)
                    @@:self.score = @@:self.score + sz * @@:self.difficulty
                    if @@:self.field.alive_count() <= 0 {
                        -> "all asteroids cleared" $WaveClear
                    }
                }
            }
            ship_hyperspace() {
                @@:self.ship.hyperspace()
            }
            => $^
        }

        $ShipDying => $InGame {
            tick(dt: float64, court_size: Vec2) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.field.advance(dt, court_size)
                if @@:self.ship.get_current_state_name() == "Respawning" {
                    -> "ship respawning" $Playing
                } else if @@:self.ship.get_current_state_name() == "Dead" {
                    -> "no lives left" $GameOver
                }
            }
            => $^
        }

        $WaveClear => $InGame {
            $>() { @@:self.wave_timer = 0.0 }
            tick(dt: float64, court_size: Vec2) {
                @@:self.last_court_size = court_size
                @@:self.ship.tick(dt)
                @@:self.wave_timer = @@:self.wave_timer + dt
                if @@:self.wave_timer >= @@:self.wave_pause {
                    @@:self.wave = @@:self.wave + 1
                    n := @@:self.asteroids_for_wave(@@:self.wave)
                    @@:self.field.spawn_wave(n, court_size)
                    -> "next wave" $Playing
                }
            }
            => $^
        }

        $Paused {
            resume() {
                -> pop$
            }
            get_score(): int        { @@:(@@:self.score) }
            get_lives(): int        { @@:(@@:self.ship.get_lives()) }
            get_wave(): int         { @@:(@@:self.wave) }
            get_difficulty(): int   { @@:(@@:self.difficulty) }
            is_paused(): bool       { @@:(true) }
        }

        $GameOver {
            restart() {
                -> $Attract
            }
            get_score(): int        { @@:(@@:self.score) }
            get_lives(): int        { @@:(@@:self.ship.get_lives()) }
            get_wave(): int         { @@:(@@:self.wave) }
            get_difficulty(): int   { @@:(@@:self.difficulty) }
            is_paused(): bool       { @@:(false) }
        }

    actions:

        asteroids_for_wave(wave: int): int {
            base := 2 + @@:self.difficulty
            return base + wave - 1
        }

        size_points(index: int): int {
            sz := @@:self.field.size_of(index)
            if sz == 3 { return 20 }
            if sz == 2 { return 50 }
            return 100
        }

    domain:
        difficulty: int = difficulty
        score: int = 0
        wave: int = 1
        wave_timer: float64 = 0.0
        wave_pause: float64 = 2.0
        bullets_in_flight: int = 0
        max_bullets: int = 4
        last_court_size: Vec2 = Vec2{X: 640.0, Y: 480.0}
        ship: Ship = @@Ship(ship_host)
        field: AsteroidField = @@AsteroidField()
}
