@@[target("rust")]

// Stealth — guard agent AI, Rust port of the canonical controller
// (games/stealth/src/stealth.fjs). Same two systems (Guard / Stealth),
// states, the $Aware HSM parent that shares the spot_player response, the
// push$/pop$ investigate-then-resume subroutine, the three owned Guard
// instances, and the game flow $Attract -> $Playing -> $Caught/$Escaped
// plus the push$/pop$ pause. Bodies are native Rust (parens, `;`, List<T>);
// doubles throughout so timer math matches the JS baseline bit-for-bit.
// The @@[persist]/@@[save]/@@[load] contract is kept verbatim — the blob
// type is `String` as in the JS reference.

use serde::{Serialize, Deserialize};

#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize)]
pub struct Vector2 {
    pub x: f64,
    pub y: f64,
}

impl Vector2 {
    pub fn new(x: f64, y: f64) -> Vector2 { Vector2 { x, y } }
}

pub fn geo_dist(a: Vector2, b: Vector2) -> f64 {
    let dx = a.x - b.x;
    let dy = a.y - b.y;
    (dx * dx + dy * dy).sqrt()
}

@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Guard {

    interface:
        init(patrol: Vec<Vector2>, speed: f64)
        tick(dt: f64, current_pos: Vector2)
        spot_player(at: Vector2)
        hear_sound(at: Vector2)
        touched_player()
        get_state(): String
        get_target(): Vector2
        get_last_known(): Vector2
        is_aware(): bool
        is_alerted(): bool
        should_move(): bool

    machine:
        $Idle {
            init(patrol: Vec<Vector2>, speed: f64) {
                @@:self.patrol = patrol;
                @@:self.speed = speed;
                @@:self.next_wp = 0;
                if @@:self.patrol.len() > 0 {
                    @@:self.target = @@:self.patrol[0];
                }
                -> $Patrolling
            }

            tick(dt: f64, current_pos: Vector2) {
            }

            get_state(): String         { @@:("idle") }
            get_target(): Vector2       { @@:(@@:self.target) }
            get_last_known(): Vector2   { @@:(@@:self.last_known) }
            is_aware(): bool            { @@:(false) }
            is_alerted(): bool          { @@:(false) }
            should_move(): bool         { @@:(false) }
        }

        $Aware {
            spot_player(at: Vector2) {
                @@:self.last_known = at;
                -> $Alerted
            }

            touched_player() {
                -> $Engaged
            }

            get_state(): String         { @@:("aware") }
            get_target(): Vector2       { @@:(@@:self.target) }
            get_last_known(): Vector2   { @@:(@@:self.last_known) }
            is_aware(): bool            { @@:(true) }
            is_alerted(): bool          { @@:(false) }
            should_move(): bool         { @@:(true) }
        }

        $Patrolling => $Aware {
            tick(dt: f64, current_pos: Vector2) {
                if @@:self.patrol.len() == 0 {
                    return;
                }
                let d = geo_dist(current_pos, @@:self.target);
                if d < @@:self.ARRIVAL_RADIUS {
                    @@:self.next_wp = @@:self.next_wp + 1;
                    if @@:self.next_wp >= @@:self.patrol.len() as i32 {
                        @@:self.next_wp = 0;
                    }
                    @@:self.target = @@:self.patrol[@@:self.next_wp as usize];
                }
            }

            hear_sound(at: Vector2) {
                push$
                @@:self.last_known = at;
                -> $Investigating
            }

            get_state(): String         { @@:("patrolling") }
            is_aware(): bool            { @@:(false) }
            should_move(): bool         { @@:(true) }
            => $^
        }

        $Investigating => $Aware {
            $.timer: f64 = 0.0

            tick(dt: f64, current_pos: Vector2) {
                $.timer = $.timer + dt;
                if $.timer >= @@:self.INVESTIGATE_DURATION {
                    -> pop$
                }
            }

            get_state(): String { @@:("investigating") }
            should_move(): bool { @@:(false) }
            => $^
        }

        $Alerted => $Aware {
            $.chase_timer: f64 = 0.0

            spot_player(at: Vector2) {
                @@:self.last_known = at;
                $.chase_timer = 0.0;
            }

            tick(dt: f64, current_pos: Vector2) {
                @@:self.target = @@:self.last_known;
                $.chase_timer = $.chase_timer + dt;
                let d = geo_dist(current_pos, @@:self.last_known);
                if d < @@:self.ARRIVAL_RADIUS {
                    -> $Searching
                } else if $.chase_timer >= @@:self.CHASE_TIMEOUT {
                    -> $Searching
                }
            }

            get_state(): String { @@:("alerted") }
            is_alerted(): bool  { @@:(true) }
            should_move(): bool { @@:(true) }
            => $^
        }

        $Searching => $Aware {
            $.timer: f64 = 0.0

            tick(dt: f64, current_pos: Vector2) {
                $.timer = $.timer + dt;
                if $.timer >= @@:self.SEARCH_DURATION {
                    @@:self._resume_patrol(current_pos);
                    -> $Patrolling
                }
            }

            get_state(): String { @@:("searching") }
            should_move(): bool { @@:(false) }
            => $^
        }

        $Engaged {
            tick(dt: f64, current_pos: Vector2) {
            }

            get_state(): String         { @@:("engaged") }
            get_target(): Vector2       { @@:(@@:self.target) }
            get_last_known(): Vector2   { @@:(@@:self.last_known) }
            is_aware(): bool            { @@:(true) }
            is_alerted(): bool          { @@:(true) }
            should_move(): bool         { @@:(false) }
        }

    actions:
        _resume_patrol(current_pos: Vector2) {
            if @@:self.patrol.len() == 0 {
                return;
            }
            let mut best_i: i32 = 0;
            let mut best_d = geo_dist(current_pos, @@:self.patrol[0]);
            let mut i: i32 = 1;
            while i < @@:self.patrol.len() as i32 {
                let d = geo_dist(current_pos, @@:self.patrol[i as usize]);
                if d < best_d {
                    best_d = d;
                    best_i = i;
                }
                i = i + 1;
            }
            @@:self.next_wp = best_i;
            @@:self.target = @@:self.patrol[best_i as usize];
        }

    domain:
        patrol: Vec<Vector2> = Vec::new()
        next_wp: i32 = 0
        target: Vector2 = Vector2::new(0.0, 0.0)
        last_known: Vector2 = Vector2::new(0.0, 0.0)
        speed: f64 = 60.0
        ARRIVAL_RADIUS: f64 = 12.0
        INVESTIGATE_DURATION: f64 = 1.5
        SEARCH_DURATION: f64 = 3.0
        CHASE_TIMEOUT: f64 = 4.0
}

@@[main]
@@[persist(String)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Stealth {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }

    interface:
        start(p1: Vec<Vector2>, p2: Vec<Vector2>, p3: Vec<Vector2>)
        restart()
        pause()
        resume()
        tick(dt: f64, pos1: Vector2, pos2: Vector2, pos3: Vector2)
        guard_caught_player(i: i32)
        player_at_exit()
        get_state(): String
        get_elapsed(): f64
        get_caught_by(): i32

    machine:
        $Attract {
            $>() {
                @@:self.elapsed = 0.0;
                @@:self.caught_by = -1;
            }

            start(p1: Vec<Vector2>, p2: Vec<Vector2>, p3: Vec<Vector2>) {
                @@:self.guard1.init(p1, @@:self.PATROL_SPEED);
                @@:self.guard2.init(p2, @@:self.PATROL_SPEED);
                @@:self.guard3.init(p3, @@:self.PATROL_SPEED);
                -> $Playing
            }

            get_state(): String     { @@:("attract") }
            get_elapsed(): f64   { @@:(0.0) }
            get_caught_by(): i32    { @@:(-1) }
        }

        $Playing {
            tick(dt: f64, pos1: Vector2, pos2: Vector2, pos3: Vector2) {
                @@:self.elapsed = @@:self.elapsed + dt;
                @@:self.guard1.tick(dt, pos1);
                @@:self.guard2.tick(dt, pos2);
                @@:self.guard3.tick(dt, pos3);
            }

            guard_caught_player(i: i32) {
                @@:self.caught_by = i;
                if i == 0 {
                    @@:self.guard1.touched_player();
                } else if i == 1 {
                    @@:self.guard2.touched_player();
                } else if i == 2 {
                    @@:self.guard3.touched_player();
                }
                -> $Caught
            }

            player_at_exit() {
                -> $Escaped
            }

            pause() {
                push$ -> $Paused
            }

            get_state(): String     { @@:("playing") }
            get_elapsed(): f64   { @@:(@@:self.elapsed) }
            get_caught_by(): i32    { @@:(@@:self.caught_by) }
        }

        $Paused {
            resume() {
                -> pop$
            }

            get_state(): String     { @@:("paused") }
            get_elapsed(): f64   { @@:(@@:self.elapsed) }
            get_caught_by(): i32    { @@:(@@:self.caught_by) }
        }

        $Caught {
            restart() {
                -> $Attract
            }

            get_state(): String     { @@:("caught") }
            get_elapsed(): f64   { @@:(@@:self.elapsed) }
            get_caught_by(): i32    { @@:(@@:self.caught_by) }
        }

        $Escaped {
            restart() {
                -> $Attract
            }

            get_state(): String     { @@:("escaped") }
            get_elapsed(): f64   { @@:(@@:self.elapsed) }
            get_caught_by(): i32    { @@:(-1) }
        }

    domain:
        guard1: Guard = @@Guard()
        guard2: Guard = @@Guard()
        guard3: Guard = @@Guard()
        elapsed: f64 = 0.0
        caught_by: i32 = -1
        PATROL_SPEED: f64 = 95.0
}
