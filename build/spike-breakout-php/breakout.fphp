@@[target("php")]

// Breakout — PHP port (native $this->field, $param bodies, native braces).
// Enter-arg transition: Ball.launch does -> (vx, vy) $InFlight into $>(vx,vy).

@@system Ball {

    interface:
        launch(vx, vy)
        lose()
        attach()
        bounce_x()
        bounce_y()
        set_velocity(vx, vy)
        tick(dt)
        get_state()
        get_vx()
        get_vy()
        is_flying()
        respawn_progress()

    machine:
        $AttachedToPaddle {
            launch(vx, vy) { -> ($vx, $vy) $InFlight }

            get_state()         { @@:("attached") }
            get_vx()            { @@:(0.0) }
            get_vy()            { @@:(0.0) }
            is_flying()         { @@:(false) }
            respawn_progress()  { @@:(1.0) }
        }

        $InFlight {
            $.vx = 0.0
            $.vy = 0.0

            $>(vx, vy) {
                $.vx = $vx;
                $.vy = $vy;
            }

            bounce_x() { $.vx = -$.vx; }
            bounce_y() { $.vy = -$.vy; }

            set_velocity(vx, vy) {
                $.vx = $vx;
                $.vy = $vy;
            }

            lose() { -> $Lost }

            get_state()         { @@:("in_flight") }
            get_vx()            { @@:($.vx) }
            get_vy()            { @@:($.vy) }
            is_flying()         { @@:(true) }
            respawn_progress()  { @@:(1.0) }
        }

        $Lost {
            $.elapsed = 0.0

            tick(dt) {
                $.elapsed = $.elapsed + $dt;
                if ($.elapsed >= 2.0) {
                    -> $AttachedToPaddle
                }
            }

            attach() { -> $AttachedToPaddle }

            get_state()         { @@:("lost") }
            get_vx()            { @@:(0.0) }
            get_vy()            { @@:(0.0) }
            is_flying()         { @@:(false) }
            respawn_progress()  { @@:($.elapsed / 2.0) }
        }
}

@@system BrickField {

    interface:
        reset(count)
        break_brick(index)
        is_broken(index)
        remaining()
        is_cleared()

    machine:
        $Active {
            reset(count) {
                $this->bricks = [];
                $_i = 0;
                while ($_i < $count) {
                    $this->bricks[] = true;
                    $_i = $_i + 1;
                }
                $this->remaining_count = $count;
            }

            break_brick(index) {
                if ($index < 0 || $index >= count($this->bricks)) {
                    @@:return(false)
                }
                if (!$this->bricks[$index]) {
                    @@:return(false)
                }
                $this->bricks[$index] = false;
                $this->remaining_count = $this->remaining_count - 1;
                @@:(true)
            }

            is_broken(index) {
                if ($index < 0 || $index >= count($this->bricks)) {
                    @@:return(true)
                }
                @@:(!$this->bricks[$index])
            }

            remaining()  { @@:($this->remaining_count) }
            is_cleared() { @@:($this->remaining_count <= 0) }
        }

    domain:
        bricks = []
        remaining_count = 0
}

@@[main]
@@system Breakout {

    operations:
        get_current_state_name() { @@:(@@:system.state.name) }

    interface:
        start()
        launch_ball(vx, vy)
        brick_hit(index)
        paddle_hit(vx, vy)
        wall_bounce_x()
        wall_bounce_y()
        ball_fell_off()
        tick(dt)
        pause()
        resume()
        restart()
        get_state()
        get_score()
        get_lives()
        get_level()
        bricks_remaining()
        is_brick_broken(index)
        ball_state()
        ball_vx()
        ball_vy()
        ball_respawn_progress()

    machine:
        $Attract {
            $>() {
                $this->score = 0;
                $this->lives = 3;
                $this->level = 1;
                $this->bricks->reset($this->brick_count);
            }

            start() {
                $this->bricks->reset($this->brick_count);
                $this->ball->attach();
                -> $Playing
            }

            get_state()          { @@:("attract") }
            get_score()          { @@:($this->score) }
            get_lives()          { @@:($this->lives) }
            get_level()          { @@:($this->level) }
            bricks_remaining()   { @@:($this->bricks->remaining()) }
            is_brick_broken(index) { @@:($this->bricks->is_broken($index)) }
            ball_state()         { @@:($this->ball->get_state()) }
            ball_vx()            { @@:($this->ball->get_vx()) }
            ball_vy()            { @@:($this->ball->get_vy()) }
        }

        $Playing {
            launch_ball(vx, vy) {
                $this->ball->launch($vx, $vy);
            }

            brick_hit(index) {
                if ($this->bricks->break_brick($index)) {
                    $this->score = $this->score + $this->points_per_brick;
                    $this->ball->bounce_y();
                    if ($this->bricks->is_cleared()) {
                        -> $LevelClear
                    }
                }
            }

            paddle_hit(vx, vy) {
                $this->ball->set_velocity($vx, $vy);
            }

            wall_bounce_x() { $this->ball->bounce_x(); }
            wall_bounce_y() { $this->ball->bounce_y(); }

            ball_fell_off() {
                $this->lives = $this->lives - 1;
                if ($this->lives <= 0) {
                    -> $GameOver
                } else {
                    $this->ball->lose();
                }
            }

            tick(dt) { $this->ball->tick($dt); }

            pause() { push$ -> $Paused }

            get_state()          { @@:("playing") }
            get_score()          { @@:($this->score) }
            get_lives()          { @@:($this->lives) }
            get_level()          { @@:($this->level) }
            bricks_remaining()   { @@:($this->bricks->remaining()) }
            is_brick_broken(index) { @@:($this->bricks->is_broken($index)) }
            ball_state()         { @@:($this->ball->get_state()) }
            ball_vx()            { @@:($this->ball->get_vx()) }
            ball_vy()            { @@:($this->ball->get_vy()) }
            ball_respawn_progress() { @@:($this->ball->respawn_progress()) }
        }

        $LevelClear {
            $>() {
                $this->level = $this->level + 1;
            }

            start() {
                $this->bricks->reset($this->brick_count);
                $this->ball->attach();
                -> $Playing
            }

            get_state()          { @@:("level_clear") }
            get_score()          { @@:($this->score) }
            get_lives()          { @@:($this->lives) }
            get_level()          { @@:($this->level) }
            bricks_remaining()   { @@:($this->bricks->remaining()) }
            is_brick_broken(index) { @@:($this->bricks->is_broken($index)) }
            ball_state()         { @@:($this->ball->get_state()) }
            ball_vx()            { @@:($this->ball->get_vx()) }
            ball_vy()            { @@:($this->ball->get_vy()) }
        }

        $Paused {
            resume() { -> pop$ }

            get_state()          { @@:("paused") }
            get_score()          { @@:($this->score) }
            get_lives()          { @@:($this->lives) }
            get_level()          { @@:($this->level) }
            bricks_remaining()   { @@:($this->bricks->remaining()) }
            is_brick_broken(index) { @@:($this->bricks->is_broken($index)) }
            ball_state()         { @@:($this->ball->get_state()) }
            ball_vx()            { @@:($this->ball->get_vx()) }
            ball_vy()            { @@:($this->ball->get_vy()) }
        }

        $GameOver {
            restart() { -> $Attract }

            get_state()          { @@:("game_over") }
            get_score()          { @@:($this->score) }
            get_lives()          { @@:($this->lives) }
            get_level()          { @@:($this->level) }
            bricks_remaining()   { @@:($this->bricks->remaining()) }
            is_brick_broken(index) { @@:($this->bricks->is_broken($index)) }
            ball_state()         { @@:($this->ball->get_state()) }
            ball_vx()            { @@:($this->ball->get_vx()) }
            ball_vy()            { @@:($this->ball->get_vy()) }
        }

    domain:
        score = 0
        lives = 3
        level = 1
        brick_count = 40
        points_per_brick = 10
        ball = @@Ball()
        bricks = @@BrickField()
}
