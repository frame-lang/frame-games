@@[target("lua")]

-- Side-scrolling shooter — the capstone: everything composed at scale.
--
-- CANONICAL: mirrors the Godot reference
-- (frame-arcade/ch07-shooter/frame/shooter.fgd) exactly — the same
-- four systems (Player / Enemy / Boss / Shooter), states, transitions,
-- the parameterized Enemy(kind, hp, fire_rate, points), the
-- three-phase Boss HSM ($PhaseOne/$PhaseTwo/$PhaseThree parents with
-- idle/fire child leaves, HP thresholds driving phase changes), the
-- owned sub-systems (player/boss + an enemies list), and the
-- push$/pop$ pause added to the orchestrator. Only action bodies
-- differ (JS host code); the Godot ": RefCounted" base is dropped.
--
-- Boss start state is $P1Idle (lexically first) — preserved here so
-- the HSM enters $PhaseOne then the idle leaf, same as Godot.
--
-- WHAT FRAME OWNS vs THE DRIVER: Frame owns every entity's MODE
-- (player alive/hit/invuln, enemy spawn/active/dying, boss phase +
-- attack pattern) and the wave/boss scheduling. The scene owns
-- positions, bullocal physics, collision, and rendering — reading the
-- FSM's wants_to_fire*/should_spawn* signals and reporting hits back,
-- exactly like the Godot main.gd.

@@system Player {

    interface:
        tick(dt: number)
        hit()
        respawn()
        can_fire(): boolean
        can_be_hit(): boolean
        is_visible(): boolean
        get_state(): string
        get_lives(): number

    machine:
        $Alive {
            hit() { -> $Exploding }

            can_fire(): boolean    { @@:(true) }
            can_be_hit(): boolean  { @@:(true) }
            is_visible(): boolean  { @@:(true) }
            get_state(): string { @@:("alive") }
            get_lives(): number    { @@:(@@:self.lives) }
        }

        $Exploding {
            $.timer: number = 0.0
            $.duration: number = 1.0

            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    @@:self.lives = @@:self.lives - 1
                    if @@:self.lives <= 0 {
                        -> $Dead
                    } else {
                        -> $Invulnerable
                    }
                }
            }

            can_fire(): boolean    { @@:(false) }
            can_be_hit(): boolean  { @@:(false) }
            is_visible(): boolean  { @@:(true) }
            get_state(): string { @@:("exploding") }
            get_lives(): number    { @@:(@@:self.lives) }
        }

        $Invulnerable {
            $.timer: number = 0.0
            $.duration: number = 2.0

            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> $Alive
                }
            }

            can_fire(): boolean    { @@:(true) }
            can_be_hit(): boolean  { @@:(false) }
            is_visible(): boolean  { @@:(true) }
            get_state(): string { @@:("invulnerable") }
            get_lives(): number    { @@:(@@:self.lives) }
        }

        $Dead {
            respawn() {
                @@:self.lives = @@:self.starting_lives
                -> $Alive
            }

            can_fire(): boolean    { @@:(false) }
            can_be_hit(): boolean  { @@:(false) }
            is_visible(): boolean  { @@:(false) }
            get_state(): string { @@:("dead") }
            get_lives(): number    { @@:(0) }
        }

    domain:
        lives: number = 3
        starting_lives: number = 3
}

@@system Enemy(kind: number, hp: number, fire_rate: number, points: number) {

    interface:
        tick(dt: number)
        hit(damage: number)
        get_state(): string
        get_kind(): number
        get_hp(): number
        get_points(): number
        wants_to_fire(): boolean
        consume_fire()
        is_alive(): boolean
        is_cleanup(): boolean

    machine:
        $Spawning {
            $.timer: number = 0.0
            $.duration: number = 0.5

            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> $Active
                }
            }

            hit(damage: number) {
            }

            get_state(): string { @@:("spawning") }
            get_kind(): number     { @@:(@@:self.ekind) }
            get_hp(): number       { @@:(@@:self.hp_remaining) }
            get_points(): number   { @@:(@@:self.pts) }
            wants_to_fire(): boolean { @@:(false) }
            consume_fire()      { }
            is_alive(): boolean    { @@:(true) }
            is_cleanup(): boolean  { @@:(false) }
        }

        $Active {
            $.fire_timer: number = 0.0

            tick(dt: number) {
                if @@:self.rate > 0.0 {
                    $.fire_timer = $.fire_timer + dt
                }
            }

            hit(damage: number) {
                @@:self.hp_remaining = @@:self.hp_remaining - damage
                if @@:self.hp_remaining <= 0 {
                    -> $Dying
                }
            }

            get_state(): string { @@:("active") }
            get_kind(): number     { @@:(@@:self.ekind) }
            get_hp(): number       { @@:(@@:self.hp_remaining) }
            get_points(): number   { @@:(@@:self.pts) }
            wants_to_fire(): boolean {
                if @@:self.rate <= 0.0 {
                    @@:return(false)
                }
                @@:($.fire_timer >= @@:self.rate)
            }
            consume_fire()      { $.fire_timer = 0.0 }
            is_alive(): boolean    { @@:(true) }
            is_cleanup(): boolean  { @@:(false) }
        }

        $Dying {
            $.timer: number = 0.0
            $.duration: number = 0.4

            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> $Gone
                }
            }

            hit(damage: number) {
            }

            get_state(): string { @@:("dying") }
            get_kind(): number     { @@:(@@:self.ekind) }
            get_hp(): number       { @@:(0) }
            get_points(): number   { @@:(@@:self.pts) }
            wants_to_fire(): boolean { @@:(false) }
            consume_fire()      { }
            is_alive(): boolean    { @@:(false) }
            is_cleanup(): boolean  { @@:(false) }
        }

        $Gone {
            get_state(): string { @@:("gone") }
            get_kind(): number     { @@:(@@:self.ekind) }
            get_hp(): number       { @@:(0) }
            get_points(): number   { @@:(@@:self.pts) }
            wants_to_fire(): boolean { @@:(false) }
            consume_fire()      { }
            is_alive(): boolean    { @@:(false) }
            is_cleanup(): boolean  { @@:(true) }
        }

    domain:
        ekind: number = kind
        hp_remaining: number = hp
        rate: number = fire_rate
        pts: number = points
}

@@system Boss {

    interface:
        tick(dt: number)
        hit(damage: number)
        get_phase(): number
        get_hp(): number
        get_hp_fraction(): number
        get_state(): string
        is_alive(): boolean
        is_dying(): boolean
        is_gone(): boolean
        wants_to_fire_single(): boolean
        wants_to_fire_spread(): boolean
        wants_to_fire_spray(): boolean
        consume_fire()

    machine:
        $P1Idle => $PhaseOne {
            $.timer: number = 0.0
            $.idle_duration: number = 1.8

            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.idle_duration {
                    -> $P1Firing
                }
            }

            get_state(): string { @@:("p1_idle") }
            => $^
        }

        $PhaseOne {
            hit(damage: number) {
                @@:self.hp = @@:self.hp - damage
                if @@:self.hp <= @@:self.hp_start * 0.66 {
                    -> $P2Idle
                } else if @@:self.hp <= 0 {
                    -> $Dying
                }
            }

            get_phase(): number        { @@:(1) }
            get_hp(): number           { @@:(@@:self.hp) }
            get_hp_fraction(): number { @@:(@@:self.hp / @@:self.hp_start) }
            get_state(): string     { @@:("phase_one") }
            is_alive(): boolean        { @@:(true) }
            is_dying(): boolean        { @@:(false) }
            is_gone(): boolean         { @@:(false) }
            wants_to_fire_single(): boolean  { @@:(false) }
            wants_to_fire_spread(): boolean  { @@:(false) }
            wants_to_fire_spray(): boolean   { @@:(false) }
            consume_fire()          { }
        }

        $P1Firing => $PhaseOne {
            $.timer: number = 0.0
            $.duration: number = 0.4
            $.fired: boolean = false

            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> $P1Idle
                }
            }

            wants_to_fire_single(): boolean {
                if $.fired {
                    @@:return(false)
                }
                @@:(true)
            }
            consume_fire() { $.fired = true }

            get_state(): string { @@:("p1_firing") }
            => $^
        }

        $PhaseTwo {
            hit(damage: number) {
                @@:self.hp = @@:self.hp - damage
                if @@:self.hp <= @@:self.hp_start * 0.33 {
                    -> $P3Idle
                } else if @@:self.hp <= 0 {
                    -> $Dying
                }
            }

            get_phase(): number        { @@:(2) }
            get_hp(): number           { @@:(@@:self.hp) }
            get_hp_fraction(): number { @@:(@@:self.hp / @@:self.hp_start) }
            get_state(): string     { @@:("phase_two") }
            is_alive(): boolean        { @@:(true) }
            is_dying(): boolean        { @@:(false) }
            is_gone(): boolean         { @@:(false) }
            wants_to_fire_single(): boolean  { @@:(false) }
            wants_to_fire_spread(): boolean  { @@:(false) }
            wants_to_fire_spray(): boolean   { @@:(false) }
            consume_fire()          { }
        }

        $P2Idle => $PhaseTwo {
            $.timer: number = 0.0
            $.idle_duration: number = 1.3

            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.idle_duration {
                    -> $P2Spread
                }
            }

            get_state(): string { @@:("p2_idle") }
            => $^
        }

        $P2Spread => $PhaseTwo {
            $.timer: number = 0.0
            $.duration: number = 0.5
            $.fired: boolean = false

            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> $P2Idle
                }
            }

            wants_to_fire_spread(): boolean {
                if $.fired {
                    @@:return(false)
                }
                @@:(true)
            }
            consume_fire() { $.fired = true }

            get_state(): string { @@:("p2_spread") }
            => $^
        }

        $PhaseThree {
            hit(damage: number) {
                @@:self.hp = @@:self.hp - damage
                if @@:self.hp <= 0 {
                    -> $Dying
                }
            }

            get_phase(): number        { @@:(3) }
            get_hp(): number           { @@:(@@:self.hp) }
            get_hp_fraction(): number { @@:(@@:self.hp / @@:self.hp_start) }
            get_state(): string     { @@:("phase_three") }
            is_alive(): boolean        { @@:(true) }
            is_dying(): boolean        { @@:(false) }
            is_gone(): boolean         { @@:(false) }
            wants_to_fire_single(): boolean  { @@:(false) }
            wants_to_fire_spread(): boolean  { @@:(false) }
            wants_to_fire_spray(): boolean   { @@:(false) }
            consume_fire()          { }
        }

        $P3Idle => $PhaseThree {
            $.timer: number = 0.0
            $.idle_duration: number = 0.6

            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.idle_duration {
                    -> $P3Spray
                }
            }

            get_state(): string { @@:("p3_idle") }
            => $^
        }

        $P3Spray => $PhaseThree {
            $.timer: number = 0.0
            $.duration: number = 0.8
            $.fire_accumulator: number = 0.0
            $.fire_ready: boolean = false

            tick(dt: number) {
                $.timer = $.timer + dt
                $.fire_accumulator = $.fire_accumulator + dt
                if $.fire_accumulator >= 0.12 {
                    $.fire_accumulator = 0.0
                    $.fire_ready = true
                }
                if $.timer >= $.duration {
                    -> $P3Idle
                }
            }

            wants_to_fire_spray(): boolean {
                @@:($.fire_ready)
            }
            consume_fire() { $.fire_ready = false }

            get_state(): string { @@:("p3_spray") }
            => $^
        }

        $Dying {
            $.timer: number = 0.0
            $.duration: number = 2.5

            tick(dt: number) {
                $.timer = $.timer + dt
                if $.timer >= $.duration {
                    -> $Gone
                }
            }

            hit(damage: number) {
            }

            get_phase(): number        { @@:(0) }
            get_hp(): number           { @@:(0) }
            get_hp_fraction(): number { @@:(0.0) }
            get_state(): string     { @@:("dying") }
            is_alive(): boolean        { @@:(false) }
            is_dying(): boolean        { @@:(true) }
            is_gone(): boolean         { @@:(false) }
            wants_to_fire_single(): boolean  { @@:(false) }
            wants_to_fire_spread(): boolean  { @@:(false) }
            wants_to_fire_spray(): boolean   { @@:(false) }
            consume_fire()          { }
        }

        $Gone {
            get_phase(): number        { @@:(0) }
            get_hp(): number           { @@:(0) }
            get_hp_fraction(): number { @@:(0.0) }
            get_state(): string     { @@:("gone") }
            is_alive(): boolean        { @@:(false) }
            is_dying(): boolean        { @@:(false) }
            is_gone(): boolean         { @@:(true) }
            wants_to_fire_single(): boolean  { @@:(false) }
            wants_to_fire_spread(): boolean  { @@:(false) }
            wants_to_fire_spray(): boolean   { @@:(false) }
            consume_fire()          { }
        }

    domain:
        hp: number = 90
        hp_start: number = 90
}

@@[main]
@@system Shooter {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }

    interface:
        start()
        restart()
        tick(dt: number)

        add_enemy(e)
        clear_dead_enemies()

        player_hit()
        enemy_hit(index: number, damage: number): boolean
        boss_hit(damage: number): boolean

        get_state(): string
        get_score(): number
        get_lives(): number
        enemy_count(): number
        should_spawn_wave(): boolean
        consume_wave()
        should_spawn_boss(): boolean
        consume_boss_spawn()

        pause()
        resume()

    machine:
        $Attract {
            $>() {
                @@:self.score = 0
                @@:self.waves_spawned = 0
                @@:self.wave_timer = 0.0
                @@:self.boss_spawn_pending = false
            }

            start() {
                @@:self.player.respawn()
                -> $Playing
            }

            get_state(): string         { @@:("attract") }
            get_score(): number            { @@:(@@:self.score) }
            get_lives(): number            { @@:(@@:self.player.get_lives()) }
            enemy_count(): number          { @@:(#@@:self.enemies) }
            should_spawn_wave(): boolean   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): boolean   { @@:(false) }
            consume_boss_spawn()        { }
        }

        $Playing {
            tick(dt: number) {
                @@:self.player.tick(dt)
                @@:self._tick_enemies(dt)
                @@:self.wave_timer = @@:self.wave_timer + dt

                if @@:self.player.get_state() == "dead" {
                    -> $GameOver
                }

                if @@:self.waves_spawned >= @@:self.waves_before_boss {
                    -> $BossFight
                }
            }

            add_enemy(e) {
                table.insert(@@:self.enemies, e)
            }

            clear_dead_enemies() {
                @@:self._cleanup_enemies()
            }

            player_hit() {
                if @@:self.player.can_be_hit() {
                    @@:self.player.hit()
                }
            }

            enemy_hit(index: number, damage: number): boolean {
                if index < 0 or index >= #@@:self.enemies {
                    @@:return(false)
                }
                local e = @@:self.enemies[index + 1]
                e:hit(damage)
                if not e:is_alive() {
                    @@:self.score = @@:self.score + e:get_points()
                    @@:return(true)
                }
                @@:(false)
            }

            boss_hit(damage: number): boolean {
                @@:(false)
            }

            should_spawn_wave(): boolean {
                @@:(@@:self.wave_timer >= @@:self.wave_interval)
            }

            consume_wave() {
                @@:self.wave_timer = 0.0
                @@:self.waves_spawned = @@:self.waves_spawned + 1
            }

            should_spawn_boss(): boolean { @@:(false) }
            consume_boss_spawn()      { }

            pause() {
                push$ -> $Paused
            }

            get_state(): string { @@:("playing") }
            get_score(): number    { @@:(@@:self.score) }
            get_lives(): number    { @@:(@@:self.player.get_lives()) }
            enemy_count(): number  { @@:(#@@:self.enemies) }
        }

        $BossFight {
            $>() {
                @@:self.boss_spawn_pending = true
            }

            tick(dt: number) {
                @@:self.player.tick(dt)
                @@:self._tick_enemies(dt)
                @@:self.boss.tick(dt)

                if @@:self.player.get_state() == "dead" {
                    -> $GameOver
                }

                if @@:self.boss.is_gone() {
                    -> $Victory
                }
            }

            add_enemy(e) {
                table.insert(@@:self.enemies, e)
            }

            clear_dead_enemies() {
                @@:self._cleanup_enemies()
            }

            player_hit() {
                if @@:self.player.can_be_hit() {
                    @@:self.player.hit()
                }
            }

            enemy_hit(index: number, damage: number): boolean {
                if index < 0 or index >= #@@:self.enemies {
                    @@:return(false)
                }
                local e = @@:self.enemies[index + 1]
                e:hit(damage)
                if not e:is_alive() {
                    @@:self.score = @@:self.score + e:get_points()
                    @@:return(true)
                }
                @@:(false)
            }

            boss_hit(damage: number): boolean {
                @@:self.boss.hit(damage)
                if @@:self.boss.is_dying() or @@:self.boss.is_gone() {
                    @@:(true)
                } else {
                    @@:(false)
                }
            }

            should_spawn_wave(): boolean   { @@:(false) }
            consume_wave()              { }

            should_spawn_boss(): boolean   { @@:(@@:self.boss_spawn_pending) }
            consume_boss_spawn()        { @@:self.boss_spawn_pending = false }

            pause() {
                push$ -> $Paused
            }

            get_state(): string { @@:("boss_fight") }
            get_score(): number    { @@:(@@:self.score) }
            get_lives(): number    { @@:(@@:self.player.get_lives()) }
            enemy_count(): number  { @@:(#@@:self.enemies) }
        }

        $Paused {
            resume() {
                -> pop$
            }

            get_state(): string         { @@:("paused") }
            get_score(): number            { @@:(@@:self.score) }
            get_lives(): number            { @@:(@@:self.player.get_lives()) }
            enemy_count(): number          { @@:(#@@:self.enemies) }
            should_spawn_wave(): boolean   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): boolean   { @@:(false) }
            consume_boss_spawn()        { }
        }

        $Victory {
            restart() {
                -> $Attract
            }

            get_state(): string         { @@:("victory") }
            get_score(): number            { @@:(@@:self.score) }
            get_lives(): number            { @@:(@@:self.player.get_lives()) }
            enemy_count(): number          { @@:(#@@:self.enemies) }
            should_spawn_wave(): boolean   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): boolean   { @@:(false) }
            consume_boss_spawn()        { }
        }

        $GameOver {
            restart() {
                -> $Attract
            }

            get_state(): string         { @@:("game_over") }
            get_score(): number            { @@:(@@:self.score) }
            get_lives(): number            { @@:(@@:self.player.get_lives()) }
            enemy_count(): number          { @@:(#@@:self.enemies) }
            should_spawn_wave(): boolean   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): boolean   { @@:(false) }
            consume_boss_spawn()        { }
        }

    actions:
        _tick_enemies(dt: number) {
            local i = 1
            while i <= #@@:self.enemies {
                @@:self.enemies[i].tick(dt)
                i = i + 1
            }
        }

        _cleanup_enemies() {
            local i = #@@:self.enemies
            while i >= 1 {
                if @@:self.enemies[i].is_cleanup() {
                    table.remove(@@:self.enemies, i)
                }
                i = i - 1
            }
        }

    domain:
        score: number = 0
        wave_timer: number = 0.0
        wave_interval: number = 2.0
        waves_spawned: number = 0
        waves_before_boss: number = 10
        boss_spawn_pending: boolean = false
        player: Player = @@Player()
        boss: Boss = @@Boss()
        enemies: Enemy[] = {}
}
