@@[target("kotlin")]

// Breakout — C# port of the canonical controller
// (games/breakout/src/breakout.fjs). Ball / BrickField / Breakout. The star is
// the enter-argument transition: Ball.launch does `-> (vx, vy) $InFlight`,
// threading the velocity into $InFlight's `$>(vx, vy)` handler. Bodies native
// C#; doubles throughout so dt=1/64 math matches the JS baseline bit-for-bit.

@@system Ball {

    interface:
        launch(vx: Double, vy: Double)
        lose()
        attach()
        bounce_x()
        bounce_y()
        set_velocity(vx: Double, vy: Double)
        tick(dt: Double)
        get_state(): String
        get_vx(): Double
        get_vy(): Double
        is_flying(): Boolean
        respawn_progress(): Double

    machine:
        $AttachedToPaddle {
            launch(vx: Double, vy: Double) { -> (vx, vy) $InFlight }

            get_state(): String         { @@:("attached") }
            get_vx(): Double            { @@:(0.0) }
            get_vy(): Double            { @@:(0.0) }
            is_flying(): Boolean           { @@:(false) }
            respawn_progress(): Double  { @@:(1.0) }
        }

        $InFlight {
            $.vx: Double = 0.0
            $.vy: Double = 0.0

            $>(vx: Double, vy: Double) {
                $.vx = vx;
                $.vy = vy;
            }

            bounce_x() { $.vx = -$.vx; }
            bounce_y() { $.vy = -$.vy; }

            set_velocity(vx: Double, vy: Double) {
                $.vx = vx;
                $.vy = vy;
            }

            lose() { -> $Lost }

            get_state(): String         { @@:("in_flight") }
            get_vx(): Double            { @@:($.vx) }
            get_vy(): Double            { @@:($.vy) }
            is_flying(): Boolean           { @@:(true) }
            respawn_progress(): Double  { @@:(1.0) }
        }

        $Lost {
            $.elapsed: Double = 0.0

            tick(dt: Double) {
                $.elapsed = $.elapsed + dt;
                if ($.elapsed >= 2.0) {
                    -> $AttachedToPaddle
                }
            }

            attach() { -> $AttachedToPaddle }

            get_state(): String         { @@:("lost") }
            get_vx(): Double            { @@:(0.0) }
            get_vy(): Double            { @@:(0.0) }
            is_flying(): Boolean           { @@:(false) }
            respawn_progress(): Double  { @@:($.elapsed / 2.0) }
        }
}

@@system BrickField {

    interface:
        reset(count: Int)
        break_brick(index: Int): Boolean
        is_broken(index: Int): Boolean
        remaining(): Int
        is_cleared(): Boolean

    machine:
        $Active {
            reset(count: Int) {
                @@:self.bricks = mutableListOf<Boolean>();
                var _i = 0
                while (_i < count) {
                    @@:self.bricks.add(true);
                    _i = _i + 1;
                }
                @@:self.remaining_count = count;
            }

            break_brick(index: Int): Boolean {
                if (index < 0 || index >= @@:self.bricks.size) {
                    @@:return(false)
                }
                if (!@@:self.bricks[index]) {
                    @@:return(false)
                }
                @@:self.bricks[index] = false;
                @@:self.remaining_count = @@:self.remaining_count - 1;
                @@:(true)
            }

            is_broken(index: Int): Boolean {
                if (index < 0 || index >= @@:self.bricks.size) {
                    @@:return(true)
                }
                @@:(!@@:self.bricks[index])
            }

            remaining(): Int  { @@:(@@:self.remaining_count) }
            is_cleared(): Boolean { @@:(@@:self.remaining_count <= 0) }
        }

    domain:
        bricks: MutableList<Boolean> = mutableListOf<Boolean>()
        remaining_count: Int = 0
}

@@[main]
@@system Breakout {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }

    interface:
        start()
        launch_ball(vx: Double, vy: Double)
        brick_hit(index: Int)
        paddle_hit(vx: Double, vy: Double)
        wall_bounce_x()
        wall_bounce_y()
        ball_fell_off()
        tick(dt: Double)
        pause()
        resume()
        restart()
        get_state(): String
        get_score(): Int
        get_lives(): Int
        get_level(): Int
        bricks_remaining(): Int
        is_brick_broken(index: Int): Boolean
        ball_state(): String
        ball_vx(): Double
        ball_vy(): Double
        ball_respawn_progress(): Double

    machine:
        $Attract {
            $>() {
                @@:self.score = 0;
                @@:self.lives = 3;
                @@:self.level = 1;
                @@:self.bricks.reset(@@:self.brick_count);
            }

            start() {
                @@:self.bricks.reset(@@:self.brick_count);
                @@:self.ball.attach();
                -> $Playing
            }

            get_state(): String          { @@:("attract") }
            get_score(): Int             { @@:(@@:self.score) }
            get_lives(): Int             { @@:(@@:self.lives) }
            get_level(): Int             { @@:(@@:self.level) }
            bricks_remaining(): Int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: Int): Boolean { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): Double            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): Double            { @@:(@@:self.ball.get_vy()) }
        }

        $Playing {
            launch_ball(vx: Double, vy: Double) {
                @@:self.ball.launch(vx, vy);
            }

            brick_hit(index: Int) {
                if (@@:self.bricks.break_brick(index)) {
                    @@:self.score = @@:self.score + @@:self.points_per_brick;
                    @@:self.ball.bounce_y();
                    if (@@:self.bricks.is_cleared()) {
                        -> $LevelClear
                    }
                }
            }

            paddle_hit(vx: Double, vy: Double) {
                @@:self.ball.set_velocity(vx, vy);
            }

            wall_bounce_x() { @@:self.ball.bounce_x(); }
            wall_bounce_y() { @@:self.ball.bounce_y(); }

            ball_fell_off() {
                @@:self.lives = @@:self.lives - 1;
                if (@@:self.lives <= 0) {
                    -> $GameOver
                } else {
                    @@:self.ball.lose();
                }
            }

            tick(dt: Double) { @@:self.ball.tick(dt); }

            pause() { push$ -> $Paused }

            get_state(): String          { @@:("playing") }
            get_score(): Int             { @@:(@@:self.score) }
            get_lives(): Int             { @@:(@@:self.lives) }
            get_level(): Int             { @@:(@@:self.level) }
            bricks_remaining(): Int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: Int): Boolean { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): Double            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): Double            { @@:(@@:self.ball.get_vy()) }
            ball_respawn_progress(): Double { @@:(@@:self.ball.respawn_progress()) }
        }

        $LevelClear {
            $>() {
                @@:self.level = @@:self.level + 1;
            }

            start() {
                @@:self.bricks.reset(@@:self.brick_count);
                @@:self.ball.attach();
                -> $Playing
            }

            get_state(): String          { @@:("level_clear") }
            get_score(): Int             { @@:(@@:self.score) }
            get_lives(): Int             { @@:(@@:self.lives) }
            get_level(): Int             { @@:(@@:self.level) }
            bricks_remaining(): Int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: Int): Boolean { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): Double            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): Double            { @@:(@@:self.ball.get_vy()) }
        }

        $Paused {
            resume() { -> pop$ }

            get_state(): String          { @@:("paused") }
            get_score(): Int             { @@:(@@:self.score) }
            get_lives(): Int             { @@:(@@:self.lives) }
            get_level(): Int             { @@:(@@:self.level) }
            bricks_remaining(): Int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: Int): Boolean { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): Double            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): Double            { @@:(@@:self.ball.get_vy()) }
        }

        $GameOver {
            restart() { -> $Attract }

            get_state(): String          { @@:("game_over") }
            get_score(): Int             { @@:(@@:self.score) }
            get_lives(): Int             { @@:(@@:self.lives) }
            get_level(): Int             { @@:(@@:self.level) }
            bricks_remaining(): Int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: Int): Boolean { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): Double            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): Double            { @@:(@@:self.ball.get_vy()) }
        }

    domain:
        score: Int = 0
        lives: Int = 3
        level: Int = 1
        brick_count: Int = 40
        points_per_brick: Int = 10
        ball: Ball = @@Ball()
        bricks: BrickField = @@BrickField()
}
