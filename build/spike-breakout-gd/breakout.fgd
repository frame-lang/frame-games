@@[target("gdscript")]

# Breakout — GDScript port (derived from the .fjs/.fcs; the ch02 fgd is an of the canonical controller
# (games/breakout/src/breakout.fjs). Ball / BrickField / Breakout. The star is
# the enter-argument transition: Ball.launch does `-> (vx, vy) $InFlight`,
# threading the velocity into $InFlight's `$>(vx, vy)` handler. Bodies native
# C#; doubles throughout so dt=1/64 math matches the JS baseline bit-for-bit.

@@system Ball : RefCounted {

    interface:
        launch(vx: float, vy: float)
        lose()
        attach()
        bounce_x()
        bounce_y()
        set_velocity(vx: float, vy: float)
        tick(dt: float)
        get_state(): String
        get_vx(): float
        get_vy(): float
        is_flying(): bool
        respawn_progress(): float

    machine:
        $AttachedToPaddle {
            launch(vx: float, vy: float) { -> (vx, vy) $InFlight }

            get_state(): String         { @@:("attached") }
            get_vx(): float            { @@:(0.0) }
            get_vy(): float            { @@:(0.0) }
            is_flying(): bool           { @@:(false) }
            respawn_progress(): float  { @@:(1.0) }
        }

        $InFlight {
            $.vx: float = 0.0
            $.vy: float = 0.0

            $>(vx: float, vy: float) {
                $.vx = vx
                $.vy = vy
            }

            bounce_x() { $.vx = -$.vx; }
            bounce_y() { $.vy = -$.vy; }

            set_velocity(vx: float, vy: float) {
                $.vx = vx
                $.vy = vy
            }

            lose() { -> $Lost }

            get_state(): String         { @@:("in_flight") }
            get_vx(): float            { @@:($.vx) }
            get_vy(): float            { @@:($.vy) }
            is_flying(): bool           { @@:(true) }
            respawn_progress(): float  { @@:(1.0) }
        }

        $Lost {
            $.elapsed: float = 0.0

            tick(dt: float) {
                $.elapsed = $.elapsed + dt
                if $.elapsed >= 2.0:
                    -> $AttachedToPaddle
            }

            attach() { -> $AttachedToPaddle }

            get_state(): String         { @@:("lost") }
            get_vx(): float            { @@:(0.0) }
            get_vy(): float            { @@:(0.0) }
            is_flying(): bool           { @@:(false) }
            respawn_progress(): float  { @@:($.elapsed / 2.0) }
        }
}

@@system BrickField : RefCounted {

    interface:
        reset(count: int)
        break_brick(index: int): bool
        is_broken(index: int): bool
        remaining(): int
        is_cleared(): bool

    machine:
        $Active {
            reset(count: int) {
                @@:self.bricks = []
                var _i = 0
                while _i < count:
                    @@:self.bricks.append(true)
                    _i = _i + 1
                @@:self.remaining_count = count
            }

            break_brick(index: int): bool {
                if index < 0 or index >= @@:self.bricks.size():
                    @@:return(false)
                if not @@:self.bricks[index]:
                    @@:return(false)
                @@:self.bricks[index] = false
                @@:self.remaining_count = @@:self.remaining_count - 1
                @@:(true)
            }

            is_broken(index: int): bool {
                if index < 0 or index >= @@:self.bricks.size():
                    @@:return(true)
                @@:(not @@:self.bricks[index])
            }

            remaining(): int  { @@:(@@:self.remaining_count) }
            is_cleared(): bool { @@:(@@:self.remaining_count <= 0) }
        }

    domain:
        bricks: Array = []
        remaining_count: int = 0
}

@@[main]
@@system Breakout : RefCounted {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }

    interface:
        start()
        launch_ball(vx: float, vy: float)
        brick_hit(index: int)
        paddle_hit(vx: float, vy: float)
        wall_bounce_x()
        wall_bounce_y()
        ball_fell_off()
        tick(dt: float)
        pause()
        resume()
        restart()
        get_state(): String
        get_score(): int
        get_lives(): int
        get_level(): int
        bricks_remaining(): int
        is_brick_broken(index: int): bool
        ball_state(): String
        ball_vx(): float
        ball_vy(): float
        ball_respawn_progress(): float

    machine:
        $Attract {
            $>() {
                @@:self.score = 0
                @@:self.lives = 3
                @@:self.level = 1
                @@:self.bricks.reset(@@:self.brick_count)
            }

            start() {
                @@:self.bricks.reset(@@:self.brick_count)
                @@:self.ball.attach()
                -> $Playing
            }

            get_state(): String          { @@:("attract") }
            get_score(): int             { @@:(@@:self.score) }
            get_lives(): int             { @@:(@@:self.lives) }
            get_level(): int             { @@:(@@:self.level) }
            bricks_remaining(): int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: int): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): float            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): float            { @@:(@@:self.ball.get_vy()) }
        }

        $Playing {
            launch_ball(vx: float, vy: float) {
                @@:self.ball.launch(vx, vy)
            }

            brick_hit(index: int) {
                if @@:self.bricks.break_brick(index):
                    @@:self.score = @@:self.score + @@:self.points_per_brick
                    @@:self.ball.bounce_y()
                    if @@:self.bricks.is_cleared():
                        -> $LevelClear
            }

            paddle_hit(vx: float, vy: float) {
                @@:self.ball.set_velocity(vx, vy)
            }

            wall_bounce_x() { @@:self.ball.bounce_x(); }
            wall_bounce_y() { @@:self.ball.bounce_y(); }

            ball_fell_off() {
                @@:self.lives = @@:self.lives - 1
                if @@:self.lives <= 0:
                    -> $GameOver
                else:
                    @@:self.ball.lose()
            }

            tick(dt: float) { @@:self.ball.tick(dt); }

            pause() { push$ -> $Paused }

            get_state(): String          { @@:("playing") }
            get_score(): int             { @@:(@@:self.score) }
            get_lives(): int             { @@:(@@:self.lives) }
            get_level(): int             { @@:(@@:self.level) }
            bricks_remaining(): int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: int): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): float            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): float            { @@:(@@:self.ball.get_vy()) }
            ball_respawn_progress(): float { @@:(@@:self.ball.respawn_progress()) }
        }

        $LevelClear {
            $>() {
                @@:self.level = @@:self.level + 1
            }

            start() {
                @@:self.bricks.reset(@@:self.brick_count)
                @@:self.ball.attach()
                -> $Playing
            }

            get_state(): String          { @@:("level_clear") }
            get_score(): int             { @@:(@@:self.score) }
            get_lives(): int             { @@:(@@:self.lives) }
            get_level(): int             { @@:(@@:self.level) }
            bricks_remaining(): int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: int): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): float            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): float            { @@:(@@:self.ball.get_vy()) }
        }

        $Paused {
            resume() { -> pop$ }

            get_state(): String          { @@:("paused") }
            get_score(): int             { @@:(@@:self.score) }
            get_lives(): int             { @@:(@@:self.lives) }
            get_level(): int             { @@:(@@:self.level) }
            bricks_remaining(): int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: int): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): float            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): float            { @@:(@@:self.ball.get_vy()) }
        }

        $GameOver {
            restart() { -> $Attract }

            get_state(): String          { @@:("game_over") }
            get_score(): int             { @@:(@@:self.score) }
            get_lives(): int             { @@:(@@:self.lives) }
            get_level(): int             { @@:(@@:self.level) }
            bricks_remaining(): int      { @@:(@@:self.bricks.remaining()) }
            is_brick_broken(index: int): bool { @@:(@@:self.bricks.is_broken(index)) }
            ball_state(): String         { @@:(@@:self.ball.get_state()) }
            ball_vx(): float            { @@:(@@:self.ball.get_vx()) }
            ball_vy(): float            { @@:(@@:self.ball.get_vy()) }
        }

    domain:
        score: int = 0
        lives: int = 3
        level: int = 1
        brick_count: int = 40
        points_per_brick: int = 10
        ball: Ball = @@Ball()
        bricks: BrickField = @@BrickField()
}
