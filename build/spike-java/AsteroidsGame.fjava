@@[target("java")]

// Asteroids — Java port of the Frame controller. Same three systems as every
// other port. Java is a typed backend with native-passthrough control flow
// (like the C#/Kotlin/Dart ports): native `if (cond) {` / `while (cond) {` with
// `;`-terminated statements, and the Frame splices `@@:self.X` (domain/self),
// `$.x` (state var), `@@:(e)` / `@@:return(e)` (return slot), transitions.
// Java specifics: types required (int/double/boolean/String/List); non-main
// systems must be `@@system private` (one public class per file — E430); the
// file is named after the public system (AsteroidsGame.java); `@@Sys(a)` lowers
// to `Sys.__create(a)`. No operator overloading, so Vec2 uses methods.
import java.util.List;
import java.util.ArrayList;

class Vec2 {
    public double x, y;
    public Vec2(double x, double y) { this.x = x; this.y = y; }
    public Vec2 add(Vec2 o) { return new Vec2(x + o.x, y + o.y); }
    public Vec2 scale(double s) { return new Vec2(x * s, y * s); }
    public double length() { return Math.sqrt(x * x + y * y); }
    public double distanceTo(Vec2 o) { return Math.sqrt((x - o.x) * (x - o.x) + (y - o.y) * (y - o.y)); }
    public static Vec2 fromAngle(double a, double speed) { return new Vec2(Math.cos(a) * speed, Math.sin(a) * speed); }
}

class Asteroid {
    public Vec2 pos, vel;
    public int size;
    public boolean alive;
    public Asteroid(Vec2 pos, Vec2 vel, int size, boolean alive) {
        this.pos = pos; this.vel = vel; this.size = size; this.alive = alive;
    }
}

interface IShipHost {
    void warp_out();
    void warp_in();
    void spawn_explosion();
    void reset_ship();
}

// ------------------------------------------------------------ Ship
@@system private Ship(host: IShipHost) {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }
        get_hyperspaces_remaining(): int { @@:(@@:self.hyperspaces_remaining) }

    interface:
        tick(dt: double)
        hit()
        hyperspace()
        respawn()
        fire()
        can_fire(): boolean
        can_be_hit(): boolean
        can_hyperspace(): boolean
        is_visible(): boolean
        is_alive(): boolean
        get_lives(): int

    machine:

        $Alive {
            $.cooldown: double = 0.0
            tick(dt: double) {
                if ($.cooldown > 0.0) {
                    $.cooldown = $.cooldown - dt;
                }
            }
            fire() { $.cooldown = 0.22; }
            hit() { -> $Exploding }
            hyperspace() {
                if (@@:self.hyperspaces_remaining > 0) {
                    @@:self.hyperspaces_remaining = @@:self.hyperspaces_remaining - 1;
                    -> $InHyperspace
                }
            }
            can_fire(): boolean       { @@:($.cooldown <= 0.0) }
            can_be_hit(): boolean     { @@:(true) }
            can_hyperspace(): boolean { @@:(@@:self.hyperspaces_remaining > 0) }
            is_visible(): boolean     { @@:(true) }
            is_alive(): boolean       { @@:(true) }
            get_lives(): int          { @@:(@@:self.lives_remaining) }
        }

        $InHyperspace {
            $.timer: double = 0.0
            $.duration: double = 0.4
            $>() { @@:self.host.warp_out(); }
            <$() { @@:self.host.warp_in(); }
            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.duration) {
                    -> "warp complete" $Alive
                }
            }
            can_fire(): boolean       { @@:(false) }
            can_be_hit(): boolean     { @@:(false) }
            can_hyperspace(): boolean { @@:(false) }
            is_visible(): boolean     { @@:(false) }
            is_alive(): boolean       { @@:(true) }
            get_lives(): int          { @@:(@@:self.lives_remaining) }
        }

        $Exploding {
            $.timer: double = 0.0
            $.duration: double = 1.0
            $>() { @@:self.host.spawn_explosion(); }
            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.duration) {
                    @@:self.lives_remaining = @@:self.lives_remaining - 1;
                    if (@@:self.lives_remaining <= 0) {
                        -> "no lives left" $Dead
                    } else {
                        -> "lives remain" $Respawning
                    }
                }
            }
            can_fire(): boolean       { @@:(false) }
            can_be_hit(): boolean     { @@:(false) }
            can_hyperspace(): boolean { @@:(false) }
            is_visible(): boolean     { @@:(true) }
            is_alive(): boolean       { @@:(false) }
            get_lives(): int          { @@:(@@:self.lives_remaining) }
        }

        $Respawning {
            $.timer: double = 0.0
            $.duration: double = 2.0
            $>() { @@:self.host.reset_ship(); }
            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.duration) {
                    -> "invuln expired" $Alive
                }
            }
            can_fire(): boolean       { @@:(true) }
            can_be_hit(): boolean     { @@:(false) }
            can_hyperspace(): boolean { @@:(false) }
            is_visible(): boolean     { @@:(true) }
            is_alive(): boolean       { @@:(true) }
            get_lives(): int          { @@:(@@:self.lives_remaining) }
        }

        $Dead {
            respawn() {
                @@:self.lives_remaining = @@:self.starting_lives;
                @@:self.hyperspaces_remaining = @@:self.starting_hyperspaces;
                -> $Respawning
            }
            can_fire(): boolean       { @@:(false) }
            can_be_hit(): boolean     { @@:(false) }
            can_hyperspace(): boolean { @@:(false) }
            is_visible(): boolean     { @@:(false) }
            is_alive(): boolean       { @@:(false) }
            get_lives(): int          { @@:(0) }
        }

    domain:
        host: IShipHost = host
        lives_remaining: int = 3
        starting_lives: int = 3
        hyperspaces_remaining: int = 3
        starting_hyperspaces: int = 3
}

// ------------------------------------------------------------ AsteroidField
@@system private AsteroidField {

    interface:
        spawn_wave(count: int, court_size: Vec2)
        split(index: int): boolean
        remove(index: int)
        clear()
        advance(dt: double, court_size: Vec2)
        count(): int
        alive_count(): int
        is_alive(index: int): boolean
        position(index: int): Vec2
        velocity(index: int): Vec2
        size_of(index: int): int
        radius_of(index: int): double

    machine:

        $Active {
            spawn_wave(count: int, court_size: Vec2) {
                @@:self.asteroids = new ArrayList<Asteroid>();
                int i = 0;
                while (i < count) {
                    @@:self.spawn_large(court_size);
                    i = i + 1;
                }
            }

            split(index: int): boolean {
                if (index < 0 || index >= @@:self.asteroids.size()) {
                    @@:return(false)
                }
                if (!@@:self.asteroids.get(index).alive) {
                    @@:return(false)
                }
                @@:self.asteroids.get(index).alive = false;
                int sz = @@:self.asteroids.get(index).size;
                Vec2 p = @@:self.asteroids.get(index).pos;
                if (sz > 1) {
                    @@:self.spawn_child(p, sz - 1);
                    @@:self.spawn_child(p, sz - 1);
                }
                @@:(true)
            }

            remove(index: int) {
                if (index < 0 || index >= @@:self.asteroids.size()) {
                    return;
                }
                @@:self.asteroids.get(index).alive = false;
            }

            clear() { @@:self.asteroids = new ArrayList<Asteroid>(); }

            advance(dt: double, court_size: Vec2) {
                int i = 0;
                while (i < @@:self.asteroids.size()) {
                    if (@@:self.asteroids.get(i).alive) {
                        @@:self.asteroids.get(i).pos = @@:self.asteroids.get(i).pos.add(@@:self.asteroids.get(i).vel.scale(dt));
                        if (@@:self.asteroids.get(i).pos.x < 0.0) { @@:self.asteroids.get(i).pos.x = @@:self.asteroids.get(i).pos.x + court_size.x; }
                        if (@@:self.asteroids.get(i).pos.x > court_size.x) { @@:self.asteroids.get(i).pos.x = @@:self.asteroids.get(i).pos.x - court_size.x; }
                        if (@@:self.asteroids.get(i).pos.y < 0.0) { @@:self.asteroids.get(i).pos.y = @@:self.asteroids.get(i).pos.y + court_size.y; }
                        if (@@:self.asteroids.get(i).pos.y > court_size.y) { @@:self.asteroids.get(i).pos.y = @@:self.asteroids.get(i).pos.y - court_size.y; }
                    }
                    i = i + 1;
                }
            }

            count(): int { @@:(@@:self.asteroids.size()) }

            alive_count(): int {
                int c = 0;
                int i = 0;
                while (i < @@:self.asteroids.size()) {
                    if (@@:self.asteroids.get(i).alive) { c = c + 1; }
                    i = i + 1;
                }
                @@:(c)
            }

            is_alive(index: int): boolean {
                if (index < 0 || index >= @@:self.asteroids.size()) {
                    @@:return(false)
                }
                @@:(@@:self.asteroids.get(index).alive)
            }

            position(index: int): Vec2 {
                if (index < 0 || index >= @@:self.asteroids.size()) {
                    @@:return(new Vec2(0.0, 0.0))
                }
                @@:(@@:self.asteroids.get(index).pos)
            }

            velocity(index: int): Vec2 {
                if (index < 0 || index >= @@:self.asteroids.size()) {
                    @@:return(new Vec2(0.0, 0.0))
                }
                @@:(@@:self.asteroids.get(index).vel)
            }

            size_of(index: int): int {
                if (index < 0 || index >= @@:self.asteroids.size()) {
                    @@:return(0)
                }
                @@:(@@:self.asteroids.get(index).size)
            }

            radius_of(index: int): double {
                if (index < 0 || index >= @@:self.asteroids.size()) {
                    @@:return(0.0)
                }
                int sz = @@:self.asteroids.get(index).size;
                if (sz == 3) { @@:return(32.0) }
                if (sz == 2) { @@:return(18.0) }
                @@:(10.0)
            }
        }

    actions:

        spawn_large(court_size: Vec2) {
            int edge = (int)(Math.random() * 4);
            Vec2 pos = new Vec2(0.0, 0.0);
            if (edge == 0) {
                pos = new Vec2(0.0, Math.random() * court_size.y);
            } else if (edge == 1) {
                pos = new Vec2(court_size.x, Math.random() * court_size.y);
            } else if (edge == 2) {
                pos = new Vec2(Math.random() * court_size.x, 0.0);
            } else {
                pos = new Vec2(Math.random() * court_size.x, court_size.y);
            }
            double angle = Math.random() * 2.0 * Math.PI;
            double speed = 40.0 + Math.random() * 30.0;
            Vec2 vel = Vec2.fromAngle(angle, speed);
            @@:self.asteroids.add(new Asteroid(pos, vel, 3, true));
        }

        spawn_child(pos: Vec2, size: int) {
            double angle = Math.random() * 2.0 * Math.PI;
            double speed = 60.0 + Math.random() * 40.0 + (3 - size) * 20.0;
            Vec2 vel = Vec2.fromAngle(angle, speed);
            @@:self.asteroids.add(new Asteroid(pos, vel, size, true));
        }

    domain:
        asteroids: List<Asteroid> = new ArrayList<Asteroid>()
}

// ------------------------------------------------------------ AsteroidsGame
@@[main]
@@system AsteroidsGame(ship_host: IShipHost, difficulty: int) {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }
        get_bullets_in_flight(): int { @@:(@@:self.bullets_in_flight) }
        get_max_bullets(): int       { @@:(@@:self.max_bullets) }

    interface:
        start()
        restart()
        pause()
        resume()
        tick(dt: double, court_size: Vec2)
        ship_hit_asteroid(index: int)
        bullet_hit_asteroid(index: int)
        ship_hyperspace()
        bullet_fired()
        bullet_expired()
        get_score(): int
        get_lives(): int
        get_wave(): int
        get_difficulty(): int
        is_paused(): boolean

    machine:

        $Attract {
            $>() {
                @@:self.score = 0;
                @@:self.wave = 1;
                @@:self.bullets_in_flight = 0;
            }
            start() {
                @@:self.ship.respawn();
                int n = @@:self.asteroids_for_wave(1);
                @@:self.field.spawn_wave(n, @@:self.last_court_size);
                -> $Playing
            }
            get_score(): int      { @@:(@@:self.score) }
            get_lives(): int      { @@:(@@:self.ship.get_lives()) }
            get_wave(): int       { @@:(@@:self.wave) }
            get_difficulty(): int { @@:(@@:self.difficulty) }
            is_paused(): boolean  { @@:(false) }
        }

        $InGame {
            pause() {
                push$ -> $Paused
            }
            bullet_fired() {
                @@:self.bullets_in_flight = @@:self.bullets_in_flight + 1;
            }
            bullet_expired() {
                if (@@:self.bullets_in_flight > 0) {
                    @@:self.bullets_in_flight = @@:self.bullets_in_flight - 1;
                }
            }
            get_score(): int      { @@:(@@:self.score) }
            get_lives(): int      { @@:(@@:self.ship.get_lives()) }
            get_wave(): int       { @@:(@@:self.wave) }
            get_difficulty(): int { @@:(@@:self.difficulty) }
            is_paused(): boolean  { @@:(false) }
        }

        $Playing => $InGame {
            tick(dt: double, court_size: Vec2) {
                @@:self.last_court_size = court_size;
                @@:self.ship.tick(dt);
                @@:self.field.advance(dt, court_size);
            }
            ship_hit_asteroid(index: int) {
                if (!@@:self.ship.can_be_hit()) {
                    return;
                }
                @@:self.ship.hit();
                -> $ShipDying
            }
            bullet_hit_asteroid(index: int) {
                if (@@:self.field.split(index)) {
                    int sz = @@:self.size_points(index);
                    @@:self.score = @@:self.score + sz * @@:self.difficulty;
                    if (@@:self.field.alive_count() <= 0) {
                        -> "all asteroids cleared" $WaveClear
                    }
                }
            }
            ship_hyperspace() {
                @@:self.ship.hyperspace();
            }
            => $^
        }

        $ShipDying => $InGame {
            tick(dt: double, court_size: Vec2) {
                @@:self.last_court_size = court_size;
                @@:self.ship.tick(dt);
                @@:self.field.advance(dt, court_size);
                if (@@:self.ship.get_current_state_name() == "Respawning") {
                    -> "ship respawning" $Playing
                } else if (@@:self.ship.get_current_state_name() == "Dead") {
                    -> "no lives left" $GameOver
                }
            }
            => $^
        }

        $WaveClear => $InGame {
            $>() { @@:self.wave_timer = 0.0; }
            tick(dt: double, court_size: Vec2) {
                @@:self.last_court_size = court_size;
                @@:self.ship.tick(dt);
                @@:self.wave_timer = @@:self.wave_timer + dt;
                if (@@:self.wave_timer >= @@:self.wave_pause) {
                    @@:self.wave = @@:self.wave + 1;
                    int n = @@:self.asteroids_for_wave(@@:self.wave);
                    @@:self.field.spawn_wave(n, court_size);
                    -> "next wave" $Playing
                }
            }
            => $^
        }

        $Paused {
            resume() {
                -> pop$
            }
            get_score(): int      { @@:(@@:self.score) }
            get_lives(): int      { @@:(@@:self.ship.get_lives()) }
            get_wave(): int       { @@:(@@:self.wave) }
            get_difficulty(): int { @@:(@@:self.difficulty) }
            is_paused(): boolean  { @@:(true) }
        }

        $GameOver {
            restart() {
                -> $Attract
            }
            get_score(): int      { @@:(@@:self.score) }
            get_lives(): int      { @@:(@@:self.ship.get_lives()) }
            get_wave(): int       { @@:(@@:self.wave) }
            get_difficulty(): int { @@:(@@:self.difficulty) }
            is_paused(): boolean  { @@:(false) }
        }

    actions:

        asteroids_for_wave(wave: int): int {
            int base_count = 2 + @@:self.difficulty;
            return base_count + wave - 1;
        }

        size_points(index: int): int {
            int sz = @@:self.field.size_of(index);
            if (sz == 3) { return 20; }
            if (sz == 2) { return 50; }
            return 100;
        }

    domain:
        difficulty: int = difficulty
        score: int = 0
        wave: int = 1
        wave_timer: double = 0.0
        wave_pause: double = 2.0
        bullets_in_flight: int = 0
        max_bullets: int = 4
        last_court_size: Vec2 = new Vec2(640.0, 480.0)
        ship: Ship = @@Ship(ship_host)
        field: AsteroidField = @@AsteroidField()
}
