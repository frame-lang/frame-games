@@[target("java")]

// Side-scrolling shooter — Java port of the canonical capstone controller
// (games/shooter/src/shooter.fjs, which mirrors the Godot ch07 reference).
// Same four systems (Player / Enemy / Boss / Shooter), states, transitions,
// the parameterized Enemy(kind, hp, fire_rate, points), the three-phase Boss
// HSM (phase parents own hit()/thresholds; idle/fire leaves), the owned
// player/boss + driver-populated enemies list, and the push$/pop$ pause.
// Bodies are native Java; doubles for all timers so the oracle's dt=1/64
// arithmetic matches the JS baseline bit-for-bit. Non-main systems are
// @@system private (one public class per file — E430).

import java.util.List;
import java.util.ArrayList;

// ------------------------------------------------------------ Player
@@system private Player {

    interface:
        tick(dt: double)
        hit()
        respawn()
        can_fire(): boolean
        can_be_hit(): boolean
        is_visible(): boolean
        get_state(): String
        get_lives(): int

    machine:
        $Alive {
            hit() { -> $Exploding }

            can_fire(): boolean    { @@:(true) }
            can_be_hit(): boolean  { @@:(true) }
            is_visible(): boolean  { @@:(true) }
            get_state(): String { @@:("alive") }
            get_lives(): int    { @@:(@@:self.lives) }
        }

        $Exploding {
            $.timer: double = 0.0
            $.duration: double = 1.0

            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.duration) {
                    @@:self.lives = @@:self.lives - 1;
                    if (@@:self.lives <= 0) {
                        -> $Dead
                    } else {
                        -> $Invulnerable
                    }
                }
            }

            can_fire(): boolean    { @@:(false) }
            can_be_hit(): boolean  { @@:(false) }
            is_visible(): boolean  { @@:(true) }
            get_state(): String { @@:("exploding") }
            get_lives(): int    { @@:(@@:self.lives) }
        }

        $Invulnerable {
            $.timer: double = 0.0
            $.duration: double = 2.0

            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.duration) {
                    -> $Alive
                }
            }

            can_fire(): boolean    { @@:(true) }
            can_be_hit(): boolean  { @@:(false) }
            is_visible(): boolean  { @@:(true) }
            get_state(): String { @@:("invulnerable") }
            get_lives(): int    { @@:(@@:self.lives) }
        }

        $Dead {
            respawn() {
                @@:self.lives = @@:self.starting_lives;
                -> $Alive
            }

            can_fire(): boolean    { @@:(false) }
            can_be_hit(): boolean  { @@:(false) }
            is_visible(): boolean  { @@:(false) }
            get_state(): String { @@:("dead") }
            get_lives(): int    { @@:(0) }
        }

    domain:
        lives: int = 3
        starting_lives: int = 3
}

// ------------------------------------------------------------ Enemy
@@system private Enemy(kind: int, hp: int, fire_rate: double, points: int) {

    interface:
        tick(dt: double)
        hit(damage: int)
        get_state(): String
        get_kind(): int
        get_hp(): int
        get_points(): int
        wants_to_fire(): boolean
        consume_fire()
        is_alive(): boolean
        is_cleanup(): boolean

    machine:
        $Spawning {
            $.timer: double = 0.0
            $.duration: double = 0.5

            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.duration) {
                    -> $Active
                }
            }

            hit(damage: int) {
            }

            get_state(): String { @@:("spawning") }
            get_kind(): int     { @@:(@@:self.ekind) }
            get_hp(): int       { @@:(@@:self.hp_remaining) }
            get_points(): int   { @@:(@@:self.pts) }
            wants_to_fire(): boolean { @@:(false) }
            consume_fire()      { }
            is_alive(): boolean    { @@:(true) }
            is_cleanup(): boolean  { @@:(false) }
        }

        $Active {
            $.fire_timer: double = 0.0

            tick(dt: double) {
                if (@@:self.rate > 0.0) {
                    $.fire_timer = $.fire_timer + dt;
                }
            }

            hit(damage: int) {
                @@:self.hp_remaining = @@:self.hp_remaining - damage;
                if (@@:self.hp_remaining <= 0) {
                    -> $Dying
                }
            }

            get_state(): String { @@:("active") }
            get_kind(): int     { @@:(@@:self.ekind) }
            get_hp(): int       { @@:(@@:self.hp_remaining) }
            get_points(): int   { @@:(@@:self.pts) }
            wants_to_fire(): boolean {
                if (@@:self.rate <= 0.0) {
                    @@:return(false)
                }
                @@:($.fire_timer >= @@:self.rate)
            }
            consume_fire()      { $.fire_timer = 0.0; }
            is_alive(): boolean    { @@:(true) }
            is_cleanup(): boolean  { @@:(false) }
        }

        $Dying {
            $.timer: double = 0.0
            $.duration: double = 0.4

            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.duration) {
                    -> $Gone
                }
            }

            hit(damage: int) {
            }

            get_state(): String { @@:("dying") }
            get_kind(): int     { @@:(@@:self.ekind) }
            get_hp(): int       { @@:(0) }
            get_points(): int   { @@:(@@:self.pts) }
            wants_to_fire(): boolean { @@:(false) }
            consume_fire()      { }
            is_alive(): boolean    { @@:(false) }
            is_cleanup(): boolean  { @@:(false) }
        }

        $Gone {
            get_state(): String { @@:("gone") }
            get_kind(): int     { @@:(@@:self.ekind) }
            get_hp(): int       { @@:(0) }
            get_points(): int   { @@:(@@:self.pts) }
            wants_to_fire(): boolean { @@:(false) }
            consume_fire()      { }
            is_alive(): boolean    { @@:(false) }
            is_cleanup(): boolean  { @@:(true) }
        }

    domain:
        ekind: int = kind
        hp_remaining: int = hp
        rate: double = fire_rate
        pts: int = points
}

// ------------------------------------------------------------ Boss
@@system private Boss {

    interface:
        tick(dt: double)
        hit(damage: int)
        get_phase(): int
        get_hp(): int
        get_hp_fraction(): double
        get_state(): String
        is_alive(): boolean
        is_dying(): boolean
        is_gone(): boolean
        wants_to_fire_single(): boolean
        wants_to_fire_spread(): boolean
        wants_to_fire_spray(): boolean
        consume_fire()

    machine:
        $P1Idle => $PhaseOne {
            $.timer: double = 0.0
            $.idle_duration: double = 1.8

            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.idle_duration) {
                    -> $P1Firing
                }
            }

            get_state(): String { @@:("p1_idle") }
            => $^
        }

        $PhaseOne {
            hit(damage: int) {
                @@:self.hp = @@:self.hp - damage;
                if (@@:self.hp <= @@:self.hp_start * 0.66) {
                    -> $P2Idle
                } else if (@@:self.hp <= 0) {
                    -> $Dying
                }
            }

            get_phase(): int        { @@:(1) }
            get_hp(): int           { @@:(@@:self.hp) }
            get_hp_fraction(): double { @@:((double)@@:self.hp / @@:self.hp_start) }
            get_state(): String     { @@:("phase_one") }
            is_alive(): boolean        { @@:(true) }
            is_dying(): boolean        { @@:(false) }
            is_gone(): boolean         { @@:(false) }
            wants_to_fire_single(): boolean  { @@:(false) }
            wants_to_fire_spread(): boolean  { @@:(false) }
            wants_to_fire_spray(): boolean   { @@:(false) }
            consume_fire()          { }
        }

        $P1Firing => $PhaseOne {
            $.timer: double = 0.0
            $.duration: double = 0.4
            $.fired: boolean = false

            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.duration) {
                    -> $P1Idle
                }
            }

            wants_to_fire_single(): boolean {
                if ($.fired) {
                    @@:return(false)
                }
                @@:(true)
            }
            consume_fire() { $.fired = true; }

            get_state(): String { @@:("p1_firing") }
            => $^
        }

        $PhaseTwo {
            hit(damage: int) {
                @@:self.hp = @@:self.hp - damage;
                if (@@:self.hp <= @@:self.hp_start * 0.33) {
                    -> $P3Idle
                } else if (@@:self.hp <= 0) {
                    -> $Dying
                }
            }

            get_phase(): int        { @@:(2) }
            get_hp(): int           { @@:(@@:self.hp) }
            get_hp_fraction(): double { @@:((double)@@:self.hp / @@:self.hp_start) }
            get_state(): String     { @@:("phase_two") }
            is_alive(): boolean        { @@:(true) }
            is_dying(): boolean        { @@:(false) }
            is_gone(): boolean         { @@:(false) }
            wants_to_fire_single(): boolean  { @@:(false) }
            wants_to_fire_spread(): boolean  { @@:(false) }
            wants_to_fire_spray(): boolean   { @@:(false) }
            consume_fire()          { }
        }

        $P2Idle => $PhaseTwo {
            $.timer: double = 0.0
            $.idle_duration: double = 1.3

            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.idle_duration) {
                    -> $P2Spread
                }
            }

            get_state(): String { @@:("p2_idle") }
            => $^
        }

        $P2Spread => $PhaseTwo {
            $.timer: double = 0.0
            $.duration: double = 0.5
            $.fired: boolean = false

            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.duration) {
                    -> $P2Idle
                }
            }

            wants_to_fire_spread(): boolean {
                if ($.fired) {
                    @@:return(false)
                }
                @@:(true)
            }
            consume_fire() { $.fired = true; }

            get_state(): String { @@:("p2_spread") }
            => $^
        }

        $PhaseThree {
            hit(damage: int) {
                @@:self.hp = @@:self.hp - damage;
                if (@@:self.hp <= 0) {
                    -> $Dying
                }
            }

            get_phase(): int        { @@:(3) }
            get_hp(): int           { @@:(@@:self.hp) }
            get_hp_fraction(): double { @@:((double)@@:self.hp / @@:self.hp_start) }
            get_state(): String     { @@:("phase_three") }
            is_alive(): boolean        { @@:(true) }
            is_dying(): boolean        { @@:(false) }
            is_gone(): boolean         { @@:(false) }
            wants_to_fire_single(): boolean  { @@:(false) }
            wants_to_fire_spread(): boolean  { @@:(false) }
            wants_to_fire_spray(): boolean   { @@:(false) }
            consume_fire()          { }
        }

        $P3Idle => $PhaseThree {
            $.timer: double = 0.0
            $.idle_duration: double = 0.6

            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.idle_duration) {
                    -> $P3Spray
                }
            }

            get_state(): String { @@:("p3_idle") }
            => $^
        }

        $P3Spray => $PhaseThree {
            $.timer: double = 0.0
            $.duration: double = 0.8
            $.fire_accumulator: double = 0.0
            $.fire_ready: boolean = false

            tick(dt: double) {
                $.timer = $.timer + dt;
                $.fire_accumulator = $.fire_accumulator + dt;
                if ($.fire_accumulator >= 0.12) {
                    $.fire_accumulator = 0.0;
                    $.fire_ready = true;
                }
                if ($.timer >= $.duration) {
                    -> $P3Idle
                }
            }

            wants_to_fire_spray(): boolean {
                @@:($.fire_ready)
            }
            consume_fire() { $.fire_ready = false; }

            get_state(): String { @@:("p3_spray") }
            => $^
        }

        $Dying {
            $.timer: double = 0.0
            $.duration: double = 2.5

            tick(dt: double) {
                $.timer = $.timer + dt;
                if ($.timer >= $.duration) {
                    -> $Gone
                }
            }

            hit(damage: int) {
            }

            get_phase(): int        { @@:(0) }
            get_hp(): int           { @@:(0) }
            get_hp_fraction(): double { @@:(0.0) }
            get_state(): String     { @@:("dying") }
            is_alive(): boolean        { @@:(false) }
            is_dying(): boolean        { @@:(true) }
            is_gone(): boolean         { @@:(false) }
            wants_to_fire_single(): boolean  { @@:(false) }
            wants_to_fire_spread(): boolean  { @@:(false) }
            wants_to_fire_spray(): boolean   { @@:(false) }
            consume_fire()          { }
        }

        $Gone {
            get_phase(): int        { @@:(0) }
            get_hp(): int           { @@:(0) }
            get_hp_fraction(): double { @@:(0.0) }
            get_state(): String     { @@:("gone") }
            is_alive(): boolean        { @@:(false) }
            is_dying(): boolean        { @@:(false) }
            is_gone(): boolean         { @@:(true) }
            wants_to_fire_single(): boolean  { @@:(false) }
            wants_to_fire_spread(): boolean  { @@:(false) }
            wants_to_fire_spray(): boolean   { @@:(false) }
            consume_fire()          { }
        }

    domain:
        hp: int = 90
        hp_start: int = 90
}

// ------------------------------------------------------------ Shooter
@@[main]
@@system Shooter {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }

    interface:
        start()
        restart()
        tick(dt: double)

        add_enemy(e: Enemy)
        clear_dead_enemies()

        player_hit()
        enemy_hit(index: int, damage: int): boolean
        boss_hit(damage: int): boolean

        get_state(): String
        get_score(): int
        get_lives(): int
        enemy_count(): int
        should_spawn_wave(): boolean
        consume_wave()
        should_spawn_boss(): boolean
        consume_boss_spawn()

        pause()
        resume()

    machine:
        $Attract {
            $>() {
                @@:self.score = 0;
                @@:self.waves_spawned = 0;
                @@:self.wave_timer = 0.0;
                @@:self.boss_spawn_pending = false;
            }

            start() {
                @@:self.player.respawn();
                -> $Playing
            }

            get_state(): String         { @@:("attract") }
            get_score(): int            { @@:(@@:self.score) }
            get_lives(): int            { @@:(@@:self.player.get_lives()) }
            enemy_count(): int          { @@:(@@:self.enemies.size()) }
            should_spawn_wave(): boolean   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): boolean   { @@:(false) }
            consume_boss_spawn()        { }
        }

        $Playing {
            tick(dt: double) {
                @@:self.player.tick(dt);
                @@:self._tick_enemies(dt);
                @@:self.wave_timer = @@:self.wave_timer + dt;

                if (@@:self.player.get_state().equals("dead")) {
                    -> $GameOver
                }

                if (@@:self.waves_spawned >= @@:self.waves_before_boss) {
                    -> $BossFight
                }
            }

            add_enemy(e: Enemy) {
                @@:self.enemies.add(e);
            }

            clear_dead_enemies() {
                @@:self._cleanup_enemies();
            }

            player_hit() {
                if (@@:self.player.can_be_hit()) {
                    @@:self.player.hit();
                }
            }

            enemy_hit(index: int, damage: int): boolean {
                if (index < 0 || index >= @@:self.enemies.size()) {
                    @@:return(false)
                }
                @@:self.enemies.get(index).hit(damage);
                if (!@@:self.enemies.get(index).is_alive()) {
                    @@:self.score = @@:self.score + @@:self.enemies.get(index).get_points();
                    @@:return(true)
                }
                @@:(false)
            }

            boss_hit(damage: int): boolean {
                @@:(false)
            }

            should_spawn_wave(): boolean {
                @@:(@@:self.wave_timer >= @@:self.wave_interval)
            }

            consume_wave() {
                @@:self.wave_timer = 0.0;
                @@:self.waves_spawned = @@:self.waves_spawned + 1;
            }

            should_spawn_boss(): boolean { @@:(false) }
            consume_boss_spawn()      { }

            pause() {
                push$ -> $Paused
            }

            get_state(): String { @@:("playing") }
            get_score(): int    { @@:(@@:self.score) }
            get_lives(): int    { @@:(@@:self.player.get_lives()) }
            enemy_count(): int  { @@:(@@:self.enemies.size()) }
        }

        $BossFight {
            $>() {
                @@:self.boss_spawn_pending = true;
            }

            tick(dt: double) {
                @@:self.player.tick(dt);
                @@:self._tick_enemies(dt);
                @@:self.boss.tick(dt);

                if (@@:self.player.get_state().equals("dead")) {
                    -> $GameOver
                }

                if (@@:self.boss.is_gone()) {
                    -> $Victory
                }
            }

            add_enemy(e: Enemy) {
                @@:self.enemies.add(e);
            }

            clear_dead_enemies() {
                @@:self._cleanup_enemies();
            }

            player_hit() {
                if (@@:self.player.can_be_hit()) {
                    @@:self.player.hit();
                }
            }

            enemy_hit(index: int, damage: int): boolean {
                if (index < 0 || index >= @@:self.enemies.size()) {
                    @@:return(false)
                }
                @@:self.enemies.get(index).hit(damage);
                if (!@@:self.enemies.get(index).is_alive()) {
                    @@:self.score = @@:self.score + @@:self.enemies.get(index).get_points();
                    @@:return(true)
                }
                @@:(false)
            }

            boss_hit(damage: int): boolean {
                @@:self.boss.hit(damage);
                if (@@:self.boss.is_dying() || @@:self.boss.is_gone()) {
                    @@:(true)
                } else {
                    @@:(false)
                }
            }

            should_spawn_wave(): boolean   { @@:(false) }
            consume_wave()              { }

            should_spawn_boss(): boolean   { @@:(@@:self.boss_spawn_pending) }
            consume_boss_spawn()        { @@:self.boss_spawn_pending = false; }

            pause() {
                push$ -> $Paused
            }

            get_state(): String { @@:("boss_fight") }
            get_score(): int    { @@:(@@:self.score) }
            get_lives(): int    { @@:(@@:self.player.get_lives()) }
            enemy_count(): int  { @@:(@@:self.enemies.size()) }
        }

        $Paused {
            resume() {
                -> pop$
            }

            get_state(): String         { @@:("paused") }
            get_score(): int            { @@:(@@:self.score) }
            get_lives(): int            { @@:(@@:self.player.get_lives()) }
            enemy_count(): int          { @@:(@@:self.enemies.size()) }
            should_spawn_wave(): boolean   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): boolean   { @@:(false) }
            consume_boss_spawn()        { }
        }

        $Victory {
            restart() {
                -> $Attract
            }

            get_state(): String         { @@:("victory") }
            get_score(): int            { @@:(@@:self.score) }
            get_lives(): int            { @@:(@@:self.player.get_lives()) }
            enemy_count(): int          { @@:(@@:self.enemies.size()) }
            should_spawn_wave(): boolean   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): boolean   { @@:(false) }
            consume_boss_spawn()        { }
        }

        $GameOver {
            restart() {
                -> $Attract
            }

            get_state(): String         { @@:("game_over") }
            get_score(): int            { @@:(@@:self.score) }
            get_lives(): int            { @@:(@@:self.player.get_lives()) }
            enemy_count(): int          { @@:(@@:self.enemies.size()) }
            should_spawn_wave(): boolean   { @@:(false) }
            consume_wave()              { }
            should_spawn_boss(): boolean   { @@:(false) }
            consume_boss_spawn()        { }
        }

    actions:
        _tick_enemies(dt: double) {
            int i = 0;
            while (i < @@:self.enemies.size()) {
                @@:self.enemies.get(i).tick(dt);
                i = i + 1;
            }
        }

        _cleanup_enemies() {
            int i = @@:self.enemies.size() - 1;
            while (i >= 0) {
                if (@@:self.enemies.get(i).is_cleanup()) {
                    @@:self.enemies.remove(i);
                }
                i = i - 1;
            }
        }

    domain:
        score: int = 0
        wave_timer: double = 0.0
        wave_interval: double = 2.0
        waves_spawned: int = 0
        waves_before_boss: int = 10
        boss_spawn_pending: boolean = false
        player: Player = @@Player()
        boss: Boss = @@Boss()
        enemies: List<Enemy> = new ArrayList<Enemy>()
}
