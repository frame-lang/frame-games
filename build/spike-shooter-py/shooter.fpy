@@[target("python_3")]

# Side-scrolling shooter — the capstone: everything composed at scale.
#
# CANONICAL: mirrors the Godot reference
# (frame-arcade/ch07-shooter/frame/shooter.fgd) exactly — the same
# four systems (Player / Enemy / Boss / Shooter), states, transitions,
# the parameterized Enemy(kind, hp, fire_rate, points), the
# three-phase Boss HSM ($PhaseOne/$PhaseTwo/$PhaseThree parents with
# idle/fire child leaves, HP thresholds driving phase changes), the
# owned sub-systems (player/boss + an enemies list), and the
# push$/pop$ pause added to the orchestrator. Only action bodies
# differ (JS host code); the Godot ": RefCounted" base is dropped.
#
# Boss start state is $P1Idle (lexically first) — preserved here so
# the HSM enters $PhaseOne then the idle leaf, same as Godot.
#
# WHAT FRAME OWNS vs THE DRIVER: Frame owns every entity's MODE
# (player alive/hit/invuln, enemy spawn/active/dying, boss phase +
# attack pattern) and the wave/boss scheduling. The scene owns
# positions, bulphysics, collision, and rendering — reading the
# FSM's wants_to_fire*/should_spawn* signals and reporting hits back,
# exactly like the Godot main.gd.

@@system Player {

    interface:
        tick(dt)
        hit()
        respawn()
        can_fire()
        can_be_hit()
        is_visible()
        get_state()
        get_lives()

    machine:
        $Alive {
            hit() { -> $Exploding }

            can_fire()    { @@:(True) }
            can_be_hit()  { @@:(True) }
            is_visible()  { @@:(True) }
            get_state() { @@:("alive") }
            get_lives()    { @@:(self.lives) }
        }

        $Exploding {
            $.timer = 0.0
            $.duration = 1.0

            tick(dt) {
                $.timer = $.timer + dt
                if $.timer >= $.duration:
                    self.lives = self.lives - 1
                    if self.lives <= 0:
                        -> $Dead
                    else:
                        -> $Invulnerable
            }

            can_fire()    { @@:(False) }
            can_be_hit()  { @@:(False) }
            is_visible()  { @@:(True) }
            get_state() { @@:("exploding") }
            get_lives()    { @@:(self.lives) }
        }

        $Invulnerable {
            $.timer = 0.0
            $.duration = 2.0

            tick(dt) {
                $.timer = $.timer + dt
                if $.timer >= $.duration:
                    -> $Alive
            }

            can_fire()    { @@:(True) }
            can_be_hit()  { @@:(False) }
            is_visible()  { @@:(True) }
            get_state() { @@:("invulnerable") }
            get_lives()    { @@:(self.lives) }
        }

        $Dead {
            respawn() {
                self.lives = self.starting_lives
                -> $Alive
            }

            can_fire()    { @@:(False) }
            can_be_hit()  { @@:(False) }
            is_visible()  { @@:(False) }
            get_state() { @@:("dead") }
            get_lives()    { @@:(0) }
        }

    domain:
        lives = 3
        starting_lives = 3
}

@@system Enemy(kind, hp, fire_rate, points) {

    interface:
        tick(dt)
        hit(damage)
        get_state()
        get_kind()
        get_hp()
        get_points()
        wants_to_fire()
        consume_fire()
        is_alive()
        is_cleanup()

    machine:
        $Spawning {
            $.timer = 0.0
            $.duration = 0.5

            tick(dt) {
                $.timer = $.timer + dt
                if $.timer >= $.duration:
                    -> $Active
            }

            hit(damage) {
            }

            get_state() { @@:("spawning") }
            get_kind()     { @@:(self.ekind) }
            get_hp()       { @@:(self.hp_remaining) }
            get_points()   { @@:(self.pts) }
            wants_to_fire() { @@:(False) }
            consume_fire()      { }
            is_alive()    { @@:(True) }
            is_cleanup()  { @@:(False) }
        }

        $Active {
            $.fire_timer = 0.0

            tick(dt) {
                if self.rate > 0.0:
                    $.fire_timer = $.fire_timer + dt
            }

            hit(damage) {
                self.hp_remaining = self.hp_remaining - damage
                if self.hp_remaining <= 0:
                    -> $Dying
            }

            get_state() { @@:("active") }
            get_kind()     { @@:(self.ekind) }
            get_hp()       { @@:(self.hp_remaining) }
            get_points()   { @@:(self.pts) }
            wants_to_fire() {
                if self.rate <= 0.0:
                    @@:return(False)
                @@:($.fire_timer >= self.rate)
            }
            consume_fire()      { $.fire_timer = 0.0 }
            is_alive()    { @@:(True) }
            is_cleanup()  { @@:(False) }
        }

        $Dying {
            $.timer = 0.0
            $.duration = 0.4

            tick(dt) {
                $.timer = $.timer + dt
                if $.timer >= $.duration:
                    -> $Gone
            }

            hit(damage) {
            }

            get_state() { @@:("dying") }
            get_kind()     { @@:(self.ekind) }
            get_hp()       { @@:(0) }
            get_points()   { @@:(self.pts) }
            wants_to_fire() { @@:(False) }
            consume_fire()      { }
            is_alive()    { @@:(False) }
            is_cleanup()  { @@:(False) }
        }

        $Gone {
            get_state() { @@:("gone") }
            get_kind()     { @@:(self.ekind) }
            get_hp()       { @@:(0) }
            get_points()   { @@:(self.pts) }
            wants_to_fire() { @@:(False) }
            consume_fire()      { }
            is_alive()    { @@:(False) }
            is_cleanup()  { @@:(True) }
        }

    domain:
        ekind = kind
        hp_remaining = hp
        rate = fire_rate
        pts = points
}

@@system Boss {

    interface:
        tick(dt)
        hit(damage)
        get_phase()
        get_hp()
        get_hp_fraction()
        get_state()
        is_alive()
        is_dying()
        is_gone()
        wants_to_fire_single()
        wants_to_fire_spread()
        wants_to_fire_spray()
        consume_fire()

    machine:
        $P1Idle => $PhaseOne {
            $.timer = 0.0
            $.idle_duration = 1.8

            tick(dt) {
                $.timer = $.timer + dt
                if $.timer >= $.idle_duration:
                    -> $P1Firing
            }

            get_state() { @@:("p1_idle") }
            => $^
        }

        $PhaseOne {
            hit(damage) {
                self.hp = self.hp - damage
                if self.hp <= self.hp_start * 0.66:
                    -> $P2Idle
                elif self.hp <= 0:
                    -> $Dying
            }

            get_phase()        { @@:(1) }
            get_hp()           { @@:(self.hp) }
            get_hp_fraction() { @@:(self.hp / self.hp_start) }
            get_state()     { @@:("phase_one") }
            is_alive()        { @@:(True) }
            is_dying()        { @@:(False) }
            is_gone()         { @@:(False) }
            wants_to_fire_single()  { @@:(False) }
            wants_to_fire_spread()  { @@:(False) }
            wants_to_fire_spray()   { @@:(False) }
            consume_fire()          { }
        }

        $P1Firing => $PhaseOne {
            $.timer = 0.0
            $.duration = 0.4
            $.fired = False

            tick(dt) {
                $.timer = $.timer + dt
                if $.timer >= $.duration:
                    -> $P1Idle
            }

            wants_to_fire_single() {
                if $.fired:
                    @@:return(False)
                @@:(True)
            }
            consume_fire() { $.fired = True }

            get_state() { @@:("p1_firing") }
            => $^
        }

        $PhaseTwo {
            hit(damage) {
                self.hp = self.hp - damage
                if self.hp <= self.hp_start * 0.33:
                    -> $P3Idle
                elif self.hp <= 0:
                    -> $Dying
            }

            get_phase()        { @@:(2) }
            get_hp()           { @@:(self.hp) }
            get_hp_fraction() { @@:(self.hp / self.hp_start) }
            get_state()     { @@:("phase_two") }
            is_alive()        { @@:(True) }
            is_dying()        { @@:(False) }
            is_gone()         { @@:(False) }
            wants_to_fire_single()  { @@:(False) }
            wants_to_fire_spread()  { @@:(False) }
            wants_to_fire_spray()   { @@:(False) }
            consume_fire()          { }
        }

        $P2Idle => $PhaseTwo {
            $.timer = 0.0
            $.idle_duration = 1.3

            tick(dt) {
                $.timer = $.timer + dt
                if $.timer >= $.idle_duration:
                    -> $P2Spread
            }

            get_state() { @@:("p2_idle") }
            => $^
        }

        $P2Spread => $PhaseTwo {
            $.timer = 0.0
            $.duration = 0.5
            $.fired = False

            tick(dt) {
                $.timer = $.timer + dt
                if $.timer >= $.duration:
                    -> $P2Idle
            }

            wants_to_fire_spread() {
                if $.fired:
                    @@:return(False)
                @@:(True)
            }
            consume_fire() { $.fired = True }

            get_state() { @@:("p2_spread") }
            => $^
        }

        $PhaseThree {
            hit(damage) {
                self.hp = self.hp - damage
                if self.hp <= 0:
                    -> $Dying
            }

            get_phase()        { @@:(3) }
            get_hp()           { @@:(self.hp) }
            get_hp_fraction() { @@:(self.hp / self.hp_start) }
            get_state()     { @@:("phase_three") }
            is_alive()        { @@:(True) }
            is_dying()        { @@:(False) }
            is_gone()         { @@:(False) }
            wants_to_fire_single()  { @@:(False) }
            wants_to_fire_spread()  { @@:(False) }
            wants_to_fire_spray()   { @@:(False) }
            consume_fire()          { }
        }

        $P3Idle => $PhaseThree {
            $.timer = 0.0
            $.idle_duration = 0.6

            tick(dt) {
                $.timer = $.timer + dt
                if $.timer >= $.idle_duration:
                    -> $P3Spray
            }

            get_state() { @@:("p3_idle") }
            => $^
        }

        $P3Spray => $PhaseThree {
            $.timer = 0.0
            $.duration = 0.8
            $.fire_accumulator = 0.0
            $.fire_ready = False

            tick(dt) {
                $.timer = $.timer + dt
                $.fire_accumulator = $.fire_accumulator + dt
                if $.fire_accumulator >= 0.12:
                    $.fire_accumulator = 0.0
                    $.fire_ready = True
                if $.timer >= $.duration:
                    -> $P3Idle
            }

            wants_to_fire_spray() {
                @@:($.fire_ready)
            }
            consume_fire() { $.fire_ready = False }

            get_state() { @@:("p3_spray") }
            => $^
        }

        $Dying {
            $.timer = 0.0
            $.duration = 2.5

            tick(dt) {
                $.timer = $.timer + dt
                if $.timer >= $.duration:
                    -> $Gone
            }

            hit(damage) {
            }

            get_phase()        { @@:(0) }
            get_hp()           { @@:(0) }
            get_hp_fraction() { @@:(0.0) }
            get_state()     { @@:("dying") }
            is_alive()        { @@:(False) }
            is_dying()        { @@:(True) }
            is_gone()         { @@:(False) }
            wants_to_fire_single()  { @@:(False) }
            wants_to_fire_spread()  { @@:(False) }
            wants_to_fire_spray()   { @@:(False) }
            consume_fire()          { }
        }

        $Gone {
            get_phase()        { @@:(0) }
            get_hp()           { @@:(0) }
            get_hp_fraction() { @@:(0.0) }
            get_state()     { @@:("gone") }
            is_alive()        { @@:(False) }
            is_dying()        { @@:(False) }
            is_gone()         { @@:(True) }
            wants_to_fire_single()  { @@:(False) }
            wants_to_fire_spread()  { @@:(False) }
            wants_to_fire_spray()   { @@:(False) }
            consume_fire()          { }
        }

    domain:
        hp = 90
        hp_start = 90
}

@@[main]
@@system Shooter {

    operations:
        get_current_state_name() { @@:(@@:system.state.name) }

    interface:
        start()
        restart()
        tick(dt)

        add_enemy(e)
        clear_dead_enemies()

        player_hit()
        enemy_hit(index, damage)
        boss_hit(damage)

        get_state()
        get_score()
        get_lives()
        enemy_count()
        should_spawn_wave()
        consume_wave()
        should_spawn_boss()
        consume_boss_spawn()

        pause()
        resume()

    machine:
        $Attract {
            $>() {
                self.score = 0
                self.waves_spawned = 0
                self.wave_timer = 0.0
                self.boss_spawn_pending = False
            }

            start() {
                self.player.respawn()
                -> $Playing
            }

            get_state()         { @@:("attract") }
            get_score()            { @@:(self.score) }
            get_lives()            { @@:(self.player.get_lives()) }
            enemy_count()          { @@:(len(self.enemies)) }
            should_spawn_wave()   { @@:(False) }
            consume_wave()              { }
            should_spawn_boss()   { @@:(False) }
            consume_boss_spawn()        { }
        }

        $Playing {
            tick(dt) {
                self.player.tick(dt)
                self._tick_enemies(dt)
                self.wave_timer = self.wave_timer + dt

                if self.player.get_state() == "dead":
                    -> $GameOver

                if self.waves_spawned >= self.waves_before_boss:
                    -> $BossFight
            }

            add_enemy(e) {
                self.enemies.append(e)
            }

            clear_dead_enemies() {
                self._cleanup_enemies()
            }

            player_hit() {
                if self.player.can_be_hit():
                    self.player.hit()
            }

            enemy_hit(index, damage) {
                if index < 0 or index >= len(self.enemies):
                    @@:return(False)
                e = self.enemies[index]
                e.hit(damage)
                if not e.is_alive():
                    self.score = self.score + e.get_points()
                    @@:return(True)
                @@:(False)
            }

            boss_hit(damage) {
                @@:(False)
            }

            should_spawn_wave() {
                @@:(self.wave_timer >= self.wave_interval)
            }

            consume_wave() {
                self.wave_timer = 0.0
                self.waves_spawned = self.waves_spawned + 1
            }

            should_spawn_boss() { @@:(False) }
            consume_boss_spawn()      { }

            pause() {
                push$ -> $Paused
            }

            get_state() { @@:("playing") }
            get_score()    { @@:(self.score) }
            get_lives()    { @@:(self.player.get_lives()) }
            enemy_count()  { @@:(len(self.enemies)) }
        }

        $BossFight {
            $>() {
                self.boss_spawn_pending = True
            }

            tick(dt) {
                self.player.tick(dt)
                self._tick_enemies(dt)
                self.boss.tick(dt)

                if self.player.get_state() == "dead":
                    -> $GameOver

                if self.boss.is_gone():
                    -> $Victory
            }

            add_enemy(e) {
                self.enemies.append(e)
            }

            clear_dead_enemies() {
                self._cleanup_enemies()
            }

            player_hit() {
                if self.player.can_be_hit():
                    self.player.hit()
            }

            enemy_hit(index, damage) {
                if index < 0 or index >= len(self.enemies):
                    @@:return(False)
                e = self.enemies[index]
                e.hit(damage)
                if not e.is_alive():
                    self.score = self.score + e.get_points()
                    @@:return(True)
                @@:(False)
            }

            boss_hit(damage) {
                self.boss.hit(damage)
                if self.boss.is_dying() or self.boss.is_gone():
                    @@:(True)
                else:
                    @@:(False)
            }

            should_spawn_wave()   { @@:(False) }
            consume_wave()              { }

            should_spawn_boss()   { @@:(self.boss_spawn_pending) }
            consume_boss_spawn()        { self.boss_spawn_pending = False }

            pause() {
                push$ -> $Paused
            }

            get_state() { @@:("boss_fight") }
            get_score()    { @@:(self.score) }
            get_lives()    { @@:(self.player.get_lives()) }
            enemy_count()  { @@:(len(self.enemies)) }
        }

        $Paused {
            resume() {
                -> pop$
            }

            get_state()         { @@:("paused") }
            get_score()            { @@:(self.score) }
            get_lives()            { @@:(self.player.get_lives()) }
            enemy_count()          { @@:(len(self.enemies)) }
            should_spawn_wave()   { @@:(False) }
            consume_wave()              { }
            should_spawn_boss()   { @@:(False) }
            consume_boss_spawn()        { }
        }

        $Victory {
            restart() {
                -> $Attract
            }

            get_state()         { @@:("victory") }
            get_score()            { @@:(self.score) }
            get_lives()            { @@:(self.player.get_lives()) }
            enemy_count()          { @@:(len(self.enemies)) }
            should_spawn_wave()   { @@:(False) }
            consume_wave()              { }
            should_spawn_boss()   { @@:(False) }
            consume_boss_spawn()        { }
        }

        $GameOver {
            restart() {
                -> $Attract
            }

            get_state()         { @@:("game_over") }
            get_score()            { @@:(self.score) }
            get_lives()            { @@:(self.player.get_lives()) }
            enemy_count()          { @@:(len(self.enemies)) }
            should_spawn_wave()   { @@:(False) }
            consume_wave()              { }
            should_spawn_boss()   { @@:(False) }
            consume_boss_spawn()        { }
        }

    actions:
        _tick_enemies(dt) {
            i = 0
            while i < len(self.enemies):
                self.enemies[i].tick(dt)
                i = i + 1
        }

        _cleanup_enemies() {
            i = len(self.enemies) - 1
            while i >= 0:
                if self.enemies[i].is_cleanup():
                    del self.enemies[i]
                i = i - 1
        }

    domain:
        score = 0
        wave_timer = 0.0
        wave_interval = 2.0
        waves_spawned = 0
        waves_before_boss = 10
        boss_spawn_pending = False
        player = @@Player()
        boss = @@Boss()
        enemies = []
}
