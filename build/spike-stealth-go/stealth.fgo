@@[target("go")]

// Stealth — guard agent AI, Go port of the canonical controller
// (games/stealth/src/stealth.fjs). Same two systems (Guard / Stealth),
// states, the $Aware HSM parent that shares the spot_player response, the
// push$/pop$ investigate-then-resume subroutine, the three owned Guard
// instances, and the game flow $Attract -> $Playing -> $Caught/$Escaped
// plus the push$/pop$ pause. Bodies are native Go (parens, `;`, List<T>)
// doubles throughout so timer math matches the JS baseline bit-for-bit.
// The @@[persist]/@@[save]/@@[load] contract is kept verbatim — the blob
// type is `string` as in the JS reference.

package main

import "math"

type Vector2 struct {
    X float64 `json:"X"`
    Y float64 `json:"Y"`
}

func geoDist(a Vector2, b Vector2) float64 {
    dx := a.X - b.X
    dy := a.Y - b.Y
    return math.Sqrt(dx*dx + dy*dy)
}

@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Guard {

    interface:
        init(patrol: []Vector2, speed: float64)
        tick(dt: float64, current_pos: Vector2)
        spot_player(at: Vector2)
        hear_sound(at: Vector2)
        touched_player()
        get_state(): string
        get_target(): Vector2
        get_last_known(): Vector2
        is_aware(): bool
        is_alerted(): bool
        should_move(): bool

    machine:
        $Idle {
            init(patrol: []Vector2, speed: float64) {
                @@:self.patrol = patrol
                @@:self.speed = speed
                @@:self.next_wp = 0
                if len(patrol) > 0 {
                    @@:self.target = patrol[0]
                }
                -> $Patrolling
            }

            tick(dt: float64, current_pos: Vector2) {
            }

            get_state(): string         { @@:("idle") }
            get_target(): Vector2       { @@:(@@:self.target) }
            get_last_known(): Vector2   { @@:(@@:self.last_known) }
            is_aware(): bool            { @@:(false) }
            is_alerted(): bool          { @@:(false) }
            should_move(): bool         { @@:(false) }
        }

        $Aware {
            spot_player(at: Vector2) {
                @@:self.last_known = at
                -> $Alerted
            }

            touched_player() {
                -> $Engaged
            }

            get_state(): string         { @@:("aware") }
            get_target(): Vector2       { @@:(@@:self.target) }
            get_last_known(): Vector2   { @@:(@@:self.last_known) }
            is_aware(): bool            { @@:(true) }
            is_alerted(): bool          { @@:(false) }
            should_move(): bool         { @@:(true) }
        }

        $Patrolling => $Aware {
            tick(dt: float64, current_pos: Vector2) {
                if len(@@:self.patrol) == 0 {
                    return
                }
                d := geoDist(current_pos, @@:self.target)
                if d < @@:self.ARRIVAL_RADIUS {
                    @@:self.next_wp = @@:self.next_wp + 1
                    if @@:self.next_wp >= len(@@:self.patrol) {
                        @@:self.next_wp = 0
                    }
                    @@:self.target = @@:self.patrol[@@:self.next_wp]
                }
            }

            hear_sound(at: Vector2) {
                push$
                @@:self.last_known = at
                -> $Investigating
            }

            get_state(): string         { @@:("patrolling") }
            is_aware(): bool            { @@:(false) }
            should_move(): bool         { @@:(true) }
            => $^
        }

        $Investigating => $Aware {
            $.timer: float64 = 0.0

            tick(dt: float64, current_pos: Vector2) {
                $.timer = $.timer + dt
                if $.timer >= @@:self.INVESTIGATE_DURATION {
                    -> pop$
                }
            }

            get_state(): string { @@:("investigating") }
            should_move(): bool { @@:(false) }
            => $^
        }

        $Alerted => $Aware {
            $.chase_timer: float64 = 0.0

            spot_player(at: Vector2) {
                @@:self.last_known = at
                $.chase_timer = 0.0
            }

            tick(dt: float64, current_pos: Vector2) {
                @@:self.target = @@:self.last_known
                $.chase_timer = $.chase_timer + dt
                d := geoDist(current_pos, @@:self.last_known)
                if d < @@:self.ARRIVAL_RADIUS {
                    -> $Searching
                } else if $.chase_timer >= @@:self.CHASE_TIMEOUT {
                    -> $Searching
                }
            }

            get_state(): string { @@:("alerted") }
            is_alerted(): bool  { @@:(true) }
            should_move(): bool { @@:(true) }
            => $^
        }

        $Searching => $Aware {
            $.timer: float64 = 0.0

            tick(dt: float64, current_pos: Vector2) {
                $.timer = $.timer + dt
                if $.timer >= @@:self.SEARCH_DURATION {
                    @@:self._resume_patrol(current_pos)
                    -> $Patrolling
                }
            }

            get_state(): string { @@:("searching") }
            should_move(): bool { @@:(false) }
            => $^
        }

        $Engaged {
            tick(dt: float64, current_pos: Vector2) {
            }

            get_state(): string         { @@:("engaged") }
            get_target(): Vector2       { @@:(@@:self.target) }
            get_last_known(): Vector2   { @@:(@@:self.last_known) }
            is_aware(): bool            { @@:(true) }
            is_alerted(): bool          { @@:(true) }
            should_move(): bool         { @@:(false) }
        }

    actions:
        _resume_patrol(current_pos: Vector2) {
            if len(@@:self.patrol) == 0 {
                return
            }
            best_i := 0
            best_d := geoDist(current_pos, @@:self.patrol[0])
            i := 1
            for i < len(@@:self.patrol) {
                d := geoDist(current_pos, @@:self.patrol[i])
                if d < best_d {
                    best_d = d
                    best_i = i
                }
                i = i + 1
            }
            @@:self.next_wp = best_i
            @@:self.target = @@:self.patrol[best_i]
        }

    domain:
        patrol: []Vector2 = []Vector2{}
        next_wp: int = 0
        target: Vector2 = Vector2{0.0, 0.0}
        last_known: Vector2 = Vector2{0.0, 0.0}
        speed: float64 = 60.0
        ARRIVAL_RADIUS: float64 = 12.0
        INVESTIGATE_DURATION: float64 = 1.5
        SEARCH_DURATION: float64 = 3.0
        CHASE_TIMEOUT: float64 = 4.0
}

@@[main]
@@[persist(string)]
@@[save(save_state)]
@@[load(restore_state)]
@@system Stealth {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }

    interface:
        start(p1: []Vector2, p2: []Vector2, p3: []Vector2)
        restart()
        pause()
        resume()
        tick(dt: float64, pos1: Vector2, pos2: Vector2, pos3: Vector2)
        guard_caught_player(i: int)
        player_at_exit()
        get_state(): string
        get_elapsed(): float64
        get_caught_by(): int

    machine:
        $Attract {
            $>() {
                @@:self.elapsed = 0.0
                @@:self.caught_by = -1
            }

            start(p1: []Vector2, p2: []Vector2, p3: []Vector2) {
                @@:self.guard1.init(p1, @@:self.PATROL_SPEED)
                @@:self.guard2.init(p2, @@:self.PATROL_SPEED)
                @@:self.guard3.init(p3, @@:self.PATROL_SPEED)
                -> $Playing
            }

            get_state(): string     { @@:("attract") }
            get_elapsed(): float64   { @@:(0.0) }
            get_caught_by(): int    { @@:(-1) }
        }

        $Playing {
            tick(dt: float64, pos1: Vector2, pos2: Vector2, pos3: Vector2) {
                @@:self.elapsed = @@:self.elapsed + dt
                @@:self.guard1.tick(dt, pos1)
                @@:self.guard2.tick(dt, pos2)
                @@:self.guard3.tick(dt, pos3)
            }

            guard_caught_player(i: int) {
                @@:self.caught_by = i
                if i == 0 {
                    @@:self.guard1.touched_player()
                } else if i == 1 {
                    @@:self.guard2.touched_player()
                } else if i == 2 {
                    @@:self.guard3.touched_player()
                }
                -> $Caught
            }

            player_at_exit() {
                -> $Escaped
            }

            pause() {
                push$ -> $Paused
            }

            get_state(): string     { @@:("playing") }
            get_elapsed(): float64   { @@:(@@:self.elapsed) }
            get_caught_by(): int    { @@:(@@:self.caught_by) }
        }

        $Paused {
            resume() {
                -> pop$
            }

            get_state(): string     { @@:("paused") }
            get_elapsed(): float64   { @@:(@@:self.elapsed) }
            get_caught_by(): int    { @@:(@@:self.caught_by) }
        }

        $Caught {
            restart() {
                -> $Attract
            }

            get_state(): string     { @@:("caught") }
            get_elapsed(): float64   { @@:(@@:self.elapsed) }
            get_caught_by(): int    { @@:(@@:self.caught_by) }
        }

        $Escaped {
            restart() {
                -> $Attract
            }

            get_state(): string     { @@:("escaped") }
            get_elapsed(): float64   { @@:(@@:self.elapsed) }
            get_caught_by(): int    { @@:(-1) }
        }

    domain:
        guard1: Guard = @@Guard()
        guard2: Guard = @@Guard()
        guard3: Guard = @@Guard()
        elapsed: float64 = 0.0
        caught_by: int = -1
        PATROL_SPEED: float64 = 95.0
}
