@@[target("rust")]

// Space Invaders — Rust port of the canonical controller
// (games/invaders/src/invaders.fjs). Same three systems (Player / Fleet /
// Invaders), the $InGame HSM parent, push$/pop$ pause, owned children.
// Bodies are native C#; doubles for all timers so dt=1/64 math matches the
// JS baseline bit-for-bit. NOTE the pace recompute casts to f64 —
// `live / total_invaders` is i32/i32 and would floor to 0 otherwise.

@@system Player {

    interface:
        tick(dt: f64)
        hit()
        respawn()
        can_fire(): bool
        can_be_hit(): bool
        is_alive(): bool
        get_state(): String
        get_lives(): i32

    machine:
        $Alive {
            hit() { -> $Exploding }
            can_fire(): bool    { @@:(true) }
            can_be_hit(): bool  { @@:(true) }
            is_alive(): bool    { @@:(true) }
            get_state(): String { @@:("alive".to_string()) }
            get_lives(): i32    { @@:(@@:self.lives_remaining) }
        }

        $Exploding {
            $.timer: f64 = 0.0
            $.duration: f64 = 1.2

            tick(dt: f64) {
                $.timer = $.timer + dt;
                if $.timer >= $.duration {
                    @@:self.lives_remaining = @@:self.lives_remaining - 1;
                    if @@:self.lives_remaining <= 0 {
                        -> $Dead
                    } else {
                        -> $Invulnerable
                    }
                }
            }

            can_fire(): bool    { @@:(false) }
            can_be_hit(): bool  { @@:(false) }
            is_alive(): bool    { @@:(false) }
            get_state(): String { @@:("exploding".to_string()) }
            get_lives(): i32    { @@:(@@:self.lives_remaining) }
        }

        $Invulnerable {
            $.timer: f64 = 0.0
            $.duration: f64 = 1.5

            tick(dt: f64) {
                $.timer = $.timer + dt;
                if $.timer >= $.duration {
                    -> $Alive
                }
            }

            can_fire(): bool    { @@:(true) }
            can_be_hit(): bool  { @@:(false) }
            is_alive(): bool    { @@:(true) }
            get_state(): String { @@:("invulnerable".to_string()) }
            get_lives(): i32    { @@:(@@:self.lives_remaining) }
        }

        $Dead {
            respawn() {
                @@:self.lives_remaining = @@:self.starting_lives;
                -> $Alive
            }

            can_fire(): bool    { @@:(false) }
            can_be_hit(): bool  { @@:(false) }
            is_alive(): bool    { @@:(false) }
            get_state(): String { @@:("dead".to_string()) }
            get_lives(): i32    { @@:(@@:self.lives_remaining) }
        }

    domain:
        lives_remaining: i32 = 3
        starting_lives: i32 = 3
}

@@system Fleet {

    interface:
        tick(dt: f64)
        kill_invader(index: i32): bool
        reset(rows: i32, cols: i32)
        edge_reached()
        consume_step(): bool
        wants_to_step(): bool
        get_state(): String
        get_direction(): i32
        get_step_interval(): f64
        is_alive(index: i32): bool
        alive_count(): i32
        lowest_row(): i32
        cols(): i32
        rows(): i32
        total(): i32

    machine:
        $Marching {
            $.timer: f64 = 0.0

            tick(dt: f64) {
                $.timer = $.timer + dt;
            }

            reset(rows: i32, cols: i32) {
                @@:self._do_reset(rows, cols);
                $.timer = 0.0;
            }

            kill_invader(index: i32): bool {
                if @@:self._do_kill(index) {
                    if @@:self._count_alive() == 0 {
                        -> $Defeated
                        @@:return(true)
                    }
                    @@:return(true)
                }
                @@:(false)
            }

            edge_reached() {
                @@:self.pending_step = true;
                -> $Stepping
            }

            consume_step(): bool {
                if $.timer >= @@:self.step_interval {
                    $.timer = 0.0;
                    @@:return(true)
                }
                @@:(false)
            }

            wants_to_step(): bool       { @@:($.timer >= @@:self.step_interval) }
            get_state(): String         { @@:("marching".to_string()) }
            get_direction(): i32        { @@:(@@:self.direction) }
            get_step_interval(): f64 { @@:(@@:self.step_interval) }
            is_alive(index: i32): bool  { @@:(@@:self._is_alive(index)) }
            alive_count(): i32          { @@:(@@:self._count_alive()) }
            lowest_row(): i32           { @@:(@@:self._lowest_row()) }
            cols(): i32                 { @@:(@@:self.grid_cols) }
            rows(): i32                 { @@:(@@:self.grid_rows) }
            total(): i32                { @@:(@@:self.grid_rows * @@:self.grid_cols) }
        }

        $Stepping {
            $>() {
                @@:self.direction = -@@:self.direction;
                @@:self.pending_step = false;
            }

            tick(dt: f64) {
                -> $Marching
            }

            kill_invader(index: i32): bool {
                if @@:self._do_kill(index) {
                    if @@:self._count_alive() == 0 {
                        -> $Defeated
                        @@:return(true)
                    }
                    @@:return(true)
                }
                @@:(false)
            }

            consume_step(): bool        { @@:(false) }
            wants_to_step(): bool       { @@:(false) }
            get_state(): String         { @@:("stepping".to_string()) }
            get_direction(): i32        { @@:(@@:self.direction) }
            get_step_interval(): f64 { @@:(@@:self.step_interval) }
            is_alive(index: i32): bool  { @@:(@@:self._is_alive(index)) }
            alive_count(): i32          { @@:(@@:self._count_alive()) }
            lowest_row(): i32           { @@:(@@:self._lowest_row()) }
            cols(): i32                 { @@:(@@:self.grid_cols) }
            rows(): i32                 { @@:(@@:self.grid_rows) }
            total(): i32                { @@:(@@:self.grid_rows * @@:self.grid_cols) }
        }

        $Defeated {
            reset(rows: i32, cols: i32) {
                @@:self._do_reset(rows, cols);
                -> $Marching
            }

            consume_step(): bool        { @@:(false) }
            wants_to_step(): bool       { @@:(false) }
            get_state(): String         { @@:("defeated".to_string()) }
            get_direction(): i32        { @@:(@@:self.direction) }
            get_step_interval(): f64 { @@:(@@:self.step_interval) }
            is_alive(index: i32): bool  { @@:(false) }
            alive_count(): i32          { @@:(0) }
            lowest_row(): i32           { @@:(-1) }
            cols(): i32                 { @@:(@@:self.grid_cols) }
            rows(): i32                 { @@:(@@:self.grid_rows) }
            total(): i32                { @@:(@@:self.grid_rows * @@:self.grid_cols) }
        }

    actions:
        _do_reset(rows: i32, cols: i32) {
            @@:self.grid_rows = rows;
            @@:self.grid_cols = cols;
            @@:self.alive = Vec::new();
            let total = rows * cols;
            let mut i = 0;
            while i < total {
                @@:self.alive.push(true);
                i = i + 1;
            }
            @@:self.direction = 1;
            @@:self.step_interval = @@:self.initial_step_interval;
            @@:self.total_invaders = total;
        }

        _do_kill(index: i32): bool {
            if index < 0 || index >= @@:self.alive.len() as i32 {
                return false;
            }
            if !@@:self.alive[(index) as usize] {
                return false;
            }
            @@:self.alive[(index) as usize] = false;
            @@:self._update_pace();
            return true;
        }

        _is_alive(index: i32): bool {
            if index < 0 || index >= @@:self.alive.len() as i32 {
                return false;
            }
            return @@:self.alive[(index) as usize];
        }

        _count_alive(): i32 {
            let mut c = 0;
            let mut i = 0;
            while i < @@:self.alive.len() as i32 {
                if @@:self.alive[(i) as usize] {
                    c = c + 1;
                }
                i = i + 1;
            }
            return c;
        }

        _lowest_row(): i32 {
            let mut i = @@:self.alive.len() as i32 - 1;
            while i >= 0 {
                if @@:self.alive[(i) as usize] {
                    return i / @@:self.grid_cols;
                }
                i = i - 1;
            }
            return -1;
        }

        _update_pace() {
            if @@:self.total_invaders <= 0 {
                return;
            }
            let live = @@:self._count_alive();
            let frac = live as f64 / @@:self.total_invaders as f64;
            @@:self.step_interval = @@:self.min_step_interval + (@@:self.initial_step_interval - @@:self.min_step_interval) * frac;
        }

    domain:
        alive: Vec<bool> = Vec::new()
        grid_rows: i32 = 5
        grid_cols: i32 = 11
        total_invaders: i32 = 55
        direction: i32 = 1
        step_interval: f64 = 0.6
        initial_step_interval: f64 = 0.6
        min_step_interval: f64 = 0.06
        pending_step: bool = false
}

@@[main]
@@system Invaders {

    operations:
        get_current_state_name(): String { @@:(@@:system.state.name) }

    interface:
        start()
        restart()
        pause()
        resume()
        tick(dt: f64)
        player_killed_invader(index: i32)
        player_hit()
        fleet_reached_edge()
        fleet_reached_bottom()
        get_state(): String
        get_score(): i32
        get_lives(): i32
        get_wave(): i32
        is_paused(): bool

    machine:
        $Attract {
            $>() {
                @@:self.score = 0;
                @@:self.wave = 1;
            }

            start() {
                @@:self.player.respawn();
                @@:self.fleet.reset(@@:self.fleet_rows, @@:self.fleet_cols);
                -> $Playing
            }

            get_state(): String { @@:("attract".to_string()) }
            get_score(): i32    { @@:(@@:self.score) }
            get_lives(): i32    { @@:(@@:self.player.get_lives()) }
            get_wave(): i32     { @@:(@@:self.wave) }
            is_paused(): bool   { @@:(false) }
        }

        $InGame {
            pause() {
                push$ -> $Paused
            }

            get_state(): String { @@:("in_game".to_string()) }
            get_score(): i32    { @@:(@@:self.score) }
            get_lives(): i32    { @@:(@@:self.player.get_lives()) }
            get_wave(): i32     { @@:(@@:self.wave) }
            is_paused(): bool   { @@:(false) }
        }

        $Playing => $InGame {
            tick(dt: f64) {
                @@:self.player.tick(dt);
                @@:self.fleet.tick(dt);
            }

            player_killed_invader(index: i32) {
                if @@:self.fleet.kill_invader(index) {
                    @@:self.score = @@:self.score + @@:self.points_per_invader;
                    if @@:self.fleet.alive_count() <= 0 {
                        -> $WaveComplete
                    }
                }
            }

            player_hit() {
                if @@:self.player.can_be_hit() {
                    @@:self.player.hit();
                    -> $PlayerDying
                }
            }

            fleet_reached_edge() {
                @@:self.fleet.edge_reached();
            }

            fleet_reached_bottom() {
                -> $GameOver
            }

            get_state(): String { @@:("playing".to_string()) }
            => $^
        }

        $PlayerDying => $InGame {
            tick(dt: f64) {
                @@:self.player.tick(dt);
                @@:self.fleet.tick(dt);
                if @@:self.player.get_state() == "invulnerable" {
                    -> $Playing
                } else if @@:self.player.get_state() == "dead" {
                    -> $GameOver
                }
            }

            fleet_reached_edge() {
                @@:self.fleet.edge_reached();
            }

            fleet_reached_bottom() {
                -> $GameOver
            }

            get_state(): String { @@:("player_dying".to_string()) }
            => $^
        }

        $WaveComplete => $InGame {
            $>() {
                @@:self.wave_timer = 0.0;
            }

            tick(dt: f64) {
                @@:self.wave_timer = @@:self.wave_timer + dt;
                if @@:self.wave_timer >= @@:self.wave_pause {
                    @@:self.wave = @@:self.wave + 1;
                    @@:self.fleet.reset(@@:self.fleet_rows, @@:self.fleet_cols);
                    -> $Playing
                }
            }

            get_state(): String { @@:("wave_complete".to_string()) }
            => $^
        }

        $Paused {
            resume() {
                -> pop$
            }

            get_state(): String { @@:("paused".to_string()) }
            get_score(): i32    { @@:(@@:self.score) }
            get_lives(): i32    { @@:(@@:self.player.get_lives()) }
            get_wave(): i32     { @@:(@@:self.wave) }
            is_paused(): bool   { @@:(true) }
        }

        $GameOver {
            restart() {
                -> $Attract
            }

            get_state(): String { @@:("game_over".to_string()) }
            get_score(): i32    { @@:(@@:self.score) }
            get_lives(): i32    { @@:(@@:self.player.get_lives()) }
            get_wave(): i32     { @@:(@@:self.wave) }
            is_paused(): bool   { @@:(false) }
        }

    domain:
        score: i32 = 0
        wave: i32 = 1
        wave_timer: f64 = 0.0
        wave_pause: f64 = 2.0
        fleet_rows: i32 = 5
        fleet_cols: i32 = 11
        points_per_invader: i32 = 10
        player: Player = @@Player()
        fleet: Fleet = @@Fleet()
}
