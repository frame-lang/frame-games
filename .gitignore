# Godot web bundles ARE committed now (shared-engine layout: one games/<id>/
# versions/_engine/ + thin per-language dirs ~ a few hundred KB each).
# Build/dev scratch — local only, never committed (cargo targets, godot-cpp
# clones, the godot projects + their multi-GB build artifacts).
build/spike-rust/
build/spike-cpp/
build/spike-c/
build/min-cpp/
# Flame (Dart) spike: source is force-added (asteroids.fdart, app/lib/main.dart,
# app/pubspec.*, app/web/); the Flutter project's generated + build artifacts
# below are local only.
build/spike-flame/
# raylib (C) spike: source is force-added (raylib_host.c, shell.html); the
# cloned raylib checkout + generated asteroids.c + emcc outputs are local only.
build/spike-raylib/
# Unity (C#) spike: force-add the source (asteroids.fcs, Assets/*.cs, .jslib,
# SETUP.md); Unity's generated Library/, the WebGL build-out/, the generated
# Assets/Asteroids.cs + Assets/Main.unity, and *.meta are local only.
build/spike-unity/


# Scratch copies of Godot projects used during the Web exports (build/godot.sh).
build/godot-*/

# Per-game generated Frame artifacts (live beside the .fjs / .fgd source).
# Regenerated by build/gen.sh + build/godot.sh — never committed.
games/*/src/*.machine.js
games/*/src/*.dot
games/*/generated/
# Generated GDScript output (mirrors the system name in the .fgd source).
games/asteroids/godot/scripts/asteroids.gd
# Godot editor caches.
games/*/godot/.godot/
games/*/godot/*.uid
games/*/godot/**/*.uid
