function AsteroidField:_state_Active(__e, compartment)
    if __e._message == "advance" then
        self:_s_Active_hdl_user_advance(__e, compartment)
        return
    end
    if __e._message == "alive_count" then
        self:_s_Active_hdl_user_alive_count(__e, compartment)
        return
    end
    if __e._message == "clear" then
        self:_s_Active_hdl_user_clear(__e, compartment)
        return
    end
    if __e._message == "count" then
        self:_s_Active_hdl_user_count(__e, compartment)
        return
    end
    if __e._message == "is_alive" then
        self:_s_Active_hdl_user_is_alive(__e, compartment)
        return
    end
    if __e._message == "position" then
        self:_s_Active_hdl_user_position(__e, compartment)
        return
    end
    if __e._message == "radius_of" then
        self:_s_Active_hdl_user_radius_of(__e, compartment)
        return
    end
    if __e._message == "remove" then
        self:_s_Active_hdl_user_remove(__e, compartment)
        return
    end
    if __e._message == "size_of" then
        self:_s_Active_hdl_user_size_of(__e, compartment)
        return
    end
    if __e._message == "spawn_wave" then
        self:_s_Active_hdl_user_spawn_wave(__e, compartment)
        return
    end
    if __e._message == "split" then
        self:_s_Active_hdl_user_split(__e, compartment)
        return
    end
    if __e._message == "velocity" then
        self:_s_Active_hdl_user_velocity(__e, compartment)
        return
    end
end

function AsteroidField:_s_Active_hdl_user_advance(__e, compartment)
    local dt = __e._parameters[1]
    local court_size = __e._parameters[2]
    local i = 1
    while i <= #self.asteroids do
        if self.asteroids[i].alive then
            self.asteroids[i].pos = vadd(self.asteroids[i].pos, vscale(self.asteroids[i].vel, dt))
            if self.asteroids[i].pos.x < 0.0 then self.asteroids[i].pos.x = self.asteroids[i].pos.x + court_size.x end
            if self.asteroids[i].pos.x > court_size.x then self.asteroids[i].pos.x = self.asteroids[i].pos.x - court_size.x end
            if self.asteroids[i].pos.y < 0.0 then self.asteroids[i].pos.y = self.asteroids[i].pos.y + court_size.y end
            if self.asteroids[i].pos.y > court_size.y then self.asteroids[i].pos.y = self.asteroids[i].pos.y - court_size.y end
        end
        i = i + 1
    end
end

function AsteroidField:_s_Active_hdl_user_alive_count(__e, compartment)
                    local c = 0
                    local i = 1
                    while i <= #self.asteroids do
                        if self.asteroids[i].alive then c = c + 1 end
                        i = i + 1
                    end
    self._context_stack[#self._context_stack]._return = c
end

function AsteroidField:_s_Active_hdl_user_clear(__e, compartment)
    self.asteroids = {}
end

function AsteroidField:_s_Active_hdl_user_count(__e, compartment)
    self._context_stack[#self._context_stack]._return = #self.asteroids
end

function AsteroidField:_s_Active_hdl_user_is_alive(__e, compartment)
    local index = __e._parameters[1]
                    if index < 1 or index > #self.asteroids then
    self._context_stack[#self._context_stack]._return = false
                        return
    end
    self._context_stack[#self._context_stack]._return = self.asteroids[index].alive
end

function AsteroidField:_s_Active_hdl_user_position(__e, compartment)
    local index = __e._parameters[1]
                    if index < 1 or index > #self.asteroids then
    self._context_stack[#self._context_stack]._return = v2(0, 0)
                        return
    end
    self._context_stack[#self._context_stack]._return = self.asteroids[index].pos
end

function AsteroidField:_s_Active_hdl_user_radius_of(__e, compartment)
    local index = __e._parameters[1]
                    if index < 1 or index > #self.asteroids then
    self._context_stack[#self._context_stack]._return = 0.0
                        return
    end
                    local sz = self.asteroids[index].size
                    if sz == 3 then 
    self._context_stack[#self._context_stack]._return = 32.0
                                 return end
                    if sz == 2 then 
    self._context_stack[#self._context_stack]._return = 18.0
                                 return end
    self._context_stack[#self._context_stack]._return = 10.0
end

function AsteroidField:_s_Active_hdl_user_remove(__e, compartment)
    local index = __e._parameters[1]
    if index < 1 or index > #self.asteroids then
        return
    end
    self.asteroids[index].alive = false
end

function AsteroidField:_s_Active_hdl_user_size_of(__e, compartment)
    local index = __e._parameters[1]
                    if index < 1 or index > #self.asteroids then
    self._context_stack[#self._context_stack]._return = 0
                        return
    end
    self._context_stack[#self._context_stack]._return = self.asteroids[index].size
end

function AsteroidField:_s_Active_hdl_user_spawn_wave(__e, compartment)
    local count = __e._parameters[1]
    local court_size = __e._parameters[2]
    self.asteroids = {}
    local i = 0
    while i < count do
        self:spawn_large(court_size)
        i = i + 1
    end
end

function AsteroidField:_s_Active_hdl_user_split(__e, compartment)
    local index = __e._parameters[1]
                    if index < 1 or index > #self.asteroids then
    self._context_stack[#self._context_stack]._return = false
                        return
    end
                    if not self.asteroids[index].alive then
    self._context_stack[#self._context_stack]._return = false
                        return
    end
                    self.asteroids[index].alive = false
                    local sz = self.asteroids[index].size
                    local p = self.asteroids[index].pos
                    if sz > 1 then
                        self:spawn_child(p, sz - 1)
                        self:spawn_child(p, sz - 1)
                    end
    self._context_stack[#self._context_stack]._return = true
end

function AsteroidField:_s_Active_hdl_user_velocity(__e, compartment)
    local index = __e._parameters[1]
                    if index < 1 or index > #self.asteroids then
    self._context_stack[#self._context_stack]._return = v2(0, 0)
                        return
    end
    self._context_stack[#self._context_stack]._return = self.asteroids[index].vel
end

function AsteroidField:spawn_large(court_size)
    local edge = math.random(0, 3)
    local pos = v2(0, 0)
    if edge == 0 then
        pos = v2(0.0, rf() * court_size.y)
    elseif edge == 1 then
        pos = v2(court_size.x, rf() * court_size.y)
    elseif edge == 2 then
        pos = v2(rf() * court_size.x, 0.0)
    else
        pos = v2(rf() * court_size.x, court_size.y)
    end
    local angle = rf() * 2.0 * math.pi
    local speed = 40.0 + rf() * 30.0
    local vel = vfromangle(angle, speed)
    table.insert(self.asteroids, {pos = pos, vel = vel, size = 3, alive = true})
end

function AsteroidField:spawn_child(pos, size)
    local angle = rf() * 2.0 * math.pi
    local speed = 60.0 + rf() * 40.0 + (3 - size) * 20.0
    local vel = vfromangle(angle, speed)
    table.insert(self.asteroids, {pos = pos, vel = vel, size = size, alive = true})
end

