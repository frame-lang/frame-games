    end
    if __e._message == "is_visible" then
        self:_s_Dead_hdl_user_is_visible(__e, compartment)
        return
    end
    if __e._message == "respawn" then
        self:_s_Dead_hdl_user_respawn(__e, compartment)
        return
    end
end

function Ship:_s_Alive_hdl_frame_enter(__e, compartment)
    if compartment.state_vars["cooldown"] == nil then
        compartment.state_vars["cooldown"] = 0.0
    end
end

function Ship:_s_Alive_hdl_user_can_be_hit(__e, compartment)
    self._context_stack[#self._context_stack]._return = true
end

function Ship:_s_Alive_hdl_user_can_fire(__e, compartment)
    self._context_stack[#self._context_stack]._return = compartment.state_vars["cooldown"] <= 0.0
end

function Ship:_s_Alive_hdl_user_can_hyperspace(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.hyperspaces_remaining > 0
end

function Ship:_s_Alive_hdl_user_fire(__e, compartment)
    compartment.state_vars["cooldown"] = 0.22
end

function Ship:_s_Alive_hdl_user_get_lives(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.lives_remaining
end

function Ship:_s_Alive_hdl_user_hit(__e, compartment)
    local __compartment = self:__prepareEnter("Exploding", nil, nil)
    self:__transition(__compartment)
    return
end

function Ship:_s_Alive_hdl_user_hyperspace(__e, compartment)
    if self.hyperspaces_remaining > 0 then
        self.hyperspaces_remaining = self.hyperspaces_remaining - 1
        local __compartment = self:__prepareEnter("InHyperspace", nil, nil)
        self:__transition(__compartment)
        return
    end
end

function Ship:_s_Alive_hdl_user_is_alive(__e, compartment)
    self._context_stack[#self._context_stack]._return = true
end

function Ship:_s_Alive_hdl_user_is_visible(__e, compartment)
    self._context_stack[#self._context_stack]._return = true
end

function Ship:_s_Alive_hdl_user_tick(__e, compartment)
    local dt = __e._parameters[1]
    if compartment.state_vars["cooldown"] > 0.0 then
        compartment.state_vars["cooldown"] = compartment.state_vars["cooldown"] - dt
    end
end

function Ship:_s_InHyperspace_hdl_frame_exit(__e, compartment)
    self.host.warp_in()
end

function Ship:_s_InHyperspace_hdl_frame_enter(__e, compartment)
    if compartment.state_vars["timer"] == nil then
        compartment.state_vars["timer"] = 0.0
    end
    if compartment.state_vars["duration"] == nil then
        compartment.state_vars["duration"] = 0.4
    end
    self.host.warp_out()
end

function Ship:_s_InHyperspace_hdl_user_can_be_hit(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_InHyperspace_hdl_user_can_fire(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_InHyperspace_hdl_user_can_hyperspace(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_InHyperspace_hdl_user_get_lives(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.lives_remaining
end

function Ship:_s_InHyperspace_hdl_user_is_alive(__e, compartment)
    self._context_stack[#self._context_stack]._return = true
end

function Ship:_s_InHyperspace_hdl_user_is_visible(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_InHyperspace_hdl_user_tick(__e, compartment)
    local dt = __e._parameters[1]
    compartment.state_vars["timer"] = compartment.state_vars["timer"] + dt
    if compartment.state_vars["timer"] >= compartment.state_vars["duration"] then
        local __compartment = self:__prepareEnter("Alive", nil, nil)
        self:__transition(__compartment)
        return
    end
end

function Ship:_s_Exploding_hdl_frame_enter(__e, compartment)
    if compartment.state_vars["timer"] == nil then
        compartment.state_vars["timer"] = 0.0
    end
    if compartment.state_vars["duration"] == nil then
        compartment.state_vars["duration"] = 1.0
    end
    self.host.spawn_explosion()
end

function Ship:_s_Exploding_hdl_user_can_be_hit(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_Exploding_hdl_user_can_fire(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_Exploding_hdl_user_can_hyperspace(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_Exploding_hdl_user_get_lives(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.lives_remaining
end

function Ship:_s_Exploding_hdl_user_is_alive(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_Exploding_hdl_user_is_visible(__e, compartment)
    self._context_stack[#self._context_stack]._return = true
end

function Ship:_s_Exploding_hdl_user_tick(__e, compartment)
    local dt = __e._parameters[1]
    compartment.state_vars["timer"] = compartment.state_vars["timer"] + dt
    if compartment.state_vars["timer"] >= compartment.state_vars["duration"] then
        self.lives_remaining = self.lives_remaining - 1
        if self.lives_remaining <= 0 then
            local __compartment = self:__prepareEnter("Dead", nil, nil)
            self:__transition(__compartment)
            return
    else
            local __compartment = self:__prepareEnter("Respawning", nil, nil)
            self:__transition(__compartment)
            return
    end
    end
end

function Ship:_s_Respawning_hdl_frame_enter(__e, compartment)
    if compartment.state_vars["timer"] == nil then
        compartment.state_vars["timer"] = 0.0
    end
    if compartment.state_vars["duration"] == nil then
        compartment.state_vars["duration"] = 2.0
    end
    self.host.reset_ship()
end

function Ship:_s_Respawning_hdl_user_can_be_hit(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_Respawning_hdl_user_can_fire(__e, compartment)
    self._context_stack[#self._context_stack]._return = true
end

function Ship:_s_Respawning_hdl_user_can_hyperspace(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_Respawning_hdl_user_get_lives(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.lives_remaining
end

function Ship:_s_Respawning_hdl_user_is_alive(__e, compartment)
    self._context_stack[#self._context_stack]._return = true
end

function Ship:_s_Respawning_hdl_user_is_visible(__e, compartment)
    self._context_stack[#self._context_stack]._return = true
end

function Ship:_s_Respawning_hdl_user_tick(__e, compartment)
    local dt = __e._parameters[1]
    compartment.state_vars["timer"] = compartment.state_vars["timer"] + dt
    if compartment.state_vars["timer"] >= compartment.state_vars["duration"] then
        local __compartment = self:__prepareEnter("Alive", nil, nil)
        self:__transition(__compartment)
        return
    end
end

function Ship:_s_Dead_hdl_user_can_be_hit(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_Dead_hdl_user_can_fire(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_Dead_hdl_user_can_hyperspace(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_Dead_hdl_user_get_lives(__e, compartment)
    self._context_stack[#self._context_stack]._return = 0
end

function Ship:_s_Dead_hdl_user_is_alive(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_Dead_hdl_user_is_visible(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function Ship:_s_Dead_hdl_user_respawn(__e, compartment)
    self.lives_remaining = self.starting_lives
    self.hyperspaces_remaining = self.starting_hyperspaces
    local __compartment = self:__prepareEnter("Respawning", nil, nil)
    self:__transition(__compartment)
    return
end

function Ship:get_current_state_name()
    return self.__compartment.state 
end

function Ship:get_hyperspaces_remaining()
    return self.hyperspaces_remaining 
end

