
-- Asteroids — Lua/LÖVE port of the Frame controller. Same three systems as the
-- other ports. Lua has no structs, so Vec2 is a plain {x=,y=} table with the
-- helpers below; field indices are 1-based (idiomatic Lua). Host effects are
-- plain functions on a host table (the LÖVE game supplies it).
local function v2(x, y) return {x = x, y = y} end
local function vadd(a, b) return {x = a.x + b.x, y = a.y + b.y} end
local function vscale(a, s) return {x = a.x * s, y = a.y * s} end
local function vfromangle(a, speed) return {x = math.cos(a) * speed, y = math.sin(a) * speed} end
local function rf() return math.random() end

-- ------------------------------------------------------------ Ship
local ShipFrameEvent = {}
ShipFrameEvent.__index = ShipFrameEvent

function ShipFrameEvent.new(message, parameters)
    local self = setmetatable({}, ShipFrameEvent)
    self._message = message
    self._parameters = parameters or {}
    return self
end


local ShipFrameContext = {}
ShipFrameContext.__index = ShipFrameContext

function ShipFrameContext.new(event, default_return)
    local self = setmetatable({}, ShipFrameContext)
    self._event = event
    self._return = default_return
    self._data = {}
    self._transitioned = false
    return self
end


local ShipCompartment = {}
ShipCompartment.__index = ShipCompartment

function ShipCompartment.new(state, parent_compartment)
    local self = setmetatable({}, ShipCompartment)
    self.state = state
    self.state_args = {}
    self.state_vars = {}
    self.enter_args = {}
    self.exit_args = {}
    self.forward_event = nil
    self.parent_compartment = parent_compartment
    return self
end

function ShipCompartment:copy()
    local c = ShipCompartment.new(self.state, self.parent_compartment)
    c.state_args = {}
    for k, v in pairs(self.state_args) do c.state_args[k] = v end
    c.state_vars = {}
    for k, v in pairs(self.state_vars) do c.state_vars[k] = v end
    c.enter_args = {}
    for k, v in pairs(self.enter_args) do c.enter_args[k] = v end
    c.exit_args = {}
    for k, v in pairs(self.exit_args) do c.exit_args[k] = v end
    c.forward_event = self.forward_event
    return c
end


local Ship = {}
Ship.__index = Ship

function Ship.new()
    local self = setmetatable({}, Ship)
    self._state_stack = {}
    self._context_stack = {}
    self.lives_remaining = 3
    self.starting_lives = 3
    self.hyperspaces_remaining = 3
    self.starting_hyperspaces = 3
    self.__compartment = self:__prepareEnter("Alive", nil, nil)
    self.__next_compartment = nil
    return self
end

function Ship:_frame_init(host)
    self.host = host
    local __e = ShipFrameEvent.new("$>", self.__compartment.enter_args)
    local __ctx = ShipFrameContext.new(__e, nil)
    self._context_stack[#self._context_stack + 1] = __ctx
    self:__kernel(__e)
    table.remove(self._context_stack)
end

function Ship._create(host)
    local c = Ship.new()
    c:_frame_init(host)
    return c
end

function Ship:hsm_chain()
    local t = {}
    t["Alive"] = {"Alive"}
    t["InHyperspace"] = {"InHyperspace"}
    t["Exploding"] = {"Exploding"}
    t["Respawning"] = {"Respawning"}
    t["Dead"] = {"Dead"}
    return t
end
function Ship:__prepareEnter(leaf, state_args, enter_args)
    state_args = state_args or {}
    enter_args = enter_args or {}
    local comp = nil
    local chain = self:hsm_chain()[leaf]
    for i = 1, #chain do
        local new_comp = ShipCompartment.new(chain[i])
        new_comp.state_args = {}
        for j = 1, #state_args do new_comp.state_args[j] = state_args[j] end
        new_comp.enter_args = {}
        for j = 1, #enter_args do new_comp.enter_args[j] = enter_args[j] end
        new_comp.parent_compartment = comp
        comp = new_comp
    end
    return comp
end

function Ship:__prepareExit(exit_args)
    local comp = self.__compartment
    while comp ~= nil do
        comp.exit_args = {}
        for j = 1, #exit_args do comp.exit_args[j] = exit_args[j] end
        comp = comp.parent_compartment
    end
end

function Ship:__kernel(__e)
    -- Route event to current state.
    self:__router(__e)
    -- Drain any transitions queued by the handler.
    while self.__next_compartment ~= nil do
        local next_compartment = self.__next_compartment
        self.__next_compartment = nil
        local exit_event = ShipFrameEvent.new("<$", self.__compartment.exit_args)
        self:__router(exit_event)
        self.__compartment = next_compartment
        local forward_event = next_compartment.forward_event
        next_compartment.forward_event = nil
        if forward_event == nil then
            local enter_event = ShipFrameEvent.new("$>", self.__compartment.enter_args)
            self:__router(enter_event)
        elseif forward_event._message == "$>" then
            self:__router(forward_event)
        else
            local enter_event = ShipFrameEvent.new("$>", self.__compartment.enter_args)
            self:__router(enter_event)
            self:__router(forward_event)
        end
        for _, ctx in ipairs(self._context_stack) do
            ctx._transitioned = true
        end
    end
end

function Ship:__router(__e)
    local handler = self["_state_" .. self.__compartment.state]
    if handler then
        handler(self, __e, self.__compartment)
    end
end

function Ship:__transition(next_compartment)
    self.__next_compartment = next_compartment
end

function Ship:tick(dt)
    local __e = ShipFrameEvent.new("tick", {dt})
    local __ctx = ShipFrameContext.new(__e, nil)
    self._context_stack[#self._context_stack + 1] = __ctx
    local __ok, __err = pcall(self.__kernel, self, __e)
    if not __ok then
        self._context_stack[#self._context_stack] = nil
        error(__err)
    end
    return table.remove(self._context_stack)._return
end

function Ship:hit()
    local __e = ShipFrameEvent.new("hit", {})
    local __ctx = ShipFrameContext.new(__e, nil)
    self._context_stack[#self._context_stack + 1] = __ctx
