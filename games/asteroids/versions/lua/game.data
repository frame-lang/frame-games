function AsteroidsGame.new()
    local self = setmetatable({}, AsteroidsGame)
    self._state_stack = {}
    self._context_stack = {}
    self.score = 0
    self.wave = 1
    self.wave_timer = 0.0
    self.wave_pause = 2.0
    self.bullets_in_flight = 0
    self.max_bullets = 4
    self.last_court_size = v2(640, 480)
    self.field = AsteroidField._create()
    self.__compartment = self:__prepareEnter("Attract", nil, nil)
    self.__next_compartment = nil
    return self
end

function AsteroidsGame:_frame_init(ship_host, difficulty)
    self.difficulty = difficulty
    self.ship = Ship._create(ship_host)
    local __e = AsteroidsGameFrameEvent.new("$>", self.__compartment.enter_args)
    local __ctx = AsteroidsGameFrameContext.new(__e, nil)
    self._context_stack[#self._context_stack + 1] = __ctx
    self:__kernel(__e)
    table.remove(self._context_stack)
end

function AsteroidsGame._create(ship_host, difficulty)
    local c = AsteroidsGame.new()
    c:_frame_init(ship_host, difficulty)
    return c
end

function AsteroidsGame:hsm_chain()
    local t = {}
    t["Attract"] = {"Attract"}
    t["InGame"] = {"InGame"}
    t["Playing"] = {"InGame", "Playing"}
    t["ShipDying"] = {"InGame", "ShipDying"}
    t["WaveClear"] = {"InGame", "WaveClear"}
    t["Paused"] = {"Paused"}
    t["GameOver"] = {"GameOver"}
    return t
end
function AsteroidsGame:__prepareEnter(leaf, state_args, enter_args)
    state_args = state_args or {}
    enter_args = enter_args or {}
    local comp = nil
    local chain = self:hsm_chain()[leaf]
    for i = 1, #chain do
        local new_comp = AsteroidsGameCompartment.new(chain[i])
        new_comp.state_args = {}
        for j = 1, #state_args do new_comp.state_args[j] = state_args[j] end
        new_comp.enter_args = {}
        for j = 1, #enter_args do new_comp.enter_args[j] = enter_args[j] end
        new_comp.parent_compartment = comp
        comp = new_comp
    end
    return comp
end

function AsteroidsGame:__prepareExit(exit_args)
    local comp = self.__compartment
    while comp ~= nil do
        comp.exit_args = {}
        for j = 1, #exit_args do comp.exit_args[j] = exit_args[j] end
        comp = comp.parent_compartment
    end
end

function AsteroidsGame:__kernel(__e)
    -- Route event to current state.
    self:__router(__e)
    -- Drain any transitions queued by the handler.
    while self.__next_compartment ~= nil do
        local next_compartment = self.__next_compartment
        self.__next_compartment = nil
        local exit_event = AsteroidsGameFrameEvent.new("<$", self.__compartment.exit_args)
        self:__router(exit_event)
        self.__compartment = next_compartment
        local forward_event = next_compartment.forward_event
        next_compartment.forward_event = nil
        if forward_event == nil then
            local enter_event = AsteroidsGameFrameEvent.new("$>", self.__compartment.enter_args)
            self:__router(enter_event)
        elseif forward_event._message == "$>" then
            self:__router(forward_event)
        else
            local enter_event = AsteroidsGameFrameEvent.new("$>", self.__compartment.enter_args)
            self:__router(enter_event)
            self:__router(forward_event)
        end
        for _, ctx in ipairs(self._context_stack) do
            ctx._transitioned = true
        end
    end
end

function AsteroidsGame:__router(__e)
    local handler = self["_state_" .. self.__compartment.state]
    if handler then
        handler(self, __e, self.__compartment)
    end
end

function AsteroidsGame:__transition(next_compartment)
    self.__next_compartment = next_compartment
end

function AsteroidsGame:start()
    local __e = AsteroidsGameFrameEvent.new("start", {})
    local __ctx = AsteroidsGameFrameContext.new(__e, nil)
    self._context_stack[#self._context_stack + 1] = __ctx
    local __ok, __err = pcall(self.__kernel, self, __e)
    if not __ok then
        self._context_stack[#self._context_stack] = nil
        error(__err)
    end
    return table.remove(self._context_stack)._return
end

function AsteroidsGame:restart()
    local __e = AsteroidsGameFrameEvent.new("restart", {})
    local __ctx = AsteroidsGameFrameContext.new(__e, nil)
    self._context_stack[#self._context_stack + 1] = __ctx
    local __ok, __err = pcall(self.__kernel, self, __e)
    if not __ok then
        self._context_stack[#self._context_stack] = nil
        error(__err)
    end
    return table.remove(self._context_stack)._return
end

