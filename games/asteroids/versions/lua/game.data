function AsteroidsGame:_state_Attract(__e, compartment)
    if __e._message == "$>" then
        self:_s_Attract_hdl_frame_enter(__e, compartment)
        return
    end
    if __e._message == "get_difficulty" then
        self:_s_Attract_hdl_user_get_difficulty(__e, compartment)
        return
    end
    if __e._message == "get_lives" then
        self:_s_Attract_hdl_user_get_lives(__e, compartment)
        return
    end
    if __e._message == "get_score" then
        self:_s_Attract_hdl_user_get_score(__e, compartment)
        return
    end
    if __e._message == "get_wave" then
        self:_s_Attract_hdl_user_get_wave(__e, compartment)
        return
    end
    if __e._message == "is_paused" then
        self:_s_Attract_hdl_user_is_paused(__e, compartment)
        return
    end
    if __e._message == "start" then
        self:_s_Attract_hdl_user_start(__e, compartment)
        return
    end
end

function AsteroidsGame:_state_InGame(__e, compartment)
    if __e._message == "bullet_expired" then
        self:_s_InGame_hdl_user_bullet_expired(__e, compartment)
        return
    end
    if __e._message == "bullet_fired" then
        self:_s_InGame_hdl_user_bullet_fired(__e, compartment)
        return
    end
    if __e._message == "get_difficulty" then
        self:_s_InGame_hdl_user_get_difficulty(__e, compartment)
        return
    end
    if __e._message == "get_lives" then
        self:_s_InGame_hdl_user_get_lives(__e, compartment)
        return
    end
    if __e._message == "get_score" then
        self:_s_InGame_hdl_user_get_score(__e, compartment)
        return
    end
    if __e._message == "get_wave" then
        self:_s_InGame_hdl_user_get_wave(__e, compartment)
        return
    end
    if __e._message == "is_paused" then
        self:_s_InGame_hdl_user_is_paused(__e, compartment)
        return
    end
    if __e._message == "pause" then
        self:_s_InGame_hdl_user_pause(__e, compartment)
        return
    end
end

function AsteroidsGame:_state_Playing(__e, compartment)
    if __e._message == "bullet_hit_asteroid" then
        self:_s_Playing_hdl_user_bullet_hit_asteroid(__e, compartment)
        return
    end
    if __e._message == "ship_hit_asteroid" then
        self:_s_Playing_hdl_user_ship_hit_asteroid(__e, compartment)
        return
    end
    if __e._message == "ship_hyperspace" then
        self:_s_Playing_hdl_user_ship_hyperspace(__e, compartment)
        return
    end
    if __e._message == "tick" then
        self:_s_Playing_hdl_user_tick(__e, compartment)
        return
    end
    self:_state_InGame(__e, compartment.parent_compartment)
end

function AsteroidsGame:_state_ShipDying(__e, compartment)
    if __e._message == "tick" then
        self:_s_ShipDying_hdl_user_tick(__e, compartment)
        return
    end
    self:_state_InGame(__e, compartment.parent_compartment)
end

function AsteroidsGame:_state_WaveClear(__e, compartment)
    if __e._message == "$>" then
        self:_s_WaveClear_hdl_frame_enter(__e, compartment)
        return
    end
    if __e._message == "tick" then
        self:_s_WaveClear_hdl_user_tick(__e, compartment)
        return
    end
    self:_state_InGame(__e, compartment.parent_compartment)
end

function AsteroidsGame:_state_Paused(__e, compartment)
    if __e._message == "get_difficulty" then
        self:_s_Paused_hdl_user_get_difficulty(__e, compartment)
        return
    end
    if __e._message == "get_lives" then
        self:_s_Paused_hdl_user_get_lives(__e, compartment)
        return
    end
    if __e._message == "get_score" then
        self:_s_Paused_hdl_user_get_score(__e, compartment)
        return
    end
    if __e._message == "get_wave" then
        self:_s_Paused_hdl_user_get_wave(__e, compartment)
        return
    end
    if __e._message == "is_paused" then
        self:_s_Paused_hdl_user_is_paused(__e, compartment)
        return
    end
    if __e._message == "resume" then
        self:_s_Paused_hdl_user_resume(__e, compartment)
        return
    end
end

function AsteroidsGame:_state_GameOver(__e, compartment)
    if __e._message == "get_difficulty" then
        self:_s_GameOver_hdl_user_get_difficulty(__e, compartment)
        return
    end
    if __e._message == "get_lives" then
        self:_s_GameOver_hdl_user_get_lives(__e, compartment)
        return
    end
    if __e._message == "get_score" then
        self:_s_GameOver_hdl_user_get_score(__e, compartment)
        return
    end
    if __e._message == "get_wave" then
        self:_s_GameOver_hdl_user_get_wave(__e, compartment)
        return
    end
    if __e._message == "is_paused" then
        self:_s_GameOver_hdl_user_is_paused(__e, compartment)
        return
    end
    if __e._message == "restart" then
        self:_s_GameOver_hdl_user_restart(__e, compartment)
        return
    end
end

function AsteroidsGame:_s_Attract_hdl_frame_enter(__e, compartment)
    self.score = 0
    self.wave = 1
    self.bullets_in_flight = 0
end

function AsteroidsGame:_s_Attract_hdl_user_get_difficulty(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.difficulty
end

function AsteroidsGame:_s_Attract_hdl_user_get_lives(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.ship:get_lives()
end

function AsteroidsGame:_s_Attract_hdl_user_get_score(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.score
end

function AsteroidsGame:_s_Attract_hdl_user_get_wave(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.wave
end

function AsteroidsGame:_s_Attract_hdl_user_is_paused(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function AsteroidsGame:_s_Attract_hdl_user_start(__e, compartment)
    self.ship:respawn()
    local n = self:asteroids_for_wave(1)
    self.field:spawn_wave(n, self.last_court_size)
    local __compartment = self:__prepareEnter("Playing", nil, nil)
    self:__transition(__compartment)
    return
end

function AsteroidsGame:_s_InGame_hdl_user_bullet_expired(__e, compartment)
    if self.bullets_in_flight > 0 then
        self.bullets_in_flight = self.bullets_in_flight - 1
    end
end

function AsteroidsGame:_s_InGame_hdl_user_bullet_fired(__e, compartment)
    self.bullets_in_flight = self.bullets_in_flight + 1
end

function AsteroidsGame:_s_InGame_hdl_user_get_difficulty(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.difficulty
end

function AsteroidsGame:_s_InGame_hdl_user_get_lives(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.ship:get_lives()
end

function AsteroidsGame:_s_InGame_hdl_user_get_score(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.score
end

function AsteroidsGame:_s_InGame_hdl_user_get_wave(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.wave
end

function AsteroidsGame:_s_InGame_hdl_user_is_paused(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function AsteroidsGame:_s_InGame_hdl_user_pause(__e, compartment)
    self._state_stack[#self._state_stack + 1] = self.__compartment
    self:__transition(AsteroidsGameCompartment.new("Paused"))
    return
end

function AsteroidsGame:_s_Playing_hdl_user_bullet_hit_asteroid(__e, compartment)
    local index = __e._parameters[1]
    if self.field:split(index) then
        local sz = self:size_points(index)
        self.score = self.score + sz * self.difficulty
        if self.field:alive_count() <= 0 then
            local __compartment = self:__prepareEnter("WaveClear", nil, nil)
            self:__transition(__compartment)
            return
    end
    end
end

function AsteroidsGame:_s_Playing_hdl_user_ship_hit_asteroid(__e, compartment)
    local index = __e._parameters[1]
    if not self.ship:can_be_hit() then
        return
    end
    self.ship:hit()
    local __compartment = self:__prepareEnter("ShipDying", nil, nil)
    self:__transition(__compartment)
    return
end

function AsteroidsGame:_s_Playing_hdl_user_ship_hyperspace(__e, compartment)
    self.ship:hyperspace()
end

function AsteroidsGame:_s_Playing_hdl_user_tick(__e, compartment)
    local dt = __e._parameters[1]
    local court_size = __e._parameters[2]
    self.last_court_size = court_size
    self.ship:tick(dt)
    self.field:advance(dt, court_size)
end

function AsteroidsGame:_s_ShipDying_hdl_user_tick(__e, compartment)
    local dt = __e._parameters[1]
    local court_size = __e._parameters[2]
    self.last_court_size = court_size
    self.ship:tick(dt)
    self.field:advance(dt, court_size)
    if self.ship:get_current_state_name() == "Respawning" then
        local __compartment = self:__prepareEnter("Playing", nil, nil)
        self:__transition(__compartment)
        return
    elseif self.ship:get_current_state_name() == "Dead" then
        local __compartment = self:__prepareEnter("GameOver", nil, nil)
        self:__transition(__compartment)
        return
    end
end

function AsteroidsGame:_s_WaveClear_hdl_frame_enter(__e, compartment)
    self.wave_timer = 0.0
end

function AsteroidsGame:_s_WaveClear_hdl_user_tick(__e, compartment)
    local dt = __e._parameters[1]
    local court_size = __e._parameters[2]
    self.last_court_size = court_size
    self.ship:tick(dt)
    self.wave_timer = self.wave_timer + dt
    if self.wave_timer >= self.wave_pause then
        self.wave = self.wave + 1
        local n = self:asteroids_for_wave(self.wave)
        self.field:spawn_wave(n, court_size)
        local __compartment = self:__prepareEnter("Playing", nil, nil)
        self:__transition(__compartment)
        return
    end
end

function AsteroidsGame:_s_Paused_hdl_user_get_difficulty(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.difficulty
end

function AsteroidsGame:_s_Paused_hdl_user_get_lives(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.ship:get_lives()
end

function AsteroidsGame:_s_Paused_hdl_user_get_score(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.score
end

function AsteroidsGame:_s_Paused_hdl_user_get_wave(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.wave
end

function AsteroidsGame:_s_Paused_hdl_user_is_paused(__e, compartment)
    self._context_stack[#self._context_stack]._return = true
end

function AsteroidsGame:_s_Paused_hdl_user_resume(__e, compartment)
    local __saved = table.remove(self._state_stack)
    self:__transition(__saved)
    return
end

function AsteroidsGame:_s_GameOver_hdl_user_get_difficulty(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.difficulty
end

function AsteroidsGame:_s_GameOver_hdl_user_get_lives(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.ship:get_lives()
end

function AsteroidsGame:_s_GameOver_hdl_user_get_score(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.score
end

function AsteroidsGame:_s_GameOver_hdl_user_get_wave(__e, compartment)
    self._context_stack[#self._context_stack]._return = self.wave
end

function AsteroidsGame:_s_GameOver_hdl_user_is_paused(__e, compartment)
    self._context_stack[#self._context_stack]._return = false
end

function AsteroidsGame:_s_GameOver_hdl_user_restart(__e, compartment)
    local __compartment = self:__prepareEnter("Attract", nil, nil)
    self:__transition(__compartment)
    return
end

function AsteroidsGame:asteroids_for_wave(wave)
    local base_count = 2 + self.difficulty
    return base_count + wave - 1
end

function AsteroidsGame:size_points(index)
    local sz = self.field:size_of(index)
    if sz == 3 then return 20 end
    if sz == 2 then return 50 end
    return 100
end

function AsteroidsGame:get_current_state_name()
    return self.__compartment.state 
end

function AsteroidsGame:get_bullets_in_flight()
    return self.bullets_in_flight 
end

function AsteroidsGame:get_max_bullets()
    return self.max_bullets 
end

return {
    Ship = Ship,
    AsteroidField = AsteroidField,
    AsteroidsGame = AsteroidsGame,
}

-- LÖVE config — fixed 800x600 design surface (the love.js HTML wrapper scales
-- the canvas to fit, keeping aspect). Unused modules off to slim the web build.
function love.conf(t)
    t.identity = "asteroids"
    t.window.title = "Asteroids"
    t.window.width = 800
    t.window.height = 600
    t.window.resizable = false
    t.modules.audio = false
    t.modules.sound = false
    t.modules.physics = false
    t.modules.joystick = false
    t.modules.touch = false
end
-- Asteroids — LÖVE (Lua) host for the Frame AsteroidsGame controller. Same FSM
-- as the other ports (asteroids.lua, generated from asteroids.flua); this is
-- the engine layer: love.update/draw/keypressed, love.graphics rendering, and
-- the four ShipHost callbacks. Field indices are 1-based to match the FSM.
--
-- Note: no live-state publish here — love.js (emscripten LÖVE) doesn't expose a
-- JS bridge for the in-wasm Lua, so the site's FSM diagram panel won't live-
-- update for this port (the game itself plays fully). An honest engine limit.
local asteroids = require("asteroids")

local COURT = { x = 800, y = 600 }

local COL_SHIP   = { 0x8a/255, 0xb4/255, 0xf8/255 }
local COL_ROCK   = { 0x9a/255, 0xa4/255, 0xb8/255 }
local COL_BULLET = { 1, 1, 1 }
local COL_FLAME  = { 1, 0.68, 0.26 }
local COL_TEXT   = { 1, 1, 1 }

local SHIP_THRUST = 240
local SHIP_ROT    = 4
local SHIP_MAX    = 320
local SHIP_DRAG   = 0.5
local SHIP_SIZE   = 14
local BULLET_SPEED = 500
local BULLET_LIFE  = 1.2
local BULLET_SIZE  = 2

local fsm, host
local ship_pos, ship_vel, ship_angle
local bullets = {}
local hudFont, centerFont

-- ── vector helpers ({x,y} tables, matching the FSM) ──
local function vadd(a, b) return { x = a.x + b.x, y = a.y + b.y } end
local function vscale(a, s) return { x = a.x * s, y = a.y * s } end
local function vlen(a) return math.sqrt(a.x * a.x + a.y * a.y) end
local function vdist(a, b) return math.sqrt((a.x-b.x)^2 + (a.y-b.y)^2) end
local function wrap(p)
    if p.x < 0 then p.x = p.x + COURT.x end
    if p.x > COURT.x then p.x = p.x - COURT.x end
    if p.y < 0 then p.y = p.y + COURT.y end
    if p.y > COURT.y then p.y = p.y - COURT.y end
end
local function thrust_held() return love.keyboard.isDown("up", "w") end

function love.load()
    math.randomseed(os.time and os.time() or 1)
    hudFont = love.graphics.newFont(18)
    centerFont = love.graphics.newFont(28)
    love.graphics.setBackgroundColor(0, 0, 0)

    ship_pos = { x = COURT.x / 2, y = COURT.y / 2 }
    ship_vel = { x = 0, y = 0 }
    ship_angle = -math.pi / 2

    host = {
        warp_out = function()
            ship_pos = { x = math.random() * COURT.x, y = math.random() * COURT.y }
            ship_vel = { x = 0, y = 0 }
        end,
        warp_in = function() end,
        spawn_explosion = function() end,
        reset_ship = function()
            ship_pos = { x = COURT.x / 2, y = COURT.y / 2 }
            ship_vel = { x = 0, y = 0 }
            ship_angle = -math.pi / 2
            for _ = 1, #bullets do fsm:bullet_expired() end
            bullets = {}
        end,
    }
    fsm = asteroids.AsteroidsGame._create(host, 2)
    host.reset_ship()
end

local function try_fire()
    fsm.ship:fire()
    local dir = { x = math.cos(ship_angle), y = math.sin(ship_angle) }
    bullets[#bullets + 1] = {
        pos = vadd(ship_pos, vscale(dir, SHIP_SIZE)),
        vel = vadd(vscale(dir, BULLET_SPEED), ship_vel),
        life = 0,
    }
    fsm:bullet_fired()
end

local function handle_input(dt)
    if not fsm.ship:is_visible() then return end
    if love.keyboard.isDown("left", "a") then ship_angle = ship_angle - SHIP_ROT * dt end
    if love.keyboard.isDown("right", "d") then ship_angle = ship_angle + SHIP_ROT * dt end
    local ss = fsm.ship:get_current_state_name()
    if (ss == "Alive" or ss == "Respawning") and thrust_held() then
        ship_vel = vadd(ship_vel, vscale({ x = math.cos(ship_angle), y = math.sin(ship_angle) }, SHIP_THRUST * dt))
        if vlen(ship_vel) > SHIP_MAX then ship_vel = vscale(ship_vel, SHIP_MAX / vlen(ship_vel)) end
    end
    if fsm.ship:can_fire() and fsm:get_bullets_in_flight() < fsm:get_max_bullets()
       and love.keyboard.isDown("space") then
        try_fire()
    end
end

local function update_ship(dt)
    if not fsm.ship:is_visible() then return end
    ship_vel = vscale(ship_vel, 1 - SHIP_DRAG * dt)
    ship_pos = vadd(ship_pos, vscale(ship_vel, dt))
    wrap(ship_pos)
end

local function update_bullets(dt)
    for i = #bullets, 1, -1 do
        local b = bullets[i]
        b.pos = vadd(b.pos, vscale(b.vel, dt))
        b.life = b.life + dt
        wrap(b.pos)
        if b.life >= BULLET_LIFE then
            table.remove(bullets, i)
            fsm:bullet_expired()
        end
    end
end

local function check_collisions()
    local total = fsm.field:count()
    for bi = #bullets, 1, -1 do
        local bp = bullets[bi].pos
        local hit = 0
        for i = 1, total do
            if fsm.field:is_alive(i) and vdist(fsm.field:position(i), bp) < fsm.field:radius_of(i) then
                hit = i
                break
            end
        end
        if hit > 0 then
            fsm:bullet_hit_asteroid(hit)
            table.remove(bullets, bi)
            fsm:bullet_expired()
        end
    end
    if fsm.ship:can_be_hit() then
        for i = 1, total do
            if fsm.field:is_alive(i) and vdist(fsm.field:position(i), ship_pos) < fsm.field:radius_of(i) + SHIP_SIZE * 0.6 then
                fsm:ship_hit_asteroid(i)
                break
            end
        end
    end
end

function love.update(dt)
    local state = fsm:get_current_state_name()
    if state ~= "Attract" and state ~= "GameOver" and not fsm:is_paused() then
        handle_input(dt)
        fsm:tick(dt, COURT)
        update_ship(dt)
        update_bullets(dt)
        check_collisions()
    end
end

function love.keypressed(key)
    local state = fsm:get_current_state_name()
    if state == "Attract" then
        fsm:start()
        bullets = {}
        return
    end
    if state == "GameOver" then
        if key == "r" then fsm:restart(); fsm:start(); bullets = {} end
        return
    end
    if key == "p" then
        if fsm:is_paused() then fsm:resume() else fsm:pause() end
        return
    end
    if fsm:is_paused() then return end
    if key == "h" and fsm.ship:can_hyperspace() then fsm:ship_hyperspace() end
end

-- ── rendering ──
local function draw_ship(at, ang)
    local nose  = vadd(at, vscale({ x = math.cos(ang),       y = math.sin(ang) },       SHIP_SIZE))
    local left  = vadd(at, vscale({ x = math.cos(ang + 2.5), y = math.sin(ang + 2.5) }, SHIP_SIZE))
    local right = vadd(at, vscale({ x = math.cos(ang - 2.5), y = math.sin(ang - 2.5) }, SHIP_SIZE))
    love.graphics.setColor(COL_SHIP)
    love.graphics.polygon("line", nose.x, nose.y, left.x, left.y, right.x, right.y)
    if thrust_held() then
        local ss = fsm.ship:get_current_state_name()
        if ss == "Alive" or ss == "Respawning" then
            local tb = vscale(vadd(left, right), 0.5)
            local tt = vadd(at, vscale({ x = math.cos(ang), y = math.sin(ang) }, -SHIP_SIZE * 1.4))
            love.graphics.setColor(COL_FLAME)
            love.graphics.line(tb.x, tb.y, tt.x, tt.y)
        end
    end
end

local function draw_explosion(at)
    love.graphics.setColor(COL_SHIP)
    for i = 0, 7 do
        local t = i / 8 * math.pi * 2
        love.graphics.line(at.x + math.cos(t) * 4, at.y + math.sin(t) * 4,
                           at.x + math.cos(t) * 14, at.y + math.sin(t) * 14)
    end
end

function love.draw()
    local state = fsm:get_current_state_name()
    local total = fsm.field:count()
    love.graphics.setColor(COL_ROCK)
    for i = 1, total do
        if fsm.field:is_alive(i) then
            local p = fsm.field:position(i)
            love.graphics.circle("line", p.x, p.y, fsm.field:radius_of(i))
        end
    end
    love.graphics.setColor(COL_BULLET)
    for i = 1, #bullets do
        love.graphics.circle("fill", bullets[i].pos.x, bullets[i].pos.y, BULLET_SIZE)
    end
    if state ~= "Attract" and state ~= "GameOver" and fsm.ship:is_visible() then
        local ss = fsm.ship:get_current_state_name()
        if ss == "Exploding" then
            draw_explosion(ship_pos)
        else
            local visible = true
            if ss == "Respawning" then visible = math.floor(love.timer.getTime() * 10) % 2 == 0 end
            if visible then draw_ship(ship_pos, ship_angle) end
        end
    end

    -- HUD + centered messages
    love.graphics.setColor(COL_TEXT)
    love.graphics.setFont(hudFont)
    love.graphics.print(string.format(
        "SCORE  %05d     LIVES  %d     WAVE  %d     DIFF  %d     WARP  %d",
        fsm:get_score(), fsm:get_lives(), fsm:get_wave(), fsm:get_difficulty(),
        fsm.ship:get_hyperspaces_remaining()), 12, 8)

    local msg = nil
    if state == "Attract" then
        msg = "A S T E R O I D S\n\nPress any key to start\n(H hyperspace · P pause)"
    elseif state == "WaveClear" then msg = "WAVE CLEAR"
    elseif state == "Paused" then msg = "PAUSED"
    elseif state == "GameOver" then msg = "GAME OVER\n\nPress R to restart"
    end
    if msg then
        love.graphics.setFont(centerFont)
        love.graphics.printf(msg, 0, COURT.y * 0.4, COURT.x, "center")
    end
end
